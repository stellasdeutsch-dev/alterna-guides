      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Spot the form",
      "items": [
        {
          "id": "1",
          "prompt": "“with sugar” → ?",
          "options": [
            "şekerli",
            "şekersiz",
            "siz şeker"
          ],
          "answer": 0,
          "explanation": "There is sugar — the tail starts with l. No separate “with,” no siz before the word. The last vowel of şeker is e, so -li."
        },
        {
          "id": "2",
          "prompt": "“without salt” → ?",
          "options": [
            "tuzlu",
            "tuzsuz",
            "tuzsız"
          ],
          "answer": 1,
          "explanation": "No salt — the tail starts with s. tuz has a u, so the tail has a u too: -suz."
        },
        {
          "id": "3",
          "prompt": "gazlı su is…",
          "say": "gazlı su",
          "options": [
            "sparkling water",
            "still water"
          ],
          "answer": 0,
          "explanation": "-lı means “with.” The gas is there, bubbles too."
        },
        {
          "id": "4",
          "prompt": "sütsüz kahve is…",
          "say": "sütsüz kahve",
          "options": [
            "coffee with milk",
            "coffee without milk"
          ],
          "answer": 1,
          "explanation": "-süz means “without.” No milk delivery today."
        }
      ]
    },
    {
