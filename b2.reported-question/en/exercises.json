{
  "topic": "b2.reported-question",
  "exercises": [
    {
      "id": "b2.reported-question.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Spot the reported question",
      "items": [
        {
          "id": "1",
          "prompt": "“Coming?” How do you report that?",
          "say": "Gelip gelmeyeceğini sordu.",
          "options": [
            "Gelip gelmeyeceğini sordu.",
            "Gelmeyeceğini söyledi.",
            "Geleceğini söyledi."
          ],
          "answer": 0,
          "explanation": "A reported question lives as a pair. Yes plus no. Without the pair it’s just a statement."
        },
        {
          "id": "2",
          "prompt": "Ne zaman geleceksin? → reported",
          "options": [
            "Ne zaman gelip gelmeyeceğini sordu.",
            "Ne zaman geleceğini sordu."
          ],
          "answer": 1,
          "explanation": "There’s a question word, ne zaman. It’s already asking. The pair is extra."
        },
        {
          "id": "3",
          "prompt": "Evli mi? → reported",
          "options": [
            "Evli olmadığını sordu.",
            "Evli mi olduğunu sordu.",
            "Evli olup olmadığını sordu."
          ],
          "answer": 2,
          "explanation": "No verb. We borrow olmak. The pair: olup olmadığını."
        }
      ]
    },
    {
      "id": "b2.reported-question.ex2",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "sort_buckets",
      "difficulty": 1,
      "instruction": "Sort by tense",
      "items": [
        {
          "id": "1",
          "buckets": [
            {
              "id": "dik",
              "label": "-DIK: whether he came"
            },
            {
              "id": "acak",
              "label": "-AcAK: whether he’ll come"
            }
          ],
          "entries": [
            {
              "text": "gelip gelmediğini",
              "bucket": "dik"
            },
            {
              "text": "yapıp yapmayacağını",
              "bucket": "acak"
            },
            {
              "text": "arayıp aramadığını",
              "bucket": "dik"
            },
            {
              "text": "okuyup okumayacağını",
              "bucket": "acak"
            },
            {
              "text": "gidip gitmeyeceğini",
              "bucket": "acak"
            },
            {
              "text": "yapıp yapmadığını",
              "bucket": "dik"
            }
          ],
          "explanation": "Look at the second half. -dığı/-diği is past or habitual. -acağı/-eceği is future."
        }
      ]
    },
    {
      "id": "b2.reported-question.ex3",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "matching",
      "difficulty": 2,
      "instruction": "Whose coming? Match them",
      "items": [
        {
          "id": "1",
          "pairs": [
            {
              "left": "gelip gelmeyeceğimi",
              "right": "whether I’ll come"
            },
            {
              "left": "gelip gelmeyeceğimizi",
              "right": "whether we’ll come"
            },
            {
              "left": "gelip gelmeyeceğinizi",
              "right": "whether you all will come"
            },
            {
              "left": "gelip gelmeyeceklerini",
              "right": "whether they’ll come"
            }
          ],
          "explanation": "The person sits in the second half: -im is I, -imiz is we, -iniz is you (pl.), -leri is they."
        }
      ]
    },
    {
      "id": "b2.reported-question.ex4",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "mixed",
      "difficulty": 2,
      "instruction": "Build, find the mistake, complete",
      "items": [
        {
          "id": "1",
          "type": "build_sentence",
          "translation": "He asked whether you’d come tomorrow.",
          "words": [
            "Yarın",
            "gelip",
            "gelmeyeceğini",
            "sordu."
          ],
          "distractors": [
            "gelecek",
            "misin"
          ],
          "explanation": "The pair gelip gelmeyeceğini, with sordu on top. The particle mi doesn’t live in reported speech."
        },
        {
          "id": "2",
          "type": "error_hunt",
          "prompt": "Find the mistake",
          "tokens": [
            "Gitip",
            "gitmeyeceğimi",
            "sordu."
          ],
          "wrong": 0,
          "fix": "Gidip",
          "options": [
            "Gidip",
            "Gitip"
          ],
          "explanation": "Before a vowel, the t in git becomes d: gidip."
        },
        {
          "id": "3",
          "type": "gap_fill",
          "text": "Gelip gelmeyeceği___ emin değilim.",
          "answers": [
            [
              "nden"
            ]
          ],
          "options": [
            [
              "ni",
              "nden",
              "ne"
            ]
          ],
          "translation": "I’m not sure whether he’ll come.",
          "explanation": "emin değilim asks “about what?” So -den, and after the person, a cushion n."
        },
        {
          "id": "4",
          "type": "gap_fill",
          "text": "Arkadaşım yarın ___ gelmeyeceğimi sordu.",
          "answers": [
            [
              "gelip"
            ]
          ],
          "translation": "A friend asked whether I’d come tomorrow.",
          "explanation": "The first half is bare: gel + ip = gelip."
        }
      ]
    },
