{
  "topic": "c1.ki-conj",
  "exercises": [
    {
      "id": "c1.ki-conj.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Which ki is this? Figure out the meaning.",
      "items": [
        {
          "prompt": "Öyle yorgunum ki hemen uyuyacağım.",
          "options": [
            "so…, that…",
            "that (after a verb)",
            "so that",
            "suffix “the one that”"
          ],
          "answer": 0,
          "say": "Öyle yorgunum ki hemen uyuyacağım.",
          "explanation": "In the first part, öyle is a promise. After ki comes the result: “so…, that….”"
        },
        {
          "prompt": "Duydum ki Samsun'dan taşınıyorsun.",
          "options": [
            "so…, that…",
            "that (after a verb)",
            "so that",
            "suffix “the one that”"
          ],
          "answer": 1,
          "say": "Duydum ki Samsun'dan taşınıyorsun.",
          "explanation": "First the verb duydum, then ki and the news. That’s the English “that.”"
        },
        {
          "prompt": "Kapıyı kapat ki soğuk girmesin.",
          "options": [
            "so…, that…",
            "that (after a verb)",
            "so that",
            "suffix “the one that”"
          ],
          "answer": 2,
          "say": "Kapıyı kapat ki soğuk girmesin.",
          "explanation": "Request + ki + wish (girmesin). That’s “so that.”"
        },
        {
          "prompt": "Sahildeki dondurmacı çok iyi.",
          "options": [
            "so…, that…",
            "that (after a verb)",
            "so that",
            "suffix “the one that”"
          ],
          "answer": 3,
          "say": "Sahildeki dondurmacı çok iyi.",
          "explanation": "ki is glued to the word: sahildeki, “the one on the waterfront.” That’s the suffix."
        }
      ]
    },
    {
      "id": "c1.ki-conj.ex2",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "sort_buckets",
      "difficulty": 1,
      "instruction": "Sort them: which is the conjunction ki, which is the suffix -ki.",
      "items": [
        {
          "buckets": [
            {
              "id": "c",
              "label": "conjunction ki: written apart"
            },
            {
              "id": "s",
              "label": "suffix -ki: written together"
            }
          ],
          "entries": [
            {
              "text": "Biliyorum ki haklısın.",
              "bucket": "c"
            },
            {
              "text": "Hava öyle sıcak ki sahil dolu.",
              "bucket": "c"
            },
            {
              "text": "Acele et ki yetişelim.",
              "bucket": "c"
            },
            {
              "text": "Görüyorum ki yorgunsun.",
              "bucket": "c"
            },
            {
              "text": "masadaki dondurma",
              "bucket": "s"
            },
            {
              "text": "Seninki hangisi?",
              "bucket": "s"
            },
            {
              "text": "bugünkü hava",
              "bucket": "s"
            },
            {
              "text": "sahildeki kafe",
              "bucket": "s"
            }
          ],
          "explanation": "The conjunction ki is followed by a whole sentence, and it stands apart. The suffix sticks to the word: masadaki, seninki, bugünkü."
        }
      ]
    },
    {
      "id": "c1.ki-conj.ex3",
