          "options": [
            "beyazbeyaz",
            "çok beyazlı",
            "bembeyaz"
          ],
          "answer": 2,
          "explanation": "Начало слова до гласной — be, плюс m: bem + beyaz."
        },
        {
          "id": "4",
          "type": "multiple_choice",
          "prompt": "«С молоком» — какой вариант?",
          "say": "sütlü",
          "options": [
            "sütlü",
            "sütlu",
            "sütsüz"
          ],
          "answer": 0,
          "explanation": "«С» — это -lı. Последняя гласная ü, значит -lü: sütlü. Sütsüz — «без молока»."
        }
      ]
    },
