              "n"
            ],
            [
              "i",
              "ni",
              "ı"
            ]
          ],
          "word": "beklemesini",
          "answer": "me|si|ni",
          "explanation": "Him: after a vowel, s and n. bekle-me-si-ni."
        },
        {
          "id": "3",
