              "ı",
              "i",
              "nı"
            ]
          ],
          "word": "kapatmamı",
          "answer": "ma|m|ı",
          "explanation": "The stem has a, so ma and ı. Me: m."
        },
        {
          "id": "2",
          "cmd": "Bekle!",
          "to": "ona",
          "stem": "bekle",
          "opts": [
