      "id": "b1.indirect-imperative.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Spot the package",
      "items": [
        {
          "id": "1",
          "prompt": "«Gel!» → Bana ___ söyledi.",
          "say": "Bana gelmemi söyledi.",
          "options": [
            "gelmemi",
            "gelmeni",
            "gelme"
          ],
          "answer": 0,
          "explanation": "Told me, so “my coming”: gel-me-m-i. Without -mi, gelme just means “Don’t come!”"
        },
        {
          "id": "2",
          "prompt": "“Otur!” (to him) → Ona ___ söyledim.",
          "options": [
            "oturmasını",
            "oturmanı",
            "oturmamı"
          ],
          "answer": 0,
          "explanation": "His or her sitting: after a vowel, s, then n. otur-ma-sı-nı."
        },
        {
          "id": "3",
          "prompt": "Bana gelmemi söyledi = ?",
          "options": [
            "He told me to come.",
            "He said that I came.",
            "He told me not to come."
          ],
          "answer": 0,
          "explanation": "A package without “not” is just the order: to come."
        },
        {
          "id": "4",
          "prompt": "How do you say “asked me to wait”?",
          "options": [
            "Benden beklememi istedi.",
            "Bana beklememi istedi.",
            "Benden bekle istedi."
          ],
          "answer": 0,
          "explanation": "In English you ask “me.” In Turkish you ask “from me”: benden. And the order is packed: beklememi."
        }
      ]
    },
    {
