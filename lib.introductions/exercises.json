          "options": [
            "Как тебя зовут?",
            "Сколько тебе лет?",
            "Откуда ты?"
          ],
          "answer": 0,
          "explanation": "ad — имя, -ın — твоё. «Твоё имя что?» — как тебя зовут."
        },
        {
          "id": "2",
          "prompt": "А это что: «Kaç yaşındasın?»",
          "say": "Kaç yaşındasın?",
          "options": [
            "Сколько стоит?",
            "Сколько тебе лет?",
            "Как тебя зовут?"
          ],
          "answer": 1,
          "explanation": "kaç — сколько, yaş — возраст. В банке это про возраст, а не про деньги."
        },
        {
          "id": "3",
          "prompt": "Как спросить имя у преподавателя?",
          "options": [
            "Adın ne?",
            "Adınız ne?",
            "Ben de memnun oldum."
          ],
          "answer": 1,
          "explanation": "Со старшими и незнакомыми — на «вы»: adınız ne?"
        },
        {
          "id": "4",
          "prompt": "Тебе сказали «Memnun oldum!». Что ответить?",
          "say": "Memnun oldum!",
          "options": [
            "Ben de memnun oldum.",
            "Adım ne?",
            "Kaç yaşındasın?"
          ],
          "answer": 0,
          "explanation": "ben de — я тоже. Ben de memnun oldum — мне тоже приятно."
        }
      ]
    },
