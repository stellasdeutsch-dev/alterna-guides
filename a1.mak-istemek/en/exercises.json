{
  "topic": "a1.mak-istemek",
  "exercises": [
    {
      "id": "a1.mak-istemek.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Spot “I want to do”",
      "items": [
        {
          "id": "1",
          "prompt": "I want to drink coffee.",
          "say": "Kahve içmek istiyorum.",
          "options": [
            "Kahve içmek istiyorum.",
            "Kahve içiyorum istiyorum.",
            "İstiyorum kahve içmek."
          ],
          "answer": 0,
          "explanation": "The action is in its passport — içmek. “Want” is at the tail."
        },
        {
          "id": "2",
          "prompt": "Which phrase means “I want to sleep”?",
          "say": "Uyumak istiyorum.",
          "options": [
            "Uyuyorum.",
            "Uyumak istiyorum.",
            "Uyumak istemiyorum."
          ],
          "answer": 1,
          "explanation": "Uyuyorum means “I’m sleeping.” This person is already asleep. We only need to want it."
        },
        {
          "id": "3",
          "prompt": "Kitap okumak istemiyorum means…",
          "say": "Kitap okumak istemiyorum.",
          "options": [
            "I want to read a book.",
            "I don’t want to read a book.",
            "I’m reading a book."
          ],
          "answer": 1,
          "explanation": "istemiyorum means “I don’t want.” The “not” sits inside: iste-mi-yorum."
        },
        {
          "id": "4",
          "prompt": "Çay istiyorum means…",
          "say": "Çay istiyorum.",
          "options": [
            "I want tea.",
            "I want to drink tea.",
            "I’m drinking tea."
          ],
          "answer": 0,
          "explanation": "No verb. Just the object and the seal. So it’s “I want tea.”"
        }
      ]
    },
    {
      "id": "a1.mak-istemek.ex2",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "sort_buckets",
      "difficulty": 1,
      "instruction": "Sort the roots into doors",
      "items": [
        {
          "id": "1",
          "buckets": [
            {
              "id": "mak",
              "label": "-mak"
            },
            {
              "id": "mek",
              "label": "-mek"
            }
          ],
          "entries": [
            {
              "text": "al-",
              "bucket": "mak"
            },
            {
              "text": "iç-",
              "bucket": "mek"
            },
            {
              "text": "oku-",
              "bucket": "mak"
            },
            {
              "text": "gör-",
              "bucket": "mek"
            },
            {
              "text": "yap-",
              "bucket": "mak"
            },
            {
              "text": "dinle-",
              "bucket": "mek"
            },
            {
              "text": "konuş-",
              "bucket": "mak"
            },
            {
              "text": "yüz-",
              "bucket": "mek"
            }
          ],
          "explanation": "Look only at the last vowel of the root. a ı o u — the -mak door. e i ö ü — the -mek door."
        }
      ]
    },
    {
      "id": "a1.mak-istemek.ex3",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "mixed",
      "difficulty": 2,
      "instruction": "Build and fix",
      "items": [
        {
          "id": "1",
          "type": "build_sentence",
          "translation": "I want to learn Turkish.",
          "words": [
            "Türkçe",
            "öğrenmek",
            "istiyorum."
          ],
          "distractors": [
            "öğreniyorum"
          ],
          "explanation": "Action first: Türkçe öğrenmek. Then the seal: istiyorum."
        },
        {
          "id": "2",
          "type": "error_hunt",
          "prompt": "Find the mistake",
          "tokens": [
            "Film",
            "izliyorum",
            "istiyorum."
          ],
          "wrong": 1,
          "fix": "izlemek",
          "options": [
            "izlemek",
            "izlemak",
            "izliyor"
          ],
          "explanation": "Two -yor in a row — two reports. The first verb goes in its passport: izlemek."
        },
        {
          "id": "3",
          "type": "build_sentence",
          "translation": "We want to have breakfast.",
          "words": [
            "Kahvaltı",
            "yapmak",
            "istiyoruz."
          ],
          "distractors": [
            "istiyorum."
          ],
          "explanation": "We — the -uz tail: istiyoruz. -um is “I.”"
        },
        {
          "id": "4",
          "type": "error_hunt",
          "prompt": "Find the mistake",
          "tokens": [
            "Ben",
            "gitmak",
            "istiyorum."
          ],
          "wrong": 1,
          "fix": "gitmek",
          "options": [
            "gitmek",
            "gidiyor"
          ],
          "explanation": "The root git has the vowel i. Front. The -mek door: gitmek."
        }
      ]
    },
    {
      "id": "a1.mak-istemek.ex4",
      "lesson": 1,
      "kind": "practice",
