            "istemiyorum.",
            "istemiyor."
          ],
          "answer": {
            "scroll": 1,
            "seal": 1
          },
          "full": "Beklemek istemiyorum.",
          "explanation": "In the passport the e comes back: beklemek. The “not” is inside: istemiyorum."
        },
        {
          "id": "5",
          "prompt": "They want to swim.",
          "scrolls": [
            "yüzmak",
            "yüzüyorlar",
            "yüzmek"
          ],
          "seals": [
            "istiyorlar.",
            "istiyoruz.",
            "istiyor musun?"
          ],
          "answer": {
            "scroll": 2,
            "seal": 0
          },
          "full": "Yüzmek istiyorlar.",
          "explanation": "yüz — vowel ü, the -mek door. They — -lar."
        }
      ]
    },
