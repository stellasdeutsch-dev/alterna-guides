          "text": "Ben ___ istiyorum. (uyu- — to sleep)",
          "answers": [
            [
              "uyumak"
            ]
          ],
          "translation": "I want to sleep.",
          "explanation": "uyu + mak: the last vowel u is a back vowel. You get uyumak."
        },
        {
          "id": "2",
          "text": "Sen ne yapmak ___? (to want, you)",
          "answers": [
            [
              "istiyorsun"
            ]
          ],
          "translation": "What do you want to do?",
          "explanation": "You — the -sun tail: istiyorsun."
        },
        {
          "id": "3",
          "text": "Ali bugün çalışmak ___. (doesn’t want)",
          "answers": [
            [
              "istemiyor"
            ]
          ],
          "translation": "Ali doesn’t want to work today.",
          "explanation": "The “not” is inside istemek: iste-mi-yor. He/she — no tail."
        },
        {
          "id": "4",
          "text": "Kahve içmek ___ musun? (to want)",
          "answers": [
            [
              "istiyor"
            ]
          ],
          "translation": "Do you want to drink coffee?",
          "explanation": "In a question the seal is istiyor, and the person moves into musun."
        }
      ]
    },
    {
      "id": "a1.mak-istemek.ex5",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "custom",
      "difficulty": 2,
      "instruction": "Scrolls at the pier: pick a scroll (the action) and a seal (want)",
      "description": "People at the Eminönü pier all want something. The learner picks the right verb in its passport and the right form of istemek. Logic is in index.html.",
      "items": [
        {
          "id": "1",
          "prompt": "The tourist wants to buy a ticket.",
          "scrolls": [
            "bilet almak",
            "bilet almek",
            "bilet alıyor"
          ],
          "seals": [
            "istiyor.",
            "istiyorum.",
            "istemiyor."
          ],
          "answer": {
            "scroll": 0,
            "seal": 0
          },
          "full": "Turist bilet almak istiyor.",
          "explanation": "al — vowel a, the -mak door. He/she — istiyor with no tail."
        },
        {
          "id": "2",
          "prompt": "We want to take photos.",
          "scrolls": [
            "fotoğraf çekmak",
            "fotoğraf çekmek",
            "fotoğraf çekiyoruz"
          ],
          "seals": [
            "istiyoruz.",
            "istiyorsunuz.",
            "istiyorlar."
          ],
          "answer": {
            "scroll": 1,
            "seal": 0
          },
          "full": "Fotoğraf çekmek istiyoruz.",
          "explanation": "çek — vowel e, the -mek door. We — -uz."
        },
        {
          "id": "3",
          "prompt": "Do you want to eat a simit?",
          "scrolls": [
            "simit yemek",
            "simit yemak",
            "simit yiyorsun"
          ],
          "seals": [
            "istiyor musun?",
            "istiyorsun mu?",
            "istiyor mu?"
          ],
          "answer": {
            "scroll": 0,
            "seal": 0
          },
          "full": "Simit yemek istiyor musun?",
          "explanation": "ye — vowel e, the -mek door. In a question the person moves into musun."
        },
        {
          "id": "4",
          "prompt": "I don’t want to wait.",
          "scrolls": [
            "bekliyorum",
            "beklemek",
            "beklmek"
          ],
          "seals": [
