        {
          "id": "1",
          "prompt": "Saçımı kestirdim.",
          "say": "Saçımı kestirdim",
          "options": [
            "Шашымды өзім алдым",
            "Шашымды шебер алды"
          ],
          "answer": 1,
          "explanation": "Етістікте -tir бар, демек шебер жұмыс істеді. Өзім — бұл kestim."
        },
        {
          "id": "2",
          "prompt": "Arabamı yıkadım.",
          "say": "Arabamı yıkadım",
          "options": [
            "Машинаны өзім жудым",
            "Машинаны жуғышқа бердім"
          ],
          "answer": 0,
          "explanation": "Етістікте бұйрық жоқ: yıka + dım. Өзің жудың. Жуғышта болса, yıkattım болар еді."
        },
        {
          "id": "3",
          "prompt": "Odamı boyattım.",
          "say": "Odamı boyattım",
          "options": [
            "Бөлмені өзім боядым",
            "Бөлмені менің тапсырысыммен боятты"
          ],
          "answer": 1,
          "explanation": "boya + t + tım. t әрпі — бұйрық: сырлаушы бояды, ақшасын сен төледің."
        },
        {
          "id": "4",
          "prompt": "Mektubu yazdırdım.",
          "say": "Mektubu yazdırdım",
          "options": [
            "Хатты өзім жаздым",
            "Маған хатты басып берді"
          ],
          "answer": 1,
          "explanation": "yaz + dır + dım. Хатты сен қолмен жазған жоқсың, принтер не басқа біреу басып шығарды."
        }
      ]
