{
  "topic": "b1.causative",
  "exercises": [
    {
      "id": "b1.causative.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Who did the work with their hands: you, or someone at your request?",
      "items": [
        {
          "id": "1",
          "prompt": "Saçımı kestirdim.",
          "say": "Saçımı kestirdim",
          "options": [
            "I cut my own hair",
            "The barber cut my hair"
          ],
          "answer": 1,
          "explanation": "The verb has -tir, so the barber did the work. In English “I cut my hair” can mean either. In Turkish it can't: doing it yourself is kestim."
        },
        {
          "id": "2",
          "prompt": "Arabamı yıkadım.",
          "say": "Arabamı yıkadım",
          "options": [
            "I washed the car myself",
            "I took the car to the car wash"
          ],
          "answer": 0,
          "explanation": "No order in the verb: yıka + dım. You washed it yourself. At the car wash it would be yıkattım."
        },
        {
          "id": "3",
          "prompt": "Odamı boyattım.",
          "say": "Odamı boyattım",
          "options": [
            "I painted the room myself",
            "I had the room painted"
          ],
          "answer": 1,
          "explanation": "boya + t + tım. The letter t is the order: the painter painted, you paid."
        },
        {
          "id": "4",
          "prompt": "Mektubu yazdırdım.",
          "say": "Mektubu yazdırdım",
          "options": [
            "I wrote the letter myself",
            "I had the letter printed"
          ],
          "answer": 1,
          "explanation": "yaz + dır + dım. A printer or someone else printed the letter, not you by hand."
        }
      ]
    },
    {
      "id": "b1.causative.ex2",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "sort_buckets",
      "difficulty": 1,
      "instruction": "Sort the verbs: who gets by with -t, and who needs -DIr",
      "items": [
        {
          "id": "1",
          "buckets": [
            {
              "id": "t",
              "label": "-t"
            },
            {
              "id": "dir",
              "label": "-DIr"
            }
          ],
          "entries": [
            {
              "text": "oku",
              "bucket": "t"
            },
            {
              "text": "bekle",
              "bucket": "t"
            },
            {
              "text": "otur",
              "bucket": "t"
            },
            {
              "text": "anla",
              "bucket": "t"
            },
            {
              "text": "yap",
              "bucket": "dir"
            },
            {
              "text": "ye",
              "bucket": "dir"
            },
            {
              "text": "öl",
              "bucket": "dir"
            },
            {
              "text": "kes",
              "bucket": "dir"
            }
          ],
          "explanation": "-t goes on verbs of more than one syllable ending in a vowel, l or r. All the rest, even short ye and öl, take -DIr."
        }
      ]
    },
    {
      "id": "b1.causative.ex3",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "mixed",
      "difficulty": 2,
      "instruction": "Put the order in the verb, find the mistake, build the sentence",
      "items": [
        {
          "id": "1",
          "type": "gap_fill",
          "text": "Dün berberde saçımı kes___.",
          "answers": [
            [
              "tirdim"
            ]
          ],
          "options": [
            [
              "tirdim",
              "tim",
              "dirdim"
            ]
          ],
          "translation": "Yesterday I got a haircut at the barbershop.",
          "say": "Dün berberde saçımı kestirdim",
          "explanation": "The barber did the cutting, so it's an order: kes + tir. After voiceless s, D sounds like t."
        },
        {
          "id": "2",
          "type": "gap_fill",
          "text": "Arabamı yıka___.",
          "answers": [
            [
              "ttım"
            ]
          ],
          "options": [
            [
              "ttım",
              "dım",
              "dırdım"
            ]
          ],
          "translation": "I took the car to the car wash.",
          "say": "Arabamı yıkattım",
          "explanation": "yıka — two syllables ending in a vowel, the order is -t. Then the past -tım: yıka + t + tım."
        },
        {
          "id": "3",
          "type": "error_hunt",
          "prompt": "Find the mistake",
          "tokens": [
            "Dün",
            "odamı",
            "boyadırdım."
          ],
          "wrong": 2,
          "fix": "boyattım.",
          "options": [
            "boyattım.",
            "boyatdım."
          ],
          "explanation": "boya — two syllables ending in a vowel, -t is enough: boyat. The past after t sounds voiceless too: boyattım."
        },
        {
          "id": "4",
          "type": "build_sentence",
          "translation": "Yesterday I took the car to the car wash.",
          "words": [
            "Dün",
            "arabamı",
            "yıkattım."
          ],
          "distractors": [
            "yıkadım."
          ],
          "say": "Dün arabamı yıkattım",
          "explanation": "Others washed it, so yıkattım. Yıkadım means you washed it yourself."
        }
      ]
    },
    {
      "id": "b1.causative.ex4",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "custom",
      "difficulty": 2,
      "instruction": "Bureau stamp: put the right order on the form",
      "description": "The form shows a root and the meaning needed. The learner picks one of three stamps, the stamp drops onto the form. Logic is in index.html.",
      "items": [
        {
          "id": "1",
          "root": "oku",
          "need": "make someone read",
          "options": [
            "okudur",
            "okut",
            "okutır"
          ],
          "answer": "okut",
          "explanation": "Two syllables, ends in a vowel. -t is enough."
        },
        {
          "id": "2",
          "root": "yap",
          "need": "have it done",
          "options": [
            "yapdır",
            "yapt",
            "yaptır"
          ],
          "answer": "yaptır",
          "explanation": "One syllable, so -DIr. English spelling would keep the d, Turkish doesn't: after voiceless p it's t. Harmony gives ı."
        },
        {
          "id": "3",
          "root": "ye",
          "need": "feed",
          "options": [
            "yedir",
            "yet",
            "yetir"
          ],
          "answer": "yedir",
          "explanation": "Ends in a vowel, but only one syllable. So -DIr. English needs a new verb (feed), Turkish just adds dir."
        },
        {
          "id": "4",
          "root": "bekle",
          "need": "keep someone waiting",
          "options": [
            "bekledir",
            "bekletir",
            "beklet"
          ],
          "answer": "beklet",
          "explanation": "Two syllables ending in a vowel. -t is enough."
        },
        {
          "id": "5",
          "root": "öl",
          "need": "kill",
          "options": [
            "öldür",
            "ölt",
            "öldır"
          ],
          "answer": "öldür",
          "explanation": "One syllable ending in -l, so -DIr. The vowel is ö, so ü. English: die → kill. Turkish: öl → öldür, “make die.”"
        },
        {
          "id": "6",
          "root": "temizle",
          "need": "have it cleaned",
          "options": [
            "temizledir",
            "temizlet",
            "temizletir"
          ],
          "answer": "temizlet",
          "explanation": "Three syllables ending in a vowel. -t is enough."
        }
      ]
    },
