          ],
          "answer": 1,
          "explanation": "Others cleaned it, so it's an order: temizle + t + tim."
        },
        {
          "id": "5",
          "type": "true_false",
          "statement": "Kestirdim means “I cut my own hair.”",
          "answer": false,
          "explanation": "Doing it yourself is kestim. Kestirdim: the barber cut, you ordered."
        }
      ]
    },
    {
      "id": "b1.causative.ex5",
      "lesson": 2,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Spot the stubborn one: what's the order form?",
      "items": [
        {
          "id": "1",
          "prompt": "piş (get cooked) → cook",
          "say": "pişir",
          "options": [
            "pişdir",
            "pişir",
            "pişt"
          ],
          "answer": 1,
          "explanation": "piş is a short stubborn one with -Ir: pişir. English uses “cook” both ways. Turkish doesn't: piş (it cooks), pişir (you cook it)."
        },
        {
          "id": "2",
          "prompt": "çık (go out) → take out",
          "say": "çıkar",
          "options": [
            "çıkar",
            "çıkır",
            "çıktır"
          ],
          "answer": 0,
          "explanation": "çık is one of the few with -Ar: çıkar."
        },
        {
          "id": "3",
          "prompt": "gel (come) → bring",
          "say": "getir",
          "options": [
            "geldir",
            "getir",
            "gelt"
          ],
          "answer": 1,
          "explanation": "gel goes its own way: getir. English has two separate verbs too, come and bring. Just memorize getir."
        },
        {
          "id": "4",
          "prompt": "gör (see) → show",
          "say": "göster",
          "options": [
            "gördür",
            "göster",
            "görür"
          ],
          "answer": 1,
          "explanation": "To show is “to make see”: göster. Its own way."
        }
      ]
    },
    {
