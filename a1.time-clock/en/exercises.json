    {
      "id": "a1.time-clock.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "What time is it? Pick the phrase",
      "items": [
        {
          "id": "1",
          "prompt": "3:00",
          "say": "Saat üç.",
          "options": [
            "Saat üç.",
            "Saat üçte.",
            "Saat üç buçuk."
          ],
          "answer": 0,
          "explanation": "On the hour — just the number. But üçte is already “at what time.”"
        },
        {
          "id": "2",
          "prompt": "3:30",
          "say": "Saat üç buçuk.",
          "options": [
            "Saat dört buçuk.",
            "Saat üç buçuk.",
            "Saat dörde otuz var."
          ],
          "answer": 1,
          "explanation": "Half — number + buçuk. The number is the hour that has already come: üç."
        },
        {
          "id": "3",
          "prompt": "4:15",
          "say": "Saat dördü çeyrek geçiyor.",
          "options": [
            "Saat dörde çeyrek var.",
            "Saat dördü çeyrek geçiyor.",
            "Saat dört çeyrek."
          ],
          "answer": 1,
          "explanation": "A quarter has passed four → dördü … geçiyor. Before a vowel, t becomes d."
        },
        {
          "id": "4",
          "prompt": "8:45",
          "say": "Saat dokuza çeyrek var.",
          "options": [
            "Saat sekizi çeyrek geçiyor.",
            "Saat dokuzu çeyrek var.",
            "Saat dokuza çeyrek var."
          ],
          "answer": 2,
          "explanation": "The very case from the pilot: a quarter left until nine → dokuza çeyrek var. The form dokuzu is for geçiyor."
        }
      ]
    },
