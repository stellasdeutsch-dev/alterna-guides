    {
      "id": "b1.zorunda.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "What does the phrase mean?",
      "items": [
        {
          "prompt": "Gelmek zorundayım.",
          "say": "Gelmek zorundayım.",
          "options": [
            "I want to come",
            "I have to come",
            "I ended up having to come"
          ],
          "answer": 1,
          "explanation": "-mAk zorundayım means “I have to.” There’s barely a choice — someone decided for you."
        },
        {
          "prompt": "Beklemeye mecburuz.",
          "say": "Beklemeye mecburuz.",
          "options": [
            "We’re forced to wait",
            "We want to wait",
            "We had to wait"
          ],
          "answer": 0,
          "explanation": "-mAyA mecburuz means “we’re forced to.” Dative beklemeye + mecbur."
        },
        {
          "prompt": "Otobüs gelmedi, yürümek zorunda kaldık.",
          "say": "Otobüs gelmedi, yürümek zorunda kaldık.",
          "options": [
            "The bus didn’t come, we are obliged to walk",
            "The bus didn’t come, we had to walk",
            "The bus didn’t come, we want to walk"
          ],
          "answer": 1,
          "explanation": "zorunda kaldık means “we had to”: circumstances forced us, and we went."
        },
        {
          "prompt": "Bugün ödemek zorunda değilsin.",
          "say": "Bugün ödemek zorunda değilsin.",
          "options": [
            "You’re not allowed to pay today",
            "You don’t have to pay today",
            "You had to pay today"
          ],
          "answer": 1,
          "explanation": "zorunda değilsin means “you don’t have to.” It’s not a ban: you can pay, you just don’t need to."
        }
      ]
    },
