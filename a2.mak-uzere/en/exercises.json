      "difficulty": 1,
      "instruction": "What does it mean?",
      "items": [
        {
          "id": "1",
          "prompt": "Film başlamak üzere.",
          "say": "Film başlamak üzere.",
          "options": [
            "The movie is about to start.",
            "The movie started.",
            "In order to start the movie."
          ],
          "answer": 0,
          "explanation": "üzere at the end, nothing after it. So it's “about to.”"
        },
        {
          "id": "2",
          "prompt": "Doktora gitmek üzere evden çıktı.",
          "say": "Doktora gitmek üzere evden çıktı.",
          "options": [
            "He's about to go to the doctor.",
            "He left the house to go to the doctor.",
            "He went to the doctor and left."
          ],
          "answer": 1,
          "explanation": "An action comes after üzere: evden çıktı. So it's a purpose."
        },
        {
          "id": "3",
          "prompt": "Görüşmek üzere!",
          "say": "Görüşmek üzere!",
          "options": [
            "See you soon!",
            "We met.",
            "In order to meet."
          ],
          "answer": 0,
          "explanation": "A set phrase for saying goodbye. See you soon."
        }
      ]
    },
