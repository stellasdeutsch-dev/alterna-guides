      "instruction": "Clip on the tail",
      "items": [
        {
          "id": "1",
          "prompt": "arkadaş → ?",
          "say": "arkadaşla",
          "options": [
            "arkadaşla",
            "arkadaşle"
          ],
          "answer": 0,
          "explanation": "Last vowel a → -la. It ends in a consonant, so no buffer y."
        },
        {
          "id": "2",
          "prompt": "kedi → ?",
          "say": "kediyle",
          "options": [
            "kedile",
            "kediyle"
          ],
          "answer": 1,
          "explanation": "It ends in the vowel i → buffer y, and i gives -le: kediyle."
        },
        {
          "id": "3",
          "prompt": "metro → ?",
          "say": "metroyla",
          "options": [
            "metroyla",
            "metroyle"
          ],
          "answer": 0,
          "explanation": "Last vowel o → -la, and it ends in a vowel → y: metroyla."
        }
      ]
    },
