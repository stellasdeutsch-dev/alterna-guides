        {
          "id": "2",
          "type": "build_sentence",
          "translation": "I went to Karaköy by ferry.",
          "words": [
            "Karaköy'e",
            "vapurla",
            "gittim."
          ],
          "distractors": [
            "vapurda"
          ],
          "explanation": "By what — so the tail -(y)lA: vapurla."
        },
        {
          "id": "3",
          "type": "gap_fill",
          "text": "Dün akşam ___ konuştum.",
          "answers": [
            [
              "seninle"
            ]
          ],
          "options": [
            [
              "seninle",
              "senle"
            ]
          ],
          "translation": "Last night I talked with you.",
          "explanation": "With pronouns, “your” comes first: sen → senin → seninle."
        }
      ]
    },
