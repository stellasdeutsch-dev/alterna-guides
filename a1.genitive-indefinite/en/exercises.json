{
  "topic": "a1.genitive-indefinite",
  "exercises": [
    {
      "id": "a1.genitive-indefinite.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Ilya is ordering at a kiosk. Pick how to say it so he gets what he wants.",
      "items": [
        {
          "prompt": "Apple juice",
          "options": [
            "elma su",
            "elma suyu",
            "elmanın su"
          ],
          "answer": 1,
          "say": "elma suyu",
          "explanation": "The second word gets the tail: su → suyu. Without the tail it’s just “apple, water”."
        },
        {
          "prompt": "Turkish textbook",
          "options": [
            "Türkçe kitabı",
            "Türkçe kitap",
            "kitap Türkçe"
          ],
          "answer": 0,
          "say": "Türkçe kitabı",
          "explanation": "The main word comes last and gets the tail: kitap → kitabı."
        },
        {
          "prompt": "Bus stop",
          "options": [
            "otobüs durak",
            "otobüsün durak",
            "otobüs durağı"
          ],
          "answer": 2,
          "say": "otobüs durağı",
          "explanation": "durak → durağı: k softens to ğ, tail -ı. The first word doesn’t change."
        },
        {
          "prompt": "Tea glass",
          "options": [
            "çay bardağı",
            "çayı bardak",
            "çay bardak"
          ],
          "answer": 0,
          "say": "çay bardağı",
          "explanation": "Which glass? For tea. çay without a tail, bardak → bardağı."
        }
      ]
    },
    {
      "id": "a1.genitive-indefinite.ex2",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "sort_buckets",
      "difficulty": 1,
      "instruction": "Sort the signs by tail: just a vowel or with s.",
      "items": [
        {
          "buckets": [
            {
              "id": "c",
              "label": "after a consonant: -ı, -i, -u, -ü"
            },
            {
              "id": "v",
              "label": "after a vowel: -sı, -si, -su, -sü"
            }
          ],
          "entries": [
            {
              "text": "Taksim Meydanı",
              "bucket": "c"
            },
            {
              "text": "otobüs bileti",
              "bucket": "c"
            },
            {
              "text": "Türkçe kursu",
              "bucket": "c"
            },
            {
              "text": "otobüs durağı",
              "bucket": "c"
            },
            {
              "text": "Kadıköy İskelesi",
              "bucket": "v"
            },
            {
              "text": "Galata Köprüsü",
              "bucket": "v"
            },
            {
              "text": "bahçe kapısı",
              "bucket": "v"
            },
            {
              "text": "Galata Kulesi",
              "bucket": "v"
            }
          ],
          "explanation": "Look at the end of the second word without the tail. iskele, köprü, kapı, kule end in a vowel, so you need s. meydan, bilet, kurs, durak end in a consonant, no s needed."
        }
      ]
    },
    {
