      "instruction": "Добавляем «мой». Гласная уйдёт или останется?",
      "items": [
        { "id": "1",
          "buckets": [ { "id": "drop", "label": "Уходит" }, { "id": "stay", "label": "Остаётся" } ],
          "entries": [
            { "text": "ağız", "bucket": "drop" }, { "text": "boyun", "bucket": "drop" }, { "text": "şehir", "bucket": "drop" }, { "text": "oğul", "bucket": "drop" },
            { "text": "okul", "bucket": "stay" }, { "text": "kalem", "bucket": "stay" }, { "text": "telefon", "bucket": "stay" }, { "text": "karın", "bucket": "drop" }
          ],
          "explanation": "Уходят: ağzım, boynum, şehrim, oğlum, karnım. Остаются: okulum (не из списка), kalemim и telefonum (широкая гласная)." }
      ]
    },
    {
