      "items": [
        { "id": "1", "type": "gap_fill", "text": "Benim ___ ağrıyor. (burun)", "answers": [["burnum"]], "translation": "У меня болит нос.", "explanation": "burun + um → burnum: вторая u уходит." },
        { "id": "2", "type": "gap_fill", "text": "Senin ___ ne? (isim)", "answers": [["ismin"]], "translation": "Как тебя зовут?", "explanation": "isim + in → ismin." },
        { "id": "3", "type": "build_sentence", "translation": "У Айше болит шея.", "words": ["Ayşe'nin", "boynu", "ağrıyor."], "distractors": ["boyunu"], "explanation": "boyun + u → boynu: узкая u уходит." },
        { "id": "4", "type": "error_hunt", "prompt": "Найди ошибку", "tokens": ["Benim", "şehirim", "çok", "güzel."], "wrong": 1, "fix": "şehrim", "options": ["şehrim", "şehirm"], "explanation": "şehir + im → şehrim. Вторая i уходит." }
      ]
    },
    {
