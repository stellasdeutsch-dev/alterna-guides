        { "id": "2", "prompt": "isim + «мой» → ?", "say": "ismim", "options": ["isimim", "ismim"], "answer": 1, "explanation": "isim теряет вторую i: ismim. Как в «Benim ismim Ali»." },
        { "id": "3", "prompt": "ağız + «его» → ?", "say": "ağzı", "options": ["ağzı", "ağızı"], "answer": 0, "explanation": "Аффикс -ı начинается с гласной. Узкая ı из ağız уходит: ağzı." }
      ]
