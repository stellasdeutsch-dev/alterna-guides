{
  "topic": "a1.vowel-dropping",
  "exercises": [
    {
      "id": "a1.vowel-dropping.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Pick the right form",
      "items": [
        {
          "id": "1",
          "prompt": "burun + “my” → ?",
          "say": "burnum",
          "options": [
            "burnum",
            "burunum"
          ],
          "answer": 0,
          "explanation": "Two syllables, high u, a suffix starting with a vowel. The second u drops: burnum."
        },
        {
          "id": "2",
          "prompt": "isim + “my” → ?",
          "say": "ismim",
          "options": [
            "isimim",
            "ismim"
          ],
          "answer": 1,
          "explanation": "isim loses its second i: ismim. As in “Benim ismim Ali.”"
        },
        {
          "id": "3",
          "prompt": "boyun + “his/her” → ?",
          "say": "boynu",
          "options": [
            "boynı",
            "boynu",
            "boyunu"
          ],
          "answer": 1,
          "explanation": "The u drops, but harmony still follows it: the ending is -u. boynu, “his/her neck.”"
        }
      ]
    },
    {
      "id": "a1.vowel-dropping.ex2",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "sort_buckets",
      "difficulty": 2,
      "instruction": "We add “my.” Does the vowel drop or stay?",
      "items": [
        {
          "id": "1",
          "buckets": [
            {
              "id": "drop",
              "label": "Drops"
            },
            {
              "id": "stay",
              "label": "Stays"
            }
          ],
          "entries": [
            {
              "text": "ağız",
              "bucket": "drop"
            },
            {
              "text": "boyun",
              "bucket": "drop"
            },
            {
              "text": "şehir",
              "bucket": "drop"
            },
            {
              "text": "oğul",
              "bucket": "drop"
            },
            {
              "text": "okul",
              "bucket": "stay"
            },
            {
              "text": "kalem",
              "bucket": "stay"
            },
            {
              "text": "oyun",
              "bucket": "stay"
            },
            {
              "text": "karın",
              "bucket": "drop"
            }
          ],
          "explanation": "Drops: ağzım, boynum, şehrim, oğlum, karnım. Stays: okulum, oyunum (not on the list — like watery, not watry), kalemim (low e)."
        }
      ]
    },
    {
      "id": "a1.vowel-dropping.ex3",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "mixed",
      "difficulty": 2,
      "instruction": "Type, build, find the mistake",
      "items": [
        {
          "id": "1",
          "type": "gap_fill",
          "text": "Benim ___ ağrıyor. (burun)",
          "answers": [
            [
              "burnum"
            ]
          ],
          "translation": "My nose hurts.",
          "explanation": "burun + um → burnum: the second u drops."
        },
        {
          "id": "2",
          "type": "gap_fill",
          "text": "Senin ___ ne? (isim)",
          "answers": [
            [
              "ismin"
            ]
          ],
          "translation": "What’s your name?",
          "explanation": "isim + in → ismin."
        },
        {
          "id": "3",
          "type": "build_sentence",
          "translation": "Ayşe’s neck hurts.",
          "words": [
            "Ayşe'nin",
            "boynu",
            "ağrıyor."
          ],
          "distractors": [
            "boyunu"
          ],
          "explanation": "boyun + u → boynu: the high u drops."
        },
        {
          "id": "4",
          "type": "error_hunt",
          "prompt": "Find the mistake",
          "tokens": [
            "Benim",
            "burun",
            "ağrıyor."
          ],
          "wrong": 1,
          "fix": "burnum",
          "options": [
            "burnum",
            "burunum"
          ],
          "explanation": "In English “my nose” is enough. In Turkish the ending is a must, even after benim: burnum."
        }
      ]
    },
