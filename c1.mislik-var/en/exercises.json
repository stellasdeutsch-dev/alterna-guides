    {
      "id": "c1.mislik-var.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "What does it actually say? Pick the meaning.",
      "items": [
        {
          "prompt": "Kerem'in geç kaldığı yok.",
          "options": [
            "Kerem is never late.",
            "Kerem is late, he's not here.",
            "Kerem will be late today."
          ],
          "answer": 0,
          "say": "Kerem'in geç kaldığı yok.",
          "explanation": "-dığı yok — “that never happens”. Yok negates the being late, not Kerem."
        },
        {
          "prompt": "Paris'e gitmişliğim var.",
          "options": [
            "I often go to Paris.",
            "I've been to Paris before.",
            "I'm going to Paris right now."
          ],
          "answer": 1,
          "say": "Paris'e gitmişliğim var.",
          "explanation": "-mışlık + var — experience: it happened at least once."
        },
        {
          "prompt": "Selin Hanım'ın bağırdığı yok.",
          "options": [
            "Selin Hanım shouted once.",
            "Selin Hanım is shouting right now.",
            "Selin Hanım never shouts."
          ],
          "answer": 2,
          "say": "Selin Hanım'ın bağırdığı yok.",
          "explanation": "-dığı yok — character: that never happens."
        },
        {
          "prompt": "Hiç Karadeniz'de yüzmüşlüğüm yok.",
          "options": [
            "I've never once swum in the Black Sea.",
            "I don't like swimming in the Black Sea.",
            "I'm not swimming in the Black Sea today."
          ],
          "answer": 0,
          "say": "Hiç Karadeniz'de yüzmüşlüğüm yok.",
          "explanation": "Hiç … -mışlık yok — no experience, not even once."
        },
        {
          "prompt": "Selin Hanım'ın arada bir sustuğu var.",
          "options": [
            "Selin Hanım is always silent.",
            "Selin Hanım does go quiet sometimes.",
            "Selin Hanım went quiet once."
          ],
          "answer": 1,
          "say": "Selin Hanım'ın arada bir sustuğu var.",
          "explanation": "-dığı var — “it happens”: it repeats now and then."
        }
      ]
    },
    {
      "id": "c1.mislik-var.ex2",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "sort_buckets",
      "difficulty": 1,
      "instruction": "Sort the sentences onto the tapes: experience or habit?",
      "items": [
        {
          "buckets": [
            {
              "id": "m",
              "label": "Experience: happened at least once (-mışlık)"
            },
            {
              "id": "d",
              "label": "Habit: happens / never happens (-dığı)"
            }
          ],
          "entries": [
            {
              "text": "Bandırma Vapuru'nu görmüşlüğüm var.",
              "bucket": "m"
            },
            {
              "text": "Kerem'in yalan söylediği yok.",
              "bucket": "d"
            },
            {
              "text": "Bir kez dış çekim yapmışlığım var.",
              "bucket": "m"
            },
            {
              "text": "Bu otobüsün zamanında geldiği yok.",
              "bucket": "d"
            },
            {
              "text": "Hiç podyumda yürümüşlüğüm yok.",
              "bucket": "m"
            },
            {
              "text": "Kerem'in erken geldiği var.",
              "bucket": "d"
            }
          ],
          "explanation": "-mışlık (mış + lık) — experience, a dot on the tape. -dığı (dık) — character, a pattern along the whole tape."
        }
      ]
    },
