      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Pick what a Turk would say",
      "items": [
        {
          "id": "1",
          "prompt": "these two small cats",
          "say": "bu iki küçük kedi",
          "options": [
            "bu iki küçük kedi",
            "iki bu küçük kedi",
            "küçük bu iki kedi"
          ],
          "answer": 0,
          "explanation": "Hangi → kaç → nasıl. The finger bu goes first, then the number iki, then küçük."
        },
        {
          "id": "2",
          "prompt": "a small white cat — just some small white cat",
          "say": "küçük beyaz bir kedi",
          "options": [
            "bir küçük beyaz kedi",
            "küçük beyaz bir kedi",
            "küçük bir beyaz kedi"
          ],
          "answer": 1,
          "explanation": "bir jumps right next to the noun. Up front it's counting: “one.”"
        },
        {
          "id": "3",
          "prompt": "that big red car",
          "say": "o büyük kırmızı araba",
          "options": [
            "o kırmızı büyük araba",
            "büyük o kırmızı araba",
            "o büyük kırmızı araba"
          ],
          "answer": 2,
          "explanation": "Size comes before color. Color is more permanent, so it's closer to the car."
        }
      ]
    },
    {
