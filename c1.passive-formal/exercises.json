        {
          "id": "1",
          "prompt": "Какая фраза из официального объявления?",
          "options": ["Binada tadilat yapıyorlar.", "Binada tadilat yapılmaktadır.", "Binada tadilat yapıldı."],
          "answer": 1,
          "explanation": "Пассив + -makta + -dır. Исполнителя нет, есть печать. Это язык объявлений."
        },
        {
          "id": "2",
          "prompt": "kullanılmaktadır — это…",
          "options": ["используют (они)", "используется", "использовал"],
          "answer": 1,
          "explanation": "-ıl- убирает исполнителя: не «используют», а «используется»."
        },
        {
          "id": "3",
          "prompt": "Что делает -ıl- в yapılmaktadır?",
          "options": ["убирает исполнителя: пассив", "делает отрицание", "ставит прошедшее время"],
          "answer": 0,
          "explanation": "-ıl- это пассив. Исполнитель исчез. Неважно кто, важно что."
        }
      ]
    },
