          "answer": "kullanılmaktadır",
          "result": "Bu yöntem kullanılmaktadır.",
          "explanation": "kullan + ıl + makta + dır. Данный метод применяется."
        },
        {
          "id": "4",
          "casual": "Belgeleri kontrol ediyorlar.",
          "task": "Документы проверяют. Нужно для объявления.",
          "prefix": "Belgeler kontrol ",
          "stem": "",
          "steps": [
            { "label": "основа", "role": "основа", "options": ["et", "ed"], "answer": "ed", "why": "Перед гласной t превращается в d: et → ed." },
            { "label": "залог", "role": "залог", "options": ["il", "n", "in"], "answer": "il", "why": "Согласная → -Il. Гласная e → -il." },
            { "label": "процесс", "role": "процесс", "options": ["makta", "mekte"], "answer": "mekte", "why": "Последняя гласная i → -mekte." },
            { "label": "печать", "role": "печать", "options": ["dır", "dir"], "answer": "dir", "why": "После -mekte → -dir." }
