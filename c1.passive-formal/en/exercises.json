{
  "topic": "c1.passive-formal",
  "exercises": [
    {
      "id": "c1.passive-formal.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Spot the official style",
      "items": [
        {
          "id": "1",
          "prompt": "Which sentence is from an official notice?",
          "options": [
            "Binada tadilat yapıyorlar.",
            "Binada tadilat yapılmaktadır.",
            "Binada tadilat yapıldı."
          ],
          "answer": 1,
          "explanation": "Passive + -makta + -dır. No doer, just a stamp. That’s the language of notices."
        },
        {
          "id": "2",
          "prompt": "kullanılmaktadır is…",
          "options": [
            "(they) use",
            "is used",
            "used"
          ],
          "answer": 1,
          "explanation": "-ıl- removes the doer: not “they use” but “is used.”"
        },
        {
          "id": "3",
          "prompt": "What does -ıl- do in yapılmaktadır?",
          "options": [
            "removes the doer: passive",
            "makes it negative",
            "puts it in the past"
          ],
          "answer": 0,
          "explanation": "-ıl- is the passive. The doer is gone. Who doesn’t matter, what does."
        }
      ]
    },
    {
      "id": "c1.passive-formal.ex2",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "sort_buckets",
      "difficulty": 1,
      "instruction": "-maktadır or -mektedir?",
      "items": [
        {
          "id": "1",
          "buckets": [
            {
              "id": "makta",
              "label": "-maktadır"
            },
            {
              "id": "mekte",
              "label": "-mektedir"
            }
          ],
          "entries": [
            {
              "text": "yapıl-",
              "bucket": "makta"
            },
            {
              "text": "beklen-",
              "bucket": "mekte"
            },
            {
              "text": "görül-",
              "bucket": "mekte"
            },
            {
              "text": "kullanıl-",
              "bucket": "makta"
            },
            {
              "text": "incelen-",
              "bucket": "mekte"
            },
            {
              "text": "alın-",
              "bucket": "makta"
            }
          ],
          "explanation": "Look at the last vowel: ı → -maktadır; e, ü → -mektedir."
        }
      ]
    },
    {
      "id": "c1.passive-formal.ex3",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "custom",
      "difficulty": 2,
      "instruction": "Press office: translate into officialese",
      "description": "You get a casual sentence. Step by step, the learner dresses the verb in layers: voice, process, stamp (plus the stem for et). The result is an official sentence with a stamp. Logic lives in index.html.",
      "items": [
        {
          "id": "1",
          "casual": "Köprüyü yapıyorlar.",
          "task": "They’re building a bridge. Needed for a press release.",
          "prefix": "Köprü ",
          "stem": "yap",
          "steps": [
            {
              "label": "voice",
              "role": "voice",
              "options": [
                "ıl",
                "n",
                "ın"
              ],
              "answer": "ıl",
              "why": "Ends in p, a consonant → -Il. Vowel a → -ıl."
            },
            {
              "label": "process",
              "role": "process",
              "options": [
                "makta",
                "mekte"
              ],
              "answer": "makta",
              "why": "Last vowel ı → -makta."
            },
            {
              "label": "stamp",
              "role": "stamp",
              "options": [
                "dır",
                "dir"
              ],
              "answer": "dır",
              "why": "After -makta → -dır."
            }
          ],
          "answer": "yapılmaktadır",
          "result": "Köprü yapılmaktadır.",
          "explanation": "yap + ıl + makta + dır. Construction of the bridge is underway."
        },
        {
          "id": "2",
          "casual": "Raporu inceliyorlar.",
          "task": "They’re reviewing the report. Needed for an official letter.",
          "prefix": "Rapor ",
          "stem": "incele",
          "steps": [
            {
              "label": "voice",
              "role": "voice",
              "options": [
                "il",
                "n",
                "in"
              ],
              "answer": "n",
              "why": "Ends in a vowel → just -n."
            },
            {
              "label": "process",
              "role": "process",
              "options": [
                "makta",
                "mekte"
              ],
              "answer": "mekte",
              "why": "Last vowel e → -mekte."
            },
            {
              "label": "stamp",
              "role": "stamp",
              "options": [
                "dır",
                "dir"
              ],
              "answer": "dir",
              "why": "After -mekte → -dir."
            }
          ],
          "answer": "incelenmektedir",
          "result": "Rapor incelenmektedir.",
          "explanation": "incele + n + mekte + dir. The report is under review."
        },
        {
          "id": "3",
          "casual": "Bu yöntemi kullanıyorlar.",
          "task": "They use this method. Needed for a research paper.",
          "prefix": "Bu yöntem ",
          "stem": "kullan",
          "steps": [
            {
              "label": "voice",
              "role": "voice",
              "options": [
                "ıl",
                "n",
                "ul"
              ],
              "answer": "ıl",
              "why": "Ends in n, a consonant → -Il. Vowel a → -ıl."
            },
            {
              "label": "process",
              "role": "process",
              "options": [
                "makta",
                "mekte"
              ],
              "answer": "makta",
              "why": "Last vowel ı → -makta."
            },
            {
              "label": "stamp",
              "role": "stamp",
              "options": [
                "dır",
                "dir"
              ],
              "answer": "dır",
              "why": "After -makta → -dır."
            }
          ],
          "answer": "kullanılmaktadır",
          "result": "Bu yöntem kullanılmaktadır.",
          "explanation": "kullan + ıl + makta + dır. This method is employed."
        },
        {
          "id": "4",
          "casual": "Belgeleri kontrol ediyorlar.",
          "task": "They’re checking the documents. Needed for a notice.",
          "prefix": "Belgeler kontrol ",
          "stem": "",
          "steps": [
            {
              "label": "stem",
              "role": "stem",
              "options": [
                "et",
                "ed"
              ],
              "answer": "ed",
              "why": "Before a vowel, t becomes d: et → ed."
            },
            {
              "label": "voice",
              "role": "voice",
              "options": [
                "il",
                "n",
                "in"
              ],
              "answer": "il",
              "why": "Consonant → -Il. Vowel e → -il."
            },
            {
              "label": "process",
              "role": "process",
              "options": [
                "makta",
                "mekte"
              ],
              "answer": "mekte",
              "why": "Last vowel i → -mekte."
            },
            {
              "label": "stamp",
              "role": "stamp",
              "options": [
                "dır",
                "dir"
              ],
              "answer": "dir",
              "why": "After -mekte → -dir."
            }
          ],
          "answer": "edilmektedir",
          "result": "Belgeler kontrol edilmektedir.",
          "explanation": "et → ed, then -il, -mekte, -dir. Not etilmektedir."
        },
        {
          "id": "5",
          "casual": "Sonuçları biliyorlar.",
          "task": "They know the results. Needed for a report.",
          "prefix": "Sonuçlar ",
          "stem": "bil",
          "steps": [
            {
              "label": "voice",
              "role": "voice",
              "options": [
                "il",
                "in",
                "n"
              ],
              "answer": "in",
              "why": "Ends in l → -In. Vowel i → -in."
            },
            {
              "label": "process",
              "role": "process",
              "options": [
                "makta",
                "mekte"
              ],
              "answer": "mekte",
              "why": "Last vowel i → -mekte."
            },
            {
              "label": "stamp",
              "role": "stamp",
              "options": [
                "dır",
                "dir"
              ],
              "answer": "dir",
              "why": "After -mekte → -dir."
            }
          ],
          "answer": "bilinmektedir",
          "result": "Sonuçlar bilinmektedir.",
          "explanation": "bil + in + mekte + dir. The results are known."
        }
      ]
    },
