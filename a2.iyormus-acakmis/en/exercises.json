      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Spot the rumor",
      "items": [
        {
          "id": "1",
          "prompt": "Where’s the “they say”?",
          "options": [
            "Otobüs geliyor.",
            "Otobüs geliyormuş."
          ],
          "answer": 1,
          "say": "Otobüs geliyormuş.",
          "explanation": "The -muş stamp at the end: you don’t see the bus, someone told you."
        },
        {
          "id": "2",
          "prompt": "“They say Murat lives in Izmir”",
          "options": [
            "Murat İzmir'de yaşıyor.",
            "Murat İzmir'de yaşıyormuş.",
            "Murat İzmir'de yaşayacak."
          ],
          "answer": 1,
          "say": "Murat İzmir'de yaşıyormuş.",
          "explanation": "Lives now — -iyor. “They say” — the -muş stamp."
        },
        {
          "id": "3",
          "prompt": "gelecekmiş means…",
          "options": [
            "they say he’ll come",
            "they say he’s coming right now",
            "he’ll come, I know for sure"
          ],
          "answer": 0,
          "say": "gelecekmiş",
          "explanation": "-ecek — later, -miş — I was told. Together: they say he’ll come."
        },
        {
          "id": "4",
          "prompt": "Mehmet Bey artık sigara içmiyormuş.",
          "options": [
            "They say Mehmet Bey doesn’t smoke anymore.",
            "Mehmet Bey won’t smoke anymore.",
            "Mehmet Bey smokes."
          ],
          "answer": 0,
          "say": "Mehmet Bey artık sigara içmiyormuş.",
          "explanation": "içmiyor — doesn’t smoke now. The -muş stamp is a rumor, not something you saw."
        }
      ]
    },
