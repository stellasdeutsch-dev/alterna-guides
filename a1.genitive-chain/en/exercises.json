      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Which chain is built correctly?",
      "items": [
        {
          "id": "1",
          "prompt": "Zeynep’s teacher’s bag",
          "say": "Zeynep'in öğretmeninin çantası",
          "options": [
            "Zeynep'in öğretmeninin çantası",
            "Zeynep'in öğretmeni çantası",
            "Zeynep'in öğretmenin çanta"
          ],
          "answer": 0,
          "explanation": "The teacher is in the middle: öğretmen + i + nin. The bag is at the end: çanta + sı."
        },
        {
          "id": "2",
          "prompt": "Murat’s car key",
          "say": "Murat'ın arabasının anahtarı",
          "options": [
            "Murat'ın arabanın anahtarı",
            "Murat'ın arabasının anahtarı",
            "Murat arabası anahtarı"
          ],
          "answer": 1,
          "explanation": "The car belongs to Murat and owns the key. It needs both tails: arabasının."
        },
        {
          "id": "3",
          "prompt": "Elif’s friend’s name",
          "say": "Elif'in arkadaşının adı",
          "options": [
            "Elif'in arkadaşının adı",
            "Elif'in arkadaşı adının",
            "adı arkadaşının Elif'in"
          ],
          "answer": 0,
          "explanation": "Order goes from owner to thing. The middle is thick, the end has just one -ı."
        },
        {
          "id": "4",
          "prompt": "Deniz’s neighbor’s cat",
          "say": "Deniz'in komşusunun kedisi",
          "options": [
            "Deniz'in komşunun kedisi",
            "Deniz'in komşusunun kedisi",
            "Deniz'in komşusu kedisinin"
          ],
          "answer": 1,
          "explanation": "komşu is in the middle: komşu + su + nun. Without -su the neighbor comes loose from Deniz."
        }
      ]
    },
    {
      "id": "a1.genitive-chain.ex2",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "sort_buckets",
      "difficulty": 1,
      "instruction": "Put the words in their places in the chain",
      "items": [
        {
          "id": "1",
          "buckets": [
            {
              "id": "start",
              "label": "first: only -nin"
            },
            {
              "id": "mid",
              "label": "middle: -sı + -nin"
            },
            {
              "id": "end",
              "label": "last: only -sı"
            }
          ],
          "entries": [
            {
              "text": "Can'ın",
              "bucket": "start"
            },
            {
              "text": "babasının",
              "bucket": "mid"
            },
            {
              "text": "eczanesi",
              "bucket": "end"
            },
            {
              "text": "Oya'nın",
              "bucket": "start"
            },
            {
              "text": "kızının",
              "bucket": "mid"
            },
            {
              "text": "okulu",
              "bucket": "end"
            },
            {
              "text": "müdürünün",
              "bucket": "mid"
            },
            {
              "text": "ofisi",
              "bucket": "end"
            }
          ],
          "explanation": "One -nin tail — the start. Two tails in a row — the middle. One -sı — the end."
        }
      ]
    },
