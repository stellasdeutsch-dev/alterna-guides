      "skill": "grammar",
      "type": "sort_buckets",
      "difficulty": 2,
      "instruction": "What does the suffix do: make a thing cute or make a quality stronger?",
      "items": [
        {
          "buckets": [
            {
              "id": "l",
              "label": "cute: a thing, an animal"
            },
            {
              "id": "u",
              "label": "stronger: a quality"
            }
          ],
          "entries": [
            {
              "text": "kedicik",
              "bucket": "l"
            },
            {
              "text": "kuzucuk",
              "bucket": "l"
            },
            {
              "text": "köpekçik",
              "bucket": "l"
            },
            {
              "text": "küçücük",
              "bucket": "u"
            },
            {
              "text": "sıcacık",
              "bucket": "u"
            },
            {
              "text": "yumuşacık",
              "bucket": "u"
            }
          ],
          "explanation": "With a noun, -CIk makes it cute (kitty); with an adjective, it intensifies (teeny-tiny, nice and hot)."
        }
      ]
    },
