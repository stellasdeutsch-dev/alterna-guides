            "kısacık",
            "kısacik",
            "kısaçık"
          ],
          "answer": 0,
          "say": "kısacık",
          "explanation": "Last vowel a → -cık. After a vowel, c doesn’t devoice."
        },
        {
          "prompt": "küçük → “teeny-tiny”",
          "options": [
            "küçükcük",
            "küçücük",
            "küçükçük"
          ],
          "answer": 1,
          "say": "küçücük",
          "explanation": "An adjective ending in k: the k goes, leaving küçü + cük."
        },
        {
          "prompt": "kitap → “booklet”",
          "options": [
            "kitapcık",
            "kitapçık",
            "kitacık"
          ],
          "answer": 1,
          "say": "kitapçık",
          "explanation": "p is voiceless (fıstıkçı Şahap), so c → ç: kitapçık."
        }
      ]
    },
