      "id": "b2.ana-kadar.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Spot the form",
      "items": [
        {
          "id": "1",
          "prompt": "“I'll wait until you come” is…",
          "say": "Sen gelene kadar bekliyorum.",
          "options": [
            "Sen gelmeyene kadar bekliyorum.",
            "Sen gelene kadar bekliyorum.",
            "Senin gelene kadar bekliyorum."
          ],
          "answer": 1,
          "explanation": "There's no “not” in the Turkish: gelene kadar. And the subject is plain — sen, no -in."
        },
        {
          "id": "2",
          "prompt": "bit- → “until it ends”",
          "say": "bitene kadar",
          "options": [
            "bitene kadar",
            "bitane kadar",
            "bitmeyene kadar"
          ],
          "answer": 0,
          "explanation": "The last vowel is i — so -ene. And no -me- at all."
        },
        {
          "id": "3",
          "prompt": "oku- + -(y)IncAyA kadar → ?",
          "say": "okuyuncaya kadar",
          "options": [
            "okuyuncaya kadar",
            "okuncaya kadar",
            "okuyunceye kadar"
          ],
          "answer": 0,
          "explanation": "oku ends in a vowel — you need y. Vowel u → -unca, then -ya."
        },
        {
          "id": "4",
          "prompt": "Which form of git- is correct?",
          "say": "gidene kadar",
          "options": [
            "gitene kadar",
            "gidene kadar",
            "gidane kadar"
          ],
          "answer": 1,
          "explanation": "Before a vowel, the t in git turns voiced: gid-ene. Vowel i — so -ene."
        }
      ]
    },
