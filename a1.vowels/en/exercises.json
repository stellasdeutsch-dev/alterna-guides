    {
      "id": "a1.vowels.ex3",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "custom",
      "difficulty": 2,
      "instruction": "Mini golf: sink the ball",
      "description": "A word sits at the tee. The learner finds the last vowel and picks one of four holes: back or front, wide or narrow. The ball arcs into the chosen hole. The answer is the hole id: k-g, i-g, k-d, i-d. Logic lives in index.html.",
      "items": [
        {
          "id": "1",
          "word": "çay",
          "ru": "tea",
          "vowel": "a",
          "answer": "k-g",
          "explanation": "Last vowel a. No dots, so back. Jaw drops, so wide."
        },
        {
          "id": "2",
          "word": "köprü",
          "ru": "bridge",
          "vowel": "ü",
          "answer": "i-d",
          "explanation": "Look at the last vowel. It’s ü, not ö. Dots, jaw stays put: front and narrow."
        },
        {
          "id": "3",
          "word": "okul",
          "ru": "school",
          "vowel": "u",
          "answer": "k-d",
          "explanation": "Last vowel u. No dots, jaw stays put: back and narrow."
        },
        {
          "id": "4",
          "word": "kale",
          "ru": "castle",
          "vowel": "e",
          "answer": "i-g",
          "explanation": "Last vowel e. Not silent, it’s read: “kah-leh.” No dots, but e is front. And wide: mouth open."
        },
        {
          "id": "5",
          "word": "kapı",
          "ru": "door",
          "vowel": "ı",
          "answer": "k-d",
          "explanation": "Last vowel ı, no dot. Back and narrow."
        },
        {
          "id": "6",
          "word": "göl",
          "ru": "lake",
          "vowel": "ö",
          "answer": "i-g",
          "explanation": "ö: dots, so front. Mouth open, so wide."
        },
        {
          "id": "7",
          "word": "deniz",
          "ru": "sea",
          "vowel": "i",
          "answer": "i-d",
          "explanation": "Last vowel i, with a dot. Front and narrow."
        },
        {
          "id": "8",
          "word": "yol",
          "ru": "road",
          "vowel": "o",
          "answer": "k-g",
          "explanation": "o, no dots, jaw drops. Back and wide."
        }
      ]
    },
