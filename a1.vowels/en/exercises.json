      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "What kind of vowel is this?",
      "items": [
        {
          "id": "1",
          "prompt": "ö — back or front?",
          "say": "ö",
          "options": [
            "back",
            "front"
          ],
          "answer": 1,
          "explanation": "It has dots, so it’s front. ö is the front twin of o."
        },
        {
          "id": "2",
          "prompt": "a — back or front?",
          "say": "a",
          "options": [
            "back",
            "front"
          ],
          "answer": 0,
          "explanation": "No dots, so it’s back. The tongue sits deep."
        },
        {
          "id": "3",
          "prompt": "e — back or front?",
          "say": "e",
          "options": [
            "back",
            "front"
          ],
          "answer": 1,
          "explanation": "e is the one exception. No dots, but it’s front. Just memorize its face."
        },
        {
          "id": "4",
          "prompt": "Turkish i always sounds like…",
          "options": [
            "ee in see",
            "i in bike",
            "i in sit"
          ],
          "answer": 0,
          "explanation": "One letter, one sound. Turkish i is always a short “ee”: simit, deniz. Never the i of bike."
        },
        {
          "id": "5",
          "prompt": "ı — narrow or wide?",
          "say": "ı",
          "options": [
            "narrow",
            "wide"
          ],
          "answer": 0,
          "explanation": "Finger on your chin. On ı the jaw stays put. So it’s narrow."
        }
      ]
    },
