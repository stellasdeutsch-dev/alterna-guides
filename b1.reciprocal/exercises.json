      "items": [
        { "id": "1", "text": "Dün eski bir arkadaşla gör___tük.", "answers": [["üş"]], "options": [["üş", "uş", "iş"]], "translation": "Вчера мы встретились со старым другом.", "explanation": "В корне ö — вставка üş." },
        { "id": "2", "text": "Ceren ile Eren dün tanı___tı.", "answers": [["ş"]], "options": [["ş", "ış", "iş"]], "translation": "Джерен и Эрен вчера познакомились.", "explanation": "tanı кончается на гласную — хватает одной ş." },
        { "id": "3", "text": "Çocuklar plajda koş___uyor.", "answers": [["uş"]], "options": [["uş", "üş", "ış"]], "translation": "Дети гурьбой бегают по пляжу.", "explanation": "В корне o — вставка uş." },
        { "id": "4", "text": "Komşular her zaman yardım___ır.", "answers": [["laş"]], "options": [["laş", "leş", "ış"]], "translation": "Соседи всегда помогают друг другу.", "explanation": "yardım — слово, последняя a: -laş." },
        { "id": "5", "text": "Akşam haber___tik.", "answers": [["leş"]], "options": [["leş", "laş", "iş"]], "translation": "Вечером мы созвонились и обменялись новостями.", "explanation": "haber — слово, последняя e: -leş." }
      ]
    },
    {
