      "instruction": "Узнай взаимный глагол",
      "items": [
        { "id": "1", "prompt": "Где оба смотрят друг на друга?", "options": ["Ali Ayşe'ye baktı.", "Ali ile Ayşe bakıştı."], "answer": 1, "say": "Ali ile Ayşe bakıştı.", "explanation": "Вставка -ış: действие идёт в обе стороны." },
        { "id": "2", "prompt": "«Мы обнялись в аэропорту»", "options": ["Havaalanında kucakladık.", "Havaalanında kucaklaştık.", "Havaalanında kucaklaşdık."], "answer": 1, "say": "Havaalanında kucaklaştık.", "explanation": "kucakla + ş + tı + k. После ş — глухое t." },
        { "id": "3", "prompt": "Çocuklar bahçede koşuşuyor — это…", "options": ["Дети гурьбой бегают в саду.", "Ребёнок бежит в сад.", "Дети бегут друг от друга."], "answer": 0, "say": "Çocuklar bahçede koşuşuyor.", "explanation": "Второй смысл вставки — все вместе, толпой." },
        { "id": "4", "prompt": "«Увидимся!»", "options": ["Görürüz!", "Görüşürüz!"], "answer": 1, "say": "Görüşürüz!", "explanation": "Görürüz — «посмотрим». Увидимся — görüşürüz." }
      ]
    },
    {
