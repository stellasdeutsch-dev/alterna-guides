      "items": [
        { "id": "1", "q": "Ali Ayşe'ye baktı, Ayşe de Ali'ye.", "frame": "Ali ile Ayşe …", "options": ["bakıştı", "baktı", "bakışdı"], "answer": 0, "explanation": "bak + ış + tı. После ş — t." },
        { "id": "2", "q": "Ben ona yazdım, o da bana.", "frame": "Biz …", "options": ["yazdık", "yazıştık", "yazışdık"], "answer": 1, "explanation": "yaz + ış + tı + k: переписались." },
        { "id": "3", "q": "Ben ona yardım ettim, o da bana.", "frame": "Biz …", "options": ["yardımıştık", "yardım ettik", "yardımlaştık"], "answer": 2, "explanation": "yardım — слово: -laş." },
        { "id": "4", "q": "Bir araba diğerine çarptı, o da ona.", "frame": "İki araba …", "options": ["çarpıştı", "çarptı", "çarpışdı"], "answer": 0, "explanation": "Обе машины: çarp + ış + tı." },
        { "id": "5", "q": "Ben ona selam verdim, o da bana.", "frame": "Biz …", "options": ["selamıştık", "selamlaştık", "selamleştik"], "answer": 1, "explanation": "selam: последняя a → -laş." }
      ]
