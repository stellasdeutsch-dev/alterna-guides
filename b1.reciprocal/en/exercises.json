    {
      "id": "b1.reciprocal.ex4",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "mixed",
      "difficulty": 3,
      "instruction": "Build, fix, say it yourself",
      "items": [
        {
          "id": "1",
          "type": "build_sentence",
          "translation": "Let's meet at the café tomorrow.",
          "words": [
            "Yarın",
            "kafede",
            "buluşalım."
          ],
          "distractors": [
            "bulalım."
          ],
          "explanation": "bul + uş + alım: to meet up is to find each other."
        },
        {
          "id": "2",
          "type": "error_hunt",
          "prompt": "Find the mistake",
          "tokens": [
            "Ali",
            "Ayşe'yi",
            "tanıştı."
          ],
          "wrong": 1,
          "fix": "Ayşe'yle",
          "options": [
            "Ayşe'yle",
            "Ayşe'ye"
          ],
          "explanation": "English says “met Ayşe.” Turkish says “met with Ayşe”: Ayşe'yle."
        },
        {
          "id": "3",
          "type": "error_hunt",
          "prompt": "Find the mistake",
          "tokens": [
            "Biz",
            "dün",
            "birlikte",
            "okuştuk."
          ],
          "wrong": 3,
          "fix": "okuduk.",
          "options": [
            "okuduk.",
            "okuşuk."
          ],
          "explanation": "okumak doesn't take the insert. birlikte + a regular verb."
        },
        {
          "id": "4",
