{
  "topic": "b1.reciprocal",
  "exercises": [
    {
      "id": "b1.reciprocal.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Spot the reciprocal verb",
      "items": [
        {
          "id": "1",
          "prompt": "In which sentence do they look at each other?",
          "options": [
            "Ali Ayşe'ye baktı.",
            "Ali ile Ayşe bakıştı."
          ],
          "answer": 1,
          "say": "Ali ile Ayşe bakıştı.",
          "explanation": "The -ış insert: the action goes both ways."
        },
        {
          "id": "2",
          "prompt": "“We hugged at the airport”",
          "options": [
            "Havaalanında kucakladık.",
            "Havaalanında kucaklaştık.",
            "Havaalanında kucaklaşdık."
          ],
          "answer": 1,
          "say": "Havaalanında kucaklaştık.",
          "explanation": "kucakla + ş + tı + k. After ş — voiceless t."
        },
        {
          "id": "3",
          "prompt": "Çocuklar bahçede koşuşuyor means…",
          "options": [
            "The kids are running around the garden in a bunch.",
            "A child is running to the garden.",
            "The kids are running away from each other."
          ],
          "answer": 0,
          "say": "Çocuklar bahçede koşuşuyor.",
          "explanation": "The insert's second meaning — all together, as a crowd."
        },
        {
          "id": "4",
          "prompt": "“See you!”",
          "options": [
            "Görürüz!",
            "Görüşürüz!"
          ],
          "answer": 1,
          "say": "Görüşürüz!",
          "explanation": "Görürüz — “we'll see.” See you — görüşürüz."
        }
      ]
    },
    {
      "id": "b1.reciprocal.ex2",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "sort_buckets",
      "difficulty": 1,
      "instruction": "Sort into lanes",
      "items": [
        {
          "id": "1",
          "buckets": [
            {
              "id": "each",
              "label": "each other"
            },
            {
              "id": "all",
              "label": "all together"
            },
            {
              "id": "one",
              "label": "one way"
            }
          ],
          "entries": [
            {
              "text": "görüştük",
              "bucket": "each"
            },
            {
              "text": "tanıştılar",
              "bucket": "each"
            },
            {
              "text": "kucaklaştık",
              "bucket": "each"
            },
            {
              "text": "koşuşuyor",
              "bucket": "all"
            },
            {
              "text": "gülüştü",
              "bucket": "all"
            },
            {
              "text": "uçuşuyor",
              "bucket": "all"
            },
            {
              "text": "baktı",
              "bucket": "one"
            },
            {
              "text": "gördüm",
              "bucket": "one"
            }
          ],
          "explanation": "No insert — from one person. With the insert — to each other or as a crowd: running, laughing, circling — that's a crowd."
        }
      ]
    },
