        { "id": "6", "q": "Ekmek nereden alıyorsunuz?", "sit": "В магазине (market).", "options": ["Marketten alıyorum.", "Marketden alıyorum.", "Markete alıyorum."], "answer": 0, "explanation": "market: глухая t → ten." }
