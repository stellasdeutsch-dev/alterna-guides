    {
      "id": "a1.ablative.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Pick the right tail",
      "items": [
        {
          "id": "1",
          "prompt": "From home →",
          "say": "evden",
          "options": [
            "evden",
            "evdan",
            "eve"
          ],
          "answer": 0,
          "explanation": "Vowel e → -den. And eve means “home” as in “going home.”"
        },
        {
          "id": "2",
          "prompt": "From school →",
          "say": "okuldan",
          "options": [
            "okulden",
            "okuldan",
            "okultan"
          ],
          "answer": 1,
          "explanation": "Vowel u → a, l is voiced → d: okuldan."
        },
        {
          "id": "3",
          "prompt": "From the bus →",
          "say": "otobüsten",
          "options": [
            "otobüsden",
            "otobüsten",
            "otobüstan"
          ],
          "answer": 1,
          "explanation": "Vowel ü → e, voiceless s → t: otobüsten."
        },
        {
          "id": "4",
          "prompt": "Kadıköy'den geliyorum. →",
          "say": "Kadıköy'den geliyorum.",
          "options": [
            "I'm going to Kadıköy.",
            "I'm coming from Kadıköy."
          ],
          "answer": 1,
          "explanation": "-den means “from where.” “Where to” would be Kadıköy'e."
        },
        {
          "id": "5",
          "prompt": "From where? →",
          "say": "Nereden?",
          "options": [
            "Nereye?",
            "Nereden?",
            "Ne?"
          ],
          "answer": 1,
          "explanation": "Nereden — from where. Nereye — where to."
        }
      ]
    },
