{
  "topic": "a1.alphabet",
  "exercises": [
    {
      "id": "a1.alphabet.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "How do you read this?",
      "items": [
        {
          "id": "1",
          "prompt": "çay",
          "say": "çay",
          "options": [
            "“kay,” like “okay”",
            "“chai”",
            "“chay,” like “day”"
          ],
          "answer": 1,
          "explanation": "A tail under the c means it hisses: ç = “ch.” And ay sounds like “eye,” not like “day.” So: “chai.”"
        },
        {
          "id": "2",
          "prompt": "göz (eye)",
          "say": "göz",
          "options": [
            "“goz”",
            "“gaz”",
            "“göz,” lips rounded"
          ],
          "answer": 2,
          "explanation": "Two dots over the o. Say “e” as in bed, but round your lips like for “o.” So, “göz.”"
        },
        {
          "id": "3",
          "prompt": "kız (girl)",
          "say": "kız",
          "options": [
            "“kuhz”",
            "“keez”",
            "“kiz,” like “quiz”"
          ],
          "answer": 0,
          "explanation": "ı has no dot. No dot means “uh,” close to the a in “about.” So, “kuhz.”"
        }
      ]
    },
    {
      "id": "a1.alphabet.ex2",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "matching",
      "difficulty": 1,
      "instruction": "Match the letter and the sound",
      "items": [
        {
          "id": "1",
          "pairs": [
            {
              "left": "ç",
              "right": "“ch” (church)"
            },
            {
              "left": "ş",
              "right": "“sh” (ship)"
            },
            {
              "left": "c",
              "right": "“j” (jam)"
            },
            {
              "left": "ı",
              "right": "“uh” (about)"
            },
            {
              "left": "j",
              "right": "“zh” (measure)"
            },
            {
              "left": "ğ",
              "right": "silent, stretches the vowel"
            }
          ],
          "explanation": "The tail hisses: ç “ch,” ş “sh.” Plain c is your “j.” And Turkish j is softer: “zh,” like the s in measure. No dot — “uh.” With a little hat, ğ goes silent."
        }
      ]
    },
    {
      "id": "a1.alphabet.ex3",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "custom",
      "difficulty": 2,
      "instruction": "Fix the sign: which letter is missing?",
      "description": "Istanbul’s neon signs, each with one letter burnt out. The learner sees the reading spelled out and picks one of three letters (finger, mouse or keys 1–3). The letter flies into the sign in an arc. The logic lives in index.html.",
      "items": [
        {
          "id": "1",
          "sign": "ÇAY",
          "slot": 0,
          "read": "“chai”",
          "ru": "tea",
          "options": [
            "C",
            "Ç",
            "Ş"
          ],
          "answer": "Ç",
          "explanation": "“Ch” is a c with a tail: Ç. A plain C would read “j.”"
        },
        {
          "id": "2",
          "sign": "ŞEKER",
          "slot": 0,
          "read": "“sheh-ker”",
          "ru": "sugar",
          "options": [
            "Ç",
            "S",
            "Ş"
          ],
          "answer": "Ş",
          "explanation": "“Sh” is an s with a tail: Ş. Ç would give “ch.”"
        },
        {
          "id": "3",
          "sign": "CAMİ",
          "slot": 0,
          "read": "“jamee”",
          "ru": "mosque",
          "options": [
            "J",
            "Ç",
            "C"
          ],
          "answer": "C",
          "explanation": "Your “j” sound is a plain C, no tail. Turkish J reads “zh,” like the s in measure."
        },
        {
          "id": "4",
          "sign": "BALIK",
          "slot": 3,
          "read": "“bah-luhk”",
          "ru": "fish",
          "options": [
            "İ",
            "I",
            "Ğ"
          ],
          "answer": "I",
          "explanation": "You need the “uh” sound. A capital I without a dot is “uh.” With a dot, İ would be “ee.”"
        }
      ]
    },
    {
