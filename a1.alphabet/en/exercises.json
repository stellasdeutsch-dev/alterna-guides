{
  "topic": "a1.alphabet",
  "exercises": [
    {
      "id": "a1.alphabet.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "How do you read this?",
      "items": [
        {
          "id": "1",
          "prompt": "çay",
          "say": "çay",
          "options": [
            "“kai”",
            "“chai”",
            "“sai”"
          ],
          "answer": 1,
          "explanation": "A tail under the c means it hisses: ç = “ch.” Hence “chai.”"
        },
        {
          "id": "2",
          "prompt": "göz (eye)",
          "say": "göz",
          "options": [
            "“goz”",
            "“gaz”",
            "“göz,” lips rounded"
          ],
          "answer": 2,
          "explanation": "Two dots over the o. Round your lips: ö is like German ö — say “e” with rounded lips. So, “göz.”"
        },
        {
          "id": "3",
          "prompt": "kız (girl)",
          "say": "kız",
          "options": [
            "“kuhz”",
            "“keez”",
            "“kez”"
          ],
          "answer": 0,
          "explanation": "ı has no dot. Take the dot off and you get “uh.” So, “kuhz.”"
        }
      ]
    },
    {
      "id": "a1.alphabet.ex2",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "matching",
      "difficulty": 1,
      "instruction": "Match the letter and the sound",
      "items": [
        {
          "id": "1",
          "pairs": [
            {
              "left": "ç",
              "right": "“ch”"
            },
            {
              "left": "ş",
              "right": "“sh”"
            },
            {
              "left": "c",
              "right": "“j”"
            },
            {
              "left": "ı",
              "right": "“uh”"
            },
            {
              "left": "y",
              "right": "“y”"
            },
            {
              "left": "ğ",
              "right": "silent, stretches the vowel"
            }
          ],
          "explanation": "The tail hisses: ç “ch,” ş “sh.” Plain c — “j.” No dot — “uh.” y — “y.” With a little hat, ğ goes silent."
        }
      ]
    },
    {
      "id": "a1.alphabet.ex3",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "custom",
      "difficulty": 2,
      "instruction": "Fix the sign: which letter is missing?",
      "description": "Istanbul’s neon signs, each with one letter burnt out. The learner sees the reading spelled out and picks one of three letters (finger, mouse or keys 1–3). The letter flies into the sign in an arc. The logic lives in index.html.",
      "items": [
        {
          "id": "1",
          "sign": "ÇAY",
          "slot": 0,
          "read": "“chai”",
          "ru": "tea",
          "options": [
            "C",
            "Ç",
            "Ş"
          ],
          "answer": "Ç",
          "explanation": "“Ch” is a c with a tail: Ç. A plain C would read “j.”"
        },
        {
          "id": "2",
          "sign": "ŞEKER",
          "slot": 0,
          "read": "“sheker”",
          "ru": "sugar",
          "options": [
            "Ç",
            "S",
            "Ş"
          ],
          "answer": "Ş",
          "explanation": "“Sh” is an s with a tail: Ş. Ç would give “ch.”"
        },
        {
          "id": "3",
          "sign": "CAMİ",
          "slot": 0,
          "read": "“jamee”",
          "ru": "mosque",
          "options": [
            "J",
            "Ç",
            "C"
          ],
          "answer": "C",
          "explanation": "“J” is a plain C, no tail. J reads “zh.”"
        },
        {
          "id": "4",
          "sign": "BALIK",
          "slot": 3,
          "read": "“baluhk”",
          "ru": "fish",
          "options": [
            "İ",
            "I",
            "Ğ"
          ],
          "answer": "I",
          "explanation": "You need the “uh” sound. A capital I without a dot is “uh.” With a dot, İ would be “ee.”"
        }
      ]
    },
