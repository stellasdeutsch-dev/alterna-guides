          "prompt": "Which letter reads “sh”?",
          "options": [
            "s",
            "ş",
            "ç"
          ],
          "answer": 1,
          "explanation": "The tail hisses. s with a tail is ş, “sh.” And ç is “ch.”"
        },
        {
          "id": "2",
          "type": "true_false",
          "statement": "A capital I without a dot reads “ee.”",
          "answer": false,
          "explanation": "No dot means “uh,” capital or small. “Ee” is İ with a dot: İstanbul."
        },
        {
          "id": "3",
          "type": "multiple_choice",
          "prompt": "How do you read Eminönü?",
          "say": "Eminönü",
          "options": [
            "“eminonoo”",
            "“eminönü”",
            "“eemeenönoo”"
          ],
          "answer": 1,
          "explanation": "e — “e” as in “bed.” ö and ü — the dots round your lips. You get “eminönü.”"
        },
