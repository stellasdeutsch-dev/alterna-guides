    {
      "id": "b1.wish-past.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "What does the sentence mean?",
      "items": [
        {
          "prompt": "Keşke dün sana söyleseydim.",
          "options": [
            "I wish I'd told you yesterday.",
            "I hope I get to tell you tomorrow.",
            "I wish I hadn't told you."
          ],
          "answer": 0,
          "say": "Keşke dün sana söyleseydim.",
          "explanation": "Turkish says “yes” — and so does English “I wish I had.” Söyleseydim with no -me means “I wish I HAD told you.”"
        },
        {
          "prompt": "Keşke o mesajı göndermeseydim.",
          "options": [
            "I wish I hadn't sent this message.",
            "I wish I'd sent this message.",
            "I hope I get to send this message."
          ],
          "answer": 0,
          "say": "Keşke o mesajı göndermeseydim.",
          "explanation": "-me in Turkish — and a “not” in English too. Göndermeseydim — “I wish I hadn't sent it.”"
        },
        {
          "prompt": "Keşke gelse.",
          "options": [
            "I hope he comes.",
            "I wish he'd come yesterday.",
            "He would have come."
          ],
          "answer": 0,
          "say": "Keşke gelse.",
          "explanation": "Without -ydı it's -sA — a wish about now or later. I hope he comes."
        },
        {
          "prompt": "Erken çıksaydık, yetişirdik.",
          "options": [
            "If we'd left earlier, we'd have made it.",
            "We left early and made it.",
            "If we leave earlier, we'll make it."
          ],
          "answer": 0,
          "say": "Erken çıksaydık, yetişirdik.",
          "explanation": "-sAydI in the first half, -(A/I)rdI in the second — the unreal past. Didn't leave — didn't make it."
        },
        {
          "prompt": "Bana sorsaydın!",
          "options": [
            "You could've asked me!",
            "Ask me!",
            "You asked me."
          ],
          "answer": 0,
          "say": "Bana sorsaydın!",
          "explanation": "-sAydI with an exclamation is a soft reproach: “you could've asked me!”"
        }
      ]
    },
