{
  "topic": "a1.present-continuous",
  "exercises": [
    {
      "id": "a1.present-continuous.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Pick the shot: which form is right?",
      "items": [
        {
          "id": "1",
          "prompt": "gel- + ben → ?",
          "say": "geliyorum",
          "options": [
            "gelyorum",
            "geliyorum",
            "geliyorım"
          ],
          "answer": 1,
          "explanation": "You need a vowel between the root and yor: after e, it’s i. After yor the tail always has u: geliyorum."
        },
        {
          "id": "2",
          "prompt": "yap- + sen → ?",
          "say": "yapıyorsun",
          "options": [
            "yapıyorsun",
            "yapiyorsun",
            "yapıyorsın"
          ],
          "answer": 0,
          "explanation": "yap- has the vowel a, so ı: yapıyor. The “you” tail after yor is -sun."
        },
        {
          "id": "3",
          "prompt": "bekle- + o → ?",
          "say": "bekliyor",
          "options": [
            "bekleiyor",
            "bekleyor",
            "bekliyor"
          ],
          "answer": 2,
          "explanation": "The vowel at the end of the root drops. Before it there’s e, so i: bekliyor."
        },
        {
          "id": "4",
          "prompt": "What does “Çay içiyorum” mean?",
          "say": "Çay içiyorum",
          "options": [
            "I’m drinking tea right now",
            "To drink tea",
            "He’s drinking tea"
          ],
          "answer": 0,
          "explanation": "-iyor is the shot, the tail -um is “I am.” So: I’m drinking tea right now."
        }
      ]
    },
    {
      "id": "a1.present-continuous.ex2",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "sort_buckets",
      "difficulty": 1,
      "instruction": "Which vowel goes before yor? Sort the roots",
      "items": [
        {
          "id": "1",
          "buckets": [
            {
              "id": "i1",
              "label": "-ıyor"
            },
            {
              "id": "i2",
              "label": "-iyor"
            },
            {
              "id": "u1",
              "label": "-uyor"
            },
            {
              "id": "u2",
              "label": "-üyor"
            }
          ],
          "entries": [
            {
              "text": "yap-",
              "bucket": "i1"
            },
            {
              "text": "al-",
              "bucket": "i1"
            },
            {
              "text": "gel-",
              "bucket": "i2"
            },
            {
              "text": "iç-",
              "bucket": "i2"
            },
            {
              "text": "konuş-",
              "bucket": "u1"
            },
            {
              "text": "otur-",
              "bucket": "u1"
            },
            {
              "text": "gör-",
              "bucket": "u2"
            },
            {
              "text": "gül-",
              "bucket": "u2"
            }
          ],
          "explanation": "Look at the last vowel of the root: a, ı → ı; e, i → i; o, u → u; ö, ü → ü."
        }
      ]
    },
    {
      "id": "a1.present-continuous.ex3",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "mixed",
      "difficulty": 2,
      "instruction": "Build it, find the mistake, fill in the form",
      "items": [
        {
          "id": "1",
          "type": "build_sentence",
          "translation": "I’m drinking tea right now.",
          "words": [
            "Şimdi",
            "çay",
            "içiyorum."
          ],
          "distractors": [
            "içmek",
            "içiyor"
          ],
          "explanation": "The “I’m drinking” shot: iç + i + yor + um. içmek is the dictionary form, içiyor is “he’s drinking.”"
        },
        {
          "id": "2",
          "type": "error_hunt",
          "prompt": "Find the mistake",
          "tokens": [
            "Ben",
            "Türkçe",
            "öğreniyor."
          ],
          "wrong": 2,
          "fix": "öğreniyorum.",
          "options": [
            "öğreniyorum.",
            "öğreniyorım.",
            "öğrenyorum."
          ],
          "explanation": "ben doesn’t mark the person, the tail does. Without -um it means “he’s learning”: öğreniyorum."
        },
        {
          "id": "3",
          "type": "gap_fill",
          "text": "Ali şimdi ___ . (çalışmak)",
          "answers": [
            [
              "çalışıyor"
            ]
          ],
          "translation": "Ali is working right now.",
          "explanation": "çalış + ı + yor. “He” has no tail: çalışıyor."
        },
        {
          "id": "4",
          "type": "gap_fill",
          "text": "Biz şimdi kitap ___ . (okumak)",
          "answers": [
            [
              "okuyoruz"
            ]
          ],
          "translation": "We’re reading a book right now.",
          "explanation": "oku- ends in a vowel: u drops, before it o → u. okuyor + uz = okuyoruz."
        }
      ]
    },
    {
      "id": "a1.present-continuous.ex4",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "custom",
      "difficulty": 2,
      "instruction": "Photographer on the Galata Bridge: take the right shot",
      "description": "The viewfinder shows who’s doing what. The learner picks the -iyor form, the right answer fires the flash. Logic lives in index.html.",
      "items": [
        {
          "id": "1",
          "cue": "o · balık tut-",
          "ru": "A fisherman is fishing",
          "options": [
            "tutıyor",
            "tutuyor",
            "tutiyor"
          ],
          "answer": 1,
          "explanation": "tut- has the vowel u, so u: tutuyor."
        },
        {
          "id": "2",
          "cue": "ben · çay iç-",
          "ru": "I’m drinking tea",
          "options": [
            "içiyorum",
            "içiyor",
            "içyorum"
          ],
          "answer": 0,
          "explanation": "iç + i + yor + um. Without -um it would be “he’s drinking.”"
        },
        {
          "id": "3",
          "cue": "biz · vapur bekle-",
          "ru": "We’re waiting for the ferry",
          "options": [
            "bekleyoruz",
            "bekleiyoruz",
            "bekliyoruz"
          ],
          "answer": 2,
          "explanation": "The e at the end of bekle- drops, before it e → i: bekliyoruz."
        },
        {
          "id": "4",
          "cue": "onlar · konuş-",
          "ru": "They’re talking",
          "options": [
            "konuşuyorlar",
            "konuşıyorlar",
            "konuşuyorler"
          ],
          "answer": 0,
          "explanation": "o, u → u: konuşuyor. After yor the tail is -lar, not -ler."
        },
        {
          "id": "5",
          "cue": "sen · gül-",
          "ru": "You’re laughing",
          "options": [
            "gülüyorsün",
            "gülüyorsun",
            "güliyorsun"
          ],
          "answer": 1,
          "explanation": "ü → ü: gülüyor. After yor the tail always has u: -sun."
        }
      ]
    },
    {
