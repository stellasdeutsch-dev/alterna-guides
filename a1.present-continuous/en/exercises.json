      "instruction": "Quick check",
      "items": [
        {
          "id": "1",
          "type": "multiple_choice",
          "prompt": "What does -iyor show?",
          "options": [
            "What’s happening now or these days",
            "What happened yesterday",
            "A lifelong habit"
          ],
          "answer": 0,
          "explanation": "-iyor is a camera: it shoots the moment and “these days.” It doesn’t shoot lifelong habits."
        },
        {
          "id": "2",
          "type": "true_false",
          "statement": "“I understand” (right now) is Anlıyorum.",
          "answer": true,
          "explanation": "English has no -ing here, but Turkish uses -iyor: anla → anlıyor + um."
        },
        {
          "id": "3",
          "type": "gap_fill",
          "text": "Onlar şimdi ___ . (uyumak)",
          "answers": [
            [
              "uyuyorlar"
            ]
          ],
          "translation": "They’re sleeping right now.",
          "explanation": "uyu- ends in u: it drops, before it u → u. uyuyor + lar."
        },
        {
          "id": "4",
          "type": "multiple_choice",
          "prompt": "How do you say “we’re talking”?",
          "options": [
            "konuşiyoruz",
            "konuşuyoruz",
            "konuşuyorüz"
          ],
          "answer": 1,
          "explanation": "o, u → u, and the “we” tail after yor is -uz: konuşuyoruz."
        },
        {
          "id": "5",
          "type": "true_false",
          "statement": "“You see” is görüyorsin",
          "answer": false,
          "explanation": "The tail looks at yor, not the root: görüyorsun."
        }
      ]
    },
    {
      "id": "a1.present-continuous.ex5",
      "lesson": 2,
      "kind": "practice",
      "skill": "grammar",
      "type": "true_false",
      "difficulty": 1,
      "instruction": "True or false?",
      "items": [
        {
          "id": "1",
          "statement": "gelmiyorum means “I’m not coming”",
          "say": "gelmiyorum",
          "answer": true,
          "explanation": "gel + mi + yor + um: the “stop” button is pressed."
        },
        {
          "id": "2",
          "statement": "Mu geliyorsun? is a correct question",
          "answer": false,
          "explanation": "No “Are you…?” word order in Turkish. The verb stays last and mu comes after it: Geliyor musun?"
        },
        {
          "id": "3",
          "statement": "gitiyorum is the correct form",
          "answer": false,
          "explanation": "t between vowels becomes d: gidiyorum."
        },
        {
          "id": "4",
          "statement": "almıyor means “he isn’t taking it”",
          "say": "almıyor",
          "answer": true,
          "explanation": "al- has the vowel a, so mı: almıyor."
        }
      ]
    },
    {
      "id": "a1.present-continuous.ex6",
      "lesson": 2,
      "kind": "practice",
      "skill": "grammar",
      "type": "matching",
      "difficulty": 2,
      "instruction": "Match the form and the translation",
      "items": [
        {
          "id": "1",
          "pairs": [
            {
              "left": "anlamıyorum",
              "right": "I don’t understand"
            },
            {
              "left": "geliyor musun?",
              "right": "are you coming?"
            },
            {
              "left": "gidiyoruz",
              "right": "we’re going"
            },
            {
              "left": "yiyor",
              "right": "he’s eating"
            },
            {
              "left": "gelmiyor musun?",
              "right": "aren’t you coming?"
            }
          ],
          "explanation": "mı/mi/mu/mü before yor means “not.” A separate mu is a question. git → gidiyor, ye → yiyor."
        }
      ]
    },
