    {
      "id": "a1.present-continuous.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Выбери кадр: какая форма правильная?",
      "items": [
        { "id": "1", "prompt": "gel- + ben → ?", "say": "geliyorum", "options": ["gelyorum", "geliyorum", "geliyorım"], "answer": 1, "explanation": "Между корнем и yor нужна гласная: после e — i. После yor хвост всегда с u: geliyorum." },
        { "id": "2", "prompt": "yap- + sen → ?", "say": "yapıyorsun", "options": ["yapıyorsun", "yapiyorsun", "yapıyorsın"], "answer": 0, "explanation": "В yap- гласная a, значит ı: yapıyor. Хвост «ты» после yor — -sun." },
        { "id": "3", "prompt": "bekle- + o → ?", "say": "bekliyor", "options": ["bekleiyor", "bekleyor", "bekliyor"], "answer": 2, "explanation": "Гласная на конце корня уходит. Перед ней e — значит i: bekliyor." },
        { "id": "4", "prompt": "Что значит «Çay içiyorum»?", "say": "Çay içiyorum", "options": ["Я пью чай прямо сейчас", "Пить чай", "Он пьёт чай"], "answer": 0, "explanation": "-iyor — кадр, хвост -um — «я». Значит, я пью чай сейчас." }
      ]
    },
    {
      "id": "a1.present-continuous.ex2",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "sort_buckets",
      "difficulty": 1,
      "instruction": "Какая гласная встанет перед yor? Разложи корни",
      "items": [
        {
          "id": "1",
