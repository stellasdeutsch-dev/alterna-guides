            { "id": "u2", "label": "-üyor" }
          ],
          "entries": [
            { "text": "yap-", "bucket": "i1" },
            { "text": "al-", "bucket": "i1" },
            { "text": "gel-", "bucket": "i2" },
            { "text": "iç-", "bucket": "i2" },
            { "text": "konuş-", "bucket": "u1" },
            { "text": "otur-", "bucket": "u1" },
            { "text": "gör-", "bucket": "u2" },
            { "text": "gül-", "bucket": "u2" }
          ],
          "explanation": "Смотри на последнюю гласную корня: a, ı → ı; e, i → i; o, u → u; ö, ü → ü."
        }
      ]
    },
