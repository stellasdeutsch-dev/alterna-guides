        { "id": "2", "type": "error_hunt", "prompt": "Найди ошибку", "tokens": ["Ben", "Türkçe", "öğreniyorım."], "wrong": 2, "fix": "öğreniyorum.", "options": ["öğreniyorum.", "öğrenyorum.", "öğreniyorim."], "explanation": "После yor хвост всегда с u: öğreniyorum." },
