        { "id": "1", "cue": "o · balık tut-", "ru": "Рыбак ловит рыбу", "options": ["tutıyor", "tutuyor", "tutiyor"], "answer": 1, "explanation": "В tut- гласная u, значит u: tutuyor." },
        { "id": "2", "cue": "ben · çay iç-", "ru": "Я пью чай", "options": ["içiyorum", "içiyor", "içyorum"], "answer": 0, "explanation": "iç + i + yor + um. Без -um было бы «он пьёт»." },
        { "id": "3", "cue": "biz · vapur bekle-", "ru": "Мы ждём паром", "options": ["bekleyoruz", "bekleiyoruz", "bekliyoruz"], "answer": 2, "explanation": "e на конце bekle- уходит, перед ней e → i: bekliyoruz." },
        { "id": "4", "cue": "onlar · konuş-", "ru": "Они разговаривают", "options": ["konuşuyorlar", "konuşıyorlar", "konuşuyorler"], "answer": 0, "explanation": "o, u → u: konuşuyor. После yor хвост -lar, не -ler." },
        { "id": "5", "cue": "sen · gül-", "ru": "Ты смеёшься", "options": ["gülüyorsün", "gülüyorsun", "güliyorsun"], "answer": 1, "explanation": "ü → ü: gülüyor. После yor хвост всегда с u: -sun." }
      ]
    },
