      "instruction": "What does the sentence mean?",
      "items": [
        {
          "prompt": "Türkçe konuştukça daha kolay oluyor.",
          "options": [
            "The more you speak Turkish, the easier it gets.",
            "Until you start speaking Turkish, it won't get easier.",
            "The whole time you speak Turkish, it's easy."
          ],
          "answer": 0,
          "say": "Türkçe konuştukça daha kolay oluyor.",
          "explanation": "-tukça is “the more / as.” The second half grows: daha kolay."
        },
        {
          "prompt": "Kartını okutmadıkça kapı açılmaz.",
          "options": [
            "Unless you tap your card, the door won't open.",
            "The more often you tap your card, the worse the door opens.",
            "The door is open as long as you have a card."
          ],
          "answer": 0,
          "say": "Kartını okutmadıkça kapı açılmaz.",
          "explanation": "-madıkça is “unless / until.” The negation -ma- flips the meaning."
        },
        {
          "prompt": "Burada kaldığın sürece bizde kalabilirsin.",
          "options": [
            "As long as you're here, you can stay with us.",
            "The longer you're here, the less you can stay with us.",
            "You can't stay with us until you stay."
          ],
          "answer": 0,
          "say": "Burada kaldığın sürece bizde kalabilirsin.",
          "explanation": "-dığın sürece is “as long as / provided that”: as long as you're here."
        },
        {
          "prompt": "Yaz boyunca Ankara'dayım.",
          "options": [
            "I'm in Ankara all summer.",
            "In summer I'm sometimes in Ankara.",
            "The more summer there is, the more I'm in Ankara."
          ],
          "answer": 0,
          "say": "Yaz boyunca Ankara'dayım.",
          "explanation": "Boyunca is the whole stretch: all summer long."
        }
      ]
    },
