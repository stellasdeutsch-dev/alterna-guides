      "difficulty": 1,
      "instruction": "Узнай персонажа",
      "items": [
        { "id": "1", "prompt": "«мы» → ?", "say": "biz", "options": ["siz", "biz", "onlar"], "answer": 1, "explanation": "biz — мы. siz — вы, onlar — они. На слух их путают, смотри на первую букву." },
        { "id": "2", "prompt": "«она» → ?", "say": "o", "options": ["o", "ona", "onlar"], "answer": 0, "explanation": "Рода нет: o — это и он, и она, и оно. ona — уже падеж «ей, ему»." },
        { "id": "3", "prompt": "«Вы» — вежливо, одному профессору → ?", "say": "siz", "options": ["sen", "siz", "biz"], "answer": 1, "explanation": "Чужой и старший — синий квадрат, siz. Даже если человек один." },
        { "id": "4", "prompt": "«они» → ?", "say": "onlar", "options": ["onlar", "o", "onların"], "answer": 0, "explanation": "onlar — они. onların — «их», это уже «чей»." }
      ]
    },
    {
