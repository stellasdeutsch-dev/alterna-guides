            { "text": "врачу", "bucket": "siz" },
            { "text": "группе студентов", "bucket": "siz" },
            { "text": "коту", "bucket": "sen" }
          ],
          "explanation": "Свой — sen. Чужой, старший или сразу несколько людей — siz."
        }
      ]
    },
    {
      "id": "lib.pronouns.ex3",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "matching",
      "difficulty": 2,
      "instruction": "Соедини форму o с переводом",
      "items": [
        {
          "id": "1",
          "pairs": [
            { "left": "onun", "right": "его (чей?)" },
            { "left": "ona", "right": "ему (кому?)" },
            { "left": "onu", "right": "его (кого?)" },
            { "left": "onda", "right": "у него" },
            { "left": "ondan", "right": "от него" }
          ],
          "explanation": "У o во всех падежах внутри n: o + n + окончание. -a — кому, -u — кого, -da — у кого, -dan — от кого, -un — чей."
        }
      ]
    },
    {
      "id": "lib.pronouns.ex4",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "mixed",
      "difficulty": 2,
      "instruction": "Поставь форму, найди ошибку, собери фразу",
      "items": [
        {
          "id": "1",
          "type": "gap_fill",
          "text": "Para ___. (ben)",
          "answers": [["bende"]],
          "options": [["bende", "bana", "beni"]],
          "translation": "Деньги у меня.",
          "explanation": "«У кого?» — окончание -de: ben + de = bende."
        },
        {
          "id": "2",
          "type": "error_hunt",
          "prompt": "Найди ошибку",
          "tokens": ["Bene", "bir", "hediye", "verdi."],
          "wrong": 0,
          "fix": "Bana",
          "options": ["Bana", "Beni", "Benim"],
          "explanation": "«Кому?» от ben — исключение: bana. Не bene."
        },
        {
          "id": "3",
          "type": "gap_fill",
          "text": "Annem ___ çok özledi. (sen)",
          "answers": [["seni"]],
          "options": [["seni", "sana", "senin"]],
          "translation": "Мама очень скучала по тебе.",
          "explanation": "Скучать по кому-то — в турецком «кого?»: sen + i = seni."
        },
        {
          "id": "4",
          "type": "build_sentence",
          "translation": "Это моя книга.",
          "words": ["Bu", "benim", "kitabım."],
          "distractors": ["kitap.", "bana"],
          "explanation": "Принадлежность дважды: benim спереди и -ım сзади. И p перед гласной становится b."
        }
      ]
    },
    {
      "id": "lib.pronouns.ex5",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "custom",
      "difficulty": 2,
      "instruction": "Табло: собери форму",
      "description": "Ученик видит русское слово и вопрос падежа, выбирает местоимение и падеж, табло показывает форму. Логика — в index.html.",
      "items": [
        { "id": "1", "q": "Кому?", "ru": "мне", "pron": "ben", "case": "dat", "answer": "bana", "explanation": "Исключение: не bene, а bana." },
        { "id": "2", "q": "Кого?", "ru": "тебя", "pron": "sen", "case": "acc", "answer": "seni", "explanation": "sen + i — без сюрпризов." },
        { "id": "3", "q": "У кого?", "ru": "у него", "pron": "o", "case": "loc", "answer": "onda", "explanation": "У o внутри n: o + n + da." },
        { "id": "4", "q": "От кого?", "ru": "от нас", "pron": "biz", "case": "abl", "answer": "bizden", "explanation": "biz + den: последняя гласная i, значит -den." },
        { "id": "5", "q": "Чей?", "ru": "их", "pron": "onlar", "case": "gen", "answer": "onların", "explanation": "onlar + ın: последняя гласная a, значит ı." },
        { "id": "6", "q": "Кому?", "ru": "вам", "pron": "siz", "case": "dat", "answer": "size", "explanation": "Исключений у siz нет: siz + e = size." }
      ]
    },
