    {
      "id": "b2.dolayi.ex3",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "custom",
      "difficulty": 2,
      "instruction": "Fitting room: put the cause into a frame",
      "description": "The cause and the frame are given. The learner picks how they connect; the lens takes on the frame's color. The logic is in index.html.",
      "items": [
        {
          "id": "1",
          "cause": "yağmur",
          "frame": "dolayı",
          "sentence": "___ maç ertelendi.",
          "options": [
            "yağmurdan dolayı",
            "yağmur dolayı",
            "yağmura dolayı"
          ],
          "answer": "yağmurdan dolayı",
          "ru": "The match was postponed because of the rain.",
          "explanation": "dolayı needs -DAn: yağmurdan dolayı."
        },
        {
          "id": "2",
          "cause": "sen",
          "frame": "sayesinde",
          "sentence": "___ sınavı geçtim.",
          "options": [
            "sen sayesinde",
            "senin sayende",
            "seni sayende"
          ],
          "answer": "senin sayende",
          "ru": "Thanks to you, I passed the exam.",
          "explanation": "With a pronoun you need a possessive tail: senin sayende."
        },
        {
          "id": "3",
          "cause": "hastalık",
          "frame": "dolayı",
          "sentence": "___ işe gitmedim.",
          "options": [
            "hastalıkdan dolayı",
            "hastalıktan dolayı",
            "hastalığa dolayı"
          ],
          "answer": "hastalıktan dolayı",
          "ru": "I didn't go to work because of illness.",
          "explanation": "After voiceless k the suffix gets devoiced: hastalıktan."
        },
        {
          "id": "4",
          "cause": "ben",
          "frame": "yüzünden",
          "sentence": "___ geç kaldınız, kusura bakmayın.",
          "options": [
            "benim yüzümden",
            "benim yüzünden",
            "ben yüzünden"
          ],
          "answer": "benim yüzümden",
          "ru": "You were late because of me, sorry.",
          "explanation": "Me means a first-person tail: benim yüzümden."
        },
        {
          "id": "5",
          "cause": "bu uygulama",
          "frame": "sayesinde",
          "sentence": "___ Türkçem gelişti.",
          "options": [
            "bu uygulamadan sayesinde",
            "bu uygulama sayesinde",
            "bu uygulamanın sayende"
          ],
          "answer": "bu uygulama sayesinde",
          "ru": "Thanks to this app, my Turkish has grown.",
          "explanation": "sayesinde takes the bare word, no -DAn."
        },
        {
          "id": "6",
          "cause": "kar",
          "frame": "nedeniyle",
          "sentence": "___ okullar tatil edildi.",
          "options": [
            "kardan nedeniyle",
            "kar nedeniyle",
            "karın nedeniyle"
          ],
          "answer": "kar nedeniyle",
          "ru": "Schools were closed because of the snow.",
          "explanation": "nedeniyle also takes no case: kar nedeniyle."
        }
      ]
    },
