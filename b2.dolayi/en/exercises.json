      "instruction": "Which glasses do you put on?",
      "items": [
        {
          "id": "1",
          "prompt": "Traffic jam, you're late and annoyed. Trafik ___ geç kaldım.",
          "say": "Trafik yüzünden geç kaldım.",
          "options": [
            "yüzünden",
            "sayesinde"
          ],
          "answer": 0,
          "explanation": "The cause is to blame, you're unhappy. Red glasses: yüzünden."
        },
        {
          "id": "2",
          "prompt": "Your teacher helped, you passed. Öğretmenim ___ sınavı geçtim.",
          "say": "Öğretmenim sayesinde sınavı geçtim.",
          "options": [
            "yüzünden",
            "sayesinde"
          ],
          "answer": 1,
          "explanation": "You're grateful to the cause. Pink glasses: sayesinde."
        },
        {
          "id": "3",
          "prompt": "How would a newscaster say it? Fırtına ___ uçuşlar iptal edildi.",
          "say": "Fırtına nedeniyle uçuşlar iptal edildi.",
          "options": [
            "sayesinde",
            "nedeniyle",
            "benim yüzümden"
          ],
          "answer": 1,
          "explanation": "The news speaks calmly and officially: nedeniyle."
        },
        {
          "id": "4",
          "prompt": "The match was postponed because of the rain. Which form goes with dolayı?",
          "say": "Yağmurdan dolayı maç ertelendi.",
          "options": [
            "Yağmur dolayı",
            "Yağmurdan dolayı",
            "Yağmura dolayı"
          ],
          "answer": 1,
          "explanation": "dolayı only holds on with the ablative: yağmurdan."
        }
      ]
    },
