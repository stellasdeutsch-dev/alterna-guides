      "id": "b1.conditional.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Spot the “if”",
      "items": [
        {
          "id": "1",
          "prompt": "Which phrase means “if I come”?",
          "say": "Gelirsem",
          "options": [
            "Gelsem",
            "Gelirsem",
            "Gelirim"
          ],
          "answer": 1,
          "explanation": "Gelsem is a dream, gelirim is “I come.” A plan is gelir + se + m."
        },
        {
          "id": "2",
          "prompt": "Yağmur yağarsa means…",
          "say": "Yağmur yağarsa",
          "options": [
            "If it rains",
            "If only it would rain",
            "It's raining"
          ],
          "answer": 0,
          "explanation": "Aorist plus -sa is a real “if.” A dream would have no -ar."
        },
        {
          "id": "3",
          "prompt": "Where's the condition: “Erken kalkarsak, plaja gideriz”?",
          "options": [
            "Erken kalkarsak",
            "plaja gideriz"
          ],
          "answer": 0,
          "explanation": "The condition is where -sa is. That's the upper floor."
        },
        {
          "id": "4",
          "prompt": "If they come…",
          "say": "Gelirlerse",
          "options": [
            "Gelirlerse",
            "Gelirsek",
            "Gelirsiniz"
          ],
          "answer": 0,
          "explanation": "They: -ler goes before -se: gelirlerse."
        }
      ]
    },
    {
      "id": "b1.conditional.ex2",
      "lesson": 1,
      "kind": "practice",
