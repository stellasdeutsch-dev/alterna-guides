          ],
          "entries": [
            {
              "text": "yapar-",
              "bucket": "sa"
            },
            {
              "text": "gelir-",
              "bucket": "se"
            },
            {
              "text": "okur-",
              "bucket": "sa"
            },
            {
              "text": "gider-",
              "bucket": "se"
            },
            {
              "text": "alır-",
              "bucket": "sa"
            },
            {
              "text": "ister-",
              "bucket": "se"
            },
            {
              "text": "konuşur-",
              "bucket": "sa"
            },
            {
              "text": "bekler-",
              "bucket": "se"
            }
          ],
          "explanation": "Look at the last vowel of the aorist. a, ı, o, u — -sa. e, i, ö, ü — -se."
        }
      ]
    },
