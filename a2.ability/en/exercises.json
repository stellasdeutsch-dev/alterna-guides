    {
      "id": "a2.ability.ex3",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "mixed",
      "difficulty": 2,
      "instruction": "Fill in the form, spot the mistake, build the request",
      "items": [
        {
          "id": "1",
          "type": "gap_fill",
          "text": "Türkçe konuş___.",
          "answers": [
            [
              "abilirim"
            ]
          ],
          "options": [
            [
              "abilirim",
              "ebilirim",
              "amam"
            ]
          ],
          "translation": "I can speak Turkish.",
          "explanation": "Last vowel u → a: konuşabilirim."
        },
        {
          "id": "2",
          "type": "error_hunt",
          "prompt": "Spot the mistake: “I can't come tonight”",
          "tokens": [
            "Bu",
            "akşam",
            "gelebilmem."
          ],
          "wrong": 2,
          "fix": "gelemem.",
          "options": [
            "gelemem.",
            "gelamam."
          ],
          "explanation": "In the negative, bil drops out: gelemem. And the vowel is e, like in the root gel."
        },
        {
          "id": "3",
          "type": "build_sentence",
          "translation": "Could you help me?",
          "words": [
            "Yardım",
            "edebilir",
            "misiniz?"
          ],
          "distractors": [
            "etebilir",
            "musunuz?"
          ],
          "explanation": "et before a vowel → ed. After bilir the particle is always mi: misiniz."
        },
        {
          "id": "4",
          "type": "gap_fill",
          "text": "Yarın ___.",
          "answers": [
            [
              "gelebilirim"
            ]
          ],
          "translation": "I can come tomorrow. (gelmek)",
          "explanation": "gel + ebil + ir + im = gelebilirim."
        }
      ]
    },
    {
      "id": "a2.ability.ex4",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "custom",
      "difficulty": 2,
      "instruction": "The climb: build the form from bricks",
      "description": "The climber goes up one ledge for every form built: first the modal brick, then the ending. The logic is in index.html.",
      "items": [
        {
          "id": "1",
          "task": "I can come.",
          "stem": "gel",
          "slots": [
            {
              "options": [
                "ebil",
                "abil",
                "yebil"
              ],
              "answer": "ebil"
            },
            {
              "options": [
                "irim",
                "im",
                "mem"
              ],
              "answer": "irim"
            }
          ],
          "answer": "gelebilirim",
          "ru": "I can come",
          "explanation": "Last vowel e → ebil. The root ends in a consonant — no y."
        },
        {
          "id": "2",
          "task": "You can read.",
          "stem": "oku",
          "slots": [
            {
              "options": [
                "abil",
                "yabil",
                "yebil"
              ],
              "answer": "yabil"
            },
            {
              "options": [
                "irsin",
                "ir",
                "mazsın"
              ],
              "answer": "irsin"
            }
          ],
          "answer": "okuyabilirsin",
          "ru": "you can read",
          "explanation": "The root ends in a vowel — you need y. Vowel u → a: yabil."
        },
        {
          "id": "3",
          "task": "We can't go.",
          "stem": "git",
          "stemBeforeVowel": "gid",
          "slots": [
            {
              "options": [
                "e",
                "a",
                "ebil"
              ],
              "answer": "e"
            },
            {
              "options": [
                "meyiz",
                "mezsiniz",
                "memiz"
              ],
              "answer": "meyiz"
            }
          ],
          "answer": "gidemeyiz",
          "ru": "we can't go",
          "explanation": "“Can't” — no bil: e + me. For biz — y: gidemeyiz. And git → gid."
        },
        {
          "id": "4",
          "task": "Could you wait, please?",
          "stem": "bekle",
          "slots": [
            {
              "options": [
                "yebil",
                "ebil",
                "yabil"
              ],
              "answer": "yebil"
            },
            {
              "options": [
                "ir misiniz",
                "irsiniz",
                "mez misiniz"
              ],
              "answer": "ir misiniz"
            }
          ],
          "answer": "bekleyebilir misiniz",
          "ru": "could you wait, please?",
          "explanation": "A request is a question with mi. The root ends in a vowel — y."
        },
        {
          "id": "5",
          "task": "She can't do it.",
          "stem": "yap",
          "slots": [
            {
              "options": [
                "a",
                "ya",
                "abil"
              ],
              "answer": "a"
            },
            {
              "options": [
                "maz",
                "mam",
                "mazsın"
              ],
              "answer": "maz"
            }
          ],
          "answer": "yapamaz",
          "ru": "she can't do it",
          "explanation": "No bil: a + ma. For o — z and nothing else: yapamaz."
        }
      ]
    },
