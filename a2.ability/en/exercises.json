    {
      "id": "a2.ability.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "What does the form mean? Listen and pick the translation",
      "items": [
        {
          "id": "1",
          "prompt": "gelebilirim",
          "say": "Gelebilirim.",
          "options": [
            "I can come",
            "I can't come",
            "I have to come"
          ],
          "answer": 0,
          "explanation": "bil is there — so it's “can”."
        },
        {
          "id": "2",
          "prompt": "gelemem",
          "say": "Gelemem.",
          "options": [
            "I can come",
            "I can't come",
            "may I come?"
          ],
          "answer": 1,
          "explanation": "bil is gone, me showed up — that's “can't”."
        },
        {
          "id": "3",
          "prompt": "Bekleyebilir misiniz?",
          "say": "Bekleyebilir misiniz?",
          "options": [
            "Are you waiting?",
            "Could you wait, please?",
            "Wait!"
          ],
          "answer": 1,
          "explanation": "-ebilir + mi — a polite request, not a question about facts."
        },
        {
          "id": "4",
          "prompt": "okuyamazsın",
          "say": "Okuyamazsın.",
          "options": [
            "you can read",
            "you can't read",
            "you read"
          ],
          "answer": 1,
          "explanation": "oku + y + a + ma + z + sın. No bil — so it's “can't”."
        }
      ]
    },
    {
