      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "What does the phrase mean?",
      "items": [
        {
          "id": "1",
          "prompt": "Servisin başlamasından önce",
          "say": "Servisin başlamasından önce",
          "options": [
            "before service starts",
            "after service starts",
            "from the start of service on"
          ],
          "answer": 0,
          "explanation": "önce means “before.” The start of service is still ahead."
        },
        {
          "id": "2",
          "prompt": "Misafirlerin gelişinden sonra",
          "say": "Misafirlerin gelişinden sonra",
          "options": [
            "before the guests arrive",
            "after the guests arrive",
            "from the guests' arrival on"
          ],
          "answer": 1,
          "explanation": "sonra means “after.” The guests have arrived, then one thing happened."
        },
        {
          "id": "3",
          "prompt": "Toplantının başlamasından itibaren",
          "say": "Toplantının başlamasından itibaren",
          "options": [
            "before the meeting starts",
            "a minute after the meeting",
            "from the start of the meeting, the whole time after"
          ],
          "answer": 2,
          "explanation": "itibaren means “from this moment on.” No break."
        }
      ]
    },
