      "instruction": "Pick the form",
      "items": [
        {
          "id": "1",
          "prompt": "uyu + “before”",
          "say": "uyumadan önce",
          "options": [
            "uyumadan önce",
            "uyumaktan önce",
            "uyudan önce"
          ],
          "answer": 0,
          "explanation": "For “before”: verb + madan + önce. Vowel u → -madan."
        },
        {
          "id": "2",
          "prompt": "gel + “after”",
          "say": "geldikten sonra",
          "options": [
            "geldikten sonra",
            "gelmeden sonra",
            "geldiktan sonra"
          ],
          "answer": 0,
          "explanation": "gel: voiced l → d, vowel e → -dikten."
        },
        {
          "id": "3",
          "prompt": "yap + “after”",
          "say": "yaptıktan sonra",
          "options": [
            "yapdıktan sonra",
            "yaptıktan sonra",
            "yaptikten sonra"
          ],
          "answer": 1,
          "explanation": "p is voiceless → t. Vowel a → ı: yaptıktan."
        },
        {
          "id": "4",
          "prompt": "ye + “before”",
          "say": "yemeden önce",
          "options": [
            "yemeden önce",
            "yemadan önce",
            "yedikten önce"
          ],
          "answer": 0,
          "explanation": "Vowel e → -meden. And “before” always comes with önce."
        },
        {
          "id": "5",
          "prompt": "“Before leaving the house”",
          "say": "evden çıkmadan önce",
          "options": [
            "evden çıktıktan sonra",
            "evden çıkmadan önce",
            "evden çıkmıyor önce"
          ],
          "answer": 1,
          "explanation": "“Before” = -madan önce. Çıkmıyor means “I’m not going out.”"
        }
      ]
    },
