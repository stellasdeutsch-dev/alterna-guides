      "items": [
        { "id": "1", "prompt": "У меня есть машина →", "say": "Arabam var.", "options": ["Arabam var.", "Ben araba var.", "Araban var."], "answer": 0, "explanation": "Моя машина есть: araba + m + var. «Ben» не нужен." },
