{
  "topic": "a1.possession-var",
  "exercises": [
    {
      "id": "a1.possession-var.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Choose how to say it",
      "items": [
        {
          "id": "1",
          "prompt": "I have a car →",
          "say": "Arabam var.",
          "options": [
            "Arabam var.",
            "Ben var araba.",
            "Araban var."
          ],
          "answer": 0,
          "explanation": "Tag on the thing, var at the end: araba + m + var. Not “I have a car” word by word."
        },
        {
          "id": "2",
          "prompt": "You have a house →",
          "say": "Evin var.",
          "options": [
            "Evim var.",
            "Evin var.",
            "Sen ev var."
          ],
          "answer": 1,
          "explanation": "Your thing gets the tag -in: evin var."
        },
        {
          "id": "3",
          "prompt": "We have no money →",
          "say": "Paramız yok.",
          "options": [
            "Paramız var.",
            "Biz para yok.",
            "Paramız yok."
          ],
          "answer": 2,
          "explanation": "Our tag: -mız. None — yok."
        },
        {
          "id": "4",
          "prompt": "Arabası var. →",
          "say": "Arabası var.",
          "options": [
            "He/She has a car.",
            "I have a car.",
            "You have a car."
          ],
          "answer": 0,
          "explanation": "The tag -sı means “his” or “her.” Turkish doesn't mark he or she."
        },
        {
          "id": "5",
          "prompt": "Do you have a passport? (formal) →",
          "say": "Pasaportunuz var mı?",
          "options": [
            "Pasaportum var mı?",
            "Pasaportunuz var mı?",
            "Siz pasaport var mı?"
          ],
          "answer": 1,
          "explanation": "The formal “your” tag: -unuz. Question: var mı."
        }
      ]
    },
    {
