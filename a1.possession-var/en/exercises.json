          "id": "3",
          "type": "true_false",
          "statement": "“Sorun yok” means “no problem.”",
          "answer": true,
          "explanation": "Sorun — problem, yok — none."
        },
        {
          "id": "4",
          "type": "build_sentence",
          "translation": "Do you have time?",
          "words": [
            "Zamanın",
            "var",
            "mı?"
          ],
          "distractors": [
            "Zamanım",
            "sen"
          ],
          "explanation": "Your tag: zamanın. Then var mı."
        },
        {
