      "instruction": "Quick check",
      "items": [
        {
          "id": "1",
          "type": "multiple_choice",
          "prompt": "bekle (to wait, to expect) → “he was expected”",
          "say": "beklendi",
          "options": [
            "beklendi",
            "bekleldi",
            "beklindi"
          ],
          "answer": 0,
          "explanation": "bekle ends in the vowel e → just n: beklendi."
        },
        {
          "id": "2",
          "type": "true_false",
          "statement": "“The bridge was built by the architect” = Köprü mimar ile yapıldı.",
          "answer": false,
          "explanation": "Ile means “together with.” For “by,” formal Turkish uses tarafından: Köprü mimar tarafından yapıldı. Usually the doer is simply dropped."
        },
        {
          "id": "3",
          "type": "multiple_choice",
          "prompt": "How do you say “The window was broken”?",
          "options": [
            "Pencereyi kırıldı.",
            "Pencere kırıldı.",
            "Pencere kırdı."
          ],
          "answer": 1,
          "explanation": "The object loses -yi, the verb is kır + ıl + dı: Pencere kırıldı."
        },
        {
          "id": "4",
          "type": "gap_fill",
          "text": "Fotoğraf ___. (sil — to delete)",
          "answers": [
            [
              "silindi"
            ]
          ],
          "options": [
            [
              "silindi",
              "sildi",
              "silildi"
            ]
          ],
          "translation": "The photo was deleted.",
          "explanation": "sil ends in l → -in-: silindi."
        },
        {
          "id": "5",
          "type": "true_false",
          "statement": "“Kitap okudu” means “The book was read.”",
          "answer": false,
          "explanation": "Without n the book does the reading. Correct: Kitap okundu."
        }
      ]
    },
    {
      "id": "b2.passive.ex5",
      "lesson": 2,
      "kind": "practice",
      "skill": "grammar",
      "type": "true_false",
      "difficulty": 1,
      "instruction": "True or false?",
      "items": [
        {
          "id": "1",
          "statement": "temizle → temizleniyor: “it's being cleaned now”",
          "say": "temizleniyor",
          "answer": true,
          "explanation": "Stem temizlen + iyor. Now, and no doer."
        },
        {
          "id": "2",
          "statement": "iptal et → iptal etildi",
          "answer": false,
          "explanation": "t between vowels sounds like d: iptal edildi."
        },
        {
          "id": "3",
          "statement": "“Araba yıkandı” — the car washed itself.",
          "answer": false,
          "explanation": "Cars don't wash themselves. Here -n- is passive: the car was washed."
        },
        {
          "id": "4",
          "statement": "“Burada sigara içilmiyor” — no smoking here.",
          "say": "Burada sigara içilmiyor.",
          "answer": true,
          "explanation": "iç + il + mi + yor: nobody in particular, just a rule."
        },
        {
          "id": "5",
          "statement": "oku → okunıyor",
          "answer": false,
          "explanation": "After u the vowel is u too: okunuyor."
        }
      ]
    },
