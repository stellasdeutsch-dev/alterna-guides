{
  "topic": "b2.passive",
  "exercises": [
    {
      "id": "b2.passive.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Pick the passive form",
      "items": [
        {
          "id": "1",
          "prompt": "yap → “it was done”",
          "say": "yapıldı",
          "options": [
            "yapıldı",
            "yapındı",
            "yaptı"
          ],
          "answer": 0,
          "explanation": "yap ends in the consonant p → -ıl-: yapıldı. Yaptı is “he did,” the doer is in the shot."
        },
        {
          "id": "2",
          "prompt": "oku → “it was read”",
          "say": "okundu",
          "options": [
            "okuldu",
            "okundu",
            "okudu"
          ],
          "answer": 1,
          "explanation": "After a vowel, only n: okundu. Okuldu means “it was a school.”"
        },
        {
          "id": "3",
          "prompt": "al → “it was bought”",
          "say": "alındı",
          "options": [
            "alıldı",
            "aldı",
            "alındı"
          ],
          "answer": 2,
          "explanation": "A verb ending in l takes -ın-: alındı. Two l's in a row don't work."
        },
        {
          "id": "4",
          "prompt": "sev → “it was loved”",
          "say": "sevildi",
          "options": [
            "sevildi",
            "sevindi",
            "sevdi"
          ],
          "answer": 0,
          "explanation": "v is a consonant, so -il-: sevildi. Sevindi is a different word: “was glad.”"
        },
        {
          "id": "5",
          "prompt": "“The ticket wasn't bought.” Which one is Turkish?",
          "say": "Bilet alınmadı.",
          "options": [
            "Bilet alınmadı.",
            "Bilet alındı değil.",
            "Bilet değil alındı."
          ],
          "answer": 0,
          "explanation": "English adds “not” after “was.” Turkish puts -ma- inside the verb: al + ın + ma + dı. Değil doesn't negate verbs."
        }
      ]
    },
    {
      "id": "b2.passive.ex2",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "sort_buckets",
      "difficulty": 1,
      "instruction": "Sort the verbs by their way into the passive",
      "items": [
        {
          "id": "1",
          "buckets": [
            {
              "id": "il",
              "label": "+ -Il-"
            },
            {
              "id": "n",
              "label": "+ -n-"
            },
            {
              "id": "in",
              "label": "+ -In-"
            }
          ],
          "entries": [
            {
              "text": "yaz",
              "bucket": "il"
            },
            {
              "text": "oku",
              "bucket": "n"
            },
            {
              "text": "al",
              "bucket": "in"
            },
            {
              "text": "aç",
              "bucket": "il"
            },
            {
              "text": "temizle",
              "bucket": "n"
            },
            {
              "text": "bul",
              "bucket": "in"
            },
            {
              "text": "bekle",
              "bucket": "n"
            },
            {
              "text": "sil",
              "bucket": "in"
            }
          ],
          "explanation": "Look at the last letter. Vowel → -n-. The letter l → -In-. Any other consonant → -Il-."
        }
      ]
    },
    {
      "id": "b2.passive.ex3",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "mixed",
      "difficulty": 2,
      "instruction": "Build it, spot the error, fill it in",
      "items": [
        {
          "id": "1",
          "type": "build_sentence",
          "translation": "The bridge was built in 1973.",
          "words": [
            "Köprü",
            "1973'te",
            "yapıldı."
          ],
          "distractors": [
            "Köprüyü",
            "yapındı."
          ],
          "explanation": "The object loses -yü: köprü. Verb: yap + ıl + dı."
        },
        {
          "id": "2",
          "type": "error_hunt",
          "prompt": "Spot the error",
          "tokens": [
            "Kitabı",
            "üç",
            "dile",
            "çevrildi."
          ],
          "wrong": 0,
          "fix": "Kitap",
          "options": [
            "Kitap",
            "Kitaba"
          ],
          "explanation": "In the passive the object becomes the main character. The accusative tail drops off: kitap."
        },
        {
          "id": "3",
          "type": "gap_fill",
          "text": "Telefonum ___. (çal — to steal)",
          "answers": [
            [
              "çalındı"
            ]
          ],
          "translation": "My phone was stolen.",
          "explanation": "çal ends in l → -ın-: çalındı."
        },
        {
          "id": "4",
          "type": "gap_fill",
          "text": "Bu ev geçen yıl ___. (sat — to sell)",
          "answers": [
            [
              "satıldı"
            ]
          ],
          "translation": "This house was sold last year.",
          "explanation": "sat ends in a consonant → -ıl-: satıldı."
        },
        {
          "id": "5",
          "type": "build_sentence",
          "translation": "My room was cleaned.",
          "words": [
            "Odam",
            "temizlendi."
          ],
          "distractors": [
            "Odamı",
            "temizlindi."
          ],
          "explanation": "temizle ends in a vowel → just n: temizlendi. Odamı → odam."
        }
      ]
    },
    {
      "id": "b2.passive.ex4",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "custom",
      "difficulty": 2,
      "instruction": "Editing room: cut the doer",
      "description": "The film shows an active sentence. The learner picks what the shot becomes without the doer: passive, object without the accusative. The logic is in index.html.",
      "items": [
        {
          "id": "1",
          "active": "Garson masayı temizledi.",
          "doer": "Garson",
          "ru": "The waiter wiped the table.",
          "options": [
            "Masa temizlendi.",
            "Masayı temizlendi.",
            "Masa temizledi."
          ],
          "answer": 0,
          "explanation": "The doer is gone, the table is the main character: masa. temizle + n + di = temizlendi."
        },
        {
          "id": "2",
          "active": "Polis cüzdanı buldu.",
          "doer": "Polis",
          "ru": "The police found the wallet.",
          "options": [
            "Cüzdan buldu.",
            "Cüzdan bulundu.",
            "Cüzdan bulıldı."
          ],
          "answer": 1,
          "explanation": "bul ends in l → -un-: bulundu. “Cüzdan buldu” — the wallet found something on its own."
        },
        {
          "id": "3",
          "active": "Hırsız arabayı çaldı.",
          "doer": "Hırsız",
          "ru": "A thief stole the car.",
          "options": [
            "Araba çalındı.",
            "Arabayı çalındı.",
            "Araba çalıldı."
          ],
          "answer": 0,
          "explanation": "çal ends in l → -ın-. And the object loses -yı: araba."
        },
        {
          "id": "4",
          "active": "Öğrenciler kitabı okudu.",
          "doer": "Öğrenciler",
          "ru": "The students read the book.",
          "options": [
            "Kitap okudu.",
            "Kitap okuldu.",
            "Kitap okundu."
          ],
          "answer": 2,
          "explanation": "oku ends in a vowel → n: okundu. “Kitap okudu” — the book did the reading."
        },
        {
          "id": "5",
          "active": "Mimar köprüyü yaptı.",
          "doer": "Mimar",
          "ru": "An architect built the bridge.",
          "options": [
            "Köprü yapıldı.",
            "Köprü yapındı.",
            "Köprüyü yapıldı."
          ],
          "answer": 0,
          "explanation": "yap ends in a consonant → -ıl-. Köprüyü → köprü."
        }
      ]
    },
    {
      "id": "b2.passive.check1",
      "lesson": 1,
      "kind": "check",
      "skill": "grammar",
