            { "text": "oku", "bucket": "n" },
            { "text": "al", "bucket": "in" },
            { "text": "aç", "bucket": "il" },
            { "text": "temizle", "bucket": "n" },
            { "text": "bul", "bucket": "in" },
            { "text": "bekle", "bucket": "n" },
            { "text": "sil", "bucket": "in" }
          ],
          "explanation": "Смотри на последнюю букву. Гласная → -n-. Буква l → -In-. Другая согласная → -Il-."
        }
      ]
    },
