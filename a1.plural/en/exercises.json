      "id": "a1.plural.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Which bag? Look at the last vowel",
      "items": [
        {
          "id": "1",
          "prompt": "çay → many",
          "say": "çaylar",
          "options": [
            "çaylar",
            "çayler"
          ],
          "answer": 0,
          "explanation": "çay has just one vowel - a. So the bag is -lar: çaylar."
        },
        {
          "id": "2",
          "prompt": "ekmek → many",
          "say": "ekmekler",
          "options": [
            "ekmeklar",
            "ekmekler"
          ],
          "answer": 1,
          "explanation": "The last vowel is e. Cashier e hands out the -ler bag: ekmekler."
        },
        {
          "id": "3",
          "prompt": "çocuk → many (children)",
          "say": "çocuklar",
          "options": [
            "çocukler",
            "çocuklar"
          ],
          "answer": 1,
          "explanation": "No “children” tricks in Turkish. Just add the bag. The last vowel is u - so -lar: çocuklar."
        },
        {
          "id": "4",
          "prompt": "simit → many",
          "say": "simitler",
          "options": [
            "simitler",
            "simits"
          ],
          "answer": 0,
          "explanation": "Turkish has no -s plural. The last vowel is i - from the e i ö ü crowd - bag -ler: simitler."
        }
      ]
    },
