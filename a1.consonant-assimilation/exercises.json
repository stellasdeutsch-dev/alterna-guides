        { "id": "i3", "tokens": ["Annem", "denizte,", "babam", "parkta."], "wrong": 1, "fix": "denizde,", "options": ["denizde,", "denizte,", "denizda,"], "say": "Annem denizde, babam parkta.", "explanation": "z звонкая, её нет в клубе. Оглушать нечего: denizde." },
        { "id": "i4", "tokens": ["Bu", "film", "Türkce."], "wrong": 2, "fix": "Türkçe.", "options": ["Türkçe.", "Türkce.", "Türkça."], "say": "Bu film Türkçe.", "explanation": "c тоже снимает голос после k: Türkçe." },
        { "id": "i5", "tokens": ["Biz", "sınıfda,", "onlar", "bahçede."], "wrong": 1, "fix": "sınıfta,", "options": ["sınıfta,", "sınıfte,", "sınıfda,"], "say": "Biz sınıfta, onlar bahçede.", "explanation": "f — первая буква клуба Fıstıkçı Şahap. d → t: sınıfta." }
      ]
