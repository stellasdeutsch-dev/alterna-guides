        { "id": "i3", "text": "Sınıf üçüncü kat___.", "translation": "Класс на третьем этаже.", "answers": [["ta"]], "options": [["da", "ta", "de", "te"]], "say": "Sınıf üçüncü katta.", "explanation": "t в клубе глухих: katta. Гласная a — значит -ta." },
        { "id": "i4", "text": "Emre Kadıköy'___.", "translation": "Эмре в Кадыкёе.", "answers": [["de"]], "options": [["da", "ta", "de", "te"]], "say": "Emre Kadıköy'de.", "explanation": "y звонкая, d остаётся. Последняя гласная ö — значит -de." },
        { "id": "i5", "text": "Annem market___.", "translation": "Мама в магазине.", "answers": [["te"]], "options": [["da", "ta", "de", "te"]], "say": "Annem markette.", "explanation": "t глухая: d → t. Гласная e: markette." },
        { "id": "i6", "text": "Bu kitap Türk___.", "translation": "Эта книга на турецком.", "answers": [["çe"]], "options": [["ca", "ça", "ce", "çe"]], "say": "Bu kitap Türkçe.", "explanation": "k в клубе: c → ç. Гласная ü — значит -çe: Türkçe." }
      ]
    },
