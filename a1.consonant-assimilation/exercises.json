      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Узнай форму. Где аффикс стоит правильно?",
      "items": [
        { "id": "i1", "prompt": "в школе", "options": ["okulda", "okulta"], "answer": 0, "say": "okulda", "explanation": "Последняя буква l. Её нет в клубе Fıstıkçı Şahap, поэтому d остаётся: okulda." },
        { "id": "i2", "prompt": "в книге", "options": ["kitapda", "kitapta", "kitapte"], "answer": 1, "say": "kitapta", "explanation": "p в клубе глухих: d → t. Гласная a, значит -ta: kitapta." },
        { "id": "i3", "prompt": "в автобусе", "options": ["otobüsde", "otobüsta", "otobüste"], "answer": 2, "say": "otobüste", "explanation": "s глухая: d → t. Последняя гласная ü, значит -te: otobüste." },
        { "id": "i4", "prompt": "в море", "options": ["denizte", "denizde"], "answer": 1, "say": "denizde", "explanation": "z жужжит, она звонкая. В клуб не входит, d остаётся: denizde." },
        { "id": "i5", "prompt": "на работе", "options": ["işde", "işte"], "answer": 1, "say": "işte", "explanation": "ş в клубе глухих: d → t. işte." },
        { "id": "i6", "prompt": "в Бешикташе", "options": ["Beşiktaş'da", "Beşiktaş'ta"], "answer": 1, "say": "Beşiktaş'ta", "explanation": "Апостроф не защищает. Последняя буква ş — глухая: Beşiktaş'ta." }
      ]
    },
    {
      "id": "a1.consonant-assimilation.ex2",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "sort_buckets",
      "difficulty": 1,
      "instruction": "Разложи слова: какой аффикс места они возьмут?",
      "items": [
        {
          "id": "i1",
          "buckets": [{ "id": "d", "label": "-da / -de" }, { "id": "t", "label": "-ta / -te" }],
