      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Spot the form. Where is the suffix right?",
      "items": [
        {
          "id": "i1",
          "prompt": "at school",
          "options": [
            "okulda",
            "okulta"
          ],
          "answer": 0,
          "say": "okulda",
          "explanation": "The last letter is l. It’s not in the Fıstıkçı Şahap club, so d stays: okulda."
        },
        {
          "id": "i2",
          "prompt": "in the book",
          "options": [
            "kitapda",
            "kitapta",
            "kitapte"
          ],
          "answer": 1,
          "say": "kitapta",
          "explanation": "p is in the voiceless club: d → t. The vowel is a, so -ta: kitapta."
        },
        {
          "id": "i3",
          "prompt": "on the bus",
          "options": [
            "otobüsde",
            "otobüsta",
            "otobüste"
          ],
          "answer": 2,
          "say": "otobüste",
          "explanation": "s is voiceless: d → t. The last vowel is ü, so -te: otobüste."
        },
        {
          "id": "i4",
          "prompt": "in the sea",
          "options": [
            "denizte",
            "denizde"
          ],
          "answer": 1,
          "say": "denizde",
          "explanation": "z buzzes, it’s voiced. It doesn’t get into the club, d stays: denizde."
        },
        {
          "id": "i5",
          "prompt": "at work",
          "options": [
            "işde",
            "işte"
          ],
          "answer": 1,
          "say": "işte",
          "explanation": "ş is in the voiceless club: d → t. işte."
        },
        {
          "id": "i6",
          "prompt": "in Beşiktaş",
          "options": [
            "Beşiktaş'da",
            "Beşiktaş'ta"
          ],
          "answer": 1,
          "say": "Beşiktaş'ta",
          "explanation": "The apostrophe doesn’t protect anything. The last letter ş is voiceless: Beşiktaş'ta."
        }
      ]
    },
