      "id": "a1.de-da.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Pick the right way to say “too”",
      "items": [
        {
          "id": "1",
          "prompt": "Bir çay, lütfen. — Me too!",
          "say": "Ben de!",
          "options": [
            "Ben de!",
            "Ve ben!",
            "Bende!"
          ],
          "answer": 0,
          "explanation": "“Me too” is Ben de. “And me!” works in English, but ve only joins words. And bende means “on me,” as in “I have it.”"
        },
        {
          "id": "2",
          "prompt": "Ayşe öğretmen. Ali ___ öğretmen.",
          "say": "Ayşe öğretmen. Ali de öğretmen.",
          "options": [
            "de",
            "da",
            "te"
          ],
          "answer": 0,
          "explanation": "In Ali the last vowel is i. Front — so de."
        },
        {
          "id": "3",
          "prompt": "Ben öğrenci değilim. — Me neither!",
          "say": "Ben öğrenci değilim. Ben de!",
          "options": [
            "Ben de!",
            "Ben da!",
            "Ve ben!"
          ],
          "answer": 0,
          "explanation": "English switches to “neither” after “not.” Turkish doesn’t switch: it’s still Ben de. Ben has e — so de."
        },
        {
          "id": "4",
          "prompt": "Kahve güzel. Çay ___ güzel.",
          "say": "Kahve güzel. Çay da güzel.",
          "options": [
            "da",
            "de",
            "ta"
          ],
          "answer": 0,
          "explanation": "The balloon looks at the word right before it — çay. That has a, so da. Kahve has nothing to do with it."
        }
      ]
    },
