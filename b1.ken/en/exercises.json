    {
      "id": "b1.ken.ex1",
      "topic": "b1.ken",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "What does the ken form mean?",
      "items": [
        {
          "id": "1",
          "prompt": "öğrenciyken",
          "options": [
            "when I was a student",
            "students",
            "I'll become a student"
          ],
          "answer": 0,
          "say": "öğrenciyken",
          "explanation": "öğrenci — student, ken — “when, while being.” While a student."
        },
        {
          "id": "2",
          "prompt": "evdeyken",
          "options": [
            "from home",
            "when at home",
            "(to) home"
          ],
          "answer": 1,
          "say": "evdeyken",
          "explanation": "evde — at home. Plus y, plus ken. While at home."
        },
        {
          "id": "3",
          "prompt": "gelirken",
          "options": [
            "came",
            "come (you all)",
            "on the way, while coming"
          ],
          "answer": 2,
          "say": "gelirken",
          "explanation": "gel + ir + ken. Verb in progress: while you're coming."
        },
        {
          "id": "4",
          "prompt": "Türkçe bilmezken",
          "options": [
            "not knowing Turkish",
            "knowing Turkish",
            "in order to know Turkish"
          ],
          "answer": 0,
          "say": "Türkçe bilmezken",
          "explanation": "bil + mez + ken. Negation: not knowing."
        }
      ]
    },
    {
      "id": "b1.ken.ex2",
      "topic": "b1.ken",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "sort_buckets",
      "difficulty": 1,
      "instruction": "Sort the words: what goes before ken?",
      "items": [
        {
          "id": "1",
          "buckets": [
            {
              "id": "k",
              "label": "+ken"
            },
            {
              "id": "yk",
              "label": "+yken"
            }
          ],
          "entries": [
            {
              "text": "çocuk",
              "bucket": "k"
            },
            {
              "text": "hasta",
              "bucket": "yk"
            },
            {
              "text": "genç",
              "bucket": "k"
            },
            {
              "text": "evde",
              "bucket": "yk"
            },
            {
              "text": "yorgun",
              "bucket": "k"
            },
            {
              "text": "öğrenci",
              "bucket": "yk"
            },
            {
              "text": "küçük",
              "bucket": "k"
            },
            {
              "text": "okulda",
              "bucket": "yk"
            }
          ],
          "explanation": "Look at the last letter. Vowel — you need the buffer y. Consonant — straight to ken."
        }
      ]
    },
    {
      "id": "b1.ken.ex3",
      "topic": "b1.ken",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "gap_fill",
      "difficulty": 2,
      "instruction": "Fill in the right ending.",
      "items": [
        {
          "id": "1",
          "text": "Küçük___ Antalya'da yaşıyordum.",
          "answers": [
            [
              "ken"
            ]
          ],
          "options": [
            [
              "ken",
              "yken",
              "kan"
            ]
          ],
          "translation": "When I was little, I lived in Antalya.",
          "say": "Küçükken Antalya'da yaşıyordum.",
          "explanation": "küçük ends in k. Consonant — just ken."
        },
        {
          "id": "2",
          "text": "Hasta___ evde kaldım.",
          "answers": [
            [
              "yken"
            ]
          ],
          "options": [
            [
              "ken",
              "yken",
              "ykan"
            ]
          ],
          "translation": "When I was sick, I stayed home.",
          "say": "Hastayken evde kaldım.",
          "explanation": "hasta ends in a. You need y. And no -kan."
        },
        {
          "id": "3",
          "text": "Sahilde yürü___ telefon çaldı.",
          "answers": [
            [
              "rken"
            ]
          ],
          "options": [
            [
              "ken",
              "rken",
              "yken"
            ]
          ],
          "translation": "While I was walking along the waterfront, the phone rang.",
          "say": "Sahilde yürürken telefon çaldı.",
          "explanation": "It's a verb. First the aorist -r, then ken."
        },
        {
          "id": "4",
          "text": "Okulda___ seni gördüm.",
          "answers": [
            [
              "yken"
            ]
          ],
          "options": [
            [
              "yken",
              "ykan",
              "ken"
            ]
          ],
          "translation": "When I was at school, I saw you.",
          "say": "Okuldayken seni gördüm.",
          "explanation": "Ken is stubborn: even after a it's still ken. And you need y."
        }
      ]
    },
    {
      "id": "b1.ken.ex4",
      "topic": "b1.ken",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "build_sentence",
      "difficulty": 2,
      "instruction": "Build the sentence.",
      "items": [
        {
          "id": "1",
          "translation": "On your way home, pick up some bread.",
          "words": [
            "Eve",
            "gelirken",
            "ekmek",
            "al"
          ],
          "distractors": [
            "gelken"
          ],
          "say": "Eve gelirken ekmek al.",
          "explanation": "gelirken: root gel, aorist ir, then ken. There's no such thing as gelken."
        },
        {
          "id": "2",
          "translation": "When I was a student, I read a lot of books.",
          "words": [
            "Öğrenciyken",
            "çok",
            "kitap",
            "okurdum"
          ],
          "distractors": [
            "öğrenciydimken"
          ],
          "say": "Öğrenciyken çok kitap okurdum.",
          "explanation": "öğrenci ends in i — you need y. Don't add past -dim like English “I was”: the tense comes from the verb okurdum."
        }
      ]
    },
    {
      "id": "b1.ken.ex5",
      "topic": "b1.ken",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "custom",
      "difficulty": 2,
      "instruction": "What goes before ken? Tap a part — the board flips.",
      "items": [
        {
          "id": "1",
          "word": "hasta",
          "answer": "y",
          "full": "hastayken",
          "ru": "when I was sick",
          "hint": "hasta — sick",
          "explanation": "After a vowel you need the buffer y."
        },
        {
          "id": "2",
          "word": "çocuk",
          "answer": "-",
          "full": "çocukken",
          "ru": "as a kid",
          "hint": "çocuk — child",
          "explanation": "After a consonant you need nothing."
        },
        {
          "id": "3",
          "word": "gel",
          "answer": "ir",
          "full": "gelirken",
          "ru": "on the way",
          "hint": "gel- — to come",
          "explanation": "The verb gel takes the aorist -ir."
        },
        {
          "id": "4",
          "word": "oku",
          "answer": "r",
          "full": "okurken",
          "ru": "while reading",
          "hint": "oku- — to read",
          "explanation": "Root ends in a vowel: the aorist is just -r."
        },
        {
          "id": "5",
          "word": "bil",
          "answer": "mez",
          "full": "bilmezken",
          "ru": "not knowing",
          "hint": "bil- — to know, but we need “not knowing”",
          "explanation": "Negation: -mez, then ken."
        },
        {
          "id": "6",
          "word": "okulda",
          "answer": "y",
          "full": "okuldayken",
          "ru": "when at school",
          "hint": "okulda — at school",
          "explanation": "Ends in a — you need y. Ken doesn't change."
        }
      ],
      "description": "Skate shop: the learner picks the part before ken (—, y, r, ir, mez)"
    },
