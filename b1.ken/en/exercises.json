        {
          "id": "2",
          "type": "true_false",
          "statement": "Eve gelirken uyudum means “When I got home, I slept.”",
          "answer": false,
          "explanation": "No. gelirken = on the way, still coming: “I slept on my way home.” Ken is only “while,” never “after.”"
        },
        {
          "id": "3",
          "type": "multiple_choice",
          "prompt": "Markete gitmişken ekmek de al.",
          "options": [
            "When you go to the store, buy bread",
