      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "What does the pair mean?",
      "items": [
        {
          "id": "1",
          "prompt": "Kitap mitap",
          "options": [
            "a book and a notebook",
            "books and stuff",
            "lots of books"
          ],
          "answer": 1,
          "explanation": "mitap is just an echo. Together: “books and whatnot.”"
        },
        {
          "id": "2",
          "prompt": "Aşağı yukarı on kişi",
          "options": [
            "about ten people",
            "ten people downstairs",
            "exactly ten"
          ],
          "answer": 0,
          "explanation": "Down plus up — “give or take,” “roughly.”"
        },
        {
          "id": "3",
          "prompt": "Bebek mışıl mışıl uyuyor.",
          "options": [
            "the baby is crying",
            "the baby is sleeping soundly",
            "the baby is awake"
          ],
          "answer": 1,
          "explanation": "mışıl mışıl is the sound of sweet sleep."
        },
        {
          "id": "4",
          "prompt": "Güle güle! Who do you say it to?",
          "options": [
            "someone who arrived",
            "someone who's leaving",
            "someone who's laughing"
          ],
          "answer": 1,
          "explanation": "Güle güle — to the one leaving. To the one staying, you say hoşça kal."
        }
      ]
    },
