      "difficulty": 1,
      "instruction": "Узнай эскиз",
      "items": [
        {
          "id": "1",
          "prompt": "Вчера я собирался тебе позвонить.",
          "options": ["Dün seni arayacağım.", "Dün seni arayacaktım.", "Dün seni aradım."],
          "answer": 1,
          "say": "Dün seni arayacaktım.",
          "explanation": "План был вчера и не сбылся. Нужна печать прошлого: arayacak + tı + m."
        },
        {
          "id": "2",
          "prompt": "gidecektik — кто собирался?",
          "options": ["я", "мы", "они"],
          "answer": 1,
          "explanation": "В конце -k. Это «мы»: gidecek-ti-k."
        },
        {
          "id": "3",
          "prompt": "Boyoz alacaktım ama bitti. Бойоз купили?",
          "options": ["Да", "Нет"],
          "answer": 1,
          "say": "Boyoz alacaktım ama bitti.",
          "explanation": "alacaktım — только собирался. А бойоз закончился. Эскиз остался эскизом."
        },
        {
          "id": "4",
          "prompt": "Как сказать «Мы собирались в кино»?",
          "options": ["Sinemaya gideceğiz.", "Sinemaya gittik.", "Sinemaya gidecektik."],
          "answer": 2,
          "say": "Sinemaya gidecektik.",
          "explanation": "gideceğiz — ещё пойдём. gittik — уже сходили. gidecektik — собирались."
        },
        {
          "id": "5",
          "prompt": "Какой кусок в «okuyacaktım» ставит печать прошлого?",
          "options": ["oku", "yacak", "tı", "m"],
          "answer": 2,
          "explanation": "oku — корень, yacak — план, tı — печать прошлого, m — «я»."
        }
      ]
    },
    {
      "id": "a2.future-past.ex2",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "sort_buckets",
      "difficulty": 2,
      "instruction": "Разложи по кадрам",
      "items": [
        {
          "id": "1",
          "buckets": [
            { "id": "did", "label": "Уже случилось" },
            { "id": "plan", "label": "Только собирался" },
            { "id": "fut", "label": "Ещё впереди" }
