          "entries": [
            { "text": "aradım", "bucket": "did" },
            { "text": "arayacaktım", "bucket": "plan" },
            { "text": "arayacağım", "bucket": "fut" },
            { "text": "gittik", "bucket": "did" },
            { "text": "gidecektik", "bucket": "plan" },
            { "text": "gideceğiz", "bucket": "fut" },
            { "text": "alacaktın", "bucket": "plan" },
            { "text": "aldın", "bucket": "did" }
          ],
          "explanation": "Только -DI — случилось. Только -AcAk — впереди. -AcAk и -tI вместе — собирался, но не случилось."
        }
      ]
    },
    {
