{
  "topic": "a2.future-past",
  "exercises": [
    {
      "id": "a2.future-past.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Spot the sketch",
      "items": [
        {
          "id": "1",
          "prompt": "Yesterday I was going to call you.",
          "options": [
            "Dün seni arayacağım.",
            "Dün seni arayacaktım.",
            "Dün seni aramaya gidiyordum."
          ],
          "answer": 1,
          "say": "Dün seni arayacaktım.",
          "explanation": "The plan was yesterday and it didn't happen: arayacak + tı + m. “aramaya gidiyordum” means you were on your way somewhere — “going to” is not gitmek."
        },
        {
          "id": "2",
          "prompt": "gidecektik — who was going to?",
          "options": [
            "I",
            "we",
            "they"
          ],
          "answer": 1,
          "explanation": "It ends in -k. That's “we”: gidecek-ti-k."
        },
        {
          "id": "3",
          "prompt": "Boyoz alacaktım ama bitti. Did the speaker get the boyoz?",
          "options": [
            "Yes",
            "No"
          ],
          "answer": 1,
          "say": "Boyoz alacaktım ama bitti.",
          "explanation": "alacaktım — only was going to. And the boyoz ran out. The sketch stayed a sketch."
        },
        {
          "id": "4",
          "prompt": "How do you say “We were going to go to the movies”?",
          "options": [
            "Sinemaya gideceğiz.",
            "Sinemaya gittik.",
            "Sinemaya gidecektik."
          ],
          "answer": 2,
          "say": "Sinemaya gidecektik.",
          "explanation": "gideceğiz — we'll still go. gittik — we already went. gidecektik — we were going to."
        },
        {
          "id": "5",
          "prompt": "Which piece of “okuyacaktım” puts the past stamp on it?",
          "options": [
            "oku",
            "yacak",
            "tı",
            "m"
          ],
          "answer": 2,
          "explanation": "oku — root, yacak — plan, tı — past stamp, m — “I.”"
        }
      ]
    },
    {
      "id": "a2.future-past.ex2",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "sort_buckets",
      "difficulty": 2,
      "instruction": "Sort into frames",
      "items": [
        {
          "id": "1",
          "buckets": [
            {
              "id": "did",
              "label": "Already happened"
            },
            {
              "id": "plan",
              "label": "Only was going to"
            },
            {
              "id": "fut",
              "label": "Still ahead"
            }
          ],
          "entries": [
            {
              "text": "aradım",
              "bucket": "did"
            },
            {
              "text": "arayacaktım",
              "bucket": "plan"
            },
            {
              "text": "arayacağım",
              "bucket": "fut"
            },
            {
              "text": "gittik",
              "bucket": "did"
            },
            {
              "text": "gidecektik",
              "bucket": "plan"
            },
            {
              "text": "gideceğiz",
              "bucket": "fut"
            },
            {
              "text": "alacaktın",
              "bucket": "plan"
            },
            {
              "text": "aldın",
              "bucket": "did"
            }
          ],
          "explanation": "Only -DI — it happened. Only -AcAk — it's ahead. -AcAk and -tI together — was going to, but didn't."
        }
      ]
    },
    {
      "id": "a2.future-past.ex3",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "mixed",
      "difficulty": 2,
      "instruction": "Build and fix",
      "items": [
        {
          "id": "1",
          "type": "gap_fill",
          "text": "Dün Kemeraltı'na ___ ama yoruldum. (gitmek, ben)",
          "answers": [
            [
              "gidecektim"
            ]
          ],
          "translation": "Yesterday I was going to go to Kemeraltı, but I got tired.",
          "explanation": "git gets voiced before a vowel: gid-ecek-ti-m."
        },
        {
          "id": "2",
          "type": "build_sentence",
          "translation": "I was going to buy boyoz, but it ran out.",
          "words": [
            "Boyoz",
            "alacaktım",
            "ama",
            "bitti."
          ],
          "distractors": [
            "alacağım"
          ],
          "explanation": "A plan in the past — alacaktım. alacağım means “I'll buy.”"
        },
        {
          "id": "3",
          "type": "error_hunt",
          "prompt": "Find the mistake",
          "tokens": [
            "Ben",
            "kitap",
            "okuacaktım."
          ],
          "wrong": 2,
          "fix": "okuyacaktım.",
          "options": [
            "okuyacaktım.",
            "okuacakdım."
          ],
          "explanation": "oku ends in a vowel. Two vowels can't sit side by side — you need y: okuyacaktım."
        },
        {
          "id": "4",
          "type": "build_sentence",
          "translation": "Were you going to help me?",
          "words": [
            "Bana",
            "yardım",
            "edecek",
            "miydin?"
          ],
          "distractors": [
            "edecektin"
          ],
          "explanation": "In a question mi breaks off and takes the past and the person with it: edecek miydin?"
        },
        {
          "id": "5",
          "type": "gap_fill",
          "text": "Bu sabah erken ___ ama uyudum. (kalkmak, ben)",
          "answers": [
            [
              "kalkacaktım"
            ]
          ],
          "translation": "This morning I was going to get up early, but I overslept.",
          "explanation": "The last vowel is a — so -acak and -tı: kalk-acak-tı-m."
        }
      ]
    },
    {
      "id": "a2.future-past.ex4",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "custom",
      "difficulty": 2,
      "instruction": "Editing: splice a frame from pieces",
      "description": "The learner picks a piece for each joint: root, plan, past stamp, person. The logic is in index.html.",
      "items": [
        {
          "id": "1",
          "ru": "I was going to go to Kemeraltı.",
          "slots": [
            [
              "git",
              "gid"
            ],
            [
              "ecek",
              "acak"
            ],
            [
              "ti",
              "di"
            ],
            [
              "m",
              "k"
            ]
          ],
          "answer": "gidecektim",
          "explanation": "git → gid before a vowel, e → -ecek, after k only -ti, “I” — -m."
        },
        {
          "id": "2",
          "ru": "We were going to take the ferry.",
          "slots": [
            [
              "bin"
            ],
            [
              "acak",
              "ecek"
            ],
            [
              "tı",
              "ti"
            ],
            [
              "k",
              "m"
            ]
          ],
          "answer": "binecektik",
          "explanation": "i is a front vowel: -ecek-ti. “We” — -k."
        },
        {
          "id": "3",
          "ru": "You were going to buy boyoz.",
          "slots": [
            [
              "al"
            ],
            [
              "acak",
              "ecek"
            ],
            [
              "dı",
              "tı"
            ],
            [
              "nız",
              "n"
            ]
          ],
          "answer": "alacaktın",
          "explanation": "a is a back vowel: -acak. After k — t: -tı. “You” — -n."
        },
        {
          "id": "4",
          "ru": "She was going to read.",
          "slots": [
            [
              "oku"
            ],
            [
              "acak",
              "yacak"
            ],
            [
              "tı",
              "ti"
            ],
            [
              "—",
              "m"
            ]
          ],
          "answer": "okuyacaktı",
          "explanation": "oku ends in a vowel — you need y. “She” has no ending."
        },
        {
          "id": "5",
          "ru": "You all were going to come.",
          "slots": [
            [
              "gel"
            ],
            [
              "ecek",
              "yecek"
            ],
            [
              "ti",
              "di"
            ],
            [
              "niz",
              "nız"
            ]
          ],
          "answer": "gelecektiniz",
          "explanation": "gel ends in a consonant — no y needed. Everything is front: -ecek-ti-niz."
        }
      ]
    },
    {
      "id": "a2.future-past.check1",
      "lesson": 1,
      "kind": "check",
      "skill": "grammar",
      "type": "mixed",
      "difficulty": 2,
      "passPercent": 80,
      "instruction": "Quick check",
      "items": [
        {
          "id": "1",
          "type": "multiple_choice",
          "prompt": "Yesterday we were going to meet at the Clock Tower.",
          "options": [
            "Dün Saat Kulesi'nde buluştuk.",
            "Dün Saat Kulesi'nde buluşacaktık.",
            "Dün Saat Kulesi'nde buluşacağız."
          ],
          "answer": 1,
          "say": "Dün Saat Kulesi'nde buluşacaktık.",
          "explanation": "Were going to, but didn't meet — plan plus past stamp: buluşacaktık."
        },
        {
          "id": "2",
          "type": "true_false",
          "statement": "“Gelecek miydin?” means “Were you going to come?”",
          "answer": true,
          "explanation": "mi stands alone, the past and the person moved over to it: miydin. It's a question about a past plan."
        },
        {
          "id": "3",
          "type": "gap_fill",
          "text": "Bir şey ___ ama unuttum. (demek, ben)",
          "answers": [
            [
              "diyecektim"
            ]
          ],
          "translation": "I was going to say something, but I forgot.",
          "explanation": "de narrows and gets a y: di-y-ecek-ti-m."
        },
        {
          "id": "4",
          "type": "multiple_choice",
          "prompt": "I wasn't going to buy anything.",
          "options": [
            "Bir şey almayacağım.",
            "Bir şey almayacaktım.",
            "Bir şey almacaktım."
          ],
          "answer": 1,
          "explanation": "Negation goes before the plan: al-ma-yacak-tı-m. After ma you can't do without y."
        },
        {
          "id": "5",
          "type": "multiple_choice",
          "prompt": "I almost missed the ferry. Az kalsın vapuru ___.",
          "options": [
            "kaçırdım",
            "kaçıracağım",
            "kaçıracaktım"
          ],
          "answer": 2,
          "explanation": "az kalsın + the same form = “almost.” English uses the past (I almost missed), Turkish uses the plan form: kaçıracaktım. kaçırdım would mean the ferry left without you."
        }
      ]
    }
  ]
}