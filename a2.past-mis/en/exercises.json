      "lesson": 2,
      "kind": "practice",
      "skill": "grammar",
      "type": "true_false",
      "difficulty": 1,
      "instruction": "True or false?",
      "items": [
        {
          "id": "1",
          "statement": "gelmemişim — “turns out I didn't come”",
          "answer": true,
          "explanation": "gel + me + miş + im: negation right after the root, then -miş and the ending."
        },
        {
          "id": "2",
          "statement": "bak + negation + mış → bakmemiş",
          "answer": false,
          "explanation": "The root has a — so it's ma, and after ma only mış: bakmamış."
        },
        {
          "id": "3",
          "statement": "“So you came, did you?” — gelmiş misin?",
          "answer": true,
          "explanation": "The sen ending moves onto the particle: gelmiş misin?"
        },
        {
          "id": "4",
          "statement": "“So they came, did they?” — gelmiş miler?",
          "answer": false,
          "explanation": "With onlar the ending stays on the verb: gelmişler mi?"
        }
      ]
    },
