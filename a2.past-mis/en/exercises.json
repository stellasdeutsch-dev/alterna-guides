{
  "topic": "a2.past-mis",
  "exercises": [
    {
      "id": "a2.past-mis.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Which tail sticks? Pick the form",
      "items": [
        {
          "id": "1",
          "prompt": "gel + mış → ?",
          "say": "gelmiş",
          "options": [
            "gelmış",
            "gelmiş",
            "gelmuş"
          ],
          "answer": 1,
          "explanation": "The last vowel of the root is e — so it's miş: gelmiş."
        },
        {
          "id": "2",
          "prompt": "oku + mış → ?",
          "say": "okumuş",
          "options": [
            "okumış",
            "okumiş",
            "okumuş"
          ],
          "answer": 2,
          "explanation": "The last vowel is u — so it's muş: okumuş. Don't spell it by ear."
        },
        {
          "id": "3",
          "prompt": "bak + mış → ?",
          "say": "bakmış",
          "options": [
            "baktmış",
            "bakmış",
            "bakmiş"
          ],
          "answer": 1,
          "explanation": "Vowel a — mış. And no devoicing: m stays m, bakmış."
        },
        {
          "id": "4",
          "prompt": "gör + mış → ?",
          "say": "görmüş",
          "options": [
            "görmüş",
            "görmiş",
            "görmuş"
          ],
          "answer": 0,
          "explanation": "The last vowel is ö — so it's müş: görmüş."
        }
      ]
    },
    {
      "id": "a2.past-mis.ex2",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "sort_buckets",
      "difficulty": 1,
      "instruction": "Sort the roots into four tails",
      "items": [
        {
          "id": "1",
          "buckets": [
            {
              "id": "mis-e",
              "label": "-miş"
            },
            {
              "id": "mis-a",
              "label": "-mış"
            },
            {
              "id": "mus",
              "label": "-muş"
            },
            {
              "id": "mus-o",
              "label": "-müş"
            }
          ],
          "entries": [
            {
              "text": "iç",
              "bucket": "mis-e"
            },
            {
              "text": "ye",
              "bucket": "mis-e"
            },
            {
              "text": "yap",
              "bucket": "mis-a"
            },
            {
              "text": "anla",
              "bucket": "mis-a"
            },
            {
              "text": "konuş",
              "bucket": "mus"
            },
            {
              "text": "unut",
              "bucket": "mus"
            },
            {
              "text": "gül",
              "bucket": "mus-o"
            },
            {
              "text": "dön",
              "bucket": "mus-o"
            }
          ],
          "explanation": "Look only at the last vowel of the root: e, i → miş; a, ı → mış; o, u → muş; ö, ü → müş."
        }
      ]
    },
    {
      "id": "a2.past-mis.ex3",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "mixed",
      "difficulty": 2,
      "instruction": "Persons, gaps and a whole sentence",
      "items": [
        {
          "id": "1",
          "type": "matching",
          "pairs": [
            {
              "left": "ben",
              "right": "gelmişim"
            },
            {
              "left": "sen",
              "right": "gelmişsin"
            },
            {
              "left": "biz",
              "right": "gelmişiz"
            },
            {
              "left": "onlar",
              "right": "gelmişler"
            }
          ],
          "explanation": "-mış takes long endings, like the present tense: -im, -sin, -iz, -ler."
        },
        {
          "id": "2",
          "type": "gap_fill",
          "text": "Sen dün İzmir'e gelmiş___.",
          "answers": [
            [
              "sin"
            ]
          ],
          "options": [
            [
              "sin",
              "im",
              "n"
            ]
          ],
          "translation": "They say you came to Izmir yesterday.",
          "explanation": "Sen → -sin. The short -n only goes with -dı: geldin."
        },
        {
          "id": "3",
          "type": "build_sentence",
          "translation": "They say Ali left for Izmir yesterday.",
          "words": [
            "Ali",
            "dün",
            "İzmir'e",
            "gitmiş."
          ],
          "distractors": [
            "gitti."
          ],
          "explanation": "“They say” — you didn't see it yourself, so it's -mış: gitmiş."
        }
      ]
    },
    {
      "id": "a2.past-mis.ex4",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "custom",
      "difficulty": 2,
      "instruction": "Witness or gossip: what do you send to the chat?",
      "description": "A chat with a friend from Izmir. The learner reads the situation and picks which line to send: with -dı (saw it myself) or with -mış (was told, turns out). The logic is in index.html.",
      "items": [
        {
          "id": "1",
          "context": "You're standing on the pier and you see it: the ferry has left.",
          "options": [
            "Vapur gitti.",
            "Vapur gitmiş."
          ],
          "answer": 0,
          "explanation": "You saw it with your own eyes — that's -dı."
        },
        {
          "id": "2",
          "context": "Your friend texts: a new café opened on the Kordon. You're still at home.",
          "options": [
            "Yeni bir kafe açtılar.",
            "Yeni bir kafe açmışlar."
          ],
          "answer": 1,
          "explanation": "You learned it from a message, didn't see it — that's -mış."
        },
        {
          "id": "3",
          "context": "You open the fridge. The börek is gone. Someone ate it!",
          "options": [
            "Biri böreğimi yedi!",
            "Biri böreğimi yemiş!"
          ],
          "answer": 1,
          "explanation": "You didn't see it happen, you found out from the result. Surprise — that's -mış."
        },
        {
          "id": "4",
          "context": "On the news: it rained hard in Izmir yesterday. You were in Istanbul.",
          "options": [
            "İzmir'de çok yağmur yağdı.",
            "İzmir'de çok yağmur yağmış."
          ],
          "answer": 1,
          "explanation": "You learned it from the news — reported, -mış."
        },
        {
          "id": "5",
          "context": "You went to the movies with friends yesterday. Yourself.",
          "options": [
            "Dün sinemaya gittim.",
            "Dün sinemaya gitmişim."
          ],
          "answer": 0,
          "explanation": "Your own ordinary experience — -dı. With -mış it sounds like amnesia."
        }
      ]
    },
    {
