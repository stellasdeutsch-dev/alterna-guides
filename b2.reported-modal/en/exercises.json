{
  "topic": "b2.reported-modal",
  "exercises": [
    {
      "id": "b2.reported-modal.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Spot the reported version",
      "items": [
        {
          "id": "1",
          "prompt": "The doctor said I need to rest.",
          "options": [
            "Doktor dinlenmen gerektiğini söyledi.",
            "Doktor dinlenmem gerektiğini söyledi.",
            "Doktor dinlenmem gerek söyledi."
          ],
          "answer": 1,
          "say": "Doktor dinlenmem gerektiğini söyledi.",
          "explanation": "The need is mine, so -m. And “need” turns into gerektiğini when you report it."
        },
        {
          "id": "2",
          "prompt": "Annem eve erken gelmemi istedi. Who has to come?",
          "options": [
            "mom",
            "me",
            "us"
          ],
          "answer": 1,
          "say": "Annem eve erken gelmemi istedi.",
          "explanation": "gelme-m-i: -m is “me.” Mom asked me."
        },
        {
          "id": "3",
          "prompt": "dinlenmesi gerektiğini — whose need is it?",
          "options": [
            "mine",
            "yours",
            "his or hers"
          ],
          "answer": 2,
          "explanation": "-si is third person: he or she needs to rest."
        },
        {
          "id": "4",
          "prompt": "The boss said I don't need to come. Patron gelmem ___ söyledi.",
          "options": [
            "gerektiğini",
            "gerekmediğini"
          ],
          "answer": 1,
          "say": "Patron gelmem gerekmediğini söyledi.",
          "explanation": "“No need” means the minus goes on gerek: gerekmediğini. You can come, there's just no point."
        },
        {
          "id": "5",
          "prompt": "Mom asked us to call.",
          "options": [
            "Annem aramamızı istedi.",
            "Annem aramamız istedi.",
            "Annem aramamızı gerektiğini istedi."
          ],
          "answer": 0,
          "say": "Annem aramamızı istedi.",
          "explanation": "After istedi you need the accusative: arama-mız-ı. No gerektiğini here."
        }
      ]
    },
    {
      "id": "b2.reported-modal.ex2",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "sort_buckets",
      "difficulty": 2,
      "instruction": "Whose need or request is it?",
      "items": [
        {
          "id": "1",
          "buckets": [
            {
              "id": "ben",
              "label": "mine"
            },
            {
              "id": "sen",
              "label": "yours"
            },
            {
              "id": "o",
              "label": "his / hers"
            }
          ],
          "entries": [
            {
              "text": "dinlenmem",
              "bucket": "ben"
            },
            {
              "text": "gelmemi",
              "bucket": "ben"
            },
            {
              "text": "dinlenmen",
              "bucket": "sen"
            },
            {
              "text": "gelmeni",
              "bucket": "sen"
            },
            {
              "text": "dinlenmesi",
              "bucket": "o"
            },
            {
              "text": "gelmesini",
              "bucket": "o"
            },
            {
              "text": "aramam",
              "bucket": "ben"
            },
            {
              "text": "araması",
              "bucket": "o"
            }
          ],
          "explanation": "Look at the tail after -mA: -m is me, -n is you, -sI is he or she. The -I at the end is the accusative."
        }
      ]
    },
