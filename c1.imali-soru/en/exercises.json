            {
              "text": "Haritayı sana göstermedim mi?",
              "bucket": "yes"
            },
            {
              "text": "Ben seni unutur muyum?",
              "bucket": "never"
            },
            {
              "text": "Annem bunu yer mi?",
              "bucket": "never"
