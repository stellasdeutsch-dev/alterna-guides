      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "What is your friend really saying?",
      "items": [
        {
          "prompt": "Seni uyarmadım mı?",
          "say": "Seni uyarmadım mı?",
          "options": [
            "I didn't warn you?",
            "I did warn you!",
            "Should I warn you?"
          ],
          "answer": 1,
          "explanation": "Negation plus mi means “I sure did warn you.” He's not asking. He's reminding."
        },
        {
          "prompt": "Ben senden para ister miyim?",
          "say": "Ben senden para ister miyim?",
          "options": [
            "Me, ask you for money? Never.",
            "I'm asking you for money.",
            "Can I ask you for money?"
          ],
          "answer": 0,
          "explanation": "No “not,” but there's mi. A plus in a question gives a minus: “I'd never ask.”"
        },
        {
          "prompt": "Biraz oturmaz mısın?",
          "say": "Biraz oturmaz mısın?",
          "options": [
            "You're not sitting?",
            "Sit a while, won't you?",
            "I won't sit."
          ],
          "answer": 1,
          "explanation": "-mAz mısın for “you” is a soft invitation. The negation here negates nothing."
        },
        {
          "prompt": "Güzel mi güzel!",
          "say": "Güzel mi güzel!",
          "options": [
            "Pretty or not?",
            "Not very pretty.",
            "So, so pretty!"
          ],
          "answer": 2,
          "explanation": "Word, mi, same word — it's a magnifying glass. Pretty becomes very pretty."
        },
        {
          "prompt": "Kapıyı açtım, karşımda patronum durmaz mı!",
          "say": "Kapıyı açtım, karşımda patronum durmaz mı!",
          "options": [
            "I open the door — and there's my boss!",
            "The boss isn't at the door?",
            "Boss, open the door!"
          ],
          "answer": 0,
          "explanation": "Start in the past, then -mAz mı! It's not a question, it's “and then suddenly.”"
        }
      ]
    },
