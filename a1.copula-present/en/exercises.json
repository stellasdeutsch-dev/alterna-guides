      "difficulty": 2,
      "instruction": "Taxi across Istanbul: buckle on the tail and the car moves",
      "description": "The taxi goes from stop to stop. The passenger says a phrase without a tail, the learner picks the tail out of four. Logic lives in index.html.",
      "items": [
        {
          "id": "1",
          "pron": "Ben",
          "word": "öğretmen",
          "ru": "I’m a teacher",
          "options": [
            "im",
            "ım",
            "sin",
            "iz"
          ],
          "answer": "im",
          "explanation": "“I” is the tail with m. The last vowel e gives i: öğretmenim."
        },
        {
          "id": "2",
          "pron": "Sen",
          "word": "hasta",
          "ru": "you’re sick",
          "options": [
            "sin",
            "yım",
            "sın",
            "yız"
          ],
          "answer": "sın",
          "explanation": "“You” is the tail s…n. The last vowel a gives ı: hastasın."
        },
        {
          "id": "3",
          "pron": "Biz",
          "word": "yorgun",
          "ru": "we’re tired",
          "options": [
            "um",
            "sunuz",
            "yuz",
            "uz"
          ],
          "answer": "uz",
          "explanation": "“We” is the tail with z. The word ends in a consonant, no buffer needed: yorgunuz."
        },
        {
          "id": "4",
          "pron": "Siz",
          "word": "Türk",
          "ru": "you’re Turks",
          "options": [
            "siniz",
            "sünüz",
            "üz",
            "ler"
          ],
          "answer": "sünüz",
          "explanation": "“You” (plural) is the tail s…n…z. The last vowel is ü: Türksünüz."
        },
        {
          "id": "5",
          "pron": "Onlar",
          "word": "mutlu",
          "ru": "they’re happy",
          "options": [
            "ler",
            "yuz",
            "lar",
            "sunuz"
          ],
          "answer": "lar",
          "explanation": "“They” is the tail -lar/-ler. The last vowel u is a back vowel: mutlular."
        }
      ]
    },
