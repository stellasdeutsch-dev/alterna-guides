  "topic": "a1.copula-present",
  "exercises": [
    {
      "id": "a1.copula-present.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Pick the form",
      "items": [
        {
          "id": "1",
          "prompt": "doktor → “I’m a doctor”",
          "say": "Ben doktorum.",
          "options": [
            "doktorum",
            "doktorim",
            "doktorüm"
          ],
          "answer": 0,
          "explanation": "The last vowel is o, so the tail has u: doktorum."
        },
        {
          "id": "2",
          "prompt": "hasta → “you’re sick”",
          "say": "Sen hastasın.",
          "options": [
            "hastayısın",
            "hastasın",
            "hastasin"
          ],
          "answer": 1,
          "explanation": "The tail -sın starts with a consonant, so no buffer y. And the vowel a gives ı."
        },
        {
          "id": "3",
          "prompt": "öğrenci → “we’re students”",
          "say": "Biz öğrenciyiz.",
          "options": [
            "öğrenciiz",
            "öğrencisiniz",
            "öğrenciyiz"
          ],
          "answer": 2,
          "explanation": "The word ends in a vowel, and the tail -iz starts with one too. The buffer y goes between them: öğrenciyiz."
        },
        {
          "id": "4",
          "prompt": "güzel → “she’s beautiful”",
          "say": "O güzel.",
          "options": [
            "güzelim",
            "güzel",
            "güzelsin"
          ],
          "answer": 1,
          "explanation": "“He, she” has no tail: O güzel."
        }
      ]
    },
    {
