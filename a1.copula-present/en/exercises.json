          "buckets": [
            {
              "id": "i1",
              "label": "-(y)ım"
            },
            {
              "id": "i2",
              "label": "-(y)im"
            },
            {
              "id": "u1",
              "label": "-(y)um"
            },
            {
              "id": "u2",
              "label": "-(y)üm"
            }
          ],
          "entries": [
            {
              "text": "hasta",
              "bucket": "i1"
            },
            {
              "text": "hazır",
              "bucket": "i1"
            },
            {
              "text": "öğretmen",
              "bucket": "i2"
            },
            {
              "text": "güzel",
              "bucket": "i2"
            },
            {
              "text": "yorgun",
              "bucket": "u1"
            },
            {
              "text": "mutlu",
              "bucket": "u1"
            },
            {
              "text": "Türk",
              "bucket": "u2"
            },
            {
              "text": "üzgün",
              "bucket": "u2"
            }
          ],
          "explanation": "Look only at the word’s last vowel: a ı → ı, e i → i, o u → u, ö ü → ü."
        }
      ]
    },
    {
      "id": "a1.copula-present.ex3",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "mixed",
      "difficulty": 2,
      "instruction": "Find the mistake, build it, and talk about yourself",
      "items": [
        {
          "id": "1",
          "type": "error_hunt",
          "prompt": "Find the mistake",
          "tokens": [
            "Sen",
            "çok",
            "yorgunsın."
          ],
          "wrong": 2,
          "fix": "yorgunsun.",
          "options": [
            "yorgunsun.",
            "yorgunsin."
          ],
          "explanation": "In yorgun the last vowel is u, so the tail gets u too: yorgunsun."
        },
        {
          "id": "2",
          "type": "error_hunt",
          "prompt": "Find the mistake",
          "tokens": [
            "Ben",
            "hastaım."
          ],
          "wrong": 1,
          "fix": "hastayım.",
          "options": [
            "hastayım.",
            "hastasın."
          ],
          "explanation": "Turks don’t like two vowels in a row: the buffer y goes between a and ı."
        },
        {
          "id": "3",
          "type": "build_sentence",
          "translation": "We’re students, but we’re tired.",
          "words": [
            "Biz",
            "öğrenciyiz",
            "ama",
            "yorgunuz."
          ],
          "distractors": [
            "öğrenciiz",
            "yorgunsunuz."
          ],
          "explanation": "“We” is the tail -iz/-uz. After the vowel i you need the buffer y: öğrenciyiz. yorgun + uz = yorgunuz."
        },
        {
          "id": "4",
          "type": "gap_fill",
          "text": "Ben ___. (öğretmen)",
          "answers": [
            [
              "öğretmenim"
            ]
          ],
          "translation": "I’m a teacher.",
          "explanation": "Last vowel e → tail -im: öğretmenim."
        },
        {
          "id": "5",
          "type": "gap_fill",
          "text": "Bugün ben ___. (mutlu)",
          "answers": [
            [
              "mutluyum"
            ]
          ],
          "translation": "I’m happy today.",
          "explanation": "mutlu ends in the vowel u: buffer y and the tail -um. You get mutluyum."
        }
      ]
    },
    {
