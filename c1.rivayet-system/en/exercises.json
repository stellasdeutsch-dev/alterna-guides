            ]
          ],
          "options": [
            [
              "koşarmış",
              "koşardı",
              "koşuyor"
            ]
          ],
          "translation": "They say Selin runs along the waterfront every morning.",
          "explanation": "A habit, secondhand: aorist + moss, koşarmış."
        },
        {
          "text": "Erken gelseymiş toplantıya ___.",
          "answers": [
            [
              "yetişirmiş"
            ]
          ],
          "options": [
