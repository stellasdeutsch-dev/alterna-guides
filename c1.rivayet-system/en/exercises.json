{
  "topic": "c1.rivayet-system",
  "exercises": [
    {
      "id": "c1.rivayet-system.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Pass on the news secondhand. Pick the form.",
      "items": [
        {
          "prompt": "They say the park will open in the summer: Park yazın ___",
          "options": [
            "açılacakmış",
            "açılacaktı",
            "açıldıymış"
          ],
          "answer": 0,
          "say": "Park yazın açılacakmış.",
          "explanation": "Future + the -mış moss: açılacakmış. Moss doesn’t grow on -DI."
        },
        {
          "prompt": "They say the city is building a new park: Belediye yeni bir park ___",
          "options": [
            "yapıyordu",
            "yapıyormuş",
            "yapmışmış"
          ],
          "answer": 1,
          "say": "Belediye yeni bir park yapıyormuş.",
          "explanation": "Present + moss: yapıyormuş. yapıyordu means “I saw it myself.”"
        },
        {
          "prompt": "Turns out I should have come earlier: Daha erken ___",
          "options": [
            "gelmeliydim",
            "gelmeliymişim",
            "gelmeliyim"
          ],
          "answer": 1,
          "say": "Daha erken gelmeliymişim.",
          "explanation": "“Turns out I should have” — -malıymışım. -malıydım means “I knew it myself.”"
        },
        {
          "prompt": "According to Ali, the meeting ended long ago: Ali'ye göre toplantı çoktan ___",
          "options": [
            "bitmişti",
            "bitmişmiş",
            "bitecekmiş"
          ],
          "answer": 1,
          "say": "Ali'ye göre toplantı çoktan bitmişmiş.",
          "explanation": "Long ago and according to Ali — double moss: bitmişmiş."
        }
      ]
    },
    {
      "id": "c1.rivayet-system.ex2",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "sort_buckets",
      "difficulty": 1,
      "instruction": "Sort them into beds: saw it myself or heard it secondhand.",
      "items": [
        {
          "buckets": [
            {
              "id": "d",
              "label": "saw it myself: -DI"
            },
            {
              "id": "m",
              "label": "secondhand: -mIş"
            }
          ],
          "entries": [
            {
              "text": "gelmişti",
              "bucket": "d"
            },
            {
              "text": "gelmeliydi",
              "bucket": "d"
            },
            {
              "text": "gelseydi",
              "bucket": "d"
            },
            {
              "text": "geliyordu",
              "bucket": "d"
            },
            {
              "text": "gelmişmiş",
              "bucket": "m"
            },
            {
              "text": "gelmeliymiş",
              "bucket": "m"
            },
            {
              "text": "gelseymiş",
              "bucket": "m"
            },
            {
              "text": "geliyormuş",
              "bucket": "m"
            }
          ],
          "explanation": "Look at the last chunk: -DI (du, ti, ydi) — saw it myself. -mIş (muş, miş, ymiş) — secondhand. The forms come in matching pairs."
        }
      ]
    },
    {
      "id": "c1.rivayet-system.ex3",
      "lesson": 1,
      "kind": "practice",
