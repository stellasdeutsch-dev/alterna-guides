      "difficulty": 1,
      "instruction": "Передай новость с чужих слов. Выбери форму.",
      "items": [
        {
          "prompt": "Говорят, парк откроется летом: Park yazın ___",
          "options": [
            "açılacakmış",
            "açılacaktı",
            "açıldıymış"
          ],
          "answer": 0,
          "say": "Park yazın açılacakmış.",
          "explanation": "Будущее время + мох -mış: açılacakmış. На -DI мох не растёт."
        },
        {
          "prompt": "Говорят, мэрия строит новый парк: Belediye yeni bir park ___",
          "options": [
            "yapıyordu",
            "yapıyormuş",
            "yapmışmış"
          ],
          "answer": 1,
          "say": "Belediye yeni bir park yapıyormuş.",
          "explanation": "Настоящее + мох: yapıyormuş. yapıyordu — «видел сам»."
        },
        {
          "prompt": "Оказывается, надо было прийти раньше: Daha erken ___",
          "options": [
            "gelmeliydim",
            "gelmeliymişim",
            "gelmeliyim"
          ],
          "answer": 1,
          "say": "Daha erken gelmeliymişim.",
          "explanation": "«Оказывается, надо было» — -malıymışım. -malıydım — «я и сам знал»."
        },
        {
          "prompt": "По словам Али, собрание давно закончилось: Ali'ye göre toplantı çoktan ___",
          "options": [
            "bitmişti",
            "bitmişmiş",
            "bitecekmiş"
          ],
          "answer": 1,
          "say": "Ali'ye göre toplantı çoktan bitmişmiş.",
          "explanation": "Давно и со слов Али — двойной мох: bitmişmiş."
        }
      ]
    },
