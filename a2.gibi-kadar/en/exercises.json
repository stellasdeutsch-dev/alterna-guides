      "difficulty": 1,
      "instruction": "Pick the Turkish sentence that means the same thing.",
      "items": [
        {
          "prompt": "Murat sleeps like a baby.",
          "options": [
            "Murat bebek gibi uyuyor.",
            "Murat bebek kadar uyuyor.",
            "Murat gibi bebek uyuyor."
          ],
          "answer": 0,
          "say": "Murat bebek gibi uyuyor.",
          "explanation": "He sleeps the way a baby sleeps — that’s a manner, so gibi. And gibi goes after the word: bebek gibi."
        },
        {
          "prompt": "The wall is as tall as Misha.",
          "options": [
            "Duvar Mişa gibi yüksek.",
            "Duvar Mişa kadar yüksek.",
            "Duvar kadar Mişa yüksek."
          ],
          "answer": 1,
          "say": "Duvar Mişa kadar yüksek.",
          "explanation": "“As tall as” is a measurement, so kadar. Watch the order: as tall as Misha → Mişa kadar yüksek. Misha first, then kadar, then tall."
        },
        {
          "prompt": "This ayran is ice-cold.",
          "options": [
            "Bu ayran buz gibi.",
            "Bu ayran buz kadar.",
            "Bu ayran gibi buz."
          ],
          "answer": 0,
          "say": "Bu ayran buz gibi.",
          "explanation": "The ayran is like ice — shape and look, so gibi: buz gibi."
        },
        {
          "prompt": "Gülay is as tall as you.",
          "options": [
            "Gülay sen kadar uzun.",
            "Gülay senin kadar uzun.",
            "Gülay kadar senin uzun."
          ],
          "answer": 1,
          "say": "Gülay senin kadar uzun.",
          "explanation": "Height is a measurement, so kadar. A pronoun before kadar takes the genitive: sen → senin."
        }
      ]
    },
