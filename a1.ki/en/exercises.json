          "answer": 1,
          "explanation": "Bugün is a cuckoo day: kü. And no -DA."
        },
        {
          "id": "4",
          "prompt": "And yours? →",
          "say": "seninki",
          "options": [
            "senki?",
            "seninki?",
            "senin?"
          ],
          "answer": 1,
          "explanation": "First “whose”: senin. Then the tag ki."
        },
        {
          "id": "5",
          "prompt": "The morning ferry →",
          "say": "sabahki vapur",
          "options": [
            "sabahki vapur",
            "sabahtaki vapur",
            "sabahkü vapur"
          ],
          "answer": 0,
          "explanation": "Time takes the tag without -DA. The cuckoo kü is only for bugün and dün."
        }
      ]
    },
