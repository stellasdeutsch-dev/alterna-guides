      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Who is this order for?",
      "items": [
        {
          "id": "1",
          "prompt": "Gelin.",
          "say": "Gelin.",
          "options": [
            "“you”: come",
            "“you, polite”: come",
            "“let him come”"
          ],
          "answer": 1,
          "explanation": "The -in tail is the politeness fee. So it’s polite “you.”"
        },
        {
          "id": "2",
          "prompt": "Otur.",
          "say": "Otur.",
          "options": [
            "“you”: sit down",
            "“you, polite”: sit down",
            "“let him sit down”"
          ],
          "answer": 0,
          "explanation": "A bare root, no tail. That’s plain “you.”"
        },
        {
          "id": "3",
          "prompt": "Beklesin.",
          "say": "Beklesin.",
          "options": [
            "“you”: wait",
            "“you, polite”: wait",
            "“let him wait”"
          ],
          "answer": 2,
          "explanation": "-sin means “let.” An order through a broker, to a third person."
        },
        {
          "id": "4",
          "prompt": "Gelmeyin.",
          "say": "Gelmeyin.",
          "options": [
            "“you, polite”: come",
            "“you, polite”: don’t come",
            "“let him not come”"
          ],
          "answer": 1,
          "explanation": "-me is the lock, the ban. Then the y bridge and -in. “Don’t come” (polite)."
        }
      ]
    },
