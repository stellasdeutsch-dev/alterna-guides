      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Find the hero: pick an answer.",
      "items": [
        {
          "id": "i1",
          "prompt": "Hesap Emre tarafından ödendi. Who paid?",
          "options": [
            "Emre",
            "The bill",
            "Unknown"
          ],
          "answer": 0,
          "say": "Hesap Emre tarafından ödendi.",
          "explanation": "Whoever stands before tarafından did it. Here that's Emre."
        },
        {
          "id": "i2",
          "prompt": "In which sentence can you see who did it?",
          "options": [
            "Karar bakanlıkça açıklandı.",
            "Karar dün açıklandı.",
            "Karar hemen açıklandı."
          ],
          "answer": 0,
          "say": "Karar bakanlıkça açıklandı.",
          "explanation": "bakanlıkça is “by the ministry.” The other sentences are passive with no hero."
        },
        {
          "id": "i3",
          "prompt": "Konser belediyece iptal edildi. How do you translate it?",
          "options": [
            "The concert was canceled by the city hall.",
            "The concert was canceled city-style.",
            "The concert will be canceled at city hall."
          ],
          "answer": 0,
          "say": "Konser belediyece iptal edildi.",
          "explanation": "Next to a passive and an institution, -CA means “by”: belediyece = belediye tarafından."
        },
        {
          "id": "i4",
          "prompt": "How do you say “by me”?",
          "options": [
            "benim tarafımdan",
            "ben tarafından",
            "benim tarafından"
          ],
          "answer": 0,
          "say": "benim tarafımdan",
          "explanation": "A pronoun needs a tail on taraf: benim taraf-ım-dan."
        }
      ]
    },
