  "exercises": [
    {
      "id": "b2.de-functions.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "What is de doing in this sentence?",
      "items": [
        {
          "prompt": "Sen de bekle.",
          "say": "Sen de bekle.",
          "options": [
            "You wait too",
            "Wait, and then…",
            "Come on, wait"
          ],
          "answer": 0,
          "explanation": "The pronoun sen comes before de — so it's “too”: “You wait too.”"
        },
        {
          "prompt": "Biraz bekle de birlikte çıkalım.",
          "say": "Biraz bekle de birlikte çıkalım.",
          "options": [
            "You wait too, we'll leave together",
            "Wait a bit, and we'll leave together",
            "Wait too together"
          ],
          "answer": 1,
          "explanation": "de comes after the command bekle — it's a link: “wait, and then we'll leave together.”"
        },
        {
          "prompt": "Söyle de bilelim!",
          "say": "Söyle de bilelim!",
          "options": [
            "You say it too, we know",
            "Come on, tell us already, we're waiting",
            "We'll say it too"
          ],
          "answer": 1,
          "explanation": "Command + de + bilelim (“let us know”) is a push: “come on, tell us already.”"
        },
        {
          "prompt": "Kapı da kilitli.",
          "say": "Kapı da kilitli.",
          "options": [
            "The door is locked too",
            "Lock the door, and then…",
            "Come on, lock the door"
          ],
          "answer": 0,
          "explanation": "The noun kapı comes before da — so it's “too”: “The door is locked too.”"
        }
      ]
    },
