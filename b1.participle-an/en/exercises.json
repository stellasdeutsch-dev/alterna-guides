    {
      "id": "b1.participle-an.ex5",
      "lesson": 2,
      "kind": "practice",
      "skill": "grammar",
      "type": "true_false",
      "difficulty": 1,
      "instruction": "True or false?",
      "items": [
        {
          "statement": "yüzmeyen means “the one who doesn't swim.”",
          "answer": true,
          "explanation": "yüz + me + y + en: -me- is the negation, then the fender y and the tail."
        },
        {
          "statement": "“The man who has a hat” is şapkası var adam.",
          "answer": false,
          "explanation": "var doesn't turn into a sign. You need olan: şapkası olan adam."
        },
        {
          "statement": "gelenler means “those who came.”",
          "answer": true,
          "explanation": "A sign with no word after it becomes a word itself and takes -ler."
        },
        {
          "statement": "The sign from yemek, “to eat,” is yeyen.",
          "answer": false,
          "explanation": "A moody verb: ye → yiyen. Same with de → diyen."
        },
        {
          "statement": "Dün gelen turist means “the tourist who came yesterday.”",
          "answer": true,
          "explanation": "The sign has no tense of its own. The word dün gives the time."
        }
      ]
    },
