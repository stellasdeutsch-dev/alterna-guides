      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "What does the sentence mean? Look at the adverb and the verb next to it.",
      "items": [
        {
          "prompt": "Henüz karar vermedim.",
          "say": "Henüz karar vermedim.",
          "options": [
            "I haven't decided yet.",
            "I've just decided.",
            "I decided long ago."
          ],
          "answer": 0,
          "explanation": "Henüz with a negation means “not yet.”"
        },
        {
          "prompt": "Ders henüz bitti.",
          "say": "Ders henüz bitti.",
          "options": [
            "The lesson hasn't ended yet.",
            "The lesson has just ended.",
            "The lesson is still going."
          ],
          "answer": 1,
          "explanation": "Henüz with the past tense and no negation means “just.”"
        },
        {
          "prompt": "Zaten biliyordum.",
          "say": "Zaten biliyordum.",
          "options": [
            "I knew for now.",
            "I didn't know yet.",
            "I already knew anyway."
          ],
          "answer": 2,
          "explanation": "Zaten: “anyway, already.”"
        },
        {
          "prompt": "Ancak yarın gelebilirim.",
          "say": "Ancak yarın gelebilirim.",
          "options": [
            "I can't come until tomorrow.",
            "I can at least come tomorrow.",
            "I'm coming tomorrow anyway."
          ],
          "answer": 0,
          "explanation": "Ancak before a time: “not until, only then.”"
        }
      ]
    },
    {
      "id": "c1.adverbs.ex2",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "matching",
      "difficulty": 1,
      "instruction": "Match each adverb to its meaning.",
      "items": [
        {
          "pairs": [
            {
              "left": "henüz (+ negation)",
              "right": "not yet"
            },
            {
              "left": "zaten",
              "right": "anyway, already"
            },
            {
              "left": "şimdilik",
              "right": "for now"
            },
            {
              "left": "hiç değilse",
              "right": "at least"
            },
            {
              "left": "yalnızca",
              "right": "only, just"
            },
            {
              "left": "ancak (+ time)",
              "right": "not until"
            }
          ],
          "explanation": "Henüz waits for an event, zaten points out the obvious, şimdilik is temporary, hiç değilse is the minimum, yalnızca limits, ancak pushes the deadline back."
        }
      ]
    },
    {
