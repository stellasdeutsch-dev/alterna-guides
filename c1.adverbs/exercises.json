      "difficulty": 2,
      "passPercent": 80,
      "instruction": "Пять вопросов. Нужно 80%.",
      "items": [
        { "type": "true_false", "statement": "«Henüz Samsun'da yaşıyorum» значит «Я всё ещё живу в Самсуне».", "answer": false, "explanation": "«Всё ещё» это hâlâ: Hâlâ Samsun'da yaşıyorum." },
        { "type": "multiple_choice", "prompt": "Ancak bir sorun var. Здесь ancak значит…", "options": ["еле-еле", "однако", "не раньше"], "answer": 1, "explanation": "В начале предложения ancak это письменное «однако»." },
        { "type": "error_hunt", "prompt": "Найди ошибку: хотели сказать «хоть бы написал вчера».", "tokens": ["Dün", "hiç", "bir", "mesaj", "atsaydın!"], "wrong": 1, "fix": "hiç değilse", "options": ["hiç değilse", "henüz", "zaten"], "say": "Dün hiç değilse bir mesaj atsaydın!", "explanation": "Hiç без değilse значит «вообще, ни разу». «Хотя бы» это hiç değilse." },
        { "type": "gap_fill", "text": "Otobüse ___ yetiştim, kapılar kapanıyordu.", "answers": [["ancak"]], "options": [["ancak", "zaten", "şimdilik"]], "translation": "Еле успел на автобус, двери уже закрывались.", "say": "Otobüse ancak yetiştim, kapılar kapanıyordu.", "explanation": "Ancak с глаголом: «еле-еле»." },
        { "type": "multiple_choice", "prompt": "Как сказать «Пока что всё в порядке»?", "options": ["Henüz her şey yolunda.", "Şimdilik her şey yolunda.", "Ancak her şey yolunda."], "answer": 1, "explanation": "«Пока что» это şimdilik." }
      ]
    }
  ]
