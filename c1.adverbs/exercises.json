      "id": "c1.adverbs.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Что значит фраза? Смотри на наречие и на глагол рядом с ним.",
      "items": [
        { "prompt": "Henüz karar vermedim.", "say": "Henüz karar vermedim.", "options": ["Я ещё не решил.", "Я только что решил.", "Я уже давно решил."], "answer": 0, "explanation": "Henüz с отрицанием значит «ещё не»." },
        { "prompt": "Ders henüz bitti.", "say": "Ders henüz bitti.", "options": ["Урок ещё не закончился.", "Урок только что закончился.", "Урок всё ещё идёт."], "answer": 1, "explanation": "Henüz с прошедшим без отрицания значит «только что»." },
        { "prompt": "Zaten biliyordum.", "say": "Zaten biliyordum.", "options": ["Я пока что знал.", "Я ещё не знал.", "Я и так знал."], "answer": 2, "explanation": "Zaten: «и так, без того»." },
        { "prompt": "Ancak yarın gelebilirim.", "say": "Ancak yarın gelebilirim.", "options": ["Смогу прийти не раньше завтра.", "Смогу прийти хотя бы завтра.", "Завтра я и так приду."], "answer": 0, "explanation": "Ancak перед временем: «не раньше, только тогда»." }
      ]
    },
    {
      "id": "c1.adverbs.ex2",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "matching",
      "difficulty": 1,
      "instruction": "Соедини наречие и его смысл.",
      "items": [
        {
          "pairs": [
            { "left": "henüz (+ отрицание)", "right": "ещё не" },
            { "left": "zaten", "right": "и так, без того" },
            { "left": "şimdilik", "right": "пока что" },
            { "left": "hiç değilse", "right": "хотя бы" },
            { "left": "yalnızca", "right": "только, всего" },
            { "left": "ancak (+ время)", "right": "не раньше" }
          ],
          "explanation": "Henüz ждёт события, zaten напоминает очевидное, şimdilik временно, hiç değilse минимум, yalnızca ограничивает, ancak отодвигает срок."
        }
      ]
    },
    {
      "id": "c1.adverbs.ex3",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "gap_fill",
      "difficulty": 2,
      "instruction": "Вставь наречие по смыслу перевода.",
      "items": [
        { "text": "Toplantı ___ bitmedi, biraz bekle.", "answers": [["henüz"]], "options": [["henüz", "zaten", "ancak"]], "translation": "Встреча ещё не закончилась, подожди немного.", "say": "Toplantı henüz bitmedi, biraz bekle.", "explanation": "Отрицание + «ещё не»: henüz." },
        { "text": "Merak etme, ___ her şeyi hazırladım.", "answers": [["zaten"]], "options": [["zaten", "henüz", "hiç değilse"]], "translation": "Не волнуйся, я и так всё подготовил.", "say": "Merak etme, zaten her şeyi hazırladım.", "explanation": "«И так, уже» это zaten." },
        { "text": "___ burada kalıyorum, sonra bakarız.", "answers": [["Şimdilik"]], "options": [["Şimdilik", "Henüz", "Ancak"]], "translation": "Пока что остаюсь здесь, потом посмотрим.", "say": "Şimdilik burada kalıyorum, sonra bakarız.", "explanation": "Сейчас так, потом может измениться: şimdilik." },
        { "text": "Gelemiyorsan ___ ara.", "answers": [["hiç değilse"]], "options": [["hiç değilse", "henüz", "zaten"]], "translation": "Если не можешь прийти, хотя бы позвони.", "say": "Gelemiyorsan hiç değilse ara.", "explanation": "«Хотя бы» + совет: hiç değilse." }
      ]
    },
    {
