        { "translation": "Хоть бы ты у меня спросил!", "words": ["Hiç", "değilse", "bana", "sorsaydın!"], "distractors": ["sor!"], "say": "Hiç değilse bana sorsaydın!", "explanation": "Упрёк о прошлом: hiç değilse + -sAydın." },
        { "translation": "Регистрация откроется не раньше завтра.", "words": ["Kayıt", "ancak", "yarın", "açılacak."], "distractors": ["henüz"], "say": "Kayıt ancak yarın açılacak.", "explanation": "«Не раньше» перед временем: ancak." },
        { "translation": "Осталось всего двадцать мест.", "words": ["Yalnızca", "yirmi", "yer", "kaldı."], "distractors": ["zaten"], "say": "Yalnızca yirmi yer kaldı.", "explanation": "«Только, всего» в объявлении: yalnızca." }
      ]
    },
    {
      "id": "c1.adverbs.ex5",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "custom",
      "difficulty": 2,
