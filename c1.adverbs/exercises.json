      "items": [
        { "id": "p1", "prompt": "Webinar ___ başlamadı, 19:00'da başlıyor.", "answer": "henüz", "explanation": "Отрицание + «ещё не»: henüz." },
        { "id": "p2", "prompt": "___ kayıtlısınız, tekrar kayıt olmayın.", "answer": "Zaten", "explanation": "«И так, уже» это zaten." },
        { "id": "p3", "prompt": "___ 12 yer kaldı!", "answer": "Yalnızca", "explanation": "«Только» в объявлении: yalnızca." },
        { "id": "p4", "prompt": "Sertifika ___ yarın gönderilecek.", "answer": "ancak", "explanation": "«Не раньше» перед временем: ancak." },
        { "id": "p5", "prompt": "Kayıt ___ ücretsiz, yarın ücretli olacak.", "answer": "şimdilik", "explanation": "Сейчас так, завтра иначе: şimdilik." },
        { "id": "p6", "prompt": "Gelemiyorsan ___ bir mesaj at.", "answer": "hiç değilse", "explanation": "«Хотя бы» + совет: hiç değilse." }
      ]
    },
    {
      "id": "c1.adverbs.check1",
      "lesson": 1,
      "kind": "check",
