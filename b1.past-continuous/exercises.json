        { "id": "5", "type": "multiple_choice", "prompt": "Neredeyse düşüyordum. Что это значит?", "options": ["Я упал.", "Я чуть не упал.", "Я падал весь день."], "answer": 1, "explanation": "Neredeyse плюс -yordu — «чуть не»." }
