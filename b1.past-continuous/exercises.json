      "id": "b1.past-continuous.ex1",
      "topic": "b1.past-continuous",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Узнай форму",
      "items": [
        { "id": "1", "prompt": "Какая форма значит «я делал (в тот момент)»?", "options": ["yapıyorum", "yapıyordum", "yaptım"], "answer": 1, "explanation": "-yor плюс печать -du плюс -m: yapıyordum. Yapıyorum — сейчас, yaptım — сделал." },
        { "id": "2", "prompt": "Geliyorduk — это кто?", "options": ["я", "мы", "вы", "они"], "answer": 1, "explanation": "-k на конце — «мы». Geliyorduk: мы шли." },
        { "id": "3", "prompt": "Где прошедшее длительное?", "options": ["Evdeydim.", "Kitap okuyordum.", "Kitap okudum."], "answer": 1, "explanation": "Okuyordum — кисть -yor и печать -du. Evdeydim — «был дома», okudum — «прочитал»." },
        { "id": "4", "prompt": "Как сказать «они ждали»?", "options": ["bekliyorlardı", "beklediler", "bekliyorlar"], "answer": 0, "explanation": "Для onlar: bekliyor + lar + dı. Beklediler — «подождали», bekliyorlar — «ждут сейчас»." },
        { "id": "5", "prompt": "«Я не знал» по-турецки:", "options": ["bilmiyordum", "biliyormadım", "bilmiyorum"], "answer": 0, "explanation": "Отрицание встаёт перед -yor: bil-mi-yor-du-m. Bilmiyorum — «не знаю» сейчас." }
      ]
    },
    {
      "id": "b1.past-continuous.ex2",
      "topic": "b1.past-continuous",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "sort_buckets",
      "difficulty": 2,
      "instruction": "Кисть или печать? Разложи русские фразы по формам",
      "items": [
        {
          "id": "1",
          "buckets": [
            { "id": "yordu", "label": "Кисть: -yordu" },
            { "id": "di", "label": "Печать: -dı" }
          ],
          "entries": [
            { "text": "В восемь вечера я ужинал.", "bucket": "yordu" },
            { "text": "Я купил хлеб.", "bucket": "di" },
            { "text": "Шёл дождь.", "bucket": "yordu" },
            { "text": "Вдруг вырубило свет.", "bucket": "di" },
            { "text": "Я чуть не упал.", "bucket": "yordu" },
            { "text": "Мы один раз были в Калеичи.", "bucket": "di" }
          ],
          "explanation": "Стоп-кадр, фон и «чуть не» — кисть -yordu. Событие, факт, «вдруг» — печать -dı."
        }
      ]
    },
    {
      "id": "b1.past-continuous.ex3",
