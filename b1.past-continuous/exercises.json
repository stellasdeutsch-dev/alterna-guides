        { "id": "2", "translation": "Что ты делал вчера в восемь?", "words": ["Dün", "saat", "sekizde", "ne", "yapıyordun?"], "distractors": ["yaptın?"], "say": "Dün saat sekizde ne yapıyordun?", "explanation": "Вопрос про момент — yapıyordun." },
        { "id": "3", "translation": "Я чуть не опоздал на автобус.", "words": ["Az", "kalsın", "otobüsü", "kaçırıyordum."], "distractors": ["kaçırdım."], "say": "Az kalsın otobüsü kaçırıyordum.", "explanation": "С az kalsın — «чуть не» — нужна -yordu." }
      ]
