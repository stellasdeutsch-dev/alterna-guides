      "instruction": "Поставь форму в пропуск",
      "items": [
        { "id": "1", "text": "Dün saat dokuzda ben televizyon ___.", "answers": [["izliyordum"]], "options": [["izliyordum", "izledim", "izliyorum"]], "translation": "Вчера в девять я смотрел телевизор.", "explanation": "В девять шло — стоп-кадр: izliyordum." },
        { "id": "2", "text": "Biz kahvaltı ___, elektrik gitti.", "answers": [["yapıyorduk"]], "options": [["yapıyorduk", "yapıyordum", "yaptık"]], "translation": "Мы завтракали, и вырубило свет.", "explanation": "Biz — «мы», а завтрак — фон: yapıyorduk." },
        { "id": "3", "text": "Sen beni ___ muydun?", "answers": [["dinliyor"]], "options": [["dinliyor", "dinliyordun", "dinledin"]], "translation": "Ты меня слушал?", "explanation": "В вопросе -du с лицом уезжает к mu: dinliyor muydun." },
        { "id": "4", "text": "Eskiden kahve ___.", "answers": [["içmiyordum"]], "options": [null], "translation": "Раньше я не пил кофе.", "explanation": "Раньше, отрицание, я: iç-mi-yor-du-m → içmiyordum." },
        { "id": "5", "text": "Onlar otelde ___.", "answers": [["çalışıyorlardı", "çalışıyordular"]], "options": [null], "translation": "Они работали в отеле.", "explanation": "Для onlar: çalışıyorlardı (или çalışıyordular)." }
      ]
    },
