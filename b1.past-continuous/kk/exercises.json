      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Форманы таны",
      "items": [
        {
          "id": "1",
          "prompt": "Қай форма «мен істеп жатыр едім (сол сәтте)» дегенді білдіреді?",
          "options": [
            "yapıyorum",
            "yapıyordum",
            "yaptım"
          ],
          "answer": 1,
          "explanation": "-yor, оған -du мөрі, оған -m: yapıyordum. Yapıyorum — қазір, yaptım — істедім."
        },
        {
          "id": "2",
          "prompt": "Geliyorduk — бұл кім?",
          "options": [
            "мен",
            "біз",
            "сіз",
            "олар"
          ],
          "answer": 1,
          "explanation": "Соңындағы -k — «біз», қазақшадағы келді-к сияқты. Geliyorduk: біз келе жатыр едік."
        },
        {
          "id": "3",
          "prompt": "Созылыңқы өткен шақ қайсы?",
          "options": [
            "Evdeydim.",
            "Kitap okuyordum.",
            "Kitap okudum."
          ],
          "answer": 1,
          "explanation": "Okuyordum — -yor қылқаламы мен -du мөрі. Evdeydim — «үйде едім», okudum — «оқыдым»."
        },
        {
          "id": "4",
          "prompt": "«Олар күтіп отыр еді» қалай болады?",
          "options": [
            "bekliyorlardı",
            "beklediler",
            "bekliyorlar"
          ],
          "answer": 0,
          "explanation": "Onlar үшін: bekliyor + lar + dı. Beklediler — «күтті», bekliyorlar — «қазір күтіп отыр»."
        },
        {
          "id": "5",
          "prompt": "«Мен білмейтінмін» түрікше:",
          "options": [
            "bilmiyordum",
            "biliyor yoktum",
            "bilmiyorum"
          ],
          "answer": 0,
          "explanation": "Қазақша «жоқ» сыртта тұрады, түрікше болымсыздық сөздің ішінде: bil-mi-yor-du-m. Yok мұнда керек емес. Bilmiyorum — «білмеймін», қазір."
        }
      ]
    },
