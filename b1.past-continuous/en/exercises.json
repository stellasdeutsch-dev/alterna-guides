{
  "topic": "b1.past-continuous",
  "exercises": [
    {
      "id": "b1.past-continuous.ex1",
      "topic": "b1.past-continuous",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Spot the form",
      "items": [
        {
          "id": "1",
          "prompt": "Which form means “I was doing (at that moment)”?",
          "options": [
            "yapıyorum",
            "yapıyordum",
            "yaptım"
          ],
          "answer": 1,
          "explanation": "-yor plus the -du stamp plus -m: yapıyordum. Yapıyorum — now, yaptım — did."
        },
        {
          "id": "2",
          "prompt": "Geliyorduk — who is that?",
          "options": [
            "I",
            "we",
            "you (plural)",
            "they"
          ],
          "answer": 1,
          "explanation": "-k at the end — “we.” Geliyorduk: we were coming."
        },
        {
          "id": "3",
          "prompt": "Which one is the past continuous?",
          "options": [
            "Evdeydim.",
            "Kitap okuyordum.",
            "Kitap okudum."
          ],
          "answer": 1,
          "explanation": "Okuyordum — the -yor brush and the -du stamp. Evdeydim — “I was at home,” okudum — “I read it.”"
        },
        {
          "id": "4",
          "prompt": "How do you say “they were waiting”?",
          "options": [
            "bekliyorlardı",
            "beklediler",
            "bekliyorlar"
          ],
          "answer": 0,
          "explanation": "For onlar: bekliyor + lar + dı. Beklediler — “they waited,” bekliyorlar — “they're waiting now.”"
        },
        {
          "id": "5",
          "prompt": "“I didn't know (back then)” in Turkish:",
          "options": [
            "bilmiyordum",
            "bilmedim",
            "bilmiyorum"
          ],
          "answer": 0,
          "explanation": "English says “didn't know” — simple past. But not knowing was a state that went on: bil-mi-yor-du-m. Bilmiyorum — “I don't know,” right now."
        }
      ]
    },
    {
      "id": "b1.past-continuous.ex2",
      "topic": "b1.past-continuous",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "sort_buckets",
      "difficulty": 2,
      "instruction": "Brush or stamp? Sort the sentences by form",
      "items": [
        {
          "id": "1",
          "buckets": [
            {
              "id": "yordu",
              "label": "Brush: -yordu"
            },
            {
              "id": "di",
              "label": "Stamp: -dı"
            }
          ],
          "entries": [
            {
              "text": "At eight in the evening I was having dinner.",
              "bucket": "yordu"
            },
            {
              "text": "I bought bread.",
              "bucket": "di"
            },
            {
              "text": "It was raining.",
              "bucket": "yordu"
            },
            {
              "text": "Suddenly the power went out.",
              "bucket": "di"
            },
            {
              "text": "I almost fell.",
              "bucket": "yordu"
            },
            {
              "text": "We went to Kaleiçi once.",
              "bucket": "di"
            }
          ],
          "explanation": "Freeze-frame, background and “almost” — the -yordu brush. Event, fact, “suddenly” — the -dı stamp."
        }
      ]
    },
