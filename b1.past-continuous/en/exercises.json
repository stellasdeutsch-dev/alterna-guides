      "items": [
        {
          "id": "1",
          "text": "Saat on birde ben ___.",
          "ru": "At eleven I ___ (sleep).",
          "options": [
            "uyuyordum",
            "uyudum"
          ],
          "answer": 0,
          "explanation": "At 11 p.m. the sleeping was in progress. Freeze-frame — brush."
        },
        {
          "id": "2",
          "text": "Ben duş ___, telefon çaldı.",
          "ru": "I ___ (take) a shower, the phone rang.",
          "options": [
            "alıyordum",
            "aldım"
          ],
          "answer": 0,
          "explanation": "Shower — background, the call — stamp."
        },
        {
          "id": "3",
          "text": "Sonra telefonu ___.",
          "ru": "Then I ___ (pick up) the phone.",
          "options": [
            "açıyordum",
            "açtım"
          ],
          "answer": 1,
          "explanation": "“Then” — the next event. Stamp."
        },
        {
          "id": "4",
          "text": "O sırada yağmur ___.",
          "ru": "At that time it ___ (rain).",
          "options": [
            "yağıyordu",
            "yağdı"
          ],
          "answer": 0,
          "explanation": "O sırada — “at that time.” Background, brush."
        },
        {
          "id": "5",
          "text": "Az kalsın merdivenden ___.",
          "ru": "I almost ___ (fall) down the stairs.",
          "options": [
            "düşüyordum",
            "düştüm"
          ],
          "answer": 0,
          "explanation": "Az kalsın — “almost.” Brush."
        },
        {
          "id": "6",
          "text": "Bir kere Kaleiçi'ne ___.",
          "ru": "Once I ___ (go) to Kaleiçi.",
          "options": [
