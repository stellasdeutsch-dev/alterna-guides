      "instruction": "Quick check: 5 questions, you need 4 right",
      "passPercent": 80,
      "items": [
        {
          "id": "1",
          "type": "true_false",
          "statement": "After -yor the vowel follows harmony: alıyordım, geliyordim.",
          "answer": false,
          "explanation": "No. After -yor it's always u: alıyordum, geliyordum."
        },
        {
          "id": "2",
          "type": "multiple_choice",
          "prompt": "“At seven in the evening we were strolling around Kaleiçi.” Which is right?",
          "options": [
            "Akşam saat yedide Kaleiçi'nde geziyorduk.",
            "Akşam saat yedide Kaleiçi'nde gezdik.",
            "Akşam saat yedide Kaleiçi'nde geziyoruz."
          ],
          "answer": 0,
          "explanation": "Freeze-frame at seven — brush: geziyorduk."
        },
        {
          "id": "3",
          "type": "error_hunt",
          "prompt": "Find the mistake",
          "tokens": [
            "Ben",
            "eskiden",
            "Türkçe",
            "biliyormadım."
          ],
          "wrong": 3,
          "fix": "bilmiyordum.",
          "options": [
            "bilmiyordum.",
            "bilmedim.",
            "biliyordum."
          ],
          "explanation": "No separate “not”: the negative goes inside the word, before -yor: bil-mi-yor-du-m. And “didn't know” is a state — so -yordu, not bilmedim."
