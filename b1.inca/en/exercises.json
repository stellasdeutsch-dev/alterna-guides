{
  "topic": "b1.inca",
  "exercises": [
    {
      "id": "b1.inca.ex1",
      "topic": "b1.inca",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Spot the splice: pick an answer.",
      "items": [
        {
          "id": "i1",
          "prompt": "Which sentence has the -(y)IncA splice?",
          "options": [
            "Eve gelince ararım.",
            "Eve geldim.",
            "Eve gelirim."
          ],
          "answer": 0,
          "say": "Eve gelince ararım.",
          "explanation": "The splice is the little tail -ince in gelince. The other sentences just have a verb tense."
        },
        {
          "id": "i2",
          "prompt": "Eve gelince seni ararım. What happens first?",
          "options": [
            "I get home",
            "I call",
            "Everything at once"
          ],
          "answer": 0,
          "say": "Eve gelince seni ararım.",
          "explanation": "The shot with the splice always comes first: home first, then the call."
        },
        {
          "id": "i3",
          "prompt": "Haberi duyunca çok sevindi. How do you translate it?",
          "options": [
            "Hearing the news, he was very happy.",
            "If he hears the news, he'll be happy.",
            "While listening to the news, he was happy."
          ],
          "answer": 0,
          "say": "Haberi duyunca çok sevindi.",
          "explanation": "duyunca — “hearing,” “as soon as he heard.” Not “if” and not “while.”"
        },
        {
          "id": "i4",
          "prompt": "Sen gelince Simit çok sevinir. Who's coming?",
          "options": [
            "you",
            "me",
            "Simit"
          ],
          "answer": 0,
          "say": "Sen gelince Simit çok sevinir.",
          "explanation": "The splice has no person. Who came is shown by the word next to it: sen — you."
        }
      ]
    },
    {
      "id": "b1.inca.ex2",
      "topic": "b1.inca",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "gap_fill",
      "difficulty": 2,
      "instruction": "Put the verb in the -(y)IncA form.",
      "items": [
        {
          "id": "i1",
          "text": "Kahvaltı ___ denize gideriz.",
          "answers": [
            [
              "bitince"
            ]
          ],
          "options": [
            [
              "bitince",
              "bidince",
              "bitınca"
            ]
          ],
          "translation": "Once breakfast is over, we'll go to the beach.",
          "say": "Kahvaltı bitince denize gideriz.",
          "explanation": "bit holds on to its t: bitince. Only git, et and tat switch to d."
        },
        {
          "id": "i2",
          "text": "Ayşe teyze telefon ___ hemen açtım.",
          "answers": [
            [
              "edince"
            ]
          ],
          "options": [
            [
              "edince",
              "etince",
              "edınce"
            ]
          ],
          "translation": "As soon as Ayşe Teyze called, I answered right away.",
          "say": "Ayşe teyze telefon edince hemen açtım.",
          "explanation": "et is one of the trio: t → d. Vowel e → -ince. You get edince."
        },
        {
          "id": "i3",
          "text": "Simit ___ Timur da uyudu.",
          "answers": [
            [
              "uyuyunca"
            ]
          ],
          "options": [
            [
              "uyuyunca",
              "uyunca",
              "uyuyınca"
            ]
          ],
          "translation": "Simit fell asleep — and so did Timur.",
          "say": "Simit uyuyunca Timur da uyudu.",
          "explanation": "uyu ends in a vowel — you need the leash y. Last vowel u → -unca."
        },
        {
          "id": "i4",
          "text": "Taksiye ___ beni ara.",
          "answers": [
            [
              "binince"
            ]
          ],
          "options": [
            [
              "binince",
              "binınca",
              "bininca"
            ]
          ],
          "translation": "Once you get in the taxi, call me.",
          "say": "Taksiye binince beni ara.",
          "explanation": "bin: last vowel i → -ince."
        }
      ]
    },
    {
      "id": "b1.inca.ex3",
      "topic": "b1.inca",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "error_hunt",
      "difficulty": 2,
      "instruction": "Find the bad take and fix it.",
      "items": [
        {
          "id": "i1",
          "tokens": [
            "Pazara",
            "gitince",
            "karpuz",
            "al."
          ],
          "wrong": 1,
          "fix": "gidince",
          "options": [
            "gidince",
            "gidınca",
            "gitınca"
          ],
          "say": "Pazara gidince karpuz al.",
          "explanation": "git turns t into d before a vowel: gidince."
        },
        {
          "id": "i2",
          "tokens": [
            "Ben",
            "gelincem",
            "seni",
            "ararım."
          ],
          "wrong": 1,
          "fix": "gelince",
          "options": [
            "gelince",
            "geldince",
            "gelinceyim"
          ],
          "say": "Ben gelince seni ararım.",
          "explanation": "We don't hang the person on the splice. Ben gelince — that's it."
        },
        {
          "id": "i3",
          "tokens": [
            "Anahtarı",
            "bulınca",
            "haber",
            "ver."
          ],
          "wrong": 1,
          "fix": "bulunca",
          "options": [
            "bulunca",
            "bulünce",
            "bulince"
          ],
          "say": "Anahtarı bulunca haber ver.",
          "explanation": "bul: last vowel u → -unca. Once you find the key, let me know."
        }
      ]
    },
    {
      "id": "b1.inca.ex4",
      "topic": "b1.inca",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "build_sentence",
      "difficulty": 3,
      "instruction": "Build the sentence from shots.",
      "items": [
        {
          "id": "i1",
          "translation": "As soon as I get home, I'll call you.",
          "words": [
            "Eve",
            "gelince",
            "seni",
            "ararım."
          ],
          "distractors": [
            "geldim",
            "gelirim"
          ],
          "say": "Eve gelince seni ararım.",
          "explanation": "First shot — Eve gelince, second — seni ararım. The second shot carries the tense."
        },
        {
          "id": "i2",
          "translation": "When you see Simit, give him some water.",
          "words": [
            "Simit'i",
            "görünce",
            "ona",
            "su",
            "ver."
          ],
          "distractors": [
            "görunca"
          ],
          "say": "Simit'i görünce ona su ver.",
          "explanation": "gör: last vowel ö → -ünce. The second shot is a request: ona su ver."
        },
        {
          "id": "i3",
          "translation": "Since you didn't call, I left.",
          "words": [
            "Sen",
            "aramayınca",
            "ben",
            "çıktım."
          ],
          "distractors": [
            "arayınca"
          ],
          "say": "Sen aramayınca ben çıktım.",
          "explanation": "“Since you didn't call” — the negation goes before the splice: ara-ma-y-ınca."
        }
      ]
    },
    {
