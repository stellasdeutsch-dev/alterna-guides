      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Aim the flash: pick the boosted form",
      "items": [
        {
          "id": "1",
          "prompt": "kırmızı → ?",
          "say": "kıpkırmızı",
          "options": [
            "kımkırmızı",
            "kıpkırmızı",
            "kırkırmızı"
          ],
          "answer": 1,
          "explanation": "Kı + p = kıp. Kıpkırmızı — you just remember a consonant like that."
        },
        {
          "id": "2",
          "prompt": "mavi → ?",
          "say": "masmavi",
          "options": [
            "masmavi",
            "mapmavi",
            "mammavi"
          ],
          "answer": 0,
          "explanation": "Ma + s = mas. Masmavi — like the sea in Çeşme."
        },
        {
          "id": "3",
          "prompt": "beyaz → ?",
          "say": "bembeyaz",
          "options": [
            "bepbeyaz",
            "besbeyaz",
            "bembeyaz"
          ],
          "answer": 2,
          "explanation": "Be + m = bem. Bembeyaz."
        },
        {
          "id": "4",
          "prompt": "temiz → ?",
          "say": "tertemiz",
          "options": [
            "tertemiz",
            "tetemiz",
            "temtemiz"
          ],
          "answer": 0,
          "explanation": "Te + r = ter. Tertemiz."
        },
        {
          "id": "5",
          "prompt": "yeni → ?",
          "say": "yepyeni",
          "options": [
            "yemyeni",
            "yepyeni",
            "yesyeni"
          ],
          "answer": 1,
          "explanation": "Ye + p = yep. Yepyeni."
        }
      ]
    },
