    {
      "id": "a1.past-di.ex5",
      "lesson": 2,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Pick the negative",
      "items": [
        {
          "id": "1",
          "prompt": "yapmak, ben: “I didn’t do it”",
          "options": [
            "yaptım değil",
            "yapmadım",
            "yapmedim"
          ],
          "answer": 1,
          "explanation": "No değil with verbs — the negation goes inside: yap + ma + dı + m. a in the root, so ma and ı.",
          "say": "yapmadım"
        },
        {
          "id": "2",
          "prompt": "gitmek, o: “he didn’t leave”",
          "options": [
            "gitmetti",
            "gitmedi",
            "gitmadı"
          ],
          "answer": 1,
          "explanation": "After -me the root doesn’t touch the tail — no t needed. i in the root — so me.",
          "say": "gitmedi"
        },
        {
          "id": "3",
          "prompt": "okumak, sen: “you didn’t read”",
          "options": [
            "okumadın",
            "okumedin",
            "okumudun"
          ],
          "answer": 0,
          "explanation": "u is a back vowel, so ma and ı: okumadın.",
          "say": "okumadın"
        },
        {
          "id": "4",
          "prompt": "görmek, biz: “we didn’t see”",
          "options": [
            "görmadık",
            "görmüdük",
            "görmedik"
          ],
          "answer": 2,
          "explanation": "ö is a front vowel, so me and i: görmedik.",
          "say": "görmedik"
        }
      ]
    },
