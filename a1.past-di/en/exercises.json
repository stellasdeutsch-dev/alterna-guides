{
  "topic": "a1.past-di",
  "exercises": [
    {
      "id": "a1.past-di.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Pick the past form for “he/she”",
      "items": [
        {
          "id": "1",
          "prompt": "gel → ?",
          "options": [
            "geldi",
            "geldı",
            "geldu"
          ],
          "answer": 0,
          "explanation": "e in the root — i in the tail: geldi.",
          "say": "geldi"
        },
        {
          "id": "2",
          "prompt": "oku → ?",
          "options": [
            "okudı",
            "okudu",
            "okutu"
          ],
          "answer": 1,
          "explanation": "The root’s last vowel is u — so the tail gets u too. The root ends in a vowel, nothing to devoice.",
          "say": "okudu"
        },
        {
          "id": "3",
          "prompt": "gör → ?",
          "options": [
            "gördi",
            "gördu",
            "gördü"
          ],
          "answer": 2,
          "explanation": "ö and ü give ü: gördü.",
          "say": "gördü"
        },
        {
          "id": "4",
          "prompt": "yap → ?",
          "options": [
            "yapdı",
            "yaptı",
            "yaptu"
          ],
          "answer": 1,
          "explanation": "p lives in the name Fıstıkçı Şahap — d goes voiceless, t. And a gives ı.",
          "say": "yaptı"
        },
        {
          "id": "5",
          "prompt": "iç → ?",
          "options": [
            "içti",
            "içdi",
            "içtı"
          ],
          "answer": 0,
          "explanation": "ç from Şahap devoices d to t, the vowel i gives i: içti.",
          "say": "içti"
        }
      ]
    },
    {
      "id": "a1.past-di.ex2",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "sort_buckets",
      "difficulty": 1,
      "instruction": "d or t? Sort the roots",
      "items": [
        {
          "id": "1",
          "buckets": [
            {
              "id": "d",
              "label": "-dI"
            },
            {
              "id": "t",
              "label": "-tI"
            }
          ],
          "entries": [
            {
              "text": "gel",
              "bucket": "d"
            },
            {
              "text": "git",
              "bucket": "t"
            },
            {
              "text": "al",
              "bucket": "d"
            },
            {
              "text": "iç",
              "bucket": "t"
            },
            {
              "text": "oku",
              "bucket": "d"
            },
            {
              "text": "yap",
              "bucket": "t"
            },
            {
              "text": "gör",
              "bucket": "d"
            },
            {
              "text": "konuş",
              "bucket": "t"
            }
          ],
          "explanation": "Look at the root’s last letter: f, s, t, k, ç, ş, h, p — that means t. Everything else and vowels — d."
        }
      ]
    },
    {
      "id": "a1.past-di.ex3",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "custom",
      "difficulty": 2,
      "instruction": "Darkroom: develop the shot with the right form",
      "description": "The learner sees the person, root and translation and picks the form; the right answer develops the photo. Logic lives in index.html.",
      "items": [
        {
          "id": "1",
          "person": "ben",
          "root": "git",
          "ru": "I left",
          "options": [
            "gitdim",
            "gittim",
            "gittin"
          ],
          "answer": "gittim",
          "explanation": "The root’s t devoices the tail: git + ti + m."
        },
        {
          "id": "2",
          "person": "sen",
          "root": "gel",
          "ru": "you came",
          "options": [
            "geldin",
            "geldim",
            "geltin"
          ],
          "answer": "geldin",
          "explanation": "“You” is the ending n: geldin."
        },
        {
          "id": "3",
          "person": "o",
          "root": "oku",
          "ru": "he read",
          "options": [
            "okudum",
            "okudu",
            "okudı"
          ],
          "answer": "okudu",
          "explanation": "“He” has no person tail, and u gives u: okudu."
        },
        {
          "id": "4",
          "person": "biz",
          "root": "yap",
          "ru": "we did",
          "options": [
            "yaptık",
            "yapdık",
            "yaptim"
          ],
          "answer": "yaptık",
          "explanation": "p devoices d to t, “we” is k: yaptık."
        },
        {
          "id": "5",
          "person": "siz",
          "root": "gör",
          "ru": "you all saw",
          "options": [
            "gördünüz",
            "gördiniz",
            "gördük"
          ],
          "answer": "gördünüz",
          "explanation": "ö gives ü everywhere: gör + dü + nüz."
        },
        {
          "id": "6",
          "person": "onlar",
          "root": "iç",
          "ru": "they drank",
          "options": [
            "içdiler",
            "içtiler",
            "içtılar"
          ],
          "answer": "içtiler",
          "explanation": "ç devoices d to t, i gives i, and “they” is ler: içtiler."
        }
      ]
    },
