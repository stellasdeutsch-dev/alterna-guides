      "id": "c1.casina.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "What does the sentence mean?",
      "items": [
        {
          "id": "1",
          "prompt": "Hiçbir şey olmamış gibi davrandı.",
          "say": "Hiçbir şey olmamış gibi davrandı.",
          "options": [
            "He acted as if nothing had happened.",
            "Nothing happened, and he acted like that.",
            "He acted as if something was going to happen."
          ],
          "answer": 0,
          "explanation": "-mış gibi means “as if.” Olmamış — hadn’t happened. As if nothing had happened."
        },
        {
          "id": "2",
          "prompt": "Uyuyormuş gibi yaptı.",
          "say": "Uyuyormuş gibi yaptı.",
          "options": [
            "He fell asleep.",
            "He pretended to be asleep."
          ],
          "answer": 1,
          "explanation": "Gibi yapmak — to pretend. -yormuş — as if sleeping right now."
        },
        {
          "id": "3",
          "prompt": "Yağmur yağacak gibi.",
          "say": "Yağmur yağacak gibi.",
          "options": [
            "Looks like it’s about to rain.",
            "As if it had been raining."
          ],
          "answer": 0,
          "explanation": "-acak gibi without -mış — a forecast based on real signs."
        },
        {
          "id": "4",
          "prompt": "Çocukçasına sevindi.",
          "say": "Çocukçasına sevindi.",
          "options": [
            "He was happy for the child.",
            "He was happy like a child."
          ],
          "answer": 1,
          "explanation": "-casına on a noun means “like X.” Çocukçasına — childlike, like a child."
        }
      ]
    },
