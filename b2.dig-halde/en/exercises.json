    {
      "id": "b2.dig-halde.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "What does the sentence mean?",
      "items": [
        {
          "id": "1",
          "prompt": "Erken kalktığım hâlde geç kaldım.",
          "say": "Erken kalktığım hâlde geç kaldım.",
          "options": [
            "Although I got up early, I was late.",
            "I got up early, so I wasn't late.",
            "By the time I got up, I was already late."
          ],
          "answer": 0,
          "explanation": "hâlde means “although.” Got up early, zero payoff: still late."
        },
        {
          "id": "2",
          "prompt": "Hasta olduğu hâlde işe gitti.",
          "say": "Hasta olduğu hâlde işe gitti.",
          "options": [
            "He went to work because he got sick.",
            "Although he was sick, he went to work.",
            "He got sick at work."
          ],
          "answer": 1,
          "explanation": "Sick — and went anyway. Expected a sick day, got a hero."
        },
        {
          "id": "3",
          "prompt": "Bugün geleceği hâlde gelmedi.",
          "say": "Bugün geleceği hâlde gelmedi.",
          "options": [
            "Although he was supposed to come today, he didn't.",
            "He'll come today, although he doesn't want to.",
            "He came today, although he hadn't promised."
          ],
          "answer": 0,
          "explanation": "-eceği is a plan. The plan was there, the person wasn't."
        },
        {
          "id": "4",
          "prompt": "Kar yağdığı hâlde herkes yürüyor.",
          "say": "Kar yağdığı hâlde herkes yürüyor.",
          "options": [
            "It snowed, so everyone is out walking.",
            "Although it's snowing, everyone is out walking.",
            "When it snows, everyone will go out for a walk."
          ],
          "answer": 1,
          "explanation": "Snow is falling, and people are out walking. Expectation vs. life — that's hâlde."
        }
      ]
    },
    {
      "id": "b2.dig-halde.ex2",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "sort_buckets",
      "difficulty": 2,
      "instruction": "Which tail does the verb get?",
      "items": [
        {
          "id": "1",
          "buckets": [
            {
              "id": "a",
              "label": "-dığı / -tığı"
            },
            {
              "id": "e",
              "label": "-diği / -tiği"
            },
            {
              "id": "o",
              "label": "-duğu / -tuğu"
            },
            {
              "id": "u",
              "label": "-düğü / -tüğü"
            }
          ],
          "entries": [
            {
              "text": "bak",
              "bucket": "a"
            },
            {
              "text": "yap",
              "bucket": "a"
            },
            {
              "text": "gel",
              "bucket": "e"
            },
            {
              "text": "iç",
              "bucket": "e"
            },
            {
              "text": "oku",
              "bucket": "o"
            },
            {
              "text": "konuş",
              "bucket": "o"
            },
            {
              "text": "gör",
              "bucket": "u"
            },
            {
              "text": "gül",
              "bucket": "u"
            }
          ],
          "explanation": "Look at the last vowel of the root: a ı → ı, e i → i, o u → u, ö ü → ü. And t instead of d after a voiceless consonant."
        }
      ]
    },
