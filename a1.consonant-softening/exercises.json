      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Что получится на стыке?",
      "items": [
        { "id": "1", "prompt": "kitap + ı → ? (книгу)", "options": ["kitapı", "kitabı"], "answer": 1, "explanation": "Аффикс начинается с гласной. p оказалась между гласными и размякла: kitabı." },
        { "id": "2", "prompt": "ağaç + a → ? (к дереву)", "options": ["ağaça", "ağaca"], "answer": 1, "explanation": "Перед гласной ç становится c: ağaca. Звучит [а:аджа]." },
        { "id": "3", "prompt": "çocuk + u → ? (ребёнка)", "options": ["çocuğu", "çocuku", "çocugu"], "answer": 0, "explanation": "k между гласными становится ğ, а не g. g бывает только после n: renk → rengi." },
        { "id": "4", "prompt": "gitmek: он идёт → ?", "options": ["gitiyor", "gidiyor"], "answer": 1, "explanation": "gitmek из клуба четырёх. Перед гласной t → d: gidiyor." },
        { "id": "5", "prompt": "top + u → ? (мяч, кого? что?)", "options": ["tobu", "topu"], "answer": 1, "explanation": "top короткое, в один слог. Такие обычно упрямые: topu." }
      ]
    },
    {
      "id": "a1.consonant-softening.ex2",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "sort_buckets",
      "difficulty": 2,
      "instruction": "Меняется ли буква на стыке?",
      "items": [
        {
          "id": "1",
          "buckets": [
            { "id": "soft", "label": "Меняется" },
            { "id": "same", "label": "Не меняется" }
          ],
          "entries": [
            { "text": "sokak + a", "bucket": "soft" },
            { "text": "top + u", "bucket": "same" },
            { "text": "mektup + u", "bucket": "soft" },
            { "text": "kitap + lar", "bucket": "same" },
            { "text": "renk + i", "bucket": "soft" },
            { "text": "saat + i", "bucket": "same" },
            { "text": "kanat + ı", "bucket": "soft" },
            { "text": "ev + e", "bucket": "same" }
          ],
          "explanation": "Меняется p ç t k перед гласной: sokağa, mektubu, rengi, kanadı. Не меняются короткие (topu), заимствования (saati), стык с согласной (kitaplar) и звонкие буквы (ev + e = eve)."
        }
      ]
    },
    {
      "id": "a1.consonant-softening.ex3",
