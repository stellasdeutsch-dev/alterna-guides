        { "id": "1", "type": "gap_fill", "text": "ağaç + ım = ___", "answers": [["ağacım"]], "translation": "моё дерево", "explanation": "ç перед гласной становится c: ağacım." },
        { "id": "2", "type": "gap_fill", "text": "ayak + ı = ___", "answers": [["ayağı"]], "translation": "ногу", "explanation": "k между гласными становится ğ: ayağı. ğ не читается, только тянет гласную." },
        { "id": "3", "type": "error_hunt", "prompt": "Найди ошибку: «Я ищу книгу»", "tokens": ["Ben", "kitapı", "arıyorum."], "wrong": 1, "fix": "kitabı", "options": ["kitabı", "kitabi"], "explanation": "kitap + ı: p перед гласной становится b. После a берём ı: kitabı." },
        { "id": "4", "type": "error_hunt", "prompt": "Найди ошибку: «Али идёт на улицу»", "tokens": ["Ali", "sokaka", "gidiyor."], "wrong": 1, "fix": "sokağa", "options": ["sokağa", "sokaga"], "explanation": "sokak + a: k перед гласной становится ğ. Правильно sokağa." }
      ]
    },
    {
      "id": "a1.consonant-softening.ex4",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "custom",
      "difficulty": 2,
      "instruction": "Пуговица на стыке: почини ценники книжного",
      "description": "Ценники в книжном на Кадыкёе. На стыке корня и аффикса — пуговица с буквой. Ученик выбирает букву: оставить глухую или смягчить. Логика — в index.html.",
      "items": [
        { "id": "1", "stem": "dola", "suffix": "ım", "ru": "мой шкаф", "options": ["p", "b"], "answer": "b", "explanation": "dolap + ım: перед гласной p → b. dolabım." },
        { "id": "2", "stem": "to", "suffix": "u", "ru": "мяч (кого? что?)", "options": ["p", "b"], "answer": "p", "explanation": "top короткое, в один слог. Не смягчается: topu." },
        { "id": "3", "stem": "soka", "suffix": "a", "ru": "на улицу", "options": ["k", "ğ", "g"], "answer": "ğ", "explanation": "k между гласными становится ğ: sokağa." },
        { "id": "4", "stem": "ren", "suffix": "i", "ru": "цвет (кого? что?)", "options": ["k", "ğ", "g"], "answer": "g", "explanation": "Перед k стоит n. Поэтому k → g, а не ğ: rengi." },
        { "id": "5", "stem": "kita", "suffix": "lar", "ru": "книги", "options": ["p", "b"], "answer": "p", "explanation": "Аффикс начинается с согласной l. Корень не трогаем: kitaplar." },
        { "id": "6", "stem": "ila", "suffix": "ım", "ru": "моё лекарство", "options": ["ç", "c"], "answer": "c", "explanation": "ilaç + ım: перед гласной ç → c. ilacım." },
        { "id": "7", "stem": "gi", "suffix": "iyor", "ru": "идёт", "options": ["t", "d"], "answer": "d", "explanation": "gitmek из клуба четырёх: t → d. gidiyor." },
        { "id": "8", "stem": "sa", "suffix": "ı", "ru": "волосы (кого? что?)", "options": ["ç", "c"], "answer": "ç", "explanation": "saç короткое. Буква держится: saçı." }
      ]
    },
