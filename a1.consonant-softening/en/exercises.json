{
  "topic": "a1.consonant-softening",
  "exercises": [
    {
      "id": "a1.consonant-softening.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "What happens at the seam?",
      "items": [
        {
          "id": "1",
          "prompt": "kitap + ı → ? (the book)",
          "options": [
            "kitapı",
            "kitabı"
          ],
          "answer": 1,
          "explanation": "The suffix starts with a vowel. p ended up between vowels and went soft: kitabı."
        },
        {
          "id": "2",
          "prompt": "ağaç + a → ? (to the tree)",
          "options": [
            "ağaça",
            "ağaca"
          ],
          "answer": 1,
          "explanation": "Before a vowel, ç becomes c: ağaca. c is the j in “jam”, ğ is silent: [ah-ah-jah]."
        },
        {
          "id": "3",
          "prompt": "çocuk + u → ? (the child)",
          "options": [
            "çocuğu",
            "çocuku",
            "çocugu"
          ],
          "answer": 0,
          "explanation": "k between vowels becomes ğ, not g. ğ is silent, like gh in “night”. Plain g only after n: renk → rengi."
        },
        {
          "id": "4",
          "prompt": "gitmek: he's going → ?",
          "options": [
            "gitiyor",
            "gidiyor"
          ],
          "answer": 1,
          "explanation": "gitmek is in the club of four. Before a vowel, t → d: gidiyor."
        },
        {
          "id": "5",
          "prompt": "top + u → ? (the ball)",
          "options": [
            "tobu",
            "topu"
          ],
          "answer": 1,
          "explanation": "top is short, one syllable. Those are usually stubborn: topu."
        }
      ]
    },
    {
      "id": "a1.consonant-softening.ex2",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "sort_buckets",
      "difficulty": 2,
      "instruction": "Does the letter change at the seam?",
      "items": [
        {
          "id": "1",
          "buckets": [
            {
              "id": "soft",
              "label": "Changes"
            },
            {
              "id": "same",
              "label": "Doesn't change"
            }
          ],
          "entries": [
            {
              "text": "sokak + a",
              "bucket": "soft"
            },
            {
              "text": "top + u",
              "bucket": "same"
            },
            {
              "text": "mektup + u",
              "bucket": "soft"
            },
            {
              "text": "kitap + lar",
              "bucket": "same"
            },
            {
              "text": "renk + i",
              "bucket": "soft"
            },
            {
              "text": "saat + i",
              "bucket": "same"
            },
            {
              "text": "kanat + ı",
              "bucket": "soft"
            },
            {
              "text": "ev + e",
              "bucket": "same"
            }
          ],
          "explanation": "p ç t k change before a vowel: sokağa, mektubu, rengi, kanadı. No change for short words (topu), loanwords (saati), a seam with a consonant (kitaplar), and voiced letters (ev + e = eve)."
        }
      ]
    },
    {
