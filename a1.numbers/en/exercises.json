      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "The board by the door shows a number. Pick how it sounds.",
      "items": [
        {
          "prompt": "14",
          "options": [
            "dört on",
            "on dört",
            "kırk"
          ],
          "answer": 1,
          "say": "on dört",
          "explanation": "14 is on dört — “ten four”. English flips it (four-teen), Turkish doesn’t. Kırk is 40."
        },
        {
          "prompt": "8",
          "options": [
            "seksen",
            "dokuz",
            "sekiz"
          ],
          "answer": 2,
          "say": "sekiz",
          "explanation": "8 is sekiz, like the bar’s name. Seksen is 80, dokuz is 9."
        },
        {
          "prompt": "60",
          "options": [
            "altmış",
            "altı on",
            "altı"
          ],
          "answer": 0,
          "say": "altmış",
          "explanation": "60 is altmış — it echoes altı (6), like six → sixty. But it’s one word, not “altı on”."
        },
        {
          "prompt": "22",
          "options": [
            "yirmi-iki",
            "yirmi iki",
            "iki yirmi"
          ],
          "answer": 1,
          "say": "yirmi iki",
          "explanation": "Big on the left, small on the right, written apart. No hyphen as in English “twenty-two”."
        },
        {
          "prompt": "100",
          "options": [
            "bir yüz",
            "yüz",
            "bin"
          ],
          "answer": 1,
          "say": "yüz",
          "explanation": "English says “one hundred”. Turkish says just yüz. Bin is a thousand."
        }
      ]
    },
