   "difficulty": 1,
   "instruction": "Pick the owner’s signature",
   "items": [
    {
     "id": "1",
     "prompt": "my house — ev →",
     "options": [
      "evim",
      "evin",
      "evi"
     ],
     "answer": 0,
     "explanation": "My is the signature m. Ev ends in a consonant, so the linking vowel i: evim.",
     "say": "evim"
    },
    {
     "id": "2",
     "prompt": "your bag — çanta →",
     "options": [
      "çantam",
      "çantan",
      "çantası"
     ],
     "answer": 1,
     "explanation": "Your is the signature n. Çanta ends in a vowel, no linking vowel needed: çantan.",
     "say": "çantan"
    },
    {
     "id": "3",
     "prompt": "his friend — arkadaş →",
     "options": [
      "arkadaşım",
      "arkadaşı",
      "arkadaşsı"
     ],
     "answer": 1,
     "explanation": "His is just ı after a consonant. The buffer s comes only after a vowel.",
     "say": "arkadaşı"
    },
    {
     "id": "4",
     "prompt": "my name — ad →",
     "options": [
      "adım",
      "adim",
      "adm"
     ],
     "answer": 0,
     "explanation": "ad has the vowel a — linking vowel ı, no dot. Say it like the a in “about”: adım.",
     "say": "adım"
    }
   ]
  },
