{
  "topic": "a1.var-yok",
  "exercises": [
    {
      "id": "a1.var-yok.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Spot the phrase. Where are the word order and the word right?",
      "items": [
        {
          "id": "i1",
          "prompt": "There’s a table in the room.",
          "options": [
            "Odada masa var.",
            "Var bir masa odada.",
            "Odada masa yok."
          ],
          "answer": 0,
          "say": "Odada masa var.",
          "explanation": "English starts with “there is.” Turkish ends with var. Place first, then the thing. No “a” needed."
        },
        {
          "id": "i2",
          "prompt": "There’s no fridge in the kitchen.",
          "options": [
            "Mutfakta buzdolabı değil.",
            "Mutfakta buzdolabı yok.",
            "Mutfak buzdolabı yok."
          ],
          "answer": 1,
          "say": "Mutfakta buzdolabı yok.",
          "explanation": "The fridge is missing — that’s yok. And the place takes -ta: mutfakta."
        },
        {
          "id": "i3",
          "prompt": "Is there a mirror in the bathroom?",
          "options": [
            "Banyoda ayna var mı?",
            "Banyoda ayna var mi?",
            "Var mı banyoda ayna?"
          ],
          "answer": 0,
          "say": "Banyoda ayna var mı?",
          "explanation": "Turkish doesn’t flip the words like “Is there…?” Same order, mı at the end. And mı has no dot after a."
        },
        {
          "id": "i4",
          "prompt": "Isn’t there a cat on the balcony?",
          "options": [
            "Balkonda kedi yok mı?",
            "Balkonda kedi yok mu?",
            "Balkonda kedi değil mi?"
          ],
          "answer": 1,
          "say": "Balkonda kedi yok mu?",
          "explanation": "After yok — mu: the vowel is o."
        },
        {
          "id": "i5",
          "prompt": "What’s in the room?",
          "options": [
            "Odada ne var mı?",
            "Odada ne var?",
            "Ne odada var?"
          ],
          "answer": 1,
          "say": "Odada ne var?",
          "explanation": "There’s the word ne — no need for mı."
        },
        {
          "id": "i6",
          "prompt": "This isn’t coffee.",
          "options": [
            "Bu kahve yok.",
            "Bu kahve değil.",
            "Bu kahve hayır."
          ],
          "answer": 1,
          "say": "Bu kahve değil.",
          "explanation": "“Isn’t” is değil. Yok means “there’s none.”"
        }
      ]
    },
    {
      "id": "a1.var-yok.ex2",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "matching",
      "difficulty": 1,
      "instruction": "Match the Turkish phrase and the translation.",
      "items": [
        {
          "id": "i1",
          "pairs": [
            {
              "left": "Masada kitap var.",
              "right": "There’s a book on the table."
            },
            {
              "left": "Kitap masada.",
              "right": "The book is on the table."
            },
            {
              "left": "Masada kitap yok.",
              "right": "There’s no book on the table."
            },
            {
              "left": "Bu kitap değil.",
              "right": "This isn’t a book."
            },
            {
              "left": "Masada kitap var mı?",
              "right": "Is there a book on the table?"
            }
          ],
          "explanation": "var — there is, yok — there isn’t. Kitap masada — where the book is. değil — “is not.”"
        }
      ]
    },
