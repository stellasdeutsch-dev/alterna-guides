        { "id": "4", "prompt": "Вы один. Берёте себе ещё стакан.", "verb": "al", "answer": "ayım", "word": "alayım", "explanation": "Я — -ayım, последняя гласная a: alayım." },
        { "id": "5", "prompt": "Зовёте всех в кино после чая.", "verb": "git", "answer": "elim", "word": "gidelim", "explanation": "Мы — -elim. И ловушка: git → gidelim." }
      ]
