          "options": [
            [
              "mayalım",
              "mayım",
              "alım"
            ]
          ],
          "translation": "Let's not make it too short!",
          "explanation": "Negation -ma, then the buffer y, then -alım: yapmayalım."
        }
      ]
    },
    {
      "id": "a1.optative.ex4",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "custom",
      "difficulty": 2,
      "instruction": "Tea house: who gets a pour?",
      "description": "A tea house situation and a verb. The learner picks the tail: -(y)eyim, -(y)ayım, -(y)elim, -(y)alım. One glass or five appears on the tray. Logic lives in index.html.",
      "items": [
        {
          "id": "1",
          "prompt": "You're alone. You want to think about getting another tea.",
          "verb": "düşün",
          "answer": "eyim",
          "word": "düşüneyim",
          "explanation": "I — -eyim, last vowel ü → e."
        },
        {
          "id": "2",
          "prompt": "You're inviting friends for a walk along the waterfront.",
          "verb": "yürü",
          "answer": "elim",
          "word": "yürüyelim",
          "explanation": "We — -elim. The stem ends in a vowel — buffer y: yürüyelim."
        },
        {
          "id": "3",
          "prompt": "You ask the group: shall we start?",
          "verb": "başla",
          "q": "mı?",
          "answer": "alım",
          "word": "başlayalım",
          "explanation": "We — -alım, last vowel a. Buffer y: başlayalım mı?"
        },
        {
          "id": "4",
          "prompt": "You're alone. Getting yourself another glass.",
          "verb": "al",
          "answer": "ayım",
          "word": "alayım",
          "explanation": "I — -ayım, last vowel a: alayım."
        },
        {
          "id": "5",
          "prompt": "You invite everyone to the movies after tea.",
          "verb": "git",
          "answer": "elim",
          "word": "gidelim",
          "explanation": "We — -elim. And the trap: git → gidelim."
        }
      ]
    },
