          "wrong": 2,
          "fix": "gidelim",
          "options": [
            "gidelim",
            "gideyim",
            "gitalım"
          ],
          "explanation": "Before a vowel, t turns into d: git → gidelim."
        },
        {
          "id": "3",
          "type": "build_sentence",
          "translation": "Shall we go to the movies?",
          "words": [
            "Sinemaya",
            "gidelim",
            "mi?"
          ],
          "distractors": [
            "gideyim",
            "mı?"
          ],
          "explanation": "We — gidelim. Last vowel i → question mi, as a separate word."
        },
        {
          "id": "4",
          "type": "gap_fill",
          "text": "Çok kısa yap___! (let's not)",
          "answers": [
