            ]
          ],
          "translation": "Shall I read now?",
          "explanation": "oku ends in a vowel — you need the buffer y. Last vowel u → -ayım: okuyayım."
        },
        {
          "id": "2",
          "type": "error_hunt",
          "prompt": "Find the mistake",
          "tokens": [
            "Hadi,",
            "sinemaya",
