      "instruction": "Pick the translation.",
      "items": [
        {
          "prompt": "You should read more.",
          "options": [
            "Daha çok kitap okumalısın.",
            "Daha çok kitap okuyorsun.",
            "Daha çok kitap okumalıyım."
          ],
          "answer": 0,
          "say": "Daha çok kitap okumalısın.",
          "explanation": "“You should” — the malı bracelet plus the ending -sın: okumalısın."
        },
        {
          "prompt": "I need to go to bed early tonight.",
          "options": [
            "Bu akşam erken yatmalısın.",
            "Bu akşam erken yatmalıyım.",
            "Bu akşam erken yatmeliyim."
          ],
          "answer": 1,
          "say": "Bu akşam erken yatmalıyım.",
          "explanation": "yat — vowel a, bracelet malı; “I” — -yım."
        },
        {
          "prompt": "You must not touch the statues (formal).",
          "options": [
            "Heykellere dokunmalısınız.",
            "Heykellere dokunmamalısınız.",
            "Heykellere dokunmalı değilsiniz."
          ],
          "answer": 1,
          "say": "Heykellere dokunmamalısınız.",
          "explanation": "A ban — ma before the bracelet: dokun-ma-malı-sınız."
        },
        {
          "prompt": "Selim must be at home.",
          "options": [
            "Selim evde olmalı.",
            "Selim evde olmalısın.",
            "Selim evde oluyor."
          ],
          "answer": 0,
          "say": "Selim evde olmalı.",
          "explanation": "A guess about him: olmalı with no ending."
        },
        {
          "prompt": "I must go.",
          "options": [
            "Ben gitmeli.",
            "Ben gitmeliyim.",
            "Ben gitmelisin."
          ],
          "answer": 1,
          "say": "Ben gitmeliyim.",
          "explanation": "English “must” never changes, but Turkish needs the person ending: gitmeliyim."
        }
      ]
    },
