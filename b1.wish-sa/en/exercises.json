      "type": "mixed",
      "difficulty": 2,
      "instruction": "Place it, build it, fix it",
      "items": [
        {
          "id": "1",
          "type": "gap_fill",
          "text": "Keşke param ___ . (olmak)",
          "answers": [
            [
              "olsa"
            ]
          ],
          "translation": "If only I had money.",
          "explanation": "ol + sa. The last vowel o is a back vowel, so -sa."
        },
        {
          "id": "2",
          "type": "build_sentence",
          "translation": "If only it were sunny tomorrow.",
          "words": [
            "Keşke",
            "yarın",
            "güneşli",
            "olsa."
          ],
          "distractors": [
            "oldu",
            "olacak"
          ],
          "explanation": "English says “were” (past) and puts it in the middle. Turkish: no past, no “would,” and the -sA verb goes last: Keşke yarın güneşli olsa."
        },
        {
          "id": "3",
          "type": "error_hunt",
          "prompt": "Find the mistake",
          "tokens": [
            "Keşke",
            "Türkçeyi",
            "iyi",
            "bilsam."
          ],
          "wrong": 3,
          "fix": "bilsem.",
          "options": [
            "bilsem.",
            "bilirsem."
          ],
          "explanation": "bil — last vowel i, so -se: bilsem. Bilirsem means “if I know,” not a dream."
        }
      ]
    },
    {
      "id": "b1.wish-sa.ex4",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "custom",
      "difficulty": 2,
      "instruction": "Konyaaltı waterfront: pick the sigh",
      "description": "A scene on the Antalya waterfront and a phrase with a gap. The learner picks one of three forms with a button or keys 1–3. Logic lives in index.html.",
      "items": [
        {
          "id": "1",
          "situation": "It’s hot. You wish the sea were closer.",
          "line": "Keşke deniz daha yakın ___",
          "options": [
            "olacak",
            "olsa",
            "olur"
          ],
          "answer": 1,
          "explanation": "English says “were.” Turkish doesn’t step back in time: a wish is -sA, olsa. Olur and olacak are regular tenses, not a sigh."
        },
        {
          "id": "2",
          "situation": "Your friend is about to leave. You say: if only you wouldn’t go.",
          "line": "Keşke ___",
          "options": [
            "gitmesen",
            "gitsen",
            "gitmezsin"
          ],
          "answer": 0,
          "explanation": "“If only… not” — you insert -mA- before -sA: git-me-se-n."
        },
        {
          "id": "3",
          "situation": "The bus is forty minutes late. Come on, just show up already!",
          "line": "Otobüs artık ___ !",
          "options": [
            "gelir",
            "gelecek",
            "gelse"
          ],
          "answer": 2,
          "explanation": "Impatience without keşke: artık + -sA. Gelse!"
        },
        {
          "id": "4",
          "situation": "You’re looking at the ice cream kiosk. Should I buy one?",
          "line": "Dondurma ___ ?",
          "options": [
            "alsam mı",
            "alsan mı",
            "alır mıyım"
          ],
          "answer": 0,
          "explanation": "“Should I…?” is one word in Turkish: -sA + ben (-m) + mı. No “should,” no word swap: alsam mı?"
        },
        {
          "id": "5",
          "situation": "The waiter talks fast. If only we knew Turkish better.",
          "line": "Keşke Türkçeyi daha iyi ___",
          "options": [
            "bilsak",
            "bilsek",
            "biliriz"
          ],
          "answer": 1,
          "explanation": "bil — vowel i, so -se. We is -k: bilsek."
        }
      ]
    },
