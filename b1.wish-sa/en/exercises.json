    {
      "id": "b1.wish-sa.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Find the sigh",
      "items": [
        {
          "id": "1",
          "prompt": "Which phrase means “if only you’d come”?",
          "say": "Keşke gelsen",
          "options": [
            "Keşke gelsen",
            "Keşke geleceksin",
            "Keşke gel"
          ],
          "answer": 0,
          "explanation": "English says “would,” but -ecek is “will,” and keşke doesn’t take it. Keşke always takes a verb in -sA: gel + se + n."
        },
        {
          "id": "2",
          "prompt": "bil → “if only I knew”",
          "say": "Keşke bilsem",
          "options": [
            "Keşke bilsam",
            "Keşke bilsem"
          ],
          "answer": 1,
          "explanation": "In bil the last vowel is i. Front. So -se."
        },
        {
          "id": "3",
          "prompt": "“Should I go?”",
          "say": "Gitsem mi?",
          "options": [
            "Gitsen mi?",
            "Gitsem mi?",
            "Gitse mi?"
          ],
          "answer": 1,
          "explanation": "“I” is ben. Ben gives -m: gitsem mi?"
        }
      ]
    },
    {
      "id": "b1.wish-sa.ex2",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "sort_buckets",
      "difficulty": 1,
      "instruction": "Sort the verbs by tail",
      "items": [
        {
          "id": "1",
          "buckets": [
            {
              "id": "sa",
              "label": "-sa"
            },
            {
              "id": "se",
              "label": "-se"
            }
          ],
          "entries": [
            {
              "text": "yap",
              "bucket": "sa"
            },
            {
              "text": "gel",
              "bucket": "se"
            },
            {
              "text": "oku",
              "bucket": "sa"
            },
            {
              "text": "gör",
              "bucket": "se"
            },
            {
              "text": "anla",
              "bucket": "sa"
            },
            {
              "text": "söyle",
              "bucket": "se"
            },
            {
              "text": "al",
              "bucket": "sa"
            },
            {
              "text": "bil",
              "bucket": "se"
            }
          ],
          "explanation": "Look only at the last vowel of the stem: a, ı, o, u → -sa; e, i, ö, ü → -se."
        }
      ]
    },
    {
      "id": "b1.wish-sa.ex3",
      "lesson": 1,
