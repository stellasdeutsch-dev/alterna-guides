{
  "topic": "c1.anlatim-bozuklugu",
  "exercises": [
    {
      "id": "c1.anlatim-bozuklugu.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Which word is extra?",
      "items": [
        {
          "id": "1",
          "prompt": "Parayı geri iade ettiler.",
          "say": "Parayı iade ettiler.",
          "options": [
            "parayı",
            "geri",
            "ettiler"
          ],
          "answer": 1,
          "explanation": "iade already means “return.” geri next to it is a belt on top of suspenders."
        },
        {
          "id": "2",
          "prompt": "Yaklaşık on kişi kadar geldi.",
          "say": "Yaklaşık on kişi geldi.",
          "options": [
            "kişi",
            "kadar",
            "geldi"
          ],
          "answer": 1,
          "explanation": "yaklaşık and kadar both mean “about.” One goes."
        },
        {
          "id": "3",
          "prompt": "Soruyu tekrar yeniden sordu.",
          "say": "Soruyu tekrar sordu.",
          "options": [
            "soruyu",
            "yeniden",
            "sordu"
          ],
          "answer": 1,
          "explanation": "tekrar and yeniden both mean “again.” One is enough."
        }
      ]
    },
    {
