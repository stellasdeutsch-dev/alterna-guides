          "id": "3",
          "type": "gap_fill",
          "text": "Yeni kurallar açıklandı ve hemen uygulamaya ___.",
          "answers": [
            [
              "kondu"
            ]
          ],
          "options": [
            [
              "kondu",
              "koydu"
            ]
          ],
          "translation": "The new rules were announced and put in place right away.",
          "explanation": "The first half has no doer: açıklandı. The second must have no doer too: kondu."
        }
      ]
    },
