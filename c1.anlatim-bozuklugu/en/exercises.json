    {
      "id": "c1.anlatim-bozuklugu.ex3",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "mixed",
      "difficulty": 2,
      "instruction": "Fix it and build it",
      "items": [
        {
          "id": "1",
          "type": "error_hunt",
          "prompt": "Find the wrong word",
          "tokens": [
            "Fiyatlar",
            "bu",
            "yıl",
            "çok",
            "pahalı."
          ],
          "wrong": 4,
          "fix": "yüksek.",
          "options": [
            "yüksek.",
            "ucuz."
          ],
          "explanation": "A price isn't expensive. A price is high: fiyatlar yüksek."
        },
        {
          "id": "2",
          "type": "build_sentence",
          "translation": "A cup of hot tea, please.",
          "words": [
            "Bir",
            "fincan",
            "sıcak",
            "çay",
            "lütfen."
          ],
          "explanation": "The tea is hot, so sıcak sits right next to çay: bir fincan sıcak çay."
        },
        {
          "id": "3",
          "type": "gap_fill",
          "text": "Komşumun oğlu çok ___.",
          "answers": [
            [
              "çekingen"
            ]
          ],
          "options": [
            [
              "çekingen",
              "çekimser"
            ]
          ],
          "translation": "My neighbor's son is very shy.",
          "explanation": "Shy is çekingen. çekimser is someone who abstained from a vote."
        }
      ]
    },
    {
      "id": "c1.anlatim-bozuklugu.ex4",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "custom",
      "difficulty": 2,
      "instruction": "Newspaper proofreader: strike the extra word in the headline",
      "description": "Samsun Haber headlines, one at a time. The learner taps the word to strike out (extra or contradictory). Keys 1–9 pick a word from the keyboard. Logic is in index.html.",
      "items": [
        {
          "id": "1",
          "tokens": [
            "Belediye",
            "fazla",
            "parayı",
            "geri",
            "iade",
            "etti"
          ],
          "answer": [
            "geri"
          ],
          "fixed": "Belediye fazla parayı iade etti",
          "explanation": "This word is needed. The extra one is geri: iade already means “return.”"
        },
        {
          "id": "2",
          "tokens": [
            "Yaklaşık",
            "yüz",
            "kişi",
            "kadar",
            "katıldı"
          ],
          "answer": [
            "Yaklaşık",
            "kadar"
          ],
          "fixed": "Yaklaşık yüz kişi katıldı",
          "explanation": "This word holds the meaning. The extra one is one of the two “abouts”: yaklaşık or kadar."
        },
        {
          "id": "3",
          "tokens": [
            "Konser",
            "tekrar",
            "yeniden",
            "ertelendi"
          ],
          "answer": [
            "tekrar",
            "yeniden"
          ],
          "fixed": "Konser yeniden ertelendi",
          "explanation": "Without this word the meaning is gone. The extra one is tekrar or yeniden, both “again.”"
        },
        {
          "id": "4",
          "tokens": [
            "Otobüsler",
            "genellikle",
            "her zaman",
            "geç",
            "kalıyor"
          ],
          "answer": [
            "genellikle",
            "her zaman"
          ],
          "fixed": "Otobüsler her zaman geç kalıyor",
          "explanation": "This word belongs here. “Usually” and “always” are fighting. Strike one of them."
        }
      ]
    },
    {
      "id": "c1.anlatim-bozuklugu.check1",
      "lesson": 1,
      "kind": "check",
      "skill": "grammar",
      "type": "mixed",
      "difficulty": 2,
      "passPercent": 80,
      "instruction": "Quick check",
      "items": [
        {
          "id": "1",
          "type": "multiple_choice",
          "prompt": "Which sentence contradicts itself?",
          "options": [
            "Kesinlikle haklısın.",
            "Galiba kesinlikle haklısın.",
            "Galiba haklısın."
          ],
          "answer": 1,
          "explanation": "galiba is doubt, kesinlikle is certainty. They can't live together."
        },
        {
          "id": "2",
          "type": "true_false",
          "statement": "Bu evin fiyatı çok yüksek. — the sentence is correct.",
          "answer": true,
          "explanation": "A price is a number, so yüksek fits. All good."
        },
        {
          "id": "3",
          "type": "multiple_choice",
          "prompt": "“A cup of hot tea” — which is right?",
          "options": [
            "Sıcak bir fincan çay",
            "Bir fincan sıcak çay"
          ],
          "answer": 1,
          "explanation": "Sıcak bir fincan is a hot cup. The tea is what should be hot: bir fincan sıcak çay."
        },
        {
          "id": "4",
          "type": "gap_fill",
          "text": "Mağaza parayı ___ etti.",
          "answers": [
            [
              "iade"
            ]
          ],
          "options": [
            [
              "iade",
              "geri iade"
            ]
          ],
          "translation": "The store refunded the money.",
          "explanation": "iade already means “return.” geri iade has an extra word."
        },
        {
          "id": "5",
          "type": "multiple_choice",
          "prompt": "Arkadaşını gördüm. What's unclear here?",
          "options": [
            "who saw",
            "whose friend it is",
            "when they saw"
          ],
          "answer": 1,
          "explanation": "Your friend or his? Name the owner: senin arkadaşını or onun arkadaşını."
        }
      ]
    },
    {
      "id": "c1.anlatim-bozuklugu.ex5",
      "lesson": 2,
      "kind": "practice",
      "skill": "grammar",
      "type": "true_false",
      "difficulty": 1,
      "instruction": "Shake it twice: is the build broken?",
      "items": [
        {
          "id": "1",
          "statement": "Bu kitabı okudum ve beğendim. — there's an error here.",
          "answer": false,
          "explanation": "Both verbs want -i: kitabı okudum, kitabı beğendim. The shared object works."
        },
        {
          "id": "2",
          "statement": "Komşulara güveniyoruz ve seviyoruz. — there's an error here.",
          "answer": true,
          "explanation": "Komşulara seviyoruz sounds wrong. sevmek wants -i: onları seviyoruz."
        },
        {
          "id": "3",
          "statement": "Hava çok güzel, biz de sahile gittik. — there's an error here.",
          "answer": true,
          "explanation": "The weather is “now,” the beach was “yesterday.” You need güzeldi."
        }
      ]
    },
    {
      "id": "c1.anlatim-bozuklugu.ex6",
      "lesson": 2,
      "kind": "practice",
      "skill": "grammar",
      "type": "matching",
      "difficulty": 2,
      "instruction": "Subject and predicate: match the pairs",
      "items": [
        {
          "id": "1",
          "pairs": [
            {
              "left": "Ben ve sen",
              "right": "gideceğiz"
            },
            {
              "left": "Sen ve o",
              "right": "gideceksiniz"
            },
            {
              "left": "Ben ve kardeşim",
              "right": "gideceğiz"
            },
            {
              "left": "Ben",
              "right": "gideceğim"
            }
          ],
          "explanation": "Count the people: ben + anyone = biz → -iz. sen + o = siz → -siniz."
        }
      ]
    },
