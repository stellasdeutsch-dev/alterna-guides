        },
        {
          "id": "3",
          "prompt": "Kemal uyuyordur.",
          "say": "Kemal uyuyordur.",
          "options": ["Кемаль спал.", "Кемаль, наверное, спит.", "Кемаль будет спать."],
          "answer": 1,
          "explanation": "-yor — сейчас, -dur — догадка. Кемаль, наверное, спит."
        },
        {
          "id": "4",
          "prompt": "Табличка на двери: «Giriş ücretsizdir.»",
          "say": "Giriş ücretsizdir.",
          "options": ["Вход, наверное, бесплатный.", "Вход бесплатный. Официально."],
          "answer": 1,
          "explanation": "Табличка не гадает. На ней -dır ставит печать."
        },
        {
          "id": "5",
          "prompt": "Selin gelmeyecektir.",
          "say": "Selin gelmeyecektir.",
          "options": ["Селин, наверное, не придёт.", "Селин, наверное, пришла.", "Селин не пришла."],
          "answer": 0,
          "explanation": "-me — «не», -yecek — будущее, -tir — догадка. Наверное, не придёт."
        }
      ]
    },
