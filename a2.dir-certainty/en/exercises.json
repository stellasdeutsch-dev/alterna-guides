{
  "topic": "a2.dir-certainty",
  "exercises": [
    {
      "id": "a2.dir-certainty.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "What does the sentence mean?",
      "items": [
        {
          "id": "1",
          "prompt": "Ali evdedir.",
          "say": "Ali evdedir.",
          "options": [
            "Ali is home. I can see him.",
            "Ali must be home."
          ],
          "answer": 1,
          "explanation": "The -dir tail is a guess, like “must be”. If you saw him, you'd just say “Ali evde.”"
        },
        {
          "id": "2",
          "prompt": "Toplantı bitmiştir.",
          "say": "Toplantı bitmiştir.",
          "options": [
            "The meeting has probably ended.",
            "The meeting will end.",
            "The meeting is on."
          ],
          "answer": 0,
          "explanation": "-miş is the past, -tir is the guess. Together: “has probably ended.”"
        },
        {
          "id": "3",
          "prompt": "Kemal uyuyordur.",
          "say": "Kemal uyuyordur.",
          "options": [
            "Kemal was sleeping.",
            "Kemal is probably sleeping.",
            "Kemal will sleep."
          ],
          "answer": 1,
          "explanation": "-yor is now, -dur is the guess. Kemal is probably sleeping."
        },
        {
          "id": "4",
          "prompt": "A sign on the door: “Giriş ücretsizdir.”",
          "say": "Giriş ücretsizdir.",
          "options": [
            "Entry is probably free.",
            "Entry is free. Official."
          ],
          "answer": 1,
          "explanation": "A sign doesn't guess. On it, -dır is an official “is”, not “probably”."
        },
        {
          "id": "5",
          "prompt": "Selin gelmeyecektir.",
          "say": "Selin gelmeyecektir.",
          "options": [
            "Selin probably won't come.",
            "Selin has probably come.",
            "Selin didn't come."
          ],
          "answer": 0,
          "explanation": "-me is “not,” -yecek is the future, -tir is the guess. Probably won't come."
        }
      ]
    },
    {
      "id": "a2.dir-certainty.ex2",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "sort_buckets",
      "difficulty": 1,
      "instruction": "Do you see it yourself or are you guessing? Sort the situations",
      "items": [
        {
          "id": "1",
          "buckets": [
            {
              "id": "fact",
              "label": "Kafe açık."
            },
            {
              "id": "guess",
              "label": "Kafe açıktır."
            }
          ],
          "entries": [
            {
              "text": "You're standing by the café and see people inside",
              "bucket": "fact"
            },
            {
              "text": "Nine a.m., the café usually opens at eight",
              "bucket": "guess"
            },
            {
              "text": "You're sitting inside drinking tea",
              "bucket": "fact"
            },
            {
              "text": "A friend asks, and you're at home on the couch",
              "bucket": "guess"
            },
            {
              "text": "The owner opened the door in front of you",
              "bucket": "fact"
            },
            {
              "text": "You can see a light from far away, but not the door",
              "bucket": "guess"
            }
          ],
          "explanation": "You see it yourself — no tail. You don't see it, you assume — with the -tır tail."
        }
      ]
    },
    {
      "id": "a2.dir-certainty.ex3",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "gap_fill",
      "difficulty": 2,
      "instruction": "Pick the tail",
      "items": [
        {
          "id": "1",
          "text": "Ali şimdi uyuyor___.",
          "answers": [
            [
              "dur"
            ]
          ],
          "options": [
            [
              "dır",
              "dur",
              "tur"
            ]
          ],
          "translation": "Ali is probably asleep right now.",
          "explanation": "After -yor the tail is always -dur: -yor has the vowel o, and r is voiced."
        },
        {
          "id": "2",
          "text": "Toplantı bitmiş___.",
          "answers": [
            [
              "tir"
            ]
          ],
          "options": [
            [
              "dir",
              "tir",
              "tır"
            ]
          ],
          "translation": "The meeting has probably ended.",
          "explanation": "-miş ends in ş — voiceless, so t. The vowel is i — the tail is -tir."
        },
        {
          "id": "3",
          "text": "Kemal yarın gelecek___.",
          "answers": [
            [
              "tir"
            ]
          ],
          "options": [
            [
              "dir",
              "tir"
            ]
          ],
          "translation": "Kemal will probably come tomorrow.",
          "explanation": "K is voiceless — so is the tail: gelecektir. And k doesn't soften here."
        },
        {
          "id": "4",
          "text": "Ayşe hasta___.",
          "answers": [
            [
              "dır"
            ]
          ],
          "options": [
            [
              "dır",
              "tır",
              "dir"
            ]
          ],
          "translation": "Ayşe is probably sick.",
          "explanation": "The word ends in the vowel a — so d and ı: hastadır."
        },
        {
          "id": "5",
          "text": "Elif üzgün___.",
          "answers": [
            [
              "dür"
            ]
          ],
          "options": [
            [
              "dur",
              "dür",
              "tür"
            ]
          ],
          "translation": "Elif is probably sad.",
          "explanation": "The last vowel is ü — the tail takes ü. N is voiced — so d. Say ü like “ee” with round lips."
        }
      ]
    },
    {
      "id": "a2.dir-certainty.ex4",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "mixed",
      "difficulty": 3,
      "instruction": "Build, fix, and say your own",
      "items": [
        {
          "id": "1",
          "type": "build_sentence",
          "translation": "Ali is probably asleep at home right now.",
          "words": [
            "Ali",
            "şimdi",
            "evde",
            "uyuyordur."
          ],
          "distractors": [
            "uyuyordır."
          ],
          "explanation": "Order: who, when, where, predicate with the tail. After -yor — only -dur."
        },
        {
          "id": "2",
          "type": "error_hunt",
          "prompt": "Find the mistake",
          "tokens": [
            "Kemal",
            "yarın",
            "gelecekdir."
          ],
          "wrong": 2,
          "fix": "gelecektir.",
          "options": [
            "gelecektir.",
            "geleceğdir."
          ],
          "explanation": "After k the tail is voiceless: -tir. And k doesn't turn into ğ — a consonant comes next."
        },
        {
          "id": "3",
          "type": "build_sentence",
          "translation": "The ferry has probably already reached Karşıyaka.",
          "words": [
            "Vapur",
            "Karşıyaka'ya",
            "varmıştır."
          ],
          "distractors": [
            "vardıdır."
          ],
          "explanation": "A guess about the past goes through -mış: varmıştır. The tail doesn't get along with -dı."
        },
        {
          "id": "4",
          "type": "error_hunt",
          "prompt": "Find the mistake",
          "tokens": [
            "Ali",
            "dün",
            "geldidir."
          ],
          "wrong": 2,
          "fix": "gelmiştir.",
          "options": [
            "gelmiştir.",
            "geldiydir."
          ],
          "explanation": "“Must have come”, not “must came”. In Turkish too: -mış, not -dı. Gelmiştir."
        },
        {
          "id": "5",
          "type": "gap_fill",
          "text": "Bugün İzmir'de hava sıcak___.",
          "answers": [
            [
              "tır"
            ]
          ],
          "translation": "It's probably hot in Izmir today.",
          "explanation": "Sıcak: vowel a → ı, k is voiceless → t. Sıcaktır."
        }
      ]
    },
    {
      "id": "a2.dir-certainty.ex5",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "custom",
      "difficulty": 2,
      "instruction": "Sticker sheet: stick on the right tail",
      "description": "Eight stickers -dır … -tür. The learner taps a sticker (or keys 1–8) and it sticks to the word. Logic is in index.html.",
      "items": [
        {
          "id": "1",
          "prompt": "Ali yolda",
          "say": "Ali yoldadır.",
          "answer": "dır",
          "explanation": "Ends in the vowel a → d and ı."
        },
        {
          "id": "2",
          "prompt": "Ayşe evde",
          "say": "Ayşe evdedir.",
          "answer": "dir",
          "explanation": "Ends in the vowel e → d and i."
        },
        {
          "id": "3",
          "prompt": "Kemal yorgun",
          "say": "Kemal yorgundur.",
          "answer": "dur",
          "explanation": "Vowel u, n is voiced → -dur."
        },
        {
          "id": "4",
          "prompt": "Kedi aç",
          "say": "Kedi açtır.",
          "answer": "tır",
          "explanation": "Vowel a, ç is voiceless → -tır."
        },
        {
          "id": "5",
          "prompt": "Toplantı bitmiş",
          "say": "Toplantı bitmiştir.",
          "answer": "tir",
          "explanation": "Vowel i, ş is voiceless → -tir."
        },
        {
          "id": "6",
          "prompt": "Saat üç",
          "say": "Saat üçtür.",
          "answer": "tür",
          "explanation": "Vowel ü, ç is voiceless → -tür."
        },
        {
          "id": "7",
          "prompt": "Elif üzgün",
          "say": "Elif üzgündür.",
          "answer": "dür",
          "explanation": "Vowel ü, n is voiced → -dür."
        },
        {
          "id": "8",
          "prompt": "Deniz soğuk",
          "say": "Deniz soğuktur.",
          "answer": "tur",
          "explanation": "Vowel u, k is voiceless → -tur."
        }
      ]
    },
    {
      "id": "a2.dir-certainty.check1",
      "lesson": 1,
      "kind": "check",
      "skill": "grammar",
      "type": "mixed",
      "difficulty": 2,
      "passPercent": 80,
      "instruction": "Mini check",
      "items": [
        {
          "id": "1",
          "type": "multiple_choice",
          "prompt": "You can't see Kemal, but you think he's at work. How do you say it?",
          "options": [
            "Kemal işte.",
            "Kemal iştedir.",
            "Kemal işdedir."
          ],
          "answer": 1,
          "explanation": "A guess takes the tail. İş ends in ş, so -te, then -dir: iştedir."
        },
        {
          "id": "2",
          "type": "multiple_choice",
          "prompt": "A sign at the entrance: “Müze pazartesi kapalıdır.” What is it?",
          "say": "Müze pazartesi kapalıdır.",
          "options": [
            "The museum is probably closed on Mondays.",
            "The museum is closed on Mondays. Official."
          ],
          "answer": 1,
          "explanation": "On a sign, -dır doesn't guess. It sets a stamp."
        },
        {
          "id": "3",
          "type": "true_false",
          "statement": "“Geldidir” is a correct guess about the past.",
          "answer": false,
          "explanation": "The tail doesn't get along with -dı. Correct: gelmiştir."
        },
        {
          "id": "4",
          "type": "multiple_choice",
          "prompt": "Your friend looks pale. “You must be tired.” How do you say it?",
          "options": [
            "Sen yorgunsundur.",
            "Sen yorgundur.",
            "Sen yorgunsundır."
          ],
          "answer": 0,
          "explanation": "“Sen” alone is not enough: -sun goes inside, then the tail. After u — -dur: yorgun-sun-dur."
        },
        {
          "id": "5",
          "type": "multiple_choice",
          "prompt": "How do you say “He probably won't come”?",
          "options": [
            "Gelmeyecektir.",
            "Gelecek değildir.",
            "Gelmeyecekdir."
          ],
          "answer": 0,
          "explanation": "“Not” goes before the tense: gel-me-yecek, then the tail. After k — voiceless -tir."
        }
      ]
    }
  ]
}
