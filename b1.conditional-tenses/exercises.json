{
  "topic": "b1.conditional-tenses",
  "exercises": [
    {
      "id": "b1.conditional-tenses.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Узнай время. Какая форма передаёт смысл?",
      "items": [
        { "id": "i1", "prompt": "если она уже позвонила", "options": ["ararsa", "aradıysa", "arayacaksa"], "answer": 1, "say": "aradıysa", "explanation": "«Уже» — это прошлое -dı: ara-dı-ysa. После гласной нужен мостик y." },
        { "id": "i2", "prompt": "если ты сейчас работаешь", "options": ["çalışırsan", "çalışıyorsan", "çalıştıysan"], "answer": 1, "say": "çalışıyorsan", "explanation": "«Сейчас» — это -iyor: çalışıyor + san." },
        { "id": "i3", "prompt": "если, говорят, магазин закрылся", "options": ["kapanırsa", "kapanmışsa", "kapanacaksa"], "answer": 1, "say": "kapanmışsa", "explanation": "«Говорят» — ты узнал не сам. Это -mış: kapanmışsa." },
        { "id": "i4", "prompt": "если вы собираетесь купить билет", "options": ["alacaksanız", "aldıysanız", "almışsanız"], "answer": 0, "say": "alacaksanız", "explanation": "«Собираетесь» — план, будущее -acak: alacaksanız." },
        { "id": "i5", "prompt": "если вдруг пойдёт дождь", "options": ["yağarsa", "yağıyorsa", "yağdıysa"], "answer": 0, "say": "yağarsa", "explanation": "«Если вдруг», без часов — это широкое время, как в gelirse: yağarsa." },
        { "id": "i6", "prompt": "если мы не успели", "options": ["yetişmediysek", "yetişmezsek", "yetişmeyeceksek"], "answer": 0, "say": "yetişmediysek", "explanation": "Не успели — это уже случилось. Прошлое с отрицанием: yetiş-me-di-y-se-k." }
      ]
    },
    {
      "id": "b1.conditional-tenses.ex2",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "matching",
      "difficulty": 1,
      "instruction": "Соедини форму и её смысл.",
      "items": [
        {
          "id": "i1",
          "pairs": [
            { "left": "geliyorsa", "right": "если идёт сейчас" },
            { "left": "geldiyse", "right": "если уже пришёл" },
            { "left": "gelmişse", "right": "если, говорят, пришёл" },
            { "left": "gelecekse", "right": "если собирается прийти" },
            { "left": "gelirse", "right": "если вдруг придёт" }
          ],
          "explanation": "Середина решает всё: -iyor — сейчас, -di — уже, -miş — говорят, -ecek — план, -ir — вообще."
        }
      ]
    },
    {
      "id": "b1.conditional-tenses.ex3",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "gap_fill",
      "difficulty": 2,
      "instruction": "Вставь форму. Смотри на перевод: там подсказка о времени.",
      "items": [
        { "id": "i1", "text": "Yarın ___ haber ver.", "translation": "Если собираешься прийти завтра, дай знать.", "answers": [["geleceksen"]], "options": [["geleceksen", "geldiysen", "gelmişsen"]], "say": "Yarın geleceksen haber ver.", "explanation": "План на завтра — будущее -ecek: geleceksen. Буква k не смягчается." },
        { "id": "i2", "text": "Ödevini ___ çıkabilirsin.", "translation": "Если ты уже закончил домашку, можешь идти.", "answers": [["bitirdiysen"]], "options": [["bitirdiysen", "bitireceksen", "bitiriyorsan"]], "say": "Ödevini bitirdiysen çıkabilirsin.", "explanation": "«Уже закончил» — прошлое: bitir-di-y-se-n." },
        { "id": "i3", "text": "Şarjın ___ benim telefonumu al.", "translation": "Если у тебя кончилась зарядка, возьми мой телефон.", "answers": [["bittiyse"]], "options": [["bittiyse", "bitecekse", "bitiyorsa"]], "say": "Şarjın bittiyse benim telefonumu al.", "explanation": "Зарядка уже кончилась — прошлое: bitti + y + se." },
        { "id": "i4", "text": "Onlar ___ biz başlıyoruz.", "translation": "Если они не собираются приходить, мы начинаем.", "answers": [["gelmeyeceklerse"]], "options": [["gelmeyeceklerse", "gelmeyecekseler", "gelmediyseler"]], "say": "Onlar gelmeyeceklerse biz başlıyoruz.", "explanation": "План с отрицанием: gel-me-yecek. «Они» прячут -ler перед -se: gelmeyeceklerse." },
        { "id": "i5", "text": "Kerem ___ kapıyı aç.", "translation": "Если Керем, оказывается, пришёл, открой дверь.", "answers": [["gelmişse"]], "options": [["gelmişse", "gelecekse", "geliyorsa"]], "say": "Kerem gelmişse kapıyı aç.", "explanation": "«Оказывается» — узнал не сам. Это -miş: gelmişse." },
        { "id": "i6", "text": "Siz de ___ masa ayırtıyorum.", "translation": "Если вы тоже идёте, я бронирую столик.", "answers": [["geliyorsanız"]], "options": [["geliyorsanız", "geliyorsunuzsa", "geldiyseniz"]], "say": "Siz de geliyorsanız masa ayırtıyorum.", "explanation": "«Идёте» сейчас — -iyor. Лицо в самом конце, после -sa: geliyorsanız." }
      ]
    },
    {
      "id": "b1.conditional-tenses.ex4",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "build_sentence",
      "difficulty": 2,
      "instruction": "Собери фразу. Одно слово лишнее.",
      "items": [
        { "id": "i1", "translation": "Если ты уже купил билет, пришли мне.", "words": ["Bileti", "aldıysan", "bana", "gönder."], "distractors": ["alırsan"], "say": "Bileti aldıysan bana gönder.", "explanation": "«Уже купил» — прошлое: aldıysan. alırsan значит «если вдруг купишь»." },
        { "id": "i2", "translation": "Если ты собираешься в Кемер, позвони мне.", "words": ["Kemer'e", "gideceksen", "beni", "ara."], "distractors": ["gittiysen"], "say": "Kemer'e gideceksen beni ara.", "explanation": "«Собираешься» — план: gideceksen." },
        { "id": "i3", "translation": "Если идёт дождь, сидим дома.", "words": ["Yağmur", "yağıyorsa", "evde", "kalıyoruz."], "distractors": ["yağdıysa"], "say": "Yağmur yağıyorsa evde kalıyoruz.", "explanation": "Дождь идёт прямо сейчас — -iyor: yağıyorsa." },
        { "id": "i4", "translation": "Если автобус, оказывается, ушёл, возьмём такси.", "words": ["Otobüs", "gitmişse", "taksiye", "bineriz."], "distractors": ["gidecekse"], "say": "Otobüs gitmişse taksiye bineriz.", "explanation": "«Оказывается» — -miş: gitmişse." }
      ]
    },
    {
      "id": "b1.conditional-tenses.ex5",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "custom",
      "difficulty": 2,
      "instruction": "Уведомления: допиши условие так, чтобы смысл совпал с подсказкой.",
      "description": "На телефон приходит уведомление: ситуация по-русски и турецкая фраза с пропуском. Ученик выбирает форму условного с нужным временем.",
      "items": [
        { "id": "i1", "ru": "Если ты СЕЙЧАС идёшь на пляж, возьми полотенце.", "text": "Plaja ___, havlu al.", "options": ["geliyorsan", "geldiysen", "geleceksen"], "answer": 0, "explanation": "Сейчас — -iyor: geliyorsan." },
        { "id": "i2", "ru": "Если ты УЖЕ добрался до отеля, напиши.", "text": "Otele ___, yaz.", "options": ["varıyorsan", "vardıysan", "varacaksan"], "answer": 1, "explanation": "Уже — прошлое: vardıysan." },
        { "id": "i3", "ru": "Если автобус, ГОВОРЯТ, уже ушёл, возьмём такси.", "text": "Otobüs ___, taksiye bineriz.", "options": ["gidiyorsa", "gitmişse", "gidecekse"], "answer": 1, "explanation": "Говорят — узнал не сам: gitmişse." },
        { "id": "i4", "ru": "Если ты СОБИРАЕШЬСЯ в Кемер, позвони мне.", "text": "Kemer'e ___, beni ara.", "options": ["gittiysen", "gitmişsen", "gideceksen"], "answer": 2, "explanation": "Собираешься — план: gideceksen." },
        { "id": "i5", "ru": "Если ты УЖЕ прочитал книгу, дай мне.", "text": "Kitabı ___, bana ver.", "options": ["okuyorsan", "okuduysan", "okuyacaksan"], "answer": 1, "explanation": "Уже прочитал — прошлое: okuduysan." },
        { "id": "i6", "ru": "Если они СЕЙЧАС плавают, подождём.", "text": "Onlar şimdi ___, bekleriz.", "options": ["yüzüyorlarsa", "yüzdülerse", "yüzeceklerse"], "answer": 0, "explanation": "Сейчас — -iyor, а «они» прячут -lar перед -sa: yüzüyorlarsa." },
        { "id": "i7", "ru": "Если Ахмет, ОКАЗЫВАЕТСЯ, уснул, не буди его.", "text": "Ahmet ___, onu uyandırma.", "options": ["uyuyorsa", "uyuduysa", "uyumuşsa"], "answer": 2, "explanation": "Оказывается — -muş: uyumuşsa." },
        { "id": "i8", "ru": "Если вы СОБИРАЕТЕСЬ на лодочную прогулку, вставайте рано.", "text": "Tekne turu ___, erken kalkın.", "options": ["yaptıysanız", "yapmışsanız", "yapacaksanız"], "answer": 2, "explanation": "Собираетесь — план: yapacaksanız." },
        { "id": "i9", "ru": "Если ты НЕ видел водопад, съезди на Дюден.", "text": "Şelaleyi ___, Düden'e git.", "options": ["görmüyorsan", "görmediysen", "görmeyeceksen"], "answer": 1, "explanation": "Не видел — прошлое с отрицанием: gör-me-di-y-se-n." },
        { "id": "i10", "ru": "Если ты НЕ собираешься купаться, посторожи вещи.", "text": "___, eşyalara bak.", "options": ["Yüzmeyeceksen", "Yüzmediysen", "Yüzmüyorsan"], "answer": 0, "explanation": "Не собираешься — план с отрицанием: yüz-me-yecek-sen." }
      ]
    },
    {
      "id": "b1.conditional-tenses.check1",
      "lesson": 1,
      "kind": "check",
      "skill": "grammar",
      "type": "mixed",
      "difficulty": 2,
      "instruction": "Мини-проверка: пять вопросов вперемешку.",
      "passPercent": 80,
      "items": [
        { "id": "q1", "type": "multiple_choice", "prompt": "«если они сейчас идут»", "options": ["geliyorsalar", "geliyorlarsa", "gelirlerse"], "answer": 1, "say": "geliyorlarsa", "explanation": "«Они» прячут -lar перед -sa: geliyorlarsa. gelirlerse — это «если вдруг придут»." },
        { "id": "q2", "type": "true_false", "statement": "В gelecekse буква k превращается в ğ.", "answer": false, "explanation": "После k идёт согласная s. Смягчать не перед чем: gelecekse." },
        { "id": "q3", "type": "multiple_choice", "prompt": "Ahmet uyumuşsa… — что это значит?", "options": ["если Ахмет, оказывается, уснул", "если Ахмет вдруг уснёт", "если Ахмет собирается спать"], "answer": 0, "say": "Ahmet uyumuşsa", "explanation": "-muş — ты узнал не сам: «оказывается, уснул»." },
        { "id": "q4", "type": "gap_fill", "text": "Filmi ___ bana anlat.", "translation": "Если ты уже посмотрел фильм, расскажи мне.", "answers": [["izlediysen"]], "options": [["izlersen", "izlediysen", "izleyeceksen"]], "say": "Filmi izlediysen bana anlat.", "explanation": "«Уже посмотрел» — прошлое: izle-di-y-se-n." },
        { "id": "q5", "type": "multiple_choice", "prompt": "«если вы собираетесь в Анталью»", "options": ["Antalya'ya gidecekseniz", "Antalya'ya gittiyseniz", "Antalya'ya gitmişseniz"], "answer": 0, "say": "Antalya'ya gidecekseniz", "explanation": "«Собираетесь» — план: gidecekseniz." }
      ]
    }
  ]
}
