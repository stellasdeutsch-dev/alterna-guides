{
  "topic": "b1.conditional-tenses",
  "exercises": [
    {
      "id": "b1.conditional-tenses.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Spot the tense. Which form carries the meaning?",
      "items": [
        {
          "id": "i1",
          "prompt": "if she already called",
          "options": [
            "ararsa",
            "aradıysa",
            "arayacaksa"
          ],
          "answer": 1,
          "say": "aradıysa",
          "explanation": "“Already” is the past -dı: ara-dı-ysa. After a vowel you need the y bridge."
        },
        {
          "id": "i2",
          "prompt": "if you’re working right now",
          "options": [
            "çalışırsan",
            "çalışıyorsan",
            "çalıştıysan"
          ],
          "answer": 1,
          "say": "çalışıyorsan",
          "explanation": "“Right now” is -iyor: çalışıyor + san."
        },
        {
          "id": "i3",
          "prompt": "if, word is, the store closed",
          "options": [
            "kapanırsa",
            "kapanmışsa",
            "kapanacaksa"
          ],
          "answer": 1,
          "say": "kapanmışsa",
          "explanation": "“Word is” means you didn’t find out yourself. That’s -mış: kapanmışsa."
        },
        {
          "id": "i4",
          "prompt": "if you’re going to buy a ticket",
          "options": [
            "alacaksanız",
            "aldıysanız",
            "almışsanız"
          ],
          "answer": 0,
          "say": "alacaksanız",
          "explanation": "“Going to” is a plan, the future -acak: alacaksanız."
        },
        {
          "id": "i5",
          "prompt": "if it happens to rain",
          "options": [
            "yağarsa",
            "yağıyorsa",
            "yağdıysa"
          ],
          "answer": 0,
          "say": "yağarsa",
          "explanation": "“If it happens to,” no clock attached, is the aorist, like in gelirse: yağarsa."
        },
        {
          "id": "i6",
          "prompt": "if we didn’t make it",
          "options": [
            "yetişmediysek",
            "yetişmezsek",
            "yetişmeyeceksek"
          ],
          "answer": 0,
          "say": "yetişmediysek",
          "explanation": "Didn’t make it means it already happened. Past with negation: yetiş-me-di-y-se-k."
        }
      ]
    },
    {
      "id": "b1.conditional-tenses.ex2",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "matching",
      "difficulty": 1,
      "instruction": "Match each form to its meaning.",
      "items": [
        {
          "id": "i1",
          "pairs": [
            {
              "left": "geliyorsa",
              "right": "if he’s coming right now"
            },
            {
              "left": "geldiyse",
              "right": "if he already came"
            },
            {
              "left": "gelmişse",
              "right": "if, word is, he came"
            },
            {
              "left": "gelecekse",
              "right": "if he’s going to come"
            },
            {
              "left": "gelirse",
              "right": "if he happens to come"
            }
          ],
          "explanation": "The middle decides everything: -iyor is now, -di is already, -miş is word is, -ecek is a plan, -ir is in general."
        }
      ]
    },
