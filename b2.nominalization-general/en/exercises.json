              "ndan"
            ]
          ],
          "translation": "I know he lives in Ankara.",
          "explanation": "bilmek takes -ı: yaşadığını. English says “lives” (present) — -DIk covers the present too."
        },
        {
          "text": "Kazandığı___ inanamıyorum!",
          "answers": [
            [
              "na"
            ]
          ],
          "options": [
            [
              "nı",
              "na",
              "ndan"
            ]
          ],
          "translation": "I can’t believe he won!",
          "explanation": "inanmak believes in something: -a. Kazandığına."
        },
        {
          "text": "Gelme___ çok sevindim.",
          "answers": [
            [
              "ne"
            ]
          ],
          "options": [
            [
              "ne",
              "ni",
              "nden"
            ]
          ],
          "translation": "I’m so glad you came.",
          "explanation": "gelmen is “your coming,” plus -e: sevinmek takes -a."
        },
        {
          "text": "Deniz'___ kazandığını duydum.",
          "answers": [
            [
              "in"
            ]
          ],
          "options": [
            [
              "in",
              "i",
              "e"
            ]
          ],
          "translation": "I heard Deniz won.",
          "explanation": "Whoever did it goes in the genitive: Deniz'in."
        }
      ]
    },
