{
  "topic": "b2.nominalization-general",
  "exercises": [
    {
      "id": "b2.nominalization-general.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Pick the sentence that means the same as the English one.",
      "items": [
        {
          "prompt": "“I’m glad you came.”",
          "options": [
            "Gelmene sevindim.",
            "Gelmeni sevindim.",
            "Gelmenden sevindim."
          ],
          "answer": 0,
          "explanation": "sevinmek takes -a: gelmen + e = gelmene. English “glad that…” has no preposition — don’t fall back to plain -i."
        },
        {
          "prompt": "“I didn’t know he’d won.”",
          "options": [
            "Kazandı bilmiyordum.",
            "Kazandığını bilmiyordum.",
            "Kazandığına bilmiyordum."
          ],
          "answer": 1,
          "explanation": "Fact → -DIk, sticker -ı, bilmek takes -(n)ı: kazandığını."
        },
        {
          "prompt": "“I heard Deniz won.”",
          "options": [
            "Deniz kazandığını duydum.",
            "Deniz'in kazandığını duydum.",
            "Deniz'in kazandı duydum."
          ],
          "answer": 1,
          "explanation": "English keeps Deniz plain. Turkish puts the doer in the genitive, like “Deniz’s winning”: Deniz'in kazandığını."
        },
        {
          "prompt": "“I want you to come.”",
          "options": [
            "Geldiğini istiyorum.",
            "Gelmeni istiyorum.",
            "Gelmene istiyorum."
          ],
          "answer": 1,
          "explanation": "istemek wants an action: -mA, and it takes -ı. Gelmeni."
        }
      ]
    },
    {
