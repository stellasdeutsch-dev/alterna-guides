        { "text": "Ankara'da yaşadığı___ biliyorum.", "answers": [["nı"]], "options": [["nı", "na", "ndan"]], "translation": "Я знаю, что он живёт в Анкаре.", "explanation": "bilmek берёт -ı: yaşadığını." },
        { "text": "Kazandığı___ inanamıyorum!", "answers": [["na"]], "options": [["nı", "na", "ndan"]], "translation": "Не верю, что он выиграл!", "explanation": "inanmak верит чему-то: -a. Kazandığına." },
        { "text": "Gelme___ çok sevindim.", "answers": [["ne"]], "options": [["ne", "ni", "nden"]], "translation": "Я очень рада, что ты пришёл.", "explanation": "gelmen — твой приход, плюс -e: sevinmek берёт -a." },
        { "text": "Deniz'___ kazandığını duydum.", "answers": [["in"]], "options": [["in", "i", "e"]], "translation": "Я слышала, что Дениз выиграл.", "explanation": "Кто сделал — в родительном: Deniz'in." }
      ]
    },
