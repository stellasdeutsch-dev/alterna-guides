{
  "topic": "a2.verbal-nouns",
  "exercises": [
    {
      "id": "a2.verbal-nouns.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Spot the form: action, name or manner",
      "items": [
        {
          "id": "1",
          "prompt": "___ istiyorum. — I want to swim.",
          "say": "Yüzmek",
          "options": [
            "Yüzmek",
            "Yüzme",
            "Yüzüş"
          ],
          "answer": 0,
          "explanation": "Want the action itself — take the dictionary form in -mak: yüzmek istiyorum."
        },
        {
          "id": "2",
          "prompt": "___ havuzu nerede? — Where’s the pool?",
          "say": "Yüzme",
          "options": [
            "Yüzmek",
            "Yüzme",
            "Yüzüş"
          ],
          "answer": 1,
          "explanation": "A pool is the name of a place. Names are built with -ma: yüzme havuzu."
        },
        {
          "id": "3",
          "prompt": "A sign on the door: “Entrance.”",
          "say": "Giriş",
          "options": [
            "Girmek",
            "Girme",
            "Giriş"
          ],
          "answer": 2,
          "explanation": "Signs use ready-made words in -ış: giriş, çıkış."
        },
        {
          "id": "4",
          "prompt": "Onun ___ çok güzel. — She has a beautiful smile.",
          "say": "gülüşü",
          "options": [
            "gülmek",
            "gülme",
            "gülüşü"
          ],
          "answer": 2,
          "explanation": "It’s about manner: exactly how she smiles. That’s -ış: gül-üş-ü."
        }
      ]
    },
    {
      "id": "a2.verbal-nouns.ex2",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "sort_buckets",
      "difficulty": 1,
      "instruction": "Which -ış tail does the verb take? Sort by vowel",
      "items": [
        {
          "id": "1",
          "buckets": [
            {
              "id": "i1",
              "label": "-ış (a, ı)"
            },
            {
              "id": "i2",
              "label": "-iş (e, i)"
            },
            {
              "id": "i3",
              "label": "-uş (o, u)"
            },
            {
              "id": "i4",
              "label": "-üş (ö, ü)"
            }
          ],
          "entries": [
            {
              "text": "bak → bak__",
              "bucket": "i1"
            },
            {
              "text": "çık → çık__",
              "bucket": "i1"
            },
            {
              "text": "gir → gir__",
              "bucket": "i2"
            },
            {
              "text": "bekle → bekley__",
              "bucket": "i2"
            },
            {
              "text": "oku → okuy__",
              "bucket": "i3"
            },
            {
              "text": "kurtul → kurtul__",
              "bucket": "i3"
            },
            {
              "text": "gör → gör__",
              "bucket": "i4"
            },
            {
              "text": "yürü → yürüy__",
              "bucket": "i4"
            }
          ],
          "explanation": "Look at the last vowel of the root: a and ı give -ış, e and i — -iş, o and u — -uş, ö and ü — -üş. After a vowel, add y."
        }
      ]
    },
