      "id": "a1.genitive-definite.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Pick the working mechanism",
      "items": [
        {
          "id": "1",
          "prompt": "Ali’s house →",
          "options": [
            "Ali'nin evi",
            "Ali'nin ev",
            "Ali'in evi"
          ],
          "answer": 0,
          "explanation": "Ali ends in a vowel — the owner needs n: Ali'nin. English stops at 's, Turkish doesn’t: the thing needs its tail too — evi.",
          "say": "Ali'nin evi"
        },
        {
          "id": "2",
          "prompt": "Ayşe’s cat →",
          "options": [
            "Ayşe'in kedisi",
            "Ayşe'nin kedisi",
            "Ayşe'nin kedi"
          ],
          "answer": 1,
          "explanation": "Ayşe ends in a vowel — 'nin. Kedi ends in a vowel — kedisi.",
          "say": "Ayşe'nin kedisi"
        },
        {
          "id": "3",
          "prompt": "the name of the teacher →",
          "options": [
            "öğretmenin adı",
            "adı öğretmenin",
            "öğretmenin ad"
          ],
          "answer": 0,
          "explanation": "No “of” order in Turkish: owner first, öğretmenin, then the thing, adı.",
          "say": "öğretmenin adı"
        },
        {
          "id": "4",
          "prompt": "my house (with the pronoun) →",
          "options": [
            "benin evim",
            "benim evim",
            "benim ev"
          ],
          "answer": 1,
          "explanation": "Ben is a rebel: benim. The thing adjusts: evim.",
          "say": "benim evim"
        }
      ]
    },
