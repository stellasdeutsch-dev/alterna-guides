    {
      "id": "a2.aorist.ex6",
      "lesson": 2,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Pick the negative",
      "items": [
        {
          "id": "1",
          "prompt": "gelmek, ben, “no” → ?",
          "say": "gelmem",
          "options": [
            "gelmezim",
            "gelmem",
            "gelmirim"
          ],
          "answer": 1,
          "explanation": "With “I,” the z goes overboard: gel + me + m = gelmem."
        },
        {
          "id": "2",
          "prompt": "içmek, sen, “no” → ?",
          "say": "içmezsin",
          "options": [
            "içmezsin",
            "içmesin",
            "içmersin"
          ],
          "answer": 0,
          "explanation": "With “you,” the z stays put: iç + mez + sin."
        },
        {
          "id": "3",
          "prompt": "yapmak, biz, “no” → ?",
          "say": "yapmayız",
          "options": [
            "yapmazız",
            "yapmayız",
            "yapmarız"
          ],
          "answer": 1,
          "explanation": "With “we,” the z is overboard too, and a y steps in between the vowels: yapmayız."
        },
        {
          "id": "4",
          "prompt": "sevmek, onlar, “no” → ?",
          "say": "sevmezler",
          "options": [
            "sevmeler",
            "sevmezler",
            "sevmiyler"
          ],
          "answer": 1,
          "explanation": "With “they,” the z stays put: sev + mez + ler."
        },
        {
          "id": "5",
          "prompt": "okumak, o, “no” → ?",
          "say": "okumaz",
          "options": [
            "okumaz",
            "okumar",
            "okumez"
          ],
          "answer": 0,
          "explanation": "oku — vowel u → -maz. “He/she” has no person ending: okumaz."
        }
      ]
    },
