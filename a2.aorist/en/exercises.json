{
  "topic": "a2.aorist",
  "exercises": [
    {
      "id": "a2.aorist.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Pick the form",
      "items": [
        {
          "id": "1",
          "prompt": "okumak → o …",
          "say": "okur",
          "options": [
            "okur",
            "okar",
            "okır"
          ],
          "answer": 0,
          "explanation": "oku ends in a vowel — just -r: okur."
        },
        {
          "id": "2",
          "prompt": "yapmak → o …",
          "say": "yapar",
          "options": [
            "yapır",
            "yapar",
            "yapur"
          ],
          "answer": 1,
          "explanation": "yap — one syllable and not one of the thirteen. So -ar: yapar."
        },
        {
          "id": "3",
          "prompt": "çalışmak → o …",
          "say": "çalışır",
          "options": [
            "çalışar",
            "çalışır",
            "çalışer"
          ],
          "answer": 1,
          "explanation": "ça-lış — two syllables. Long verbs get -ır by harmony: çalışır."
        },
        {
          "id": "4",
          "prompt": "gelmek → o …",
          "say": "gelir",
          "options": [
            "geler",
            "gelir",
            "gelür"
          ],
          "answer": 1,
          "explanation": "gel — one syllable, but it’s one of the thirteen exceptions. They get -ir: gelir."
        },
        {
          "id": "5",
          "prompt": "içmek → ben …",
          "say": "içerim",
          "options": [
            "içirim",
            "içerim",
            "içer"
          ],
          "answer": 1,
          "explanation": "iç — one syllable, vowel i → -er. Then “I” → -im: içerim. Plain içer means “he drinks”: unlike English, Turkish marks “I” with an ending."
        }
      ]
    },
    {
      "id": "a2.aorist.ex2",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "sort_buckets",
      "difficulty": 1,
      "instruction": "Sort the verbs to their piers",
      "items": [
        {
          "id": "1",
          "buckets": [
            {
              "id": "r",
              "label": "-r"
            },
            {
              "id": "ar",
              "label": "-ar / -er"
            },
            {
              "id": "ir",
              "label": "-ır / -ir / -ur / -ür"
            }
          ],
          "entries": [
            {
              "text": "bekle-",
              "bucket": "r"
            },
            {
              "text": "uyu-",
              "bucket": "r"
            },
            {
              "text": "sev-",
              "bucket": "ar"
            },
            {
              "text": "yaz-",
              "bucket": "ar"
            },
            {
              "text": "konuş-",
              "bucket": "ir"
            },
            {
              "text": "otur-",
              "bucket": "ir"
            },
            {
              "text": "al-",
              "bucket": "ir"
            },
            {
              "text": "bil-",
              "bucket": "ir"
            }
          ],
          "explanation": "Ends in a vowel — just -r. One syllable — -ar/-er. Two syllables or more — -ır. The thirteen exceptions like al and bil take -ır too."
        }
      ]
    },
    {
      "id": "a2.aorist.ex3",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "matching",
      "difficulty": 2,
      "instruction": "Match the verb with its “he does” form",
      "items": [
        {
          "id": "1",
          "pairs": [
            {
              "left": "okumak",
              "right": "okur"
            },
            {
              "left": "sevmek",
              "right": "sever"
            },
            {
              "left": "öğrenmek",
              "right": "öğrenir"
            },
            {
              "left": "kalmak",
              "right": "kalır"
            },
            {
              "left": "gitmek",
              "right": "gider"
            }
          ],
          "explanation": "oku → okur (vowel), sev → sever (one syllable), öğren → öğrenir (many syllables), kal → kalır (one of the thirteen), git → gider (t before a vowel turns into d)."
        }
      ]
    },
    {
      "id": "a2.aorist.ex4",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "mixed",
      "difficulty": 2,
      "instruction": "Build it, find the mistake, write it yourself",
      "items": [
        {
          "id": "1",
          "type": "build_sentence",
          "translation": "I drink coffee every morning.",
          "words": [
            "Her",
            "sabah",
            "kahve",
            "içerim."
          ],
          "distractors": [
            "içirim."
          ],
          "explanation": "iç — one syllable, vowel i → -er: içerim."
        },
        {
          "id": "2",
          "type": "error_hunt",
          "prompt": "Find the mistake",
          "tokens": [
            "Babam",
            "her",
            "akşam",
            "evde",
            "kalar."
          ],
          "wrong": 4,
          "fix": "kalır.",
          "options": [
            "kalır.",
            "kaler.",
            "kalur."
          ],
          "explanation": "kal — one of the thirteen exceptions. It gets -ır, not -ar: kalır."
        },
        {
          "id": "3",
          "type": "gap_fill",
          "text": "Ben her gün Türkçe ___. (öğrenmek)",
          "answers": [
            [
              "öğrenirim"
            ]
          ],
          "translation": "I study Turkish every day.",
          "explanation": "öğ-ren — two syllables → -ir. Then “I” → -im: öğrenirim."
        },
        {
          "id": "4",
          "type": "build_sentence",
          "translation": "We walk along the Kordon in the evenings.",
          "words": [
            "Akşamları",
            "Kordon'da",
            "yürürüz."
          ],
          "distractors": [
            "yürüyürüz."
          ],
          "explanation": "yürü ends in a vowel — just -r, then “we” -üz: yürürüz."
        }
      ]
    },
    {
      "id": "a2.aorist.ex5",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "custom",
      "difficulty": 2,
      "instruction": "Ferry timetable: dock at the right ending",
      "description": "The ferry carries a sentence with a gap. The learner picks a pier (button or keys 1–3), the ferry docks, the sentence plays. Logic lives in index.html.",
      "items": [
        {
          "id": "1",
          "phrase": "Vapur her yarım saatte kalk___.",
          "ru": "The ferry leaves every half hour.",
          "options": [
            "ır",
            "ar",
            "er"
          ],
          "answer": "ar",
          "say": "Vapur her yarım saatte kalkar.",
          "explanation": "kalk — one syllable, not one of the thirteen, vowel a → -ar."
        },
        {
          "id": "2",
          "phrase": "Martılar simit sev___.",
          "ru": "Seagulls love simit.",
          "options": [
            "er",
            "ir",
            "ar"
          ],
          "answer": "er",
          "say": "Martılar simit sever.",
          "explanation": "sev — one syllable, vowel e → -er."
        },
        {
          "id": "3",
          "phrase": "Dedem her sabah Kordon'da yürü___.",
          "ru": "Grandpa walks along the Kordon every morning.",
          "options": [
            "ür",
            "er",
            "r"
          ],
          "answer": "r",
          "say": "Dedem her sabah Kordon'da yürür.",
          "explanation": "yürü ends in a vowel — one r is enough."
        },
        {
          "id": "4",
          "phrase": "Annem çok güzel yemek yap___.",
          "ru": "Mom cooks really well.",
          "options": [
            "ır",
            "ar",
            "er"
          ],
          "answer": "ar",
          "say": "Annem çok güzel yemek yapar.",
          "explanation": "yap — one syllable, vowel a → -ar."
        },
        {
          "id": "5",
          "phrase": "Bu otobüs her on dakikada gel___.",
          "ru": "This bus comes every ten minutes.",
          "options": [
            "er",
            "ir",
            "ür"
          ],
          "answer": "ir",
          "say": "Bu otobüs her on dakikada gelir.",
          "explanation": "gel — one of the thirteen: gelir, not geler."
        },
        {
          "id": "6",
          "phrase": "Öğrenciler kütüphanede çalış___.",
          "ru": "The students study in the library.",
          "options": [
            "ar",
            "ır",
            "ur"
          ],
          "answer": "ır",
          "say": "Öğrenciler kütüphanede çalışır.",
          "explanation": "ça-lış — two syllables, last vowel ı → -ır."
        }
      ]
    },
