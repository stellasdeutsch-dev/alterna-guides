        { "id": "6", "phrase": "Öğrenciler kütüphanede çalış___.", "ru": "Студенты занимаются в библиотеке.", "options": ["ar", "ır", "ur"], "answer": "ır", "say": "Öğrenciler kütüphanede çalışır.", "explanation": "ça-lış — два слога, последняя гласная ı → -ır." }
