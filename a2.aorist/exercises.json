      "difficulty": 1,
      "instruction": "Выбери форму",
      "items": [
        { "id": "1", "prompt": "okumak → o …", "say": "okur", "options": ["okur", "okar", "okır"], "answer": 0, "explanation": "oku кончается на гласную — просто -r: okur." },
        { "id": "2", "prompt": "yapmak → o …", "say": "yapar", "options": ["yapır", "yapar", "yapur"], "answer": 1, "explanation": "yap — один слог и не из тринадцати. Значит -ar: yapar." },
        { "id": "3", "prompt": "çalışmak → o …", "say": "çalışır", "options": ["çalışar", "çalışır", "çalışer"], "answer": 1, "explanation": "ça-lış — два слога. Длинным глаголам -ır по гармонии: çalışır." },
        { "id": "4", "prompt": "gelmek → o …", "say": "gelir", "options": ["geler", "gelir", "gelür"], "answer": 1, "explanation": "gel — один слог, но он из тринадцати исключений. Им положено -ir: gelir." },
        { "id": "5", "prompt": "içmek → ben …", "say": "içerim", "options": ["içirim", "içerim", "içarım"], "answer": 1, "explanation": "iç — один слог, гласная i → -er. Потом «я»: içerim." }
      ]
    },
    {
      "id": "a2.aorist.ex2",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "sort_buckets",
      "difficulty": 1,
      "instruction": "Разведи глаголы по причалам",
      "items": [
        {
          "id": "1",
          "buckets": [
            { "id": "r", "label": "-r" },
            { "id": "ar", "label": "-ar / -er" },
            { "id": "ir", "label": "-ır / -ir / -ur / -ür" }
