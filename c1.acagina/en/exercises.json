          "answer": 1,
          "explanation": "Cable car — the plan. Reality — sleeping till noon. No ride."
        },
        {
          "id": "3",
          "prompt": "Bu kadar para vereceğine yenisini al.",
          "say": "Bu kadar para vereceğine yenisini al.",
          "options": [
            "You paid that much and bought a new one.",
            "Rather than pay that much, buy a new one."
          ],
          "answer": 1,
          "explanation": "With the imperative it's advice: “rather than…, just…”"
        },
        {
          "id": "4",
          "prompt": "Sorunu çözecekleri yerde birbirlerini suçladılar.",
          "say": "Sorunu çözecekleri yerde birbirlerini suçladılar.",
          "options": [
            "Instead of solving the problem, they blamed each other.",
            "They solved the problem and blamed each other."
          ],
          "answer": 0,
          "explanation": "Yerde is the bookish sibling of -ına. Same meaning: the problem wasn't solved."
        }
      ]
    },
