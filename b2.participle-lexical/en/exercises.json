          "answer": 0,
          "say": "çıkmaz sokak",
          "explanation": "-maz is “never.” A street that leads nowhere is a dead end."
        },
        {
          "id": "2",
          "prompt": "akar su",
          "options": [
            "water that leaked out",
            "running water",
            "water worth drinking"
          ],
          "answer": 1,
          "say": "akar su",
          "explanation": "-ar is “always does it.” Water that always flows is running water."
        },
        {
          "id": "3",
          "prompt": "okunası kitap",
          "options": [
            "a book that's been read",
            "the book I'm reading",
            "a book worth reading"
          ],
          "answer": 2,
          "say": "okunası kitap",
          "explanation": "-ası is a rating: it's worth doing."
        },
        {
          "id": "4",
          "prompt": "beklenmedik misafir",
          "options": [
            "an unexpected guest",
            "the guest I'm waiting for",
            "a guest who's always waiting"
          ],
          "answer": 0,
          "say": "beklenmedik misafir",
          "explanation": "-medik with no person means “nobody expected.” With a person it would be beklediğim."
        },
        {
          "id": "5",
          "prompt": "kızarmış ekmek",
          "options": [
            "bread worth toasting",
            "toasted bread",
            "bread that won't toast"
          ],
          "answer": 1,
          "say": "kızarmış ekmek",
          "explanation": "-mış: it already happened and the result stayed. The bread got toasted."
        }
      ]
    },
