    {
      "id": "b2.participle-lexical.ex5",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "custom",
      "difficulty": 2,
      "instruction": "Plug the verb into the right port",
      "description": "Exhibition stand: a description is given in English, the learner picks one of five colored ports (-ar, -maz, -ası, -dık, -mış, keys 1–5), the wire connects and shows the finished trait. The logic lives in index.html.",
      "items": [
        {
          "id": "1",
          "ru": "a watch that doesn't let water in",
          "answer": "maz",
          "result": "su geçir[mez] saat",
          "explanation": "It never lets water in: -mez, su geçirmez saat."
        },
        {
          "id": "2",
          "ru": "water that flows",
          "answer": "ar",
          "result": "ak[ar] su",
          "explanation": "Always flows, so it's the aorist: akar su."
        },
        {
          "id": "3",
          "ru": "a place worth seeing",
          "answer": "asi",
          "result": "gör{ül}[esi] yer",
          "explanation": "“Worth it” is -esi: görülesi yer."
        },
        {
          "id": "4",
          "ru": "a guest nobody expected",
          "answer": "dik",
          "result": "bekle{n}[medik] misafir",
          "explanation": "Nobody expected them: -medik with no person, beklenmedik misafir."
        },
        {
          "id": "5",
          "ru": "an egg that's already been boiled",
          "answer": "mis",
          "result": "haşla{n}[mış] yumurta",
          "explanation": "Already boiled, the result is on the plate: -mış, haşlanmış yumurta."
        },
        {
          "id": "6",
          "ru": "a door that spins",
          "answer": "ar",
          "result": "dön[er] kapı",
          "explanation": "Always spins: -er, döner kapı."
        },
        {
          "id": "7",
          "ru": "a day you won't forget",
          "answer": "maz",
          "result": "unut{ul}[maz] gün",
          "explanation": "Can't be forgotten: -maz, unutulmaz gün."
        },
        {
          "id": "8",
