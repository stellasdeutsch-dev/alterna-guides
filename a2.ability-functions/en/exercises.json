      "difficulty": 1,
      "instruction": "Which flag is up? Listen to the phrase and pick the meaning",
      "items": [
        {
          "id": "1",
          "prompt": "Fotoğraf çekebilir miyim?",
          "say": "Fotoğraf çekebilir miyim?",
          "options": [
            "May I? Asking permission",
            "Maybe",
            "My advice"
          ],
          "answer": 0,
          "explanation": "A question, and miyim at the end — “I.” You’re asking permission: can I take a photo?"
        },
        {
          "id": "2",
          "prompt": "Akşam yağmur yağabilir.",
          "say": "Akşam yağmur yağabilir.",
          "options": [
            "May I? Asking permission",
            "Maybe",
            "My advice"
          ],
          "answer": 1,
          "explanation": "Rain doesn’t ask permission. It’s about the weather — so it’s the yellow flag: it might rain."
        },
        {
          "id": "3",
          "prompt": "Kemeraltı'nda alışveriş yapabilirsin.",
          "say": "Kemeraltı'nda alışveriş yapabilirsin.",
          "options": [
            "May I? Asking permission",
            "Maybe",
            "My advice"
          ],
          "answer": 2,
          "explanation": "A statement, -sin at the end — “you.” You’re suggesting an option to a friend. That’s advice."
        },
        {
          "id": "4",
          "prompt": "Hesabı getirebilir misiniz?",
          "say": "Hesabı getirebilir misiniz?",
          "options": [
            "Could you? Asking someone to do it",
            "Maybe",
            "My advice"
          ],
          "answer": 0,
          "explanation": "A question with misiniz — formal “you.” You’re politely asking the waiter for the check. Green flag."
        },
        {
          "id": "5",
          "prompt": "Vapur geç kalabilir.",
          "say": "Vapur geç kalabilir.",
          "options": [
            "May I? Asking permission",
            "Maybe",
            "My advice"
          ],
          "answer": 1,
          "explanation": "The ferry is third person, and nobody is asking anything. It’s a forecast: it might be late."
        }
      ]
    },
