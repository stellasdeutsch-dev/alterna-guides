        {
          "id": "1",
          "phrase": "Şezlonga oturabilir miyim?",
          "ru": "Can I take a sunbed?",
          "answer": "green",
          "explanation": "A question and miyim — you’re asking permission for yourself. Green."
        },
        {
          "id": "2",
          "phrase": "Öğleden sonra dalga olabilir.",
          "ru": "There might be waves in the afternoon.",
          "answer": "yellow",
          "explanation": "Nobody asks the waves. It’s a forecast — yellow."
        },
        {
          "id": "3",
          "phrase": "Sabah yüzebilirsin, deniz sakin olur.",
          "ru": "You can swim in the morning, the sea is usually calm.",
          "answer": "blue",
          "explanation": "You’re suggesting an option: the morning is better. That’s advice — blue."
        },
        {
          "id": "4",
          "phrase": "Bana krem verebilir misin?",
          "ru": "Can you pass me the sunscreen?",
          "answer": "green",
          "explanation": "A question with misin — a request to someone else. Same green flag: “can I? can you?”"
        },
        {
          "id": "5",
          "phrase": "Son vapur dolu olabilir.",
          "ru": "The last ferry might be packed.",
          "answer": "yellow",
          "explanation": "The ferry is third person, no question. Yellow: maybe."
        },
        {
          "id": "6",
          "phrase": "Şapka takabilirsin, güneş çok sıcak.",
          "ru": "You could wear a hat, the sun is really hot.",
          "answer": "blue",
          "explanation": "A statement with -sin, to a friend, with a reason. Classic advice. Blue."
        }
      ]
    },
