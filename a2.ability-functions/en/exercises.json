    {
      "id": "a2.ability-functions.ex3",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "gap_fill",
      "difficulty": 2,
      "instruction": "Add the tail",
      "items": [
        {
          "id": "1",
          "text": "Pencereyi aç___ miyim?",
          "answers": [
            [
              "abilir"
            ]
          ],
          "options": [
            [
              "abilir",
              "ebilir",
              "abil"
            ]
          ],
          "translation": "Can I open the window?",
          "explanation": "aç has the vowel a, a back vowel — so -abil. And don’t lose -ir: açabilir miyim."
        },
        {
          "id": "2",
          "text": "Bu akşam kar yağ___.",
          "answers": [
            [
              "abilir"
            ]
          ],
          "options": [
            [
              "abilir",
              "abilirsin",
              "ebilir"
            ]
          ],
          "translation": "It might snow tonight.",
          "explanation": "Snow is third person, no ending. Vowel a → -abilir. In Izmir, sure. Well, it might."
        },
        {
          "id": "3",
          "text": "Hafta sonu Çeşme'ye gid___.",
          "answers": [
            [
              "ebilirsin"
            ]
          ],
          "options": [
            [
              "ebilirsin",
              "ebilir miyim",
              "abilirsin"
            ]
          ],
          "translation": "You could go to Çeşme this weekend.",
          "explanation": "Advice to a friend — a statement with -sin. Vowel i, front → -ebil. Result: gidebilirsin."
        },
        {
          "id": "4",
          "text": "Bana yardım ed___ misiniz?",
          "answers": [
            [
              "ebilir"
            ]
          ],
          "options": [
            [
              "ebilir",
              "ebil",
              "abilir"
            ]
          ],
          "translation": "Could you help me?",
          "explanation": "et → ed, vowel e → -ebil, then -ir, always. The question mi is written separately."
        },
        {
          "id": "5",
          "text": "Burada yüz___siniz.",
          "answers": [
            [
              "emez"
            ]
          ],
          "options": [
            [
              "emez",
              "ebilmez",
              "amaz"
            ]
          ],
          "translation": "No swimming here.",
          "explanation": "Not allowed — that’s -emez. English keeps “can” in “cannot,” Turkish drops bil: yüzemezsiniz. ü is a front vowel → -emez, not -amaz."
        }
      ]
    },
    {
      "id": "a2.ability-functions.ex4",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "build_sentence",
      "difficulty": 2,
      "instruction": "Build the phrase",
      "items": [
        {
          "id": "1",
          "translation": "Can I sit here?",
          "words": [
            "Burada",
            "oturabilir",
            "miyim?"
          ],
          "distractors": [
            "Mi",
            "misin?"
          ],
          "explanation": "Permission for yourself — miyim, at the very end. No question word up front like English “Can I.” Misin would ask whether someone else can sit."
        },
        {
          "id": "2",
          "translation": "Could you speak a little slower?",
          "words": [
            "Biraz",
            "yavaş",
            "konuşabilir",
            "misiniz?"
          ],
          "distractors": [
            "miyim?"
          ],
          "explanation": "Asking someone else — misiniz. Polite, formal, like with a stranger."
        },
        {
          "id": "3",
          "translation": "There might be traffic tonight.",
          "words": [
            "Akşam",
            "trafik",
            "olabilir."
          ],
          "distractors": [
            "olabilir miyim?"
          ],
          "explanation": "It’s a forecast, not a request. No mi — just olabilir."
        },
        {
          "id": "4",
          "translation": "You could go to Çeşme this weekend.",
          "words": [
            "Hafta",
            "sonu",
            "Çeşme'ye",
            "gidebilirsin."
          ],
          "alternatives": [
            [
              "Çeşme'ye",
              "hafta",
              "sonu",
              "gidebilirsin."
            ]
          ],
          "explanation": "Advice: a statement with -sin at the end. Turkish puts the verb at the very end of the sentence."
        }
      ]
    },
    {
      "id": "a2.ability-functions.ex5",
      "lesson": 1,
      "kind": "practice",
