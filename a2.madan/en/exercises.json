        {
          "id": "1",
          "prompt": "“without having breakfast” → ?",
          "options": [
            "kahvaltı yapmadan",
            "kahvaltı yapmeden",
            "kahvaltı yapmamadan"
          ],
          "answer": 0,
          "explanation": "yap: vowel a → -madan. The “not” is already inside the tail, you don't need a second one."
        },
        {
          "id": "2",
          "prompt": "“without thinking” → ?",
          "options": [
            "düşünmadan",
            "düşünmeden",
            "düşünmemeden"
          ],
          "answer": 1,
          "explanation": "The last vowel in düşün is ü — a front vowel. So it's -meden."
        },
        {
          "id": "3",
          "prompt": "Bilet almadan biniyor. — that's…",
          "say": "Bilet almadan biniyor.",
          "options": [
            "gets on without buying a ticket",
            "gets on after buying a ticket",
            "gets on before buying a ticket"
          ],
          "answer": 0,
          "explanation": "-madan without önce — the action didn't happen. No ticket. The inspector is already on his way."
        },
        {
          "id": "4",
          "prompt": "Yemeden önce — that's…",
          "say": "Yemeden önce",
          "options": [
            "before eating",
            "without eating"
          ],
          "answer": 0,
          "explanation": "With önce — “before”. The food will happen, just later."
        }
      ]
    },
