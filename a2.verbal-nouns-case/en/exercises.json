  "topic": "a2.verbal-nouns-case",
  "exercises": [
    {
      "id": "a2.verbal-nouns-case.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Who does it? Pick the form",
      "items": [
        {
          "id": "1",
          "prompt": "“I want to come” — I’m the one coming",
          "say": "Gelmek istiyorum.",
          "options": [
            "Gelmek istiyorum.",
            "Gelmeni istiyorum."
          ],
          "answer": 0,
          "explanation": "You do it yourself — no person needed, just -mAk."
        },
        {
          "id": "2",
          "prompt": "“I want you to come”",
          "say": "Gelmeni istiyorum.",
          "options": [
            "Gelmek istiyorum.",
            "Gelmeni istiyorum."
          ],
          "answer": 1,
          "explanation": "Someone else comes. So it’s -mA, the person -n, and the case -i."
        },
        {
          "id": "3",
          "prompt": "“I’m waiting for him to call”",
          "say": "Onun aramasını bekliyorum.",
          "options": [
            "Onun aramak bekliyorum.",
            "Onun araması bekliyorum.",
            "Onun aramasını bekliyorum."
          ],
          "answer": 2,
          "explanation": "He’s the one calling: ara-ma-sı. Waiting for what? Accusative, and after -sı the buffer n: aramasını."
        }
      ]
    },
    {
      "id": "a2.verbal-nouns-case.ex2",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "matching",
      "difficulty": 1,
      "instruction": "Match form and meaning",
      "items": [
        {
          "id": "1",
          "pairs": [
            {
              "left": "gelmem",
              "right": "my coming"
            },
            {
              "left": "gelmen",
              "right": "your coming"
            },
            {
              "left": "gelmesi",
              "right": "his coming"
            },
            {
              "left": "gelmemiz",
              "right": "our coming"
            },
            {
              "left": "gelmeniz",
              "right": "your (pl.) coming"
            },
            {
              "left": "gelmeleri",
              "right": "their coming"
            }
          ],
          "explanation": "After -me hangs the person tag: -m, -n, -si, -miz, -niz, -leri."
        }
      ]
    },
    {
      "id": "a2.verbal-nouns-case.ex3",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "mixed",
      "difficulty": 2,
      "instruction": "Place it, build it, find the mistake",
      "items": [
        {
          "id": "1",
          "type": "gap_fill",
          "text": "Senin oku___ istiyorum.",
          "answers": [
            [
              "manı"
            ]
          ],
          "options": [
            [
              "manı",
              "mayı",
              "man"
            ]
          ],
          "translation": "I want you to read.",
          "say": "Senin okumanı istiyorum.",
          "explanation": "oku-ma-n-ı: first the person -n, then the accusative -ı."
        },
        {
          "id": "2",
          "type": "build_sentence",
          "translation": "I want you all to come.",
          "words": [
            "Sizin",
            "gelmenizi",
            "istiyorum."
          ],
          "distractors": [
            "gelmeniz"
          ],
          "say": "Sizin gelmenizi istiyorum.",
          "explanation": "istemek asks for the accusative: gelmeniz + i = gelmenizi."
        },
        {
          "id": "3",
          "type": "error_hunt",
          "prompt": "Find the wrong buffer",
          "tokens": [
            "Onun",
            "gelmesiyi",
            "bekliyorum."
          ],
          "wrong": 1,
          "fix": "gelmesini",
          "options": [
            "gelmesini",
            "gelmesi"
          ],
          "say": "Onun gelmesini bekliyorum.",
          "explanation": "After “his” -si the buffer is always n, not y: gelmesini."
        }
      ]
    },
    {
      "id": "a2.verbal-nouns-case.ex4",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "custom",
      "difficulty": 2,
      "instruction": "Couple the cars: build the word in order",
      "description": "The learner taps word pieces in order: root, -mA, person, buffer n, case. Keys 1–9 — piece, Backspace — uncouple, Enter — check. Logic is in index.html.",
      "items": [
        {
          "id": "1",
          "prompt": "Senin ___ istiyorum.",
          "hint": "gel · I want you to come",
          "pieces": [
            "me",
            "gel",
            "i",
            "mek",
            "n",
            "si"
          ],
          "solution": [
            1,
            0,
            4,
            2
          ],
          "answer": "gelmeni",
          "say": "Senin gelmeni istiyorum.",
          "explanation": "gel + me + n (you) + i (what I want)."
        },
        {
          "id": "2",
          "prompt": "Onun ___ bekliyorum.",
          "hint": "ara · I’m waiting for him to call",
          "pieces": [
            "sı",
            "ara",
            "yı",
            "ma",
            "ı",
            "n",
            "mak"
          ],
          "solution": [
            1,
            3,
            0,
            5,
            4
          ],
          "answer": "aramasını",
          "say": "Onun aramasını bekliyorum.",
          "explanation": "ara + ma + sı (he) + n + ı. After “his” you need the buffer n."
        },
        {
          "id": "3",
          "prompt": "Annem benim ___ istiyor.",
          "hint": "uyu · Mom wants me to sleep",
          "pieces": [
            "m",
            "mak",
            "uyu",
            "ı",
            "ma",
            "n"
          ],
          "solution": [
            2,
            4,
            0,
            3
          ],
          "answer": "uyumamı",
          "say": "Annem benim uyumamı istiyor.",
          "explanation": "uyu + ma + m (I) + ı. After -m no buffer needed."
        },
        {
          "id": "4",
          "prompt": "Onların ___ bekliyoruz.",
          "hint": "dön · we’re waiting for them to come back",
          "pieces": [
            "leri",
            "dön",
            "i",
            "mek",
            "n",
            "me",
            "yi"
          ],
          "solution": [
            1,
            5,
            0,
            4,
            2
          ],
          "answer": "dönmelerini",
          "say": "Onların dönmelerini bekliyoruz.",
          "explanation": "dön + me + leri (they) + n + i. “Their” takes the buffer n too."
        }
      ]
    },
