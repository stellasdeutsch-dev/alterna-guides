      "difficulty": 1,
      "instruction": "Әрекет қай жерде өзіне қайтты?",
      "items": [
        {
          "id": "1",
          "prompt": "«Киінемін» — қалай?",
          "options": [
            "Giyiyorum.",
            "Giyiniyorum.",
            "Giydim."
          ],
          "answer": 1,
          "explanation": "Өзімді киіндіремін — бумеранг. giy дауыссызға бітеді: giy + in. Giyiniyorum."
        },
        {
          "id": "2",
          "prompt": "«Ол мақтанады» — қалай?",
          "options": [
            "Övüyor.",
            "Övdü.",
            "Övünüyor."
          ],
          "answer": 2,
          "explanation": "Өзін мақтайды — бумеранг. öv + ün: I ö-ге бейімделді. Övünüyor."
        },
        {
          "id": "3",
          "prompt": "«Біз демалысқа дайындалып жатырмыз» — қалай?",
          "options": [
            "Tatile hazırlanıyoruz.",
            "Tatile hazırlıyoruz.",
            "Tatili hazırladık."
          ],
          "answer": 0,
          "explanation": "Өзімізді дайындаймыз. hazırla дауыстыға бітеді — жай n: hazırlan."
        }
      ]
    },
