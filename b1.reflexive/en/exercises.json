{
  "topic": "b1.reflexive",
  "exercises": [
    {
      "id": "b1.reflexive.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Where did the action come back to the doer?",
      "items": [
        {
          "id": "1",
          "prompt": "“I'm getting dressed” — how?",
          "options": [
            "Giyiyorum.",
            "Giyiniyorum.",
            "Giydim."
          ],
          "answer": 1,
          "explanation": "Dressing yourself — boomerang. giy ends in a consonant: giy + in. Giyiniyorum."
        },
        {
          "id": "2",
          "prompt": "“He's bragging” — how?",
          "options": [
            "Övüyor.",
            "Övdü.",
            "Övünüyor."
          ],
          "answer": 2,
          "explanation": "Praising himself — boomerang. öv + ün: the I adapted to ö. Övünüyor."
        },
        {
          "id": "3",
          "prompt": "“We're getting ready for vacation” — how?",
          "options": [
            "Tatile hazırlanıyoruz.",
            "Tatile hazırlıyoruz.",
            "Tatili hazırladık."
          ],
          "answer": 0,
          "explanation": "We're getting ourselves ready. hazırla ends in a vowel — just n: hazırlan."
        },
        {
          "id": "4",
          "prompt": "“I washed this morning” (washed myself) — how?",
          "options": [
            "Bu sabah yıkadım.",
            "Bu sabah yıkandım.",
            "Bu sabah kendimi yıkandım."
          ],
          "answer": 1,
          "explanation": "English can drop “myself.” Turkish can't: yıkadım needs an object. For yourself — yıka + n: yıkandım. And not kendimi + n together."
        }
      ]
    },
    {
      "id": "b1.reflexive.ex2",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "sort_buckets",
      "difficulty": 1,
      "instruction": "Which boomerang do you attach: n or In?",
      "items": [
        {
          "id": "1",
          "buckets": [
            {
              "id": "n",
              "label": "-n (after a vowel)"
            },
            {
              "id": "In",
              "label": "-In (after a consonant)"
            }
          ],
          "entries": [
            {
              "text": "yıka",
              "bucket": "n"
            },
            {
              "text": "giy",
              "bucket": "In"
            },
            {
              "text": "hazırla",
              "bucket": "n"
            },
            {
              "text": "öv",
              "bucket": "In"
            },
            {
              "text": "tara",
              "bucket": "n"
            },
            {
              "text": "soy",
              "bucket": "In"
            },
            {
              "text": "dinle",
              "bucket": "n"
            },
            {
              "text": "sar",
              "bucket": "In"
            }
          ],
          "explanation": "Look at the last letter. Vowel — just n: yıkan, hazırlan, taran, dinlen. Consonant — I + n: giyin, övün, soyun, sarın."
        }
      ]
    },
