      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Где действие вернулось к себе?",
      "items": [
        {
          "id": "1",
          "prompt": "«Я одеваюсь» — как?",
          "options": ["Giyiyorum.", "Giyiniyorum.", "Giydim."],
          "answer": 1,
          "explanation": "Одеваю себя — бумеранг. giy кончается на согласную: giy + in. Giyiniyorum."
        },
        {
          "id": "2",
          "prompt": "«Он хвалится» — как?",
          "options": ["Övüyor.", "Övdü.", "Övünüyor."],
          "answer": 2,
          "explanation": "Хвалит себя — бумеранг. öv + ün: I подстроилась под ö. Övünüyor."
        },
        {
          "id": "3",
          "prompt": "«Мы готовимся к отпуску» — как?",
          "options": ["Tatile hazırlanıyoruz.", "Tatile hazırlıyoruz.", "Tatili hazırladık."],
          "answer": 0,
          "explanation": "Готовим себя. hazırla кончается на гласную — просто n: hazırlan."
        }
      ]
    },
