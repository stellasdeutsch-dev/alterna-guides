    {
      "id": "b1.diginden-beri.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Spot the form",
      "items": [
        {
          "id": "1",
          "prompt": "Antalya'ya taşındığımdan beri… — what does it mean?",
          "say": "Antalya'ya taşındığımdan beri",
          "options": [
            "ever since I moved to Antalya",
            "because I moved to Antalya",
            "when I move to Antalya"
          ],
          "answer": 0,
          "explanation": "Beri at the end means “ever since.” The -ım tail means “I.”"
        },
        {
          "id": "2",
          "prompt": "“Ever since I came” — how?",
          "options": [
            "geldiğimden beri",
            "geldim beri",
            "gelmekten beri"
          ],
          "answer": 0,
          "explanation": "You need the whole tail: gel + diğ + im + den + beri."
        },
        {
          "id": "3",
          "prompt": "Tanıştığımızdan beri — who met?",
          "say": "Tanıştığımızdan beri",
          "options": [
            "we",
            "you (pl.)",
            "they"
          ],
          "answer": 0,
          "explanation": "-ımız means “our,” so we met."
        },
        {
          "id": "4",
          "prompt": "Which -DIk variant does iç- take?",
          "options": [
            "içtiğim",
            "içdiğim",
            "içtuğum"
          ],
          "answer": 0,
          "explanation": "ç is voiceless, so t. Last vowel is i, so -tiğ."
        }
      ]
    },
