        {
          "id": "1",
          "prompt": "«Я пью чай»",
          "say": "Ben çay içiyorum",
          "options": ["Ben çay içiyorum", "Ben içiyorum çay", "İçiyorum ben çay"],
          "answer": 0,
          "explanation": "Кто → что → глагол. Глагол-локомотив закрывает поезд: Ben çay içiyorum."
        },
        {
          "id": "2",
          "prompt": "«Я иду домой»",
          "say": "Ben eve gidiyorum",
          "options": ["Ben gidiyorum eve", "Ben eve gidiyorum"],
          "answer": 1,
          "explanation": "Куда — прямо перед глаголом: Ben eve gidiyorum."
        },
        {
          "id": "3",
          "prompt": "«Я не знаю турецкий» — как на экзамене?",
          "say": "Türkçe bilmiyorum",
          "options": ["Bilmiyorum Türkçe", "Türkçe bilmiyorum"],
          "answer": 1,
          "explanation": "«Не» живёт внутри глагола, а глагол — в конце: Türkçe bilmiyorum. Первый вариант скажет таксист, ходжа — нет."
        },
        {
          "id": "4",
          "prompt": "«Ты придёшь завтра?»",
          "say": "Yarın gelecek misin?",
          "options": ["Mi sen gelecek yarın?", "Yarın gelecek misin?"],
          "answer": 1,
          "explanation": "Частица вопроса mi сидит в хвосте, после глагола. Никаких «ли» в начале."
        }
      ]
    },
