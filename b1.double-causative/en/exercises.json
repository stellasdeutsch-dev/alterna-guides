            },
            {
              "text": "yazdırttım",
              "bucket": "f2"
            },
            {
              "text": "boyattırdım",
              "bucket": "f2"
            }
          ],
          "explanation": "Count the suffixes: -dIr or -t is one floor, -dIr + -t or -t + -dIr is two."
        }
      ]
    },
    {
      "id": "b1.double-causative.ex3",
      "topic": "b1.double-causative",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "gap_fill",
      "difficulty": 2,
      "instruction": "Add the second floor",
      "items": [
        {
          "text": "Patron raporu asistana ___. (yaz-)",
          "answers": [
            [
              "yazdırttı"
            ]
          ],
          "options": [
            [
              "yazdırttı",
              "yazdırdırdı",
              "yazttırdı"
            ]
          ],
          "translation": "The boss had the assistant write the report, through the manager.",
          "explanation": "yaz → yazdır → yazdırt: after -dır, -t serves."
        },
        {
          "text": "Odamı resepsiyona ___. (temizle-)",
          "answers": [
            [
              "temizlettirdim"
            ]
          ],
          "options": [
            [
              "temizlettirdim",
              "temizletttim",
              "temizletdirdim"
            ]
          ],
          "translation": "I asked reception to have my room cleaned.",
          "explanation": "After -t, -tir serves — voiceless after t."
        },
        {
          "text": "Kral düşmanını askerlerine ___. (öl-)",
          "answers": [
            [
              "öldürttü"
            ]
          ],
          "options": [
            [
              "öldürttü",
              "öldirtti",
              "öldürdürdü"
            ]
          ],
          "translation": "The king had his soldiers kill the enemy.",
          "explanation": "öl → öldür → öldürt. The tail copies ö as ü — not “öldir”."
        },
        {
          "text": "Ali yemeği aşçıya ___. (piş-)",
          "answers": [
            [
              "pişirtti"
            ]
          ],
          "options": [
            [
              "pişirtti",
              "pişirdirdi",
              "pişti"
            ]
          ],
          "translation": "Ali had the cook make the food.",
          "explanation": "piş → pişir → pişirt: after -ir, -t serves."
        },
        {
          "text": "Müdür kitabı öğrencilere ___. (oku-)",
          "answers": [
            [
              "okutturdu"
            ]
          ],
          "options": [
            [
              "okutturdu",
              "okutdurdu",
              "okuttu"
            ]
          ],
          "translation": "The principal had the students read the book, through the teacher.",
          "explanation": "oku → okut → okuttur: after t only voiceless -tur."
        },
        {
          "text": "Musluğu ___ tamir ettirdim. (usta)",
          "answers": [
            [
              "ustaya"
            ]
          ],
          "options": [
            [
              "ustaya",
              "usta tarafından",
              "ustayı"
            ]
          ],
          "translation": "I had a plumber fix the faucet.",
          "explanation": "The doer takes the dative -(y)A. No word for “by”: tarafından is for passive sentences."
        }
      ]
    },
