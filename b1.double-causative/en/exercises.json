{
  "topic": "b1.double-causative",
  "exercises": [
    {
      "id": "b1.double-causative.ex1",
      "topic": "b1.double-causative",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Who did what?",
      "items": [
        {
          "prompt": "Kral düşmanını askerlerine öldürttü. Who killed the enemy?",
          "say": "Kral düşmanını askerlerine öldürttü.",
          "options": [
            "The king",
            "The soldiers",
            "The enemy himself"
          ],
          "answer": 1,
          "explanation": "askerlerine — dative: the last doer. The king only gave the order."
        },
        {
          "prompt": "Arabamı yıkattırdım.",
          "say": "Arabamı yıkattırdım.",
          "options": [
            "I washed the car myself.",
            "I had the car washed; I didn’t wash it myself.",
            "The car wasn’t washed."
          ],
          "answer": 1,
          "explanation": "yıka → yıkat → yıkattır: two floors, you just set it up."
        },
        {
          "prompt": "How many floors in “yaptırt”?",
          "options": [
            "Zero",
            "One",
            "Two"
          ],
          "answer": 2,
          "explanation": "-tır is the first floor, -t the second."
        },
        {
          "prompt": "Ebe bebeği doğurttu.",
          "say": "Ebe bebeği doğurttu.",
          "options": [
            "The midwife gave birth to a baby.",
            "The midwife delivered the baby.",
            "The baby was born on its own."
          ],
          "answer": 1,
          "explanation": "doğ → doğur → doğurt: “deliver a baby” — help someone else give birth."
        },
        {
          "prompt": "Duvarı boyattım.",
          "say": "Duvarı boyattım.",
          "options": [
            "I had a painter paint the wall.",
            "I painted the wall myself.",
            "I got the wall painted through two people."
          ],
          "answer": 0,
          "explanation": "One -t — one floor, one doer."
        }
      ]
    },
    {
      "id": "b1.double-causative.ex2",
