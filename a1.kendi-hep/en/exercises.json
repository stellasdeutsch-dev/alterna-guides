          "options": [
            "kendi",
            "kendim",
            "kendin"
          ],
          "answer": 1,
          "explanation": "ben → plate -m: kendim."
        },
        {
          "id": "2",
          "prompt": "Biz ___ gidiyoruz. (we ourselves)",
          "say": "Biz kendimiz gidiyoruz.",
          "options": [
            "kendimiz",
            "kendiniz",
            "kendileri"
          ],
          "answer": 0,
          "explanation": "biz and -uz in the verb → kendimiz."
        },
        {
          "id": "3",
          "prompt": "___ öğrenciyiz. (all of us)",
          "say": "Hepimiz öğrenciyiz.",
          "options": [
            "Hepsi",
            "Hepiniz",
            "Hepimiz"
          ],
          "answer": 2,
          "explanation": "-yiz means “we.” So hepimiz."
        },
        {
          "id": "4",
          "prompt": "kendi ___ (my own house)",
          "say": "kendi evim",
          "options": [
            "ev",
            "evim",
            "kendim ev"
          ],
          "answer": 1,
          "explanation": "Before a thing, kendi is bare and the tail goes on the house: kendi evim."
        }
      ]
    },
