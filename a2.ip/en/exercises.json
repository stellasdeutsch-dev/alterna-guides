    {
      "id": "a2.ip.ex3",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "custom",
      "difficulty": 2,
      "instruction": "Morning in İzmir: glue two sentences into one",
      "description": "Two sentences from a morning in İzmir are on the court. The student picks the form of the first verb, and the sentences glue into one. The logic is in index.html.",
      "items": [
        {
          "id": "1",
          "a": "Kalktım.",
          "b": "Kahvaltı yaptım.",
          "options": [
            "kalkıp",
            "kalktıp",
            "kalkup"
          ],
          "answer": "kalkıp",
          "result": "Kalkıp kahvaltı yaptım.",
          "ru": "Got up and had breakfast.",
          "explanation": "English marks the past twice: got up, had. Turkish only once. -ıp hooks onto the bare root kalk; the past -tı stays on the last verb."
        },
        {
          "id": "2",
          "a": "Boyoz aldım.",
          "b": "Çay içtim.",
          "options": [
            "alip",
            "aldıp",
            "alıp"
          ],
          "answer": "alıp",
          "result": "Boyoz alıp çay içtim.",
          "ru": "Bought a boyoz and had some tea.",
          "explanation": "Last vowel a, so -ıp."
        },
        {
          "id": "3",
          "a": "Gazete okudum.",
          "b": "Uyudum.",
          "options": [
            "okup",
            "okuyup",
            "okuyıp"
          ],
          "answer": "okuyup",
          "result": "Gazete okuyup uyudum.",
          "ru": "Read the paper and fell asleep.",
          "explanation": "oku ends in a vowel: y runs out. After u comes -up."
        },
        {
          "id": "4",
          "a": "Vapur bekledim.",
          "b": "Bindim.",
          "options": [
            "bekleyip",
            "beklip",
            "bekleyıp"
          ],
          "answer": "bekleyip",
          "result": "Vapur bekleyip bindim.",
          "ru": "Waited for the ferry and got on.",
          "explanation": "bekle ends in e: you need the buffer y, and e gives -ip. Turkish never drops the vowel of the suffix."
        },
        {
          "id": "5",
          "a": "Gittim.",
          "b": "Baktım.",
          "options": [
            "gitip",
            "gittip",
            "gidip"
          ],
          "answer": "gidip",
          "result": "Gidip baktım.",
          "ru": "Went and took a look.",
          "explanation": "Before a vowel, the t in git becomes d: gidip."
        }
      ]
    },
    {
      "id": "a2.ip.ex4",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "build_sentence",
      "difficulty": 2,
      "instruction": "Build the sentence",
      "items": [
        {
          "id": "1",
          "translation": "In the morning I got up and took a shower.",
          "words": [
            "Sabah",
            "kalkıp",
            "duş",
            "aldım."
          ],
          "distractors": [
            "ve",
            "kalktım"
          ],
          "explanation": "The first verb gets -ıp, the tense and “I” go on the last one. English “and” is already inside -ıp, so no ve."
        },
        {
          "id": "2",
          "translation": "We ate and left.",
          "words": [
            "Yemek",
            "yiyip",
            "çıktık."
          ],
          "distractors": [
            "yeyip",
            "çıkıp"
          ],
          "explanation": "ye → yiyip. The last verb carries “we” and the past: çıktık."
        },
        {
          "id": "3",
          "translation": "He came and sat down.",
          "words": [
            "Gelip",
            "oturdu."
          ],
          "distractors": [
            "Geldip",
            "oturup"
          ],
          "explanation": "gel → gelip. The last verb takes the tense: oturdu."
        }
      ]
    },
    {
