          "prompt": "göz — «глаз». Как будет «глаза»?",
          "say": "gözler",
          "options": ["gözler", "gözlar"],
          "answer": 0,
          "explanation": "Последняя гласная ö — из переднего ряда. Значит, -ler: gözler."
        },
        {
          "id": "2",
          "prompt": "okul — «школа». Как будет «школы»?",
          "say": "okullar",
          "options": ["okuller", "okullar"],
          "answer": 1,
          "explanation": "Последняя гласная u — задний ряд. Значит, -lar: okullar."
        },
        {
          "id": "3",
          "prompt": "ağaç — «дерево». Как будет «деревья»?",
          "say": "ağaçlar",
          "options": ["ağaçlar", "ağaçler"],
          "answer": 0,
          "explanation": "Смотрим только на последнюю гласную: a → -lar. Никаких «человек → люди»."
        },
        {
          "id": "4",
          "prompt": "Как сказать «она красивая»?",
          "say": "O güzel.",
          "options": ["Ona güzel.", "O güzel.", "O güzelle."],
          "answer": 1,
          "explanation": "Рода нет: o — и он, и она, и оно. Фраза одна на всех: O güzel."
        }
      ]
    },
