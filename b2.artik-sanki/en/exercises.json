{
  "topic": "b2.artik-sanki",
  "exercises": [
    {
      "id": "b2.artik-sanki.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Get the meaning",
      "items": [
        {
          "id": "1",
          "prompt": "“I don't smoke anymore” is…",
          "say": "Artık sigara içmiyorum.",
          "options": [
            "Artık sigara içiyorum.",
            "Artık sigara içmiyorum.",
            "Hâlâ sigara içiyorum."
          ],
          "answer": 1,
          "explanation": "“Not anymore” is artık plus negation in the verb: içmiyorum. English splits it (don't … anymore); Turkish doesn't."
        },
        {
          "id": "2",
          "prompt": "“Sanki yağmur yağıyor.” means…",
          "say": "Sanki yağmur yağıyor.",
          "options": [
            "It's probably raining.",
            "It feels like it's raining.",
            "It's not raining anymore."
          ],
          "answer": 1,
          "explanation": "Sanki is “as if”: a feeling, no guarantee. English “it seems” can be a guess too — but a guess is galiba."
        },
        {
          "id": "3",
          "prompt": "“Now I understand” is…",
          "say": "Artık anlıyorum.",
          "options": [
            "Artık anlıyorum.",
            "Artık anlamıyorum.",
            "Sanki anlıyorum."
          ],
          "answer": 0,
          "explanation": "Without negation artık means “now”: didn't get it before, get it now."
        },
        {
          "id": "4",
          "prompt": "“As if you work a lot!” is…",
          "say": "Sanki sen çok çalışıyorsun!",
          "options": [
            "Artık çok çalışıyorsun.",
            "Sanki sen çok çalışıyorsun!",
            "Hâlâ çok çalışıyorsun."
          ],
          "answer": 1,
          "explanation": "Irony is sanki with stress on “you.” The meaning flips: you don't work."
        }
      ]
    },
    {
      "id": "b2.artik-sanki.ex2",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "matching",
      "difficulty": 1,
      "instruction": "Match the sentence and the translation",
      "items": [
        {
          "id": "1",
          "pairs": [
            {
              "left": "Artık kahve içmiyorum.",
              "right": "I don't drink coffee anymore."
            },
            {
              "left": "Artık kahve içiyorum.",
              "right": "Now I drink coffee."
            },
            {
              "left": "Hâlâ kahve içiyorum.",
              "right": "I still drink coffee."
            },
            {
              "left": "Zaten kahve içiyorum.",
              "right": "I drink coffee anyway."
            },
            {
              "left": "Sanki rüya görüyorum.",
              "right": "It's as if I'm dreaming."
            }
          ],
          "explanation": "Artık with “not” — not anymore, without “not” — now. Hâlâ — still. Zaten — anyway, already. Sanki — as if."
        }
      ]
    },
