            [
              "Seven",
              "Sevdiğin",
              "Sevtiğin"
            ]
          ],
          "translation": "Who’s the writer you love?",
          "explanation": "v is voiced, so d. The “your” ending is -in."
        },
        {
          "id": "c",
          "text": "___ kahve güzel. (we drink)",
          "answers": [
            [
              "İçtiğimiz"
            ]
          ],
          "options": [
            [
              "İçdiğimiz",
              "İçtiğimiz",
              "İçtiğim"
            ]
          ],
          "translation": "The coffee we drink is good.",
          "explanation": "ç is voiceless, so t. “Our” is -imiz."
        },
        {
          "id": "d",
          "text": "___ film güzel mi? (they watch)",
          "answers": [
            [
              "Gördükleri"
            ]
          ],
          "options": [
            [
              "Gördükleri",
              "Gördüğleri",
              "Görenleri"
            ]
          ],
          "translation": "Is the movie they’re watching good?",
          "explanation": "“They” is -leri. After k comes a consonant, so k doesn’t soften."
        },
        {
          "id": "e",
          "text": "___ mesaj güzel. (he writes)",
          "answers": [
            [
              "Yazdığı"
            ]
          ],
          "options": [
            [
              "Yazdığım",
              "Yazdığı",
              "Yazan"
            ]
          ],
          "translation": "The message he’s writing is good.",
          "explanation": "“His” is -ı. He’s the one who can write, not the message."
        }
      ]
    },
    {
