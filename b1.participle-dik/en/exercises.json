{
  "topic": "b1.participle-dik",
  "exercises": [
    {
      "id": "b1.participle-dik.ex1",
      "topic": "b1.participle-dik",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "What does the phrase mean? Pick the translation.",
      "items": [
        {
          "id": "a",
          "prompt": "okuduğum kitap",
          "say": "okuduğum kitap",
          "options": [
            "I’m reading a book",
            "the book I’m reading",
            "the book that reads"
          ],
          "answer": 1,
          "explanation": "-DIk + “my”: I’m the one reading. It’s not a sentence, it’s a description of the book — the English “the book (that) I’m reading,” flipped."
        },
        {
          "id": "b",
          "prompt": "sevdiğin yazar",
          "say": "sevdiğin yazar",
          "options": [
            "the writer you love",
            "the writer who loves you",
            "I love the writer"
          ],
          "answer": 0,
          "explanation": "The ending -in is “your”: you do the loving, the writer gets loved."
        },
        {
          "id": "c",
          "prompt": "içtiğimiz kahve",
          "say": "içtiğimiz kahve",
          "options": [
            "the coffee they drink",
            "the coffee that drinks us",
            "the coffee we drink"
          ],
          "answer": 2,
          "explanation": "-imiz is “our”: we drink it."
        },
        {
          "id": "d",
          "prompt": "okuyan kız",
          "say": "okuyan kız",
          "options": [
            "the girl I’m reading",
            "the girl who is reading",
            "the girl’s book"
          ],
          "answer": 1,
          "explanation": "-(y)An is “who + verb”: the girl reads by herself. In English you can’t drop “who” here — that’s your sign."
        }
      ]
    },
    {
      "id": "b1.participle-dik.ex2",
