        {
          "id": "q1",
          "type": "true_false",
          "statement": "In “okuduğum kitap,” the ending -um shows who’s reading.",
          "answer": true,
          "explanation": "Yes. -um is “my”: I’m reading."
        },
        {
          "id": "q2",
          "type": "multiple_choice",
          "prompt": "How do you say “the coffee you drink”?",
          "options": [
            "içen kahve",
            "içtiğin kahve",
            "içdiğin kahve"
          ],
          "answer": 1,
          "explanation": "You drink it — -DIk plus “your.” After voiceless ç — t."
        },
        {
          "id": "q3",
          "type": "true_false",
          "statement": "A -DIk form can mean both “read (past)” and “am reading.”",
          "answer": true,
          "explanation": "Yes. -DIk doesn’t split past and present. It just doesn’t do the future."
        },
        {
          "id": "q4",
          "type": "multiple_choice",
          "prompt": "Why okuduğum and not okudukum?",
          "options": [
            "k before a vowel softens to ğ",
            "it’s shorter",
            "it’s a different tense"
          ],
          "answer": 0,
          "explanation": "Like kitap → kitabı: a voiceless consonant before a vowel softens."
        },
        {
          "id": "q5",
          "type": "multiple_choice",
          "prompt": "“The girl who is reading” —",
          "options": [
            "okuduğum kız",
            "okuduğu kız",
            "okuyan kız"
          ],
          "answer": 2,
          "explanation": "“The girl who is reading” — you can’t drop “who,” the girl does it herself. That’s -(y)An."
        }
      ]
    },
