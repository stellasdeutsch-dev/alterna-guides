    {
      "id": "b1.must-past.ex4",
      "topic": "b1.must-past",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "error_hunt",
      "difficulty": 3,
      "instruction": "Find the mistake and fix it",
      "items": [
        {
          "prompt": "I should have left earlier.",
          "tokens": [
            "Evden",
            "erken",
            "çıkmalıydim."
          ],
          "wrong": 2,
          "fix": "çıkmalıydım.",
          "options": [
            "çıkmalıydım.",
            "çıkmalıdım.",
            "çıkmalımdı."
          ],
          "explanation": "After malı comes ydı, so the person is -ım too: çıkmalıydım."
        },
        {
          "prompt": "You should have told me.",
          "tokens": [
            "Bana",
            "söylemelindi."
          ],
          "wrong": 1,
          "fix": "söylemeliydin.",
          "options": [
            "söylemeliydin.",
            "söylemelidin.",
            "söylemeliymişin."
          ],
          "explanation": "In English “you” comes first. In Turkish the person goes at the very end: söyle-meli-ydi-n."
        },
        {
          "prompt": "Turns out we should have gone to Düden in the morning.",
          "tokens": [
            "Düden'e",
            "sabah",
            "gelmeliydik."
          ],
          "wrong": 2,
          "fix": "gelmeliymişiz.",
          "options": [
            "gelmeliymişiz.",
            "gelmeliydiniz.",
            "gelmemeliydik."
          ],
          "explanation": "“Turns out” means -ymiş: gelmeliymişiz."
        },
        {
          "prompt": "I shouldn’t have eaten so much.",
          "tokens": [
            "Bu",
            "kadar",
            "yemeliydim."
          ],
          "wrong": 2,
          "fix": "yememeliydim.",
          "options": [
            "yememeliydim.",
            "yememeliymişim.",
            "yemeliymişim."
          ],
          "explanation": "You need “not,” and it goes on the verb, not on “should”: ye-me-meli-ydi-m."
        }
      ]
    },
