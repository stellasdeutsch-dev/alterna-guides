    {
      "id": "b1.must-past.ex1",
      "topic": "b1.must-past",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "What does the sentence mean?",
      "items": [
        {
          "prompt": "Seni dinlemeliydim.",
          "say": "Seni dinlemeliydim.",
          "options": [
            "I need to listen to you.",
            "I should have listened to you.",
            "Turns out I should have listened to you."
          ],
          "answer": 1,
          "explanation": "-meliydim is “should have,” and you know it yourself. No “turns out.”"
        },
        {
          "prompt": "Havalimanına üç saat önce gelmeliymişiz.",
          "say": "Havalimanına üç saat önce gelmeliymişiz.",
          "options": [
            "Turns out we should have gotten to the airport three hours early.",
            "We need to get to the airport three hours early.",
            "We shouldn’t have gotten to the airport so early."
          ],
          "answer": 0,
          "explanation": "-meliymiş is “turns out”: we found out later. -iz is “we.”"
        },
        {
          "prompt": "Bu kadar para harcamamalıydım.",
          "say": "Bu kadar para harcamamalıydım.",
          "options": [
            "I should have spent more money.",
            "I shouldn’t have spent so much money.",
            "I have to spend less."
          ],
          "answer": 1,
          "explanation": "harca-ma-malı-ydı-m: -ma before -malı means “shouldn’t have.”"
        },
        {
          "prompt": "Bana söylemeliydin.",
          "say": "Bana söylemeliydin.",
          "options": [
            "You should have told me.",
            "I should have told you.",
            "Tell me."
          ],
          "answer": 0,
          "explanation": "The ending -n is “you”: it’s a dig at a friend."
        },
        {
          "prompt": "Ablama çiçek almalı mıydım?",
          "say": "Ablama çiçek almalı mıydım?",
          "options": [
            "Should I have bought my sister flowers?",
            "I should have bought my sister flowers.",
            "Did my sister buy flowers?"
          ],
          "answer": 0,
          "explanation": "mı stands alone, so it’s a question: “should I have or not?”"
        }
      ]
    },
    {
      "id": "b1.must-past.ex2",
      "topic": "b1.must-past",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "matching",
      "difficulty": 2,
      "instruction": "Match the form and the translation",
      "items": [
        {
          "pairs": [
            {
              "left": "gelmeliydim",
              "right": "I should have come"
            },
            {
              "left": "gelmeliydin",
              "right": "you should have come"
            },
            {
              "left": "gelmemeliydik",
              "right": "we shouldn’t have come"
            },
            {
              "left": "gelmeliymiş",
              "right": "turns out he should have come"
            },
            {
              "left": "gelmeli miydiniz?",
              "right": "should you have come?"
            }
          ],
          "explanation": "Look at the tail: -m is I, -n is you, -k is we. English changes the word in front (I, you, we); Turkish changes the ending. -me- is “not,” -ymiş is “turns out,” mi is a question."
        }
      ]
    },
