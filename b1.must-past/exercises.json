        { "prompt": "Bu kadar para harcamamalıydım.", "say": "Bu kadar para harcamamalıydım.", "options": ["Надо было потратить больше денег.", "Не надо было тратить столько денег.", "Я должен тратить меньше."], "answer": 1, "explanation": "harca-ma-malı-ydı-m: -ma перед -malı — «не надо было»." },
        { "prompt": "Bana söylemeliydin.", "say": "Bana söylemeliydin.", "options": ["Тебе надо было мне сказать.", "Мне надо было тебе сказать.", "Скажи мне."], "answer": 0, "explanation": "Окончание -n — «ты»: это упрёк другу." },
        { "prompt": "Ablama çiçek almalı mıydım?", "say": "Ablama çiçek almalı mıydım?", "options": ["Надо было купить сестре цветы?", "Надо было купить сестре цветы.", "Сестра купила цветы?"], "answer": 0, "explanation": "mı отдельно — это вопрос: «надо было или нет?»" }
      ]
    },
