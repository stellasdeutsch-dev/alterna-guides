      "difficulty": 1,
      "instruction": "The taxi driver asks “Nerelisin?” Pick the answer.",
      "items": [
        {
          "prompt": "You're from Ankara.",
          "options": [
            "Ankaralıyım.",
            "Ankarayım.",
            "Ankaralıyız."
          ],
          "answer": 0,
          "say": "Ankaralıyım.",
          "explanation": "City + -lı = “from Ankara.” Then the “I” ending: Ankaralı + y + ım."
        },
        {
          "prompt": "You're from Izmir.",
          "options": [
            "İzmirlıyım.",
            "İzmirliyim.",
            "İzmirluyum."
          ],
          "answer": 1,
          "say": "İzmirliyim.",
          "explanation": "The last vowel in İzmir is i. So -li, then -yim."
        },
        {
          "prompt": "What does “Nerelisin?” mean?",
          "options": [
            "Where are you from?",
            "Where are you now?",
            "What do you do for a living?"
          ],
          "answer": 0,
          "say": "Nerelisin?",
          "explanation": "Nere + li + sin — “where are you from.” They're asking where you come from."
        },
        {
          "prompt": "You're from Kazakhstan.",
          "options": [
            "Ben Kazakistan.",
            "Ben Kazakistanlıyım.",
            "Ben Kazakçayım."
          ],
          "answer": 1,
          "say": "Ben Kazakistanlıyım.",
          "explanation": "“Ben Kazakistan” means “I am Kazakhstan.” You need -lı and the ending -yım."
        }
      ]
    },
