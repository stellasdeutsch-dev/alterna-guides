    {
      "id": "a1.nationality.ex4",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "build_sentence",
      "difficulty": 3,
      "instruction": "Build the whole line.",
      "items": [
        {
          "translation": "I'm from Kazakhstan. I speak Kazakh and Russian.",
          "words": [
            "Ben",
            "Kazakistanlıyım.",
            "Kazakça",
            "ve",
            "Rusça",
            "biliyorum."
          ],
          "distractors": [
            "Kazakistanca",
            "Kazakistan"
          ],
          "say": "Ben Kazakistanlıyım. Kazakça ve Rusça biliyorum.",
          "explanation": "Where from — Kazakistanlıyım (-lı + -yım). The language comes from the people: Kazakça, not Kazakistanca."
        },
        {
          "translation": "Where are you from? — We're from Istanbul.",
          "words": [
            "Nerelisiniz?",
            "Biz",
            "İstanbulluyuz."
          ],
          "distractors": [
            "İstanbullıyız.",
            "Nerelisin?"
          ],
          "say": "Nerelisiniz? Biz İstanbulluyuz.",
          "explanation": "Polite — Nerelisiniz. In İstanbul the last vowel is u → -lu, and for “we” — -yuz."
        },
        {
          "translation": "Anna is Russian. She's from Moscow.",
          "words": [
            "Anna",
            "Rus.",
            "O",
            "Moskovalı."
          ],
          "distractors": [
            "Rusça.",
            "Moskovalu."
          ],
          "say": "Anna Rus. O Moskovalı.",
          "explanation": "Rus is the nationality, Rusça is the language. In Moskova the last vowel is a → -lı. No tail for “she.”"
        }
      ]
    },
