{
  "topic": "a1.copula-negative",
  "exercises": [
    {
      "id": "a1.copula-negative.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Spot the form",
      "items": [
        {
          "id": "1",
          "prompt": "“I’m not a teacher” is…",
          "say": "Ben öğretmen değilim.",
          "options": [
            "Ben öğretmen değilim.",
            "Ben değil öğretmenim.",
            "Ben öğretmenim değil."
          ],
          "answer": 0,
          "explanation": "English says “I am not a teacher”. Turkish puts the word first, then değil. The tail -im sits on değil."
        },
        {
          "id": "2",
          "prompt": "Which one is “are you tired?”",
          "say": "Sen yorgun musun?",
          "options": [
            "Mu sen yorgunsun?",
            "Sen yorgun musun?",
            "Sen yorgun değilsin."
          ],
          "answer": 1,
          "explanation": "No English-style flip. The key mu goes after the word, and the tail -sun moves onto it: musun."
        },
        {
          "id": "3",
          "prompt": "“We’re not hungry” is…",
          "say": "Biz aç değiliz.",
          "options": [
            "Biz aç değilsiniz.",
            "Biz açız değil.",
            "Biz aç değiliz."
          ],
          "answer": 2,
          "explanation": "We is the tail -iz. The tail rides on değil: değiliz."
        },
        {
          "id": "4",
          "prompt": "“Aren’t you a student?” is…",
          "say": "Sen öğrenci değil misin?",
          "options": [
            "Sen öğrenci değilsin.",
            "Sen öğrenci değil misin?",
            "Sen öğrenci misin?"
          ],
          "answer": 1,
          "explanation": "A question with “not”: first the değil scissors, then the key mi with the tail -sin."
        }
      ]
    },
