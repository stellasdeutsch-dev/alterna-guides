      "id": "a1.demonstratives.ex3",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "custom",
      "difficulty": 2,
      "instruction": "Ferry deck: ask the question",
      "description": "The deck has three zones: in hand, nearby, far away. A thing or a person shows up, the learner picks bu/şu/o and ne/kim and asks. The logic lives in index.html.",
      "items": [
        {
          "id": "1",
          "object": "cay",
          "zone": 0,
          "ctx": "Someone handed you a glass of tea. It’s in your hand. Ask what it is.",
          "answer": {
            "pointer": "bu",
            "q": "ne"
          },
          "reply": "Bu bir çay.",
          "explanation": "In your hand — bu. Tea isn’t a person — ne."
        },
        {
          "id": "2",
          "object": "simit",
          "zone": 1,
          "ctx": "The woman next to you is holding something round. You point at it.",
          "answer": {
            "pointer": "şu",
            "q": "ne"
          },
          "reply": "Şu bir simit.",
          "explanation": "You point, the thing is with her — şu. It’s a thing — ne."
        },
        {
          "id": "3",
          "object": "kaptan",
          "zone": 2,
          "ctx": "Far away on the bridge stands a man in a captain’s cap.",
          "answer": {
            "pointer": "o",
            "q": "kim"
          },
          "reply": "O kaptan.",
          "explanation": "Far away — o. A person — kim."
        },
        {
          "id": "4",
          "object": "kedi",
          "zone": 2,
          "ctx": "Far away on the pier sits a ginger cat. Very important.",
          "answer": {
            "pointer": "o",
            "q": "ne"
          },
          "reply": "O bir kedi.",
          "explanation": "Far away — o. A cat isn’t a person — ne. Even if he runs the place."
        },
        {
          "id": "5",
          "object": "ogretmen",
          "zone": 0,
          "ctx": "Right next to you stands a woman with a red book.",
          "answer": {
            "pointer": "bu",
            "q": "kim"
          },
          "reply": "Bu bir öğretmen.",
          "explanation": "Really close — bu. A person — kim."
        }
      ]
    },
