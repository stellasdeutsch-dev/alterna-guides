          "wrong": 4,
          "fix": "girerdim.",
          "options": [
            "girerdim.",
            "girdim.",
            "giriyorum."
          ],
          "explanation": "There's eskiden — you need a past habit: girerdim. Girerim is about now."
        },
        {
          "id": "3",
          "type": "error_hunt",
          "prompt": "Find the mistake",
          "tokens": [
            "Eskiden",
            "her",
            "sabah",
            "çay",
            "içtim."
          ],
          "wrong": 4,
          "fix": "içerdim.",
          "options": [
            "içerdim.",
            "içerim.",
            "içiyorum."
          ],
          "explanation": "English says “I drank tea every morning.” Turkish wants the habit form for an old habit: içerdim."
        },
        {
          "id": "4",
          "type": "build_sentence",
          "translation": "Did you use to play the guitar?",
          "words": [
            "Eskiden",
            "gitar",
            "çalar",
            "mıydın?"
          ],
          "distractors": [
            "çalardın",
            "mı?"
          ],
          "explanation": "Mı goes after -r and drags -ydın along: çalar mıydın?"
        }
      ]
    },
    {
      "id": "a2.aorist-past.ex5",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "custom",
      "difficulty": 2,
      "instruction": "A constellation over the bay: light the stars with the right forms",
      "description": "Night over the Bay of Izmir. Six stars — six old habits. The learner picks a form by finger, mouse or keys 1–3; the right form lights a star and finishes drawing the ferry constellation. The logic lives in index.html.",
      "items": [
        {
          "id": "1",
          "prompt": "Her yaz Foça'ya ___.",
          "ru": "We used to go to Foça every summer.",
          "options": [
            "gittik",
            "giderdik",
            "gideriz"
          ],
          "answer": "giderdik",
          "explanation": "Every summer, long ago: gider + di + k."
        },
        {
          "id": "2",
          "prompt": "Çocukken balık ___.",
          "ru": "As a kid I didn't like fish.",
          "options": [
            "sevmezdim",
            "sevmemdim",
            "sevmem"
          ],
          "answer": "sevmezdim",
          "explanation": "A negative habit is always -mez: sevmezdim."
        },
        {
          "id": "3",
          "prompt": "Dedem her sabah denize ___.",
          "ru": "Grandpa used to look at the sea every morning.",
          "options": [
            "baktı",
            "bakardı",
            "bakıyor"
          ],
          "answer": "bakardı",
          "explanation": "Every morning and long ago: bak + ar + dı."
        },
        {
          "id": "4",
          "prompt": "Eskiden dans ___?",
          "ru": "Did you use to dance?",
          "options": [
            "ederdin mi",
            "eder miydin",
            "ettin mi"
          ],
          "answer": "eder miydin",
          "explanation": "Mi goes after -r: eder miydin."
        },
        {
          "id": "5",
          "prompt": "Her akşam vapura ___.",
          "ru": "We used to take the ferry every evening.",
          "options": [
            "binerdik",
            "binirdik",
            "binardık"
          ],
          "answer": "binerdik",
          "explanation": "Bin — one syllable, not an exception: bin-er. Then -di-k."
        },
        {
          "id": "6",
          "prompt": "Komşumuz her gün bize ___.",
          "ru": "The neighbor used to come over every day.",
          "options": [
            "gelerdi",
            "geldi",
            "gelirdi"
          ],
          "answer": "gelirdi",
          "explanation": "Gel is an exception: gel-ir. So gelirdi."
        }
      ]
    },
