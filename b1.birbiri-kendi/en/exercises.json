      "instruction": "What does the sentence mean?",
      "items": [
        {
          "id": "1",
          "prompt": "Onlar birbirini seviyor.",
          "say": "Onlar birbirini seviyor.",
          "options": [
            "They love each other.",
            "They love themselves.",
            "They love him."
          ],
          "answer": 0,
          "explanation": "birbiri is ping-pong: the action flies from one person to the other. It means “each other.”"
        },
        {
          "id": "2",
          "prompt": "Kendine iyi bak!",
          "say": "Kendine iyi bak!",
          "options": [
            "Look at him!",
            "Take care of each other!",
            "Take care of yourself!"
          ],
          "answer": 2,
          "explanation": "kendine is a boomerang back to you: “look well to yourself,” that is, “take care.”"
        },
        {
          "id": "3",
          "prompt": "Biz birbirimize yardım ediyoruz.",
          "say": "Biz birbirimize yardım ediyoruz.",
          "options": [
            "We help ourselves.",
            "We help each other.",
            "Someone helps us."
          ],
          "answer": 1,
          "explanation": "birbirimize is “to each other” for “we.” Badge -imiz, case -e."
        },
        {
          "id": "4",
          "prompt": "Çocuk kendi kendine oynuyor.",
          "say": "Çocuk kendi kendine oynuyor.",
          "options": [
            "The kids play with each other.",
            "The kid plays by himself.",
            "The kid plays with him."
          ],
          "answer": 1,
          "explanation": "Double kendi, kendi kendine, means “by oneself,” alone."
        }
      ]
    },
