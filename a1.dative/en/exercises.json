{
  "topic": "a1.dative",
  "exercises": [
    {
      "id": "a1.dative.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Spot the form: where to, to whom, toward what",
      "items": [
        {
          "id": "1",
          "prompt": "okul → “to school”",
          "say": "okula",
          "options": [
            "okula",
            "okule"
          ],
          "answer": 0,
          "explanation": "The last vowel u is a back vowel. So -a: okula."
        },
        {
          "id": "2",
          "prompt": "kedi → “to the cat”",
          "say": "kediye",
          "options": [
            "kedie",
            "kediye",
            "kedia"
          ],
          "answer": 1,
          "explanation": "It ends in a vowel. Turkish doesn’t like two vowels in a row, so the buffer y steps in: kediye."
        },
        {
          "id": "3",
          "prompt": "kitap → “to the book”",
          "say": "kitaba",
          "options": [
            "kitapa",
            "kitaba",
            "kitabe"
          ],
          "answer": 1,
          "explanation": "p before a vowel gets voiced and turns into b. Vowel a → -a: kitaba."
        },
        {
          "id": "4",
          "prompt": "ben → “to me”",
          "say": "bana",
          "options": [
            "bene",
            "bana",
            "benye"
          ],
          "answer": 1,
          "explanation": "Ben and sen don’t follow the rule. Learn them by sight: bana, sana."
        },
        {
          "id": "5",
          "prompt": "İstanbul → “to Istanbul”",
          "say": "İstanbul'a",
          "options": [
            "İstanbula",
            "İstanbul'a",
            "İstanbul'e"
          ],
          "answer": 1,
          "explanation": "A city goes behind an apostrophe, like behind a fence. Last vowel u → -a."
        }
      ]
    },
    {
      "id": "a1.dative.ex2",
      "lesson": 1,
      "kind": "practice",
