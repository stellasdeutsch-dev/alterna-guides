            },
            {
              "id": "ya",
              "label": "-ya"
            },
            {
              "id": "ye",
              "label": "-ye"
            }
          ],
          "entries": [
            {
              "text": "okul",
              "bucket": "a"
            },
            {
              "text": "park",
              "bucket": "a"
            },
            {
              "text": "ev",
              "bucket": "e"
            },
            {
              "text": "deniz",
              "bucket": "e"
            },
            {
              "text": "araba",
              "bucket": "ya"
            },
            {
              "text": "masa",
              "bucket": "ya"
            },
            {
              "text": "kedi",
              "bucket": "ye"
            },
            {
              "text": "anne",
              "bucket": "ye"
            }
          ],
          "explanation": "Two questions, in order. Is the last vowel back (a, ı, o, u) or front (e, i, ö, ü)? Does the word end in a vowel? Then add the buffer y."
        }
      ]
    },
    {
      "id": "a1.dative.ex3",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "mixed",
      "difficulty": 2,
      "instruction": "Fill in the form, build the phrase, find the mistake",
      "items": [
        {
          "id": "1",
          "type": "gap_fill",
          "text": "Her sabah ___ gidiyorum. (okul)",
          "answers": [
            [
              "okula"
            ]
          ],
          "translation": "Every morning I go to school.",
          "explanation": "Where to? To school. okul + a = okula."
        },
        {
          "id": "2",
          "type": "build_sentence",
          "translation": "I’m looking at the sea.",
          "words": [
            "Ben",
            "denize",
            "bakıyorum."
          ],
          "distractors": [
            "denizde"
          ],
          "explanation": "Bakmak takes the dative: your gaze flies toward the sea, denize. English says “at,” but denizde would mean “at the sea” as a place."
        },
        {
          "id": "3",
          "type": "error_hunt",
          "prompt": "Find the mistake",
          "tokens": [
            "Ev",
            "gidiyorum."
          ],
          "wrong": 0,
          "fix": "Eve",
          "options": [
            "Eve",
            "Evde"
          ],
          "explanation": "English says “go home” with no “to.” Turkish still needs the arrow: eve gidiyorum."
        },
        {
          "id": "4",
          "type": "gap_fill",
          "text": "Akşam ___ gidiyorum.",
          "answers": [
            [
              "eve",
              "parka",
              "kafeye",
              "okula",
              "denize"
            ]
          ],
          "translation": "In the evening I’m going… Where are you going? Home (ev), to the park (park), or to a café (kafe)?",
          "explanation": "Any place works if the tail is right: eve, parka, kafeye. kafe ends in a vowel, so it needs the buffer y."
        }
      ]
    },
    {
      "id": "a1.dative.ex4",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "custom",
      "difficulty": 2,
      "instruction": "Dolmuş across Istanbul: what’s the tail for this stop?",
      "description": "The dolmuş rides from stop to stop around Istanbul. The learner picks the tail -a, -e, -ya, or -ye (buttons or keys 1–4), and the dolmuş moves on. Logic lives in index.html.",
      "items": [
        {
          "id": "1",
          "place": "Kadıköy",
          "answer": "e",
          "form": "Kadıköy'e",
          "explanation": "The last vowel ö is a front vowel: -e. A neighborhood name goes behind an apostrophe."
        },
        {
          "id": "2",
          "place": "Galata",
          "answer": "ya",
          "form": "Galata'ya",
          "explanation": "It ends in the vowel a: buffer y and -a."
        },
        {
          "id": "3",
          "place": "Beşiktaş",
          "answer": "a",
          "form": "Beşiktaş'a",
          "explanation": "The last vowel is a, and it ends in a consonant: just -a."
        },
        {
          "id": "4",
          "place": "Sirkeci",
          "answer": "ye",
          "form": "Sirkeci'ye",
          "explanation": "It ends in i, a front vowel. Buffer y and -e."
        },
        {
          "id": "5",
          "place": "Bebek",
          "answer": "e",
          "form": "Bebek'e",
          "explanation": "The last vowel is e. It’s a neighborhood name: the k behind the apostrophe doesn’t soften."
        },
        {
          "id": "6",
          "place": "Taksim",
          "answer": "e",
          "form": "Taksim'e",
          "explanation": "The last vowel i is a front vowel: -e."
        }
      ]
    },
