          "options": [
            "The train arrived yesterday.",
            "The train is arriving.",
            "The train won't come."
          ],
          "answer": 1,
          "explanation": "gelmektedir = geliyor: arriving right now."
        },
        {
          "id": "2",
          "prompt": "Müze saat dokuzda açılmaktadır.",
          "say": "Müze saat dokuzda açılmaktadır.",
          "options": [
            "The museum opens at nine.",
            "The museum is closed at nine.",
            "The museum opened at nine."
          ],
          "answer": 0,
          "explanation": "açılmaktadır = açılıyor: opens."
        },
        {
          "id": "3",
          "prompt": "Fiyatlar artmaktadır.",
          "say": "Fiyatlar artmaktadır.",
          "options": [
            "Prices are falling.",
            "Prices went up yesterday.",
            "Prices are going up."
          ],
          "answer": 2,
          "explanation": "artmaktadır = artıyor: going up. Now, not yesterday."
        },
        {
          "id": "4",
          "prompt": "Asansör çalışmamaktadır.",
          "say": "Asansör çalışmamaktadır.",
          "options": [
            "The elevator isn't working.",
            "The elevator is working.",
            "The elevator was working."
          ],
          "answer": 0,
          "explanation": "-ma before -makta means “not.” The stairs await."
        }
      ]
    },
