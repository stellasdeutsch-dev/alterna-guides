    {
      "id": "a1.locative.ex4",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "custom",
      "difficulty": 2,
      "instruction": "House tour: where’s the cat?",
      "description": "The learner reads and hears a phrase with -DA and taps the room in a cutaway of the house. Keys 1–6. Logic lives in index.html.",
      "items": [
        {
          "id": "1",
          "sentence": "Kedi mutfakta.",
          "answer": "mutfak",
          "explanation": "mutfakta means “in the kitchen.” mutfak + ta."
        },
        {
          "id": "2",
          "sentence": "Anne bahçede.",
          "answer": "bahçe",
          "explanation": "bahçede means “in the garden.” bahçe + de."
        },
        {
          "id": "3",
          "sentence": "Araba garajda.",
          "answer": "garaj",
          "explanation": "garajda means “in the garage.” garaj + da."
        },
        {
          "id": "4",
          "sentence": "Ali banyoda.",
          "answer": "banyo",
          "explanation": "banyoda means “in the bathroom.” banyo + da."
        },
        {
          "id": "5",
          "sentence": "Kedi şimdi çatıda!",
          "answer": "çatı",
          "explanation": "çatıda means “on the roof,” right up under it. The cat always finds a way up."
        }
      ]
    },
