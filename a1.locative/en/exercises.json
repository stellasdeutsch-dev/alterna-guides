      "difficulty": 1,
      "instruction": "Pick the right tail",
      "items": [
        {
          "id": "1",
          "prompt": "okul → ?",
          "say": "okulda",
          "options": [
            "okulda",
            "okulde",
            "okulta"
          ],
          "answer": 0,
          "explanation": "The last vowel is u, the word ends in a voiced l → -da."
        },
        {
          "id": "2",
          "prompt": "ev → ?",
          "say": "evde",
          "options": [
            "evda",
            "evde",
            "evte"
          ],
          "answer": 1,
          "explanation": "The last vowel is e, the word ends in v → -de."
        },
        {
          "id": "3",
          "prompt": "park → ?",
          "say": "parkta",
          "options": [
            "parkda",
            "parkta",
            "parkte"
          ],
          "answer": 1,
          "explanation": "Ends in a voiceless k → t. Vowel a → -ta."
        }
      ]
    },
    {
