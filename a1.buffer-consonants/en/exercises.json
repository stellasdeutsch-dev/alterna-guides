          "wrong": 0,
          "fix": "Onu",
          "options": [
            "Onu",
            "Ou",
            "Oyu"
          ],
          "say": "Onu al.",
          "explanation": "With o, bu, şu only n works: onu."
        },
        {
          "id": "4",
          "prompt": "His car is red.",
          "tokens": [
            "Onun",
            "araba",
            "kırmızı."
          ],
          "wrong": 1,
          "fix": "arabası",
          "options": [
            "arabası",
            "arabaya",
            "araba"
          ],
          "say": "Onun arabası kırmızı.",
          "explanation": "In English “his” is enough. In Turkish the car gets its own ending too: -ı, and s after a vowel: onun arabası."
        }
      ]
