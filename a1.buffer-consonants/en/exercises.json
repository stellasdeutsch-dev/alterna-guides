{
  "topic": "a1.buffer-consonants",
  "exercises": [
    {
      "id": "a1.buffer-consonants.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Look at the seam and pick the whole word",
      "items": [
        {
          "id": "1",
          "prompt": "araba + a (to the car)",
          "options": [
            "arabaa",
            "arabaya",
            "arabasa"
          ],
          "answer": 1,
          "say": "arabaya",
          "explanation": "a + a back to back — a gap. The tail isn't “his,” so it's fixer y: arabaya."
        },
        {
          "id": "2",
          "prompt": "kedi + i (the cat, as object)",
          "options": [
            "kedii",
            "kedisi",
            "kediyi"
          ],
          "answer": 2,
          "say": "kediyi",
          "explanation": "kedisi means “his cat.” We need “the cat” as an object: kediyi."
        },
        {
          "id": "3",
          "prompt": "anne + i (his mom)",
          "options": [
            "annei",
            "anneyi",
            "annesi"
          ],
          "answer": 2,
          "say": "annesi",
          "explanation": "The “his” tail after a vowel calls s: annesi."
        },
        {
          "id": "4",
          "prompt": "o + u (him, as object)",
          "options": [
            "ou",
            "oyu",
            "onu"
          ],
          "answer": 2,
          "say": "onu",
          "explanation": "Little o always takes n: onu."
        },
        {
          "id": "5",
          "prompt": "ev + e (to the house)",
          "options": [
            "eve",
            "evye",
            "evse"
          ],
          "answer": 0,
          "say": "eve",
          "explanation": "ev ends in a consonant. No gap — no fixer needed."
        }
      ]
    },
