    {
      "id": "a1.buffer-consonants.ex4",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "error_hunt",
      "difficulty": 3,
      "instruction": "Find the word with a gap or the wrong fixer and fix it",
      "items": [
        {
          "id": "1",
          "prompt": "Look at the simit cart!",
          "tokens": [
            "Simit",
            "arabasıya",
            "bak!"
          ],
          "wrong": 1,
          "fix": "arabasına",
          "options": [
            "arabasına",
            "arabaya",
            "arabasıya"
          ],
          "say": "Simit arabasına bak!",
          "explanation": "After “his” (-sı), the case takes n, not y: arabasına."
        },
        {
          "id": "2",
          "prompt": "I'm a student.",
          "tokens": [
            "Ben",
            "öğrenci."
          ],
          "wrong": 1,
          "fix": "öğrenciyim.",
          "options": [
            "öğrenciyim.",
            "öğrencim.",
            "öğrenci."
          ],
          "say": "Ben öğrenciyim.",
          "explanation": "English has a separate “am.” Turkish puts it at the end as -im, with y after a vowel: öğrenciyim."
        },
        {
          "id": "3",
          "prompt": "Take it.",
          "tokens": [
            "Oyu",
            "al."
