        { "id": "2", "text": "Kapı___ aç.", "answers": [["yı"]], "options": [["yı", "sı", "nı"]], "translation": "Открой дверь.", "say": "Kapıyı aç.", "explanation": "Дверь — что? Хвост не «его», значит y: kapıyı." },
