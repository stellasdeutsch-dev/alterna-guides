    {
      "id": "a1.buffer-consonants.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Выбери форму, где гласные не сталкиваются",
      "items": [
        {
          "id": "1",
          "prompt": "masa + a (куда?) → ?",
          "say": "masaya",
          "options": [
            "masaa",
            "masaya",
            "masana"
          ],
          "answer": 1,
          "explanation": "masa кончается на a, аффикс тоже на a. Две гласные — нужен мост y: masaya."
        },
        {
          "id": "2",
          "prompt": "ev + e (куда?) → ?",
          "say": "eve",
          "options": [
            "evye",
            "evse",
            "eve"
          ],
          "answer": 2,
          "explanation": "ev кончается на согласную v. Гласные не встретились — мост не нужен: eve."
        },
        {
          "id": "3",
          "prompt": "kapı + ı (его дверь) → ?",
          "say": "kapısı",
          "options": [
            "kapısı",
            "kapıyı",
            "kapını"
          ],
          "answer": 0,
          "explanation": "«Его» — это -(s)I. После гласной встаёт s: kapısı. А kapıyı — это «дверь» в «открой дверь»."
        },
        {
          "id": "4",
          "prompt": "o + a (ему, ей) → ?",
          "say": "ona",
          "options": [
            "oya",
            "ona",
            "osa"
          ],
          "answer": 1,
          "explanation": "У o, bu, şu свой мост — n: ona, buna, şuna."
        },
        {
          "id": "5",
          "prompt": "öğrenci + im (я студент) → ?",
          "say": "öğrenciyim",
          "options": [
            "öğrenciim",
            "öğrencisim",
            "öğrenciyim"
          ],
          "answer": 2,
          "explanation": "«Я есть» — это -(y)Im. Слово кончается на i, аффикс начинается с i. Ставим y: öğrenciyim."
        }
      ]
    },
