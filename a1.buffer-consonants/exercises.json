      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Посмотри на стык и выбери целое слово",
      "items": [
        { "id": "1", "prompt": "araba + a (куда? в машину)", "options": ["arabaa", "arabaya", "arabasa"], "answer": 1, "say": "arabaya", "explanation": "a + a встык — щель. Хвост не «его», значит мастер y: arabaya." },
        { "id": "2", "prompt": "kedi + i (что? кошку)", "options": ["kedii", "kedisi", "kediyi"], "answer": 2, "say": "kediyi", "explanation": "kedisi — это «его кошка». Нам нужно «кошку (что?)»: kediyi." },
        { "id": "3", "prompt": "anne + i (его мама)", "options": ["annei", "anneyi", "annesi"], "answer": 2, "say": "annesi", "explanation": "Хвост «его» после гласной зовёт s: annesi." },
        { "id": "4", "prompt": "o + u (его — что?)", "options": ["ou", "oyu", "onu"], "answer": 2, "say": "onu", "explanation": "Маленькое o всегда берёт n: onu." },
        { "id": "5", "prompt": "ev + e (куда? домой)", "options": ["eve", "evye", "evse"], "answer": 0, "say": "eve", "explanation": "ev кончается на согласную. Щели нет — мастер не нужен." }
      ]
    },
    {
