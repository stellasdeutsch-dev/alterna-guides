      "id": "b1.dig-zaman.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Spot the “when”",
      "items": [
        {
          "id": "1",
          "prompt": "“When I got home” →",
          "say": "Eve geldiğimde",
          "options": [
            "Eve geldiğimde",
            "Ne zaman eve geldim",
            "Eve geliyorum zaman"
          ],
          "answer": 0,
          "explanation": "Ne zaman asks a question. In a story, “when” is a tail on the verb: geldiğimde."
        },
        {
          "id": "2",
          "prompt": "geldiğim zaman = ?",
          "options": [
            "geldiğimde",
            "geldim",
            "geldiğinde"
          ],
          "answer": 0,
          "explanation": "They’re twins. -dığında and -dığı zaman mean the same thing."
        },
        {
          "id": "3",
          "prompt": "“When you came” →",
          "options": [
            "geldiğimde",
            "geldiğinde",
            "geldiğimizde"
          ],
          "answer": 1,
          "explanation": "-im is “my,” -in is “your.” Your coming: geldiğinde."
        },
        {
          "id": "4",
          "prompt": "Where’s the question “when?”",
          "options": [
            "Ne zaman geldin?",
            "Geldiğinde ara.",
            "Geldiğim zaman uyudum."
          ],
          "answer": 0,
          "explanation": "Only ne zaman asks. The tail tells a story."
        }
      ]
    },
    {
