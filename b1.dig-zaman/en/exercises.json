    {
      "id": "b1.dig-zaman.ex4",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "custom",
      "difficulty": 2,
      "instruction": "Tea house register: pick the letter and the vowel and ring up the order",
      "description": "The receipt shows “when I…”. The learner picks d or t and the vowel ı, i, u, ü, and the word builds at the register. Logic is in index.html.",
      "items": [
        {
          "id": "1",
          "stem": "iç",
          "loc": "de",
          "ru": "when I drink",
          "word": "içtiğimde",
          "answer": "ti",
          "explanation": "ç is voiceless, so t. The stem has i, so i."
        },
        {
          "id": "2",
          "stem": "al",
          "loc": "da",
          "ru": "when I take",
          "word": "aldığımda",
          "answer": "dı",
          "explanation": "l is voiced, so d. The stem has a, so ı."
        },
        {
          "id": "3",
          "stem": "gör",
          "loc": "de",
          "ru": "when I see",
          "word": "gördüğümde",
          "answer": "dü",
          "explanation": "r is voiced, so d. The stem has ö, so ü."
        },
        {
          "id": "4",
          "stem": "konuş",
          "loc": "da",
          "ru": "when I talk",
          "word": "konuştuğumda",
          "answer": "tu",
          "explanation": "ş is voiceless, so t. The last vowel is u, so u."
        },
        {
          "id": "5",
          "stem": "otur",
          "loc": "da",
          "ru": "when I sit",
          "word": "oturduğumda",
          "answer": "du",
          "explanation": "r is voiced, so d. The last vowel is u, so u."
        }
      ]
    },
