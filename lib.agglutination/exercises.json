      "items": [
        {
          "id": "1",
          "type": "multiple_choice",
          "prompt": "ekmek + -(y)I — «хлеб» (кого, что)",
          "say": "ekmeği",
          "options": ["ekmeki", "ekmeği", "ekmekı"],
          "answer": 1,
          "explanation": "Аффикс начинается с гласной — конечная k смягчается в ğ. Последняя гласная e → i: ekmeği."
        },
        {
          "id": "2",
          "type": "multiple_choice",
          "prompt": "Как сказать «в ЕГО доме»?",
          "say": "evinde",
          "options": ["evde", "evide", "evinde", "evsinde"],
          "answer": 2,
          "explanation": "ev + i (его) + n (буфер) + de (где). А evde — просто «в доме», без хозяина."
        },
        {
          "id": "3",
          "type": "true_false",
          "statement": "evimler — правильный способ сказать «мои дома».",
          "answer": false,
          "explanation": "Множественное число всегда раньше «чей»: evlerim. Формы evimler в турецком нет."
        },
        {
          "id": "4",
          "type": "multiple_choice",
          "prompt": "iş + -cI — «рабочий»",
          "say": "işçi",
          "options": ["işci", "işcı", "işçi"],
          "answer": 2,
          "explanation": "ş — глухая, поэтому c становится ç. Последняя гласная i → i: işçi."
        },
        {
          "id": "5",
          "type": "multiple_choice",
          "prompt": "renk + -(s)I — «его цвет»",
          "say": "rengi",
          "options": ["renki", "renği", "rengi"],
          "answer": 2,
          "explanation": "Сочетание nk смягчается в ng, а не в nğ: rengi."
        }
      ]
    }
  ]
