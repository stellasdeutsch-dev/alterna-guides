{
  "topic": "c1.dig-gibi",
  "exercises": [
    {
      "id": "c1.dig-gibi.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "What does the sentence mean?",
      "items": [
        {
          "id": "1",
          "prompt": "Bildiğiniz gibi, konser yarın.",
          "say": "Bildiğiniz gibi, konser yarın.",
          "options": [
            "As you know, the concert is tomorrow.",
            "As if you knew the concert is tomorrow.",
            "As far as you know, the concert is tomorrow."
          ],
          "answer": 0,
          "explanation": "bil + diğ + iniz + gibi — “as you know.” “As if” is -mIş gibi, “as far as” is -DIğI kadar."
        },
        {
          "id": "2",
          "prompt": "Dediğin gibi yaptım.",
          "say": "Dediğin gibi yaptım.",
          "options": [
            "I did what you said.",
            "I did it the way you said.",
            "I did it as if you had said so."
          ],
          "answer": 1,
          "explanation": "gibi means “the way.” Not “what,” but “how”: the way you said."
        },
        {
          "id": "3",
          "prompt": "Eve geldiği gibi uyudu.",
          "say": "Eve geldiği gibi uyudu.",
          "options": [
            "He fell asleep the same way he came in.",
            "He fell asleep as if he had come home.",
            "As soon as he got home, he fell asleep."
          ],
          "answer": 2,
          "explanation": "Two actions in a row, nothing to compare. Here gibi means “as soon as”: geldiği gibi = gelir gelmez."
        },
        {
          "id": "4",
          "prompt": "Sandığın gibi değil.",
          "say": "Sandığın gibi değil.",
          "options": [
            "It's not what you think.",
            "You don't think so.",
            "You don't think the way I do."
          ],
          "answer": 0,
          "explanation": "-DIğI gibi değil — “not the way…”. san- means “think” in the sense of “wrongly assume.”"
        },
        {
          "id": "5",
          "prompt": "Göreceğiniz gibi, sahne denize bakıyor.",
          "say": "Göreceğiniz gibi, sahne denize bakıyor.",
          "options": [
            "As you saw, the stage faces the sea.",
            "As you will see, the stage faces the sea.",
            "So that you see it, the stage faces the sea."
          ],
          "answer": 1,
          "explanation": "-(y)AcAğI gibi — something still ahead: göreceğiniz gibi — “as you will see.”"
        }
      ]
    },
    {
      "id": "c1.dig-gibi.ex2",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "matching",
      "difficulty": 1,
      "instruction": "Match the form and the translation",
      "items": [
        {
          "id": "1",
          "pairs": [
            {
              "left": "dediğim gibi",
              "right": "as I was saying"
            },
            {
              "left": "istediğin gibi",
              "right": "as you wish"
            },
            {
              "left": "herkesin bildiği gibi",
              "right": "as everyone knows"
            },
            {
              "left": "planladığımız gibi",
              "right": "as we planned"
            },
            {
              "left": "dedikleri gibi",
              "right": "as they say"
            }
          ],
          "explanation": "The owner of the action sits in the suffix: -im — I, -in — you, -i — he or “everyone,” -imiz — we, -leri — they."
        }
      ]
    },
