      "id": "a2.diye.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Pick the Turkish order",
      "items": [
        {
          "id": "1",
          "prompt": "“What time is it?” he asked.",
          "say": "\"Saat kaç?\" diye sordu.",
          "options": [
            "\"Saat kaç?\" diye sordu.",
            "Sordu \"Saat kaç?\" diye.",
            "Diye \"Saat kaç?\" sordu."
          ],
          "answer": 0,
          "explanation": "Quote, then diye, then the verb. The verb always goes last — never “Sordu…” like “He asked…”."
        },
        {
          "id": "2",
          "prompt": "“Hi,” he said.",
          "say": "\"Merhaba\" dedi.",
          "options": [
            "\"Merhaba\" dedi.",
            "\"Merhaba\" diye dedi."
          ],
          "answer": 0,
          "explanation": "diye already means “saying.” diye dedi = “said saying” — one “say” too many. Just dedi."
        },
        {
          "id": "3",
          "prompt": "“It's really hot,” I thought.",
          "say": "\"Çok sıcak\" diye düşündüm.",
          "options": [
            "\"Çok sıcak\" diye sordum.",
            "\"Çok sıcak\" diye düşündüm.",
            "\"Çok sıcak\" düşündüm diye."
          ],
          "answer": 1,
          "explanation": "Thought — düşündüm. And it goes last, after diye."
        }
      ]
    },
