            {
              "text": "Gitmem lazım",
              "bucket": "one"
            },
            {
              "text": "Beklemeniz gerekiyor",
              "bucket": "one"
            },
            {
              "text": "Bana su lazım",
              "bucket": "thing"
            },
            {
              "text": "Bize taksi lazım",
              "bucket": "thing"
            },
            {
              "text": "Türkçe öğrenmek şart",
              "bucket": "all"
            },
            {
              "text": "Araman lazım",
              "bucket": "one"
            }
          ],
          "explanation": "Verb with -mak: everyone. Verb with -ma/-me plus a signature: someone. Bana, bize + noun: you need a thing."
        }
      ]
    },
