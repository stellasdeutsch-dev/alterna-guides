    {
      "id": "b1.gerek-lazim.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Pick the clean take",
      "items": [
        {
          "id": "1",
          "prompt": "I need to go →",
          "options": [
            "Gitmem lazım.",
            "Ben gitmek lazım.",
            "Gitmek lazımım."
          ],
          "answer": 0,
          "explanation": "No “I” up front: the person sits in the verb's tail, gitme + m (“my going”). Lazım doesn't change.",
          "say": "Gitmem lazım."
        },
        {
          "id": "2",
          "prompt": "You need to eat →",
          "options": [
            "Yemem gerek.",
            "Yemen gerek.",
            "Yemek gereksin."
          ],
          "answer": 1,
          "explanation": "You: the signature n, yeme + n. Gerek takes no endings.",
          "say": "Yemen gerek."
        },
        {
          "id": "3",
          "prompt": "He needs to work →",
          "options": [
            "Çalışması lazım.",
            "Çalışman lazım.",
            "Çalışmak lazımı."
          ],
          "answer": 0,
          "explanation": "He or she: the buffer s plus ı, çalışma + sı. Turkish o is both he and she.",
          "say": "Çalışması lazım."
        },
        {
          "id": "4",
          "prompt": "We need to wait →",
          "options": [
            "Beklemeniz gerek.",
            "Beklemek gerekiyoruz.",
            "Beklememiz gerek."
          ],
          "answer": 2,
          "explanation": "We: miz, bekleme + miz. Beklemeniz is “you all.”",
          "say": "Beklememiz gerek."
        }
      ]
    },
    {
