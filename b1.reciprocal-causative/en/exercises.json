{
  "topic": "b1.reciprocal-causative",
  "exercises": [
    {
      "id": "b1.reciprocal-causative.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "What does the sentence mean?",
      "items": [
        {
          "id": "1",
          "prompt": "Elif'i Mert'le tanıştırdım.",
          "say": "Elif'i Mert'le tanıştırdım.",
          "options": [
            "I introduced Elif to Mert.",
            "I met Elif and Mert.",
            "Elif met Mert."
          ],
          "answer": 0,
          "explanation": "-tır is you, the go-between. You set Elif and Mert up, you didn't meet anyone yourself."
        },
        {
          "id": "2",
          "prompt": "Ali ile Can barıştı.",
          "say": "Ali ile Can barıştı.",
          "options": [
            "Ali reconciled Can.",
            "Ali and Can made up.",
            "Can reconciled Ali."
          ],
          "answer": 1,
          "explanation": "Only -ş, no -tır: the two make up on their own. No go-between."
        },
        {
          "id": "3",
          "prompt": "Öğretmen iki öğrenciyi barıştırdı.",
          "say": "Öğretmen iki öğrenciyi barıştırdı.",
          "options": [
            "The teacher made up with the students.",
            "The students reconciled the teacher.",
            "The teacher got two students to make up."
          ],
          "answer": 2,
          "explanation": "barış + tır: the teacher is the go-between, the students are the ones who got reconciled."
        },
        {
          "id": "4",
          "prompt": "Bu uygulama insanları buluşturuyor.",
          "say": "Bu uygulama insanları buluşturuyor.",
          "options": [
            "This app brings people together.",
            "People meet up with this app.",
            "This app meets up with people."
          ],
          "answer": 0,
          "explanation": "buluş — meet up, buluştur — bring together. The go-between here is the app. English needs “bring … together”; Turkish adds -tur."
        }
      ]
    },
    {
      "id": "b1.reciprocal-causative.ex2",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "sort_buckets",
      "difficulty": 1,
      "instruction": "The two on their own, or is there a go-between?",
      "items": [
        {
          "id": "1",
          "buckets": [
            {
              "id": "s",
              "label": "-ş: the two on their own"
            },
            {
              "id": "t",
              "label": "-ştır: a third person set it up"
            }
          ],
          "entries": [
            {
              "text": "tanıştık",
              "bucket": "s"
            },
            {
              "text": "tanıştırdım",
              "bucket": "t"
            },
            {
              "text": "barıştılar",
              "bucket": "s"
            },
            {
              "text": "barıştırdı",
              "bucket": "t"
            },
            {
              "text": "buluşuyoruz",
              "bucket": "s"
            },
            {
              "text": "buluşturuyor",
              "bucket": "t"
            },
            {
              "text": "görüştük",
              "bucket": "s"
            },
            {
              "text": "görüştürdü",
              "bucket": "t"
            }
          ],
          "explanation": "Look for -tır / -tir / -tur / -tür after ş. If it's there, a go-between is at work. If not, the two did it themselves."
        }
      ]
    },
