      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Какой суффикс возьмёт глагол?",
      "items": [
        {
          "id": "1",
          "prompt": "okumak (прочитать) → он прочитает",
          "say": "okuyacak",
          "options": [
            "okuyecek",
            "okuyacak",
            "okuacak"
          ],
          "answer": 1,
          "explanation": "Последняя гласная u — задняя, значит -acak. Основа на гласную — буфер y: okuyacak."
        },
        {
          "id": "2",
          "prompt": "görmek (увидеть) → он увидит",
          "say": "görecek",
          "options": [
            "göracak",
            "görecek",
            "göreyecek"
          ],
          "answer": 1,
          "explanation": "ö — передняя гласная, значит -ecek. Основа на согласную, буфер не нужен."
        },
        {
          "id": "3",
          "prompt": "almak (взять) → он возьмёт",
          "say": "alacak",
          "options": [
            "alacak",
            "alecek"
          ],
          "answer": 0,
          "explanation": "a — задняя гласная: alacak."
        },
        {
          "id": "4",
          "prompt": "içmek (выпить) → он выпьет",
          "say": "içecek",
          "options": [
            "içacak",
            "içecek"
          ],
          "answer": 1,
          "explanation": "i — передняя гласная: içecek."
        },
        {
          "id": "5",
          "prompt": "konuşmak (поговорить) → он поговорит",
          "say": "konuşacak",
          "options": [
            "konuşecek",
            "konuşacak"
          ],
          "answer": 1,
          "explanation": "Смотри на последнюю гласную основы konuş — это u. Значит konuşacak."
        }
      ]
    },
