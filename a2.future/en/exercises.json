        {
          "id": "4",
          "type": "gap_fill",
          "text": "Biz akşam Kordon'a ___. (gitmek)",
          "answers": [
            [
              "gideceğiz"
            ]
          ],
          "translation": "Tonight we'll go to the Kordon.",
          "explanation": "git → gid before a vowel, and with biz k → ğ: gideceğiz."
        }
      ]
    },
    {
      "id": "a2.future.ex4",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "custom",
      "difficulty": 2,
      "instruction": "Workshop in Kemeraltı: fix the seam",
      "description": "A word with a torn seam. The learner picks a tool: k → ğ, + y, t → d, or “seam is fine.” The logic lives in index.html.",
      "items": [
        {
          "id": "1",
          "word": "gelecekim",
          "answer": "kg",
          "fixed": "geleceğim",
          "explanation": "The vowel i follows — k → ğ: geleceğim."
        },
        {
          "id": "2",
          "word": "bekleecek",
          "answer": "y",
          "fixed": "bekleyecek",
          "explanation": "Two vowels side by side — you need buffer y: bekleyecek."
        },
        {
          "id": "3",
          "word": "giteceksin",
          "answer": "td",
          "fixed": "gideceksin",
          "explanation": "The short stem git becomes gid before a vowel: gideceksin."
        },
        {
          "id": "4",
          "word": "yazacaklar",
          "answer": "ok",
          "fixed": "yazacaklar",
          "explanation": "In onlar the consonant l follows — k doesn't change. The seam is fine."
        },
        {
          "id": "5",
          "word": "okuacak",
          "answer": "y",
          "fixed": "okuyacak",
          "explanation": "oku ends in a vowel — buffer y: okuyacak."
        },
        {
          "id": "6",
          "word": "yazacakız",
          "answer": "kg",
          "fixed": "yazacağız",
          "explanation": "In biz the vowel ı follows — k → ğ: yazacağız."
        }
      ]
    },
