{
  "topic": "a2.future",
  "exercises": [
    {
      "id": "a2.future.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Which suffix will the verb take?",
      "items": [
        {
          "id": "1",
          "prompt": "okumak (to read) → he'll read",
          "say": "okuyacak",
          "options": [
            "okuyecek",
            "okuyacak",
            "okuacak"
          ],
          "answer": 1,
          "explanation": "The last vowel u is a back vowel, so -acak. The stem ends in a vowel — buffer y: okuyacak."
        },
        {
          "id": "2",
          "prompt": "görmek (to see) → he'll see",
          "say": "görecek",
          "options": [
            "göracak",
            "görecek",
            "göreyecek"
          ],
          "answer": 1,
          "explanation": "ö is a front vowel, so -ecek. The stem ends in a consonant, no buffer needed."
        },
        {
          "id": "3",
          "prompt": "almak (to take) → he'll take",
          "say": "alacak",
          "options": [
            "alacak",
            "alecek"
          ],
          "answer": 0,
          "explanation": "a is a back vowel: alacak."
        },
        {
          "id": "4",
          "prompt": "içmek (to drink) → he'll drink",
          "say": "içecek",
          "options": [
            "içacak",
            "içecek"
          ],
          "answer": 1,
          "explanation": "i is a front vowel: içecek."
        },
        {
          "id": "5",
          "prompt": "konuşmak (to talk) → he'll talk",
          "say": "konuşacak",
          "options": [
            "konuşecek",
            "konuşacak"
          ],
          "answer": 1,
          "explanation": "Look at the last vowel of the stem konuş — it's u. So konuşacak."
        }
      ]
    },
    {
      "id": "a2.future.ex2",
      "lesson": 1,
