          "options": [
            "geleceğim.",
            "gelecekim.",
            "geleceğiz."
          ],
          "explanation": "Before the vowel i, the letter k turns into ğ: geleceğim."
        },
        {
          "id": "3",
          "type": "build_sentence",
          "translation": "I'll call you later.",
          "words": [
            "Sonra",
