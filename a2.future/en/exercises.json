              "label": "-yecek"
            },
            {
              "id": "yacak",
              "label": "-yacak"
            }
          ],
          "entries": [
            {
              "text": "gel",
              "bucket": "ecek"
            },
            {
              "text": "yaz",
              "bucket": "acak"
            },
            {
              "text": "bekle",
              "bucket": "yecek"
            },
            {
              "text": "ara",
              "bucket": "yacak"
            },
            {
              "text": "gör",
              "bucket": "ecek"
            },
            {
              "text": "oku",
              "bucket": "yacak"
            },
            {
              "text": "bul",
              "bucket": "acak"
            }
          ],
          "explanation": "First the last vowel: e, i, ö, ü → -ecek, a, ı, o, u → -acak. Then the end of the stem: ends in a vowel — add y."
        }
      ]
    },
    {
