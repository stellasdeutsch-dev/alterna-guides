      "difficulty": 1,
      "instruction": "Pick the form",
      "items": [
        {
          "id": "1",
          "prompt": "“from morning” — start",
          "say": "sabahtan",
          "options": [
            "sabahtan",
            "sabahdan",
            "sabaha"
          ],
          "answer": 0,
          "explanation": "h is voiceless, so -tan. Sabaha is the finish, “till morning.”"
        },
        {
          "id": "2",
          "prompt": "“till evening”",
          "say": "akşama kadar",
          "options": [
            "akşamdan kadar",
            "akşama kadar",
            "kadar akşama"
          ],
          "answer": 1,
          "explanation": "The finish is in the dative case, kadar comes after: akşama kadar."
        },
        {
          "id": "3",
          "prompt": "ev — start",
          "say": "evden",
          "options": [
            "evden",
            "evdan",
            "evten"
          ],
          "answer": 0,
          "explanation": "Vowel e → -den. v is voiced, so d."
        },
        {
          "id": "4",
          "prompt": "cuma — finish",
          "say": "cumaya",
          "options": [
            "cumaya",
            "cumae",
            "cumadan"
          ],
          "answer": 0,
          "explanation": "After a vowel comes y, vowel a → cumaya."
        },
        {
          "id": "5",
          "prompt": "Where is kadar in the right place?",
          "say": "Evden okula kadar.",
          "options": [
            "Kadar evden okula.",
            "Evden kadar okula.",
            "Evden okula kadar."
          ],
          "answer": 2,
          "explanation": "The order: start, finish, kadar. Kadar closes the phrase."
        }
      ]
    },
