{
  "topic": "a1.accusative",
  "exercises": [
    {
      "id": "a1.accusative.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Pin or no pin?",
      "items": [
        {
          "id": "1",
          "prompt": "I'm reading. Just doing some reading.",
          "options": [
            "Kitap okuyorum.",
            "Kitabı okuyorum."
          ],
          "answer": 0,
          "explanation": "A book “in general,” the activity. No pin: kitap okuyorum. English would say “a book” here.",
          "say": "Kitap okuyorum."
        },
        {
          "id": "2",
          "prompt": "I want this jacket.",
          "options": [
            "Bu ceket istiyorum.",
            "Bu ceketi istiyorum."
          ],
          "answer": 1,
          "explanation": "bu means “this one.” In English “this” is enough; in Turkish the pin comes too: ceketi.",
          "say": "Bu ceketi istiyorum."
        },
        {
          "id": "3",
          "prompt": "Do you know Tarkan?",
          "options": [
            "Tarkan tanıyor musun?",
            "Tarkan'ı tanıyor musun?"
          ],
          "answer": 1,
          "explanation": "A name is always a specific person. Pin it with an apostrophe: Tarkan'ı.",
          "say": "Tarkan'ı tanıyor musun?"
        },
        {
          "id": "4",
          "prompt": "I love tea.",
          "options": [
            "Çay seviyorum.",
            "Çayı seviyorum."
          ],
          "answer": 1,
          "explanation": "English says “I love tea” with no “the.” Turkish sevmek pins it anyway: çayı seviyorum.",
          "say": "Çayı seviyorum."
        }
      ]
    },
    {
      "id": "a1.accusative.ex2",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "sort_buckets",
      "difficulty": 1,
      "instruction": "Which pin does the word take? Sort by vowel",
      "items": [
        {
          "id": "1",
          "buckets": [
            {
              "id": "i1",
              "label": "-(y)ı"
            },
            {
              "id": "i2",
              "label": "-(y)i"
            },
            {
              "id": "u1",
              "label": "-(y)u"
            },
            {
              "id": "u2",
              "label": "-(y)ü"
            }
          ],
          "entries": [
            {
              "text": "kız",
              "bucket": "i1"
            },
            {
              "text": "masa",
              "bucket": "i1"
            },
            {
              "text": "ev",
              "bucket": "i2"
            },
            {
              "text": "deniz",
              "bucket": "i2"
            },
            {
              "text": "okul",
              "bucket": "u1"
            },
            {
              "text": "vapur",
              "bucket": "u1"
            },
            {
              "text": "göz",
              "bucket": "u2"
            },
            {
              "text": "köprü",
              "bucket": "u2"
            }
          ],
          "explanation": "Look at the last vowel: a, ı → ı; e, i → i; o, u → u; ö, ü → ü. Ends in a vowel — add y."
        }
      ]
    },
    {
