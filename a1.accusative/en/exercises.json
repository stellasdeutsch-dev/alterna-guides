          "fix": "ceketi",
          "options": [
            "ceketi",
            "ceketı"
          ],
          "explanation": "The word bu makes the thing specific. Without a pin, the clerk won't know which one.",
          "say": "Bu ceketi istiyorum."
        },
        {
          "id": "4",
          "type": "gap_fill",
          "text": "___ seviyorum. (sen → “you”)",
          "answers": [
            [
              "Seni",
              "seni"
            ]
          ],
          "translation": "I love you.",
          "explanation": "sen → seni. English “you” never changes — Turkish sen does.",
          "say": "Seni seviyorum."
        }
      ]
    },
