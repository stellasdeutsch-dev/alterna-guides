            ]
          ],
          "translation": "The youngest (or oldest) in my family is me.",
          "explanation": "küçük → küçüğü, büyük → büyüğü. k before a vowel becomes ğ."
        },
        {
          "id": "2",
          "text": "Bu montun ___ var mı? (siyah)",
          "answers": [
            [
              "siyahı"
            ]
          ],
          "translation": "Do you have a black one (same jacket)?",
          "explanation": "siyah ends in a consonant: just -ı. You get siyahı."
        }
      ]
    },
