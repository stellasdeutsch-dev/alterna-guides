{
  "topic": "c1.adj-noun",
  "exercises": [
    {
      "id": "c1.adj-noun.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Recognize the word. What does it mean?",
      "items": [
        {
          "id": "1",
          "prompt": "büyüklerimiz",
          "say": "büyüklerimiz",
          "options": [
            "our elders",
            "our big houses",
            "we are big"
          ],
          "answer": 0,
          "explanation": "büyük quit being an adjective: büyükler means elders. -imiz means “our.”"
        },
        {
          "id": "2",
          "prompt": "Bu en iyisi.",
          "say": "Bu en iyisi.",
          "options": [
            "This is the best one (of them).",
            "This is good.",
            "This is better."
          ],
          "answer": 0,
          "explanation": "-si hides the noun: “the best one of them.”"
        },
        {
          "id": "3",
          "prompt": "Mavisi var mı?",
          "say": "Mavisi var mı?",
          "options": [
            "Do you have it in blue (the same one)?",
            "Is there a blue sea?",
            "Is it blue?"
          ],
          "answer": 0,
          "explanation": "mavi + si = “the blue one of them.” Same item, just a different color."
        },
        {
          "id": "4",
          "prompt": "gençler",
          "say": "gençler",
          "options": [
            "young people",
            "young trees",
            "younger"
          ],
          "answer": 0,
          "explanation": "genç without a noun becomes a person. -ler makes it a crowd."
        }
      ]
    },
    {
      "id": "c1.adj-noun.ex2",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "sort_buckets",
      "difficulty": 1,
      "instruction": "Sort the colors: which suffix does the word get?",
      "items": [
        {
          "id": "1",
          "buckets": [
            {
              "id": "s",
              "label": "-sı / -si / -su (after a vowel)"
            },
            {
              "id": "v",
              "label": "-ı / -i (after a consonant)"
            }
          ],
          "entries": [
            {
              "text": "mavi",
              "bucket": "s"
            },
            {
              "text": "turuncu",
              "bucket": "s"
            },
            {
              "text": "kırmızı",
              "bucket": "s"
            },
            {
              "text": "iyi",
              "bucket": "s"
            },
            {
              "text": "siyah",
              "bucket": "v"
            },
            {
              "text": "beyaz",
              "bucket": "v"
            },
            {
              "text": "yeşil",
              "bucket": "v"
            },
            {
              "text": "güzel",
              "bucket": "v"
            }
          ],
          "explanation": "Look at the last letter. A vowel needs s (mavisi). A consonant just needs the vowel (siyahı)."
        }
      ]
    },
    {
      "id": "c1.adj-noun.ex3",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "mixed",
      "difficulty": 2,
      "instruction": "Fill in the form, find the mistake, build the sentence",
      "items": [
        {
          "id": "1",
          "type": "gap_fill",
          "text": "Kardeşlerimin en ___ benim. (küçük)",
          "answers": [
            [
              "küçüğü"
            ]
          ],
          "options": [
            [
              "küçüğü",
              "küçükü",
              "küçük"
            ]
          ],
          "translation": "The youngest of my siblings is me.",
          "explanation": "küçük + ü, and k before a vowel becomes ğ: küçüğü."
        },
        {
          "id": "2",
          "type": "error_hunt",
          "prompt": "Find the mistake",
          "tokens": [
            "Telefonum",
            "bozuldu,",
            "yenisi",
            "aldım."
          ],
          "wrong": 2,
          "fix": "yenisini",
          "options": [
            "yenisini",
            "yeniyi",
            "yenisi"
          ],
          "explanation": "Bought what? You need the accusative. After -si it hooks on with n: yenisini."
        },
        {
          "id": "3",
          "type": "build_sentence",
          "translation": "The highest of the mountains is Everest.",
          "words": [
            "Dağların",
            "en",
            "yükseği",
            "Everest'tir."
          ],
          "distractors": [
            "yüksek",
            "dağlar"
          ],
          "explanation": "Who we choose from (dağların) + en + adjective + -(s)i: en yükseği."
        }
      ]
    },
    {
      "id": "c1.adj-noun.ex4",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "custom",
      "difficulty": 2,
      "instruction": "Rope team: clip on the right suffixes",
      "description": "A climber walks along a ridge. The learner taps the suffixes in order and checks. Correct: the climber climbs to the camp. Logic is in index.html.",
      "items": [
        {
          "id": "1",
          "base": "büyük",
          "ru": "elders (people)",
          "ctx": "___ her şeyi bilir.",
          "chips": [
            "ler",
            "ü",
            "si"
          ],
          "answer": [
            "ler"
          ],
          "explanation": "Elders are people, and there are many: büyük + ler."
        },
        {
          "id": "2",
          "base": "büyük",
          "ru": "of our elders (whose?)",
          "ctx": "___ ellerinden öperiz.",
          "chips": [
            "e",
            "ler",
            "in",
            "imiz"
          ],
          "answer": [
            "ler",
            "imiz",
            "in"
          ],
          "explanation": "Same order as for a noun: number, then “our,” then case."
        },
        {
          "id": "3",
          "base": "en küçük",
          "ru": "the youngest (of them)",
          "ctx": "Kardeşlerimin ___ benim.",
          "chips": [
            "sü",
            "ü",
            "ler"
          ],
          "answer": [
            "ü"
          ],
          "explanation": "After a consonant -(s)i has no s. And k before a vowel becomes ğ."
        },
        {
          "id": "4",
          "base": "yeni",
          "ru": "the new one (bought it)",
          "ctx": "Telefonum bozuldu, ___ aldım.",
          "chips": [
            "i",
            "ni",
            "si",
            "yi"
          ],
          "answer": [
            "si",
            "ni"
          ],
          "explanation": "First -si (the new one of them), then the accusative via n."
        },
        {
          "id": "5",
          "base": "mavi",
          "ru": "the blue one (same kind)",
          "ctx": "Bu montun ___ var mı?",
          "chips": [
            "ler",
            "ı",
            "si"
          ],
          "answer": [
            "si"
          ],
          "explanation": "mavi ends in a vowel, so -si with s."
        }
      ]
    },
    {
      "id": "c1.adj-noun.ex5",
      "lesson": 1,
      "kind": "practice",
