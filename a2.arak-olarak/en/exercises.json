{
  "topic": "a2.arak-olarak",
  "exercises": [
    {
      "id": "a2.arak-olarak.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Pick the -arak / -erek form",
      "items": [
        {
          "id": "1",
          "prompt": "koşmak → “running”",
          "say": "koşarak",
          "options": [
            "koşarak",
            "koşerek",
            "koşyarak"
          ],
          "answer": 0,
          "explanation": "The last vowel o is back, so it's -arak. It ends in a consonant, no y needed."
        },
        {
          "id": "2",
          "prompt": "gülmek → “laughing”",
          "say": "gülerek",
          "options": [
            "gülarak",
            "gülerek",
            "gülürek"
          ],
          "answer": 1,
          "explanation": "The vowel ü is front, so it's -erek: gülerek. English has no vowel harmony — that's why gülarak sounds fine to you, but not to a Turk."
        },
        {
          "id": "3",
          "prompt": "okumak → “reading”",
          "say": "okuyarak",
          "options": [
            "okuarak",
            "okurak",
            "okuyarak"
          ],
          "answer": 2,
          "explanation": "oku ends in a vowel — a y goes between it and -arak: okuyarak."
        },
        {
          "id": "4",
          "prompt": "dinlemek → “listening”",
          "say": "dinleyerek",
          "options": [
            "dinleyerek",
            "dinlerek",
            "dinleyarak"
          ],
          "answer": 0,
          "explanation": "dinle ends in e: you need y and the front tail -erek."
        },
        {
          "id": "5",
          "prompt": "yemek → “eating”",
          "say": "yiyerek",
          "options": [
            "yeyerek",
            "yiyerek",
            "yerek"
          ],
          "answer": 1,
          "explanation": "Special case: ye turns into yi before y — yiyerek. Same with de → diyerek."
        }
      ]
    },
    {
