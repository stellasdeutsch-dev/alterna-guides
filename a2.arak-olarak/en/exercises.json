            "dinlemek"
          ],
          "answer": "dinleyerek",
          "mode": "overlay",
          "say": "Müzik dinleyerek ders çalışıyorum.",
          "explanation": "Music and studying run at the same time — that's an overlay, -erek."
        },
        {
          "id": "2",
          "phrase": "Sabah ___ duş aldım.",
          "ru": "In the morning I got up and took a shower.",
          "options": [
