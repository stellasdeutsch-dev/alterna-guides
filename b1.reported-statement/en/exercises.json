{
  "topic": "b1.reported-statement",
  "exercises": [
    {
      "id": "b1.reported-statement.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "How do you report it?",
      "items": [
        {
          "id": "1",
          "prompt": "Ali: “Yarın geleceğim.” → Ali yarın ___ söyledi.",
          "say": "Ali yarın geleceğini söyledi.",
          "options": [
            "geleceğini",
            "geleceğim",
            "geldiğini"
          ],
          "answer": 0,
          "explanation": "The quote is future, so -eceğ. English says “he would come,” but Turkish doesn't shift back: geldiğini would mean “he came.” Then “his”: -i, and “what?”: -ni."
        },
        {
          "id": "2",
          "prompt": "Ayşe: “Dün geldim.” → Ayşe dün ___ söyledi.",
          "say": "Ayşe dün geldiğini söyledi.",
          "options": [
            "geleceğini",
            "geldiğini",
            "geldim"
          ],
          "answer": 1,
          "explanation": "Past isn't future. So -DIk: geldiğini."
        },
        {
          "id": "3",
          "prompt": "Murat: “Her gün çalışırım.” → Murat her gün ___ söyledi.",
          "say": "Murat her gün çalıştığını söyledi.",
          "options": [
            "çalışacağını",
            "çalışırım",
            "çalıştığını"
          ],
          "answer": 2,
          "explanation": "English says “he worked every day.” Turkish just asks: future? No — so -DIk. After ş — voiceless t: çalıştığını."
        }
      ]
    },
    {
      "id": "b1.reported-statement.ex2",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
