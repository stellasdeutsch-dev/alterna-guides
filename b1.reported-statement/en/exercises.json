    {
      "id": "b1.reported-statement.ex4",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "custom",
      "difficulty": 2,
      "instruction": "Headline for the issue: report the quote",
      "description": "The learner sees a quote and builds a line for the magazine from tiles. Logic is in index.html.",
      "items": [
        {
          "id": "1",
          "quote": "Ayşe: “Yarın geleceğim.”",
          "tiles": [
            "söyledi.",
            "Ayşe",
            "geleceğini",
            "yarın",
            "geleceğim"
          ],
          "answer": [
            "Ayşe",
            "yarın",
            "geleceğini",
            "söyledi."
          ],
          "explanation": "Future → -eceğini. We don't take the quote with -im."
        },
        {
          "id": "2",
          "quote": "Murat: “Dün kitap okudum.”",
          "tiles": [
            "okuduğunu",
            "Murat",
            "söyledi.",
            "kitap",
            "dün"
          ],
          "answer": [
            "Murat",
            "dün",
            "kitap",
            "okuduğunu",
            "söyledi."
          ],
          "explanation": "Past → -DIk: okuduğunu."
        },
        {
          "id": "3",
          "quote": "Elif: “Sinemaya gideceğim.”",
          "tiles": [
            "gideceğini",
            "sinemaya",
            "Elif",
            "söyledi.",
            "gittiğini"
          ],
          "answer": [
            "Elif",
            "sinemaya",
            "gideceğini",
            "söyledi."
          ],
          "explanation": "Future → gideceğini. t became d: git → gid."
        },
        {
          "id": "4",
          "quote": "Ali: “Bir daha yapmayacağım.”",
          "tiles": [
            "söyledi.",
            "yapmayacağını",
            "bir",
            "Ali",
            "daha",
            "yaptığını"
          ],
          "answer": [
            "Ali",
            "bir",
            "daha",
            "yapmayacağını",
            "söyledi."
          ],
          "explanation": "“Not” inside: yap-ma-yacağ-ı-nı."
        }
      ]
    },
