            {
              "id": "acak",
              "label": "-AcAğInI (future)"
            },
            {
              "id": "dik",
              "label": "-DIğInI (everything else)"
            }
          ],
          "entries": [
            {
              "text": "Yarın geleceğim.",
              "bucket": "acak"
            },
            {
              "text": "Dün geldim.",
              "bucket": "dik"
            },
            {
              "text": "Şimdi çalışıyorum.",
              "bucket": "dik"
            },
            {
              "text": "Haftaya gideceğim.",
              "bucket": "acak"
            },
            {
              "text": "Her gün okurum.",
              "bucket": "dik"
            },
            {
              "text": "Kitabı okuyacağım.",
              "bucket": "acak"
            }
          ],
          "explanation": "Future goes in -AcAk. Past, present and “usually” all go in -DIk."
        }
      ]
    },
