      "instruction": "Find the right form",
      "items": [
        {
          "id": "1",
          "prompt": "“Even though it was raining, the match was played”",
          "say": "Yağmur yağmasına rağmen maç oynandı.",
          "options": [
            "Yağmur yağmasına rağmen maç oynandı.",
            "Yağmur yağmasını rağmen maç oynandı.",
            "Yağmur yağdı rağmen maç oynandı."
          ],
          "answer": 0,
          "explanation": "No “although” at the start, no full sentence: yağ-ma-sı-na rağmen, with the dative."
        },
        {
          "id": "2",
          "prompt": "ben + çalış → ?",
          "say": "çalışmama rağmen",
          "options": [
            "çalışmasına rağmen",
            "çalışmana rağmen",
            "çalışmama rağmen"
          ],
          "answer": 2,
          "explanation": "Ben gets the tail -m: çalış-ma-m-a."
        },
        {
          "id": "3",
          "prompt": "o + gel → ?",
          "say": "gelmesine rağmen",
          "options": [
            "gelmesına rağmen",
            "gelmesine rağmen"
          ],
          "answer": 1,
          "explanation": "gel has the front vowel e. So it's -mesine."
        }
      ]
    },
    {
