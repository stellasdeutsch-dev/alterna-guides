      "items": [
        {
          "id": "1",
          "type": "gap_fill",
          "text": "Hava soğuk ___ rağmen denize girdik. (olmak)",
          "answers": [
            [
              "olmasına"
            ]
          ],
          "translation": "Even though it was cold, we went swimming in the sea.",
          "explanation": "Hava is “it”: ol-ma-sı-na."
        },
        {
          "id": "2",
          "type": "build_sentence",
          "translation": "Even though it was raining, the match was played.",
          "words": [
            "Yağmur",
            "yağmasına",
            "rağmen",
            "maç",
            "oynandı."
          ],
          "distractors": [
            "yağmasını",
            "yağdı"
          ],
          "explanation": "Rağmen closes the first part. Then the result."
        },
        {
          "id": "3",
          "type": "error_hunt",
          "prompt": "Find the mistake: “Even though I was tired, I finished.”",
          "tokens": [
            "Yorgun",
            "olmasına",
            "rağmen",
            "bitirdim."
          ],
          "wrong": 1,
          "fix": "olmama",
          "options": [
            "olmama",
            "olmamı"
          ],
          "explanation": "“I” was tired, so the tail is -m (my): olmam-a. Olmasına = he or she was tired."
        }
      ]
    },
