        { "id": "f4", "text": "Dördüncü kat, lütfen.", "answer": 4, "say": "Dördüncü kat, lütfen.", "explanation": "Dördüncü — четвёртый, с исключением t → d." },
        { "id": "f5", "text": "Onuncu kat, lütfen.", "answer": 10, "say": "Onuncu kat, lütfen.", "explanation": "Onuncu — десятый." },
        { "id": "f6", "text": "İkinci kat, lütfen.", "answer": 2, "say": "İkinci kat, lütfen.", "explanation": "İkinci — второй." }
