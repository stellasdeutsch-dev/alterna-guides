        { "prompt": "3 → третий", "options": ["üçüncü", "üçinci", "üçıncı"], "answer": 0, "say": "üçüncü", "explanation": "В üç гласная ü — значит хвост -üncü." },
        { "prompt": "2 → второй", "options": ["ikiinci", "ikinci", "ikünci"], "answer": 1, "say": "ikinci", "explanation": "iki кончается на гласную — вторая i не нужна: ikinci." },
        { "prompt": "4 → четвёртый", "options": ["dörtüncü", "dördüncü", "dördinci"], "answer": 1, "say": "dördüncü", "explanation": "Единственное исключение: t превращается в d. Dördüncü." },
        { "prompt": "9 → девятый", "options": ["dokuzinci", "dokuzıncı", "dokuzuncu"], "answer": 2, "say": "dokuzuncu", "explanation": "Последняя гласная u — костюм -uncu." },
        { "prompt": "Kaçıncı kat?", "options": ["На каком этаже? Который по счёту?", "Сколько этажей?", "Где этаж?"], "answer": 0, "say": "Kaçıncı kat?", "explanation": "Kaç — сколько. Kaçıncı — который по счёту." }
      ]
    },
    {
