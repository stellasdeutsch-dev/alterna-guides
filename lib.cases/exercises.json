      "id": "lib.cases.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Выберите форму",
      "items": [
        {
          "id": "1",
          "prompt": "Yarın ___ gidiyoruz. — Завтра мы едем в Анкару.",
          "say": "Ankara'ya",
          "options": ["Ankara'da", "Ankara'ya", "Ankara'dan", "Ankara'yı"],
          "answer": 1,
          "explanation": "Куда — дательный -a/-e. Ankara кончается на гласную, поэтому встаёт буфер y, а имя собственное берёт апостроф: Ankara'ya."
        },
        {
          "id": "2",
          "prompt": "Ben ___ yaşıyorum. — Я живу в Стамбуле.",
          "say": "İstanbul'da",
          "options": ["İstanbul'a", "İstanbul'dan", "İstanbul'da", "İstanbul'u"],
          "answer": 2,
          "explanation": "«Где» — местный падеж. Последняя гласная u → гармония на 2 даёт a. Конечная l звонкая, поэтому -da."
        },
        {
          "id": "3",
          "prompt": "___ çok kedi var. — На улице много кошек.",
          "say": "Sokakta",
          "options": ["Sokakda", "Sokakta", "Sokağa", "Sokaktan"],
          "answer": 1,
          "explanation": "sokak кончается на глухую k из fıstıkçı şahap, поэтому d в хвосте глохнет: -ta. Смягчения нет: хвост начинается с согласной."
        },
        {
          "id": "4",
          "prompt": "___ içtim. — Я выпил ту воду, о которой мы говорили.",
          "say": "Suyu",
          "options": ["Su", "Suyu", "Suda", "Sudan"],
          "answer": 1,
          "explanation": "Вода конкретная — винительный. su кончается на гласную → буфер y, гармония на 4 от u даёт u: suyu. «Su içtim» — просто «попил воды»."
        },
        {
          "id": "5",
          "prompt": "___ geldim. — Я приехал на машине.",
          "say": "Arabayla",
          "options": ["Arabala", "Arabayla", "Arabada", "Arabaya"],
          "answer": 1,
          "explanation": "На чём — творительный -la/-le. araba кончается на гласную, поэтому форма -yla."
        }
      ]
    },
