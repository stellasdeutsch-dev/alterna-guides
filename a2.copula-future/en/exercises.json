{
  "topic": "a2.copula-future",
  "exercises": [
    {
      "id": "a2.copula-future.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Spot the form",
      "items": [
        {
          "id": "1",
          "prompt": "“I'll be a doctor”",
          "options": [
            "Doktoracağım.",
            "Doktor olacağım.",
            "Doktorum."
          ],
          "answer": 1,
          "say": "Doktor olacağım.",
          "explanation": "A word can't go into the future on its own: doktor + ol + acak + ım."
        },
        {
          "id": "2",
          "prompt": "Which one has the ol adapter?",
          "options": [
            "Akşam eve geleceğim.",
            "Akşam evde olacağım."
          ],
          "answer": 1,
          "say": "Akşam evde olacağım.",
          "explanation": "evde is a place, it needs ol. gelmek is a verb, it takes the future directly."
        },
        {
          "id": "3",
          "prompt": "olmayacağız means…",
          "options": [
            "we won't be",
            "we will be",
            "you all won't be"
          ],
          "answer": 0,
          "say": "olmayacağız",
          "explanation": "ma is “not,” ız is “we.”"
        },
        {
          "id": "4",
          "prompt": "“There will be a concert tomorrow”",
          "options": [
            "Yarın konser var olacak.",
            "Yarın konser olacak.",
            "Yarın konser varacak."
          ],
          "answer": 1,
          "say": "Yarın konser olacak.",
          "explanation": "In the future, var turns into olacak. You don't need var itself."
        }
      ]
    },
    {
      "id": "a2.copula-future.ex2",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "sort_buckets",
      "difficulty": 1,
      "instruction": "Adapter or no adapter?",
      "items": [
        {
          "id": "1",
          "buckets": [
            {
              "id": "ol",
              "label": "ol + acak"
            },
            {
              "id": "verb",
              "label": "-acak directly"
            }
          ],
          "entries": [
            {
              "text": "Hava sıcak …",
              "bucket": "ol"
            },
            {
              "text": "Sinemaya gid…",
              "bucket": "verb"
            },
            {
              "text": "Ali öğretmen …",
              "bucket": "ol"
            },
            {
              "text": "Kitap oku…",
              "bucket": "verb"
            },
            {
              "text": "Akşam burada …",
              "bucket": "ol"
            },
            {
              "text": "Eve gel…",
              "bucket": "verb"
            },
            {
              "text": "Murat yorgun …",
              "bucket": "ol"
            },
            {
              "text": "Kar yağ…",
              "bucket": "verb"
            }
          ],
          "explanation": "An action verb at the end — future directly. A word, a quality, or a place — you need ol."
        }
      ]
    },
