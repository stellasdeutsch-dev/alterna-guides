      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Событие, фон, опыт или keşke? Выбери форму",
      "items": [
        {
          "id": "1",
          "prompt": "Dün akşam sinemaya ___. (Вчера вечером я сходил в кино.)",
          "say": "Dün akşam sinemaya gittim.",
          "options": ["gittim", "gidiyordum", "gideceğim"],
          "answer": 0,
          "explanation": "Вчера вечером — закрытое событие. Значит -dı: gittim."
        },
        {
          "id": "2",
          "prompt": "Ben kitap ___, telefon çaldı. (Я читал книгу, зазвонил телефон.)",
          "say": "Ben kitap okuyordum, telefon çaldı.",
          "options": ["okudum", "okuyordum", "okurum"],
          "answer": 1,
          "explanation": "Чтение — фон, звонок — событие. Фон строим на -ıyordu: okuyordum."
        },
        {
          "id": "3",
          "prompt": "Hiç Kapadokya'ya ___? (Ты когда-нибудь был в Каппадокии?)",
          "say": "Hiç Kapadokya'ya gittin mi?",
          "options": ["gidiyor musun", "gittin mi", "gidersin mi"],
          "answer": 1,
          "explanation": "Опыт в прошлом: Hiç … -dın mı? Значит gittin mi."
        },
        {
          "id": "4",
          "prompt": "Maça gitmedim. Keşke ___! (Я не пошёл на матч. Эх, надо было пойти!)",
          "say": "Maça gitmedim. Keşke gitseydim!",
          "options": ["gitsem", "gitseydim", "giderdim"],
          "answer": 1,
          "explanation": "Прошлое не вернуть — поезд ушёл. Это -saydı: keşke gitseydim."
        }
      ]
    },
