    {
      "id": "a1.copula-past.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Spot the form",
      "items": [
        {
          "id": "1",
          "prompt": "Dün hastaydım. — what does it mean?",
          "say": "Dün hastaydım.",
          "options": [
            "I was sick yesterday.",
            "Yesterday I am sick.",
            "Yesterday I will get sick."
          ],
          "answer": 0,
          "explanation": "-ydı means “was.” Hasta-y-dı-m: I was sick."
        },
        {
          "id": "2",
          "prompt": "evde + “I, yesterday” = ?",
          "options": [
            "evdeydim",
            "evdedim",
            "evdeyim"
          ],
          "answer": 0,
          "explanation": "Word ends in a vowel — the y bridge, then -di and -m."
        },
        {
          "id": "3",
          "prompt": "aç + “I, yesterday” = ?",
          "options": [
            "açtım",
            "açdım",
            "açydım"
          ],
          "answer": 0,
          "explanation": "ç is voiceless — so t: açtım."
        },
        {
          "id": "4",
          "prompt": "“Were you sick?” — how?",
          "options": [
            "Hasta mıydın?",
            "Hastaydın mı?"
          ],
          "answer": 0,
          "explanation": "In a question the tail sticks to the particle mı: hasta mıydın?"
        }
      ]
    },
    {
