      "type": "custom",
      "difficulty": 2,
      "instruction": "Display case: seal the exhibit with the right capsule",
      "description": "A word sits under a glass dome. The learner picks one of three ending capsules, it flies in an arc to the word, the dome closes. Keys 1–3. Logic lives in index.html.",
      "items": [
        {
          "id": "1",
          "ctx": "Where were you yesterday? Say: “I was sick yesterday.”",
          "before": "Dün ",
          "word": "hasta",
          "after": ".",
          "opts": [
            "ydım",
            "dım",
            "tım"
          ],
          "answer": "ydım",
          "full": "Dün hastaydım.",
          "ru": "I was sick yesterday.",
          "explanation": "hasta ends in a vowel — y bridge: hastaydım."
        },
        {
          "id": "2",
          "ctx": "Lunch in Kadıköy. “I was really hungry yesterday.”",
          "before": "Dün çok ",
          "word": "aç",
          "after": ".",
          "opts": [
            "dım",
            "tım",
            "ydım"
          ],
          "answer": "tım",
          "full": "Dün çok açtım.",
          "ru": "I was really hungry yesterday.",
          "explanation": "ç is voiceless — t: açtım."
        },
        {
          "id": "3",
          "ctx": "An evening at home with the whole family. “We were home yesterday.”",
          "before": "Dün ",
          "word": "evde",
          "after": ".",
          "opts": [
            "ydik",
            "dik",
            "ydık"
          ],
          "answer": "ydik",
          "full": "Dün evdeydik.",
          "ru": "We were home yesterday.",
          "explanation": "evde ends in the vowel e: y bridge, -di, “we” — -k."
        },
        {
          "id": "4",
          "ctx": "A friend after a shift. “You were tired yesterday.”",
          "before": "Dün ",
          "word": "yorgun",
          "after": ".",
          "opts": [
            "tun",
            "dun",
            "ydun"
          ],
          "answer": "dun",
          "full": "Dün yorgundun.",
          "ru": "You were tired yesterday.",
          "explanation": "n is voiced — d; the vowel u — du; “you” — -n."
        },
        {
          "id": "5",
          "ctx": "A hotel in Sultanahmet. “The room was small.”",
          "before": "Oda ",
          "word": "küçük",
          "after": ".",
          "opts": [
