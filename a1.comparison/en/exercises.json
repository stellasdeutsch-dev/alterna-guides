{
  "topic": "a1.comparison",
  "exercises": [
    {
      "id": "a1.comparison.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Pick how to say it",
      "items": [
        {
          "id": "1",
          "prompt": "“better”",
          "say": "daha iyi",
          "options": [
            "daha iyi",
            "en iyi",
            "iyi daha"
          ],
          "answer": 0,
          "explanation": "daha = more. It goes before the adjective: daha iyi."
        },
        {
          "id": "2",
          "prompt": "“the cheapest”",
          "say": "en ucuz",
          "options": [
            "daha ucuz",
            "ucuz en",
            "en ucuz"
          ],
          "answer": 2,
          "explanation": "en = the most. daha ucuz is just “cheaper”."
        },
        {
          "id": "3",
          "prompt": "Kış yazdan daha soğuk. — what does it mean?",
          "say": "Kış yazdan daha soğuk.",
          "options": [
            "Summer is colder than winter.",
            "Winter is colder than summer.",
            "Winter is the coldest."
          ],
          "answer": 1,
          "explanation": "The tail -dan goes on what you compare with: yazdan — “than summer”. So winter is colder."
        },
        {
          "id": "4",
          "prompt": "“One more tea, please”",
          "say": "Bir çay daha, lütfen.",
          "options": [
            "Bir daha çay, lütfen.",
            "Bir çay daha, lütfen.",
            "En çay, lütfen."
          ],
          "answer": 1,
          "explanation": "“One more” — daha after the noun: bir çay daha."
        }
      ]
    },
    {
      "id": "a1.comparison.ex2",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "sort_buckets",
      "difficulty": 2,
      "instruction": "Sort the words by tail: “than…”",
      "items": [
        {
          "id": "1",
          "buckets": [
            {
              "id": "dan",
              "label": "-dan"
            },
            {
              "id": "den",
              "label": "-den"
            },
            {
              "id": "tan",
              "label": "-tan"
            },
            {
              "id": "ten",
              "label": "-ten"
            }
          ],
          "entries": [
            {
              "text": "araba",
              "bucket": "dan"
            },
            {
              "text": "kahve",
              "bucket": "den"
            },
            {
              "text": "kış",
              "bucket": "tan"
            },
            {
              "text": "köpek",
              "bucket": "ten"
            },
            {
              "text": "dün",
              "bucket": "den"
            },
            {
              "text": "kitap",
              "bucket": "tan"
            },
            {
              "text": "okul",
              "bucket": "dan"
            },
            {
              "text": "otobüs",
              "bucket": "ten"
            }
          ],
          "explanation": "Two questions, in order. Last vowel a ı o u → -dan, e i ö ü → -den. The word ends in a voiceless consonant (f s t k ç ş h p) → d becomes t."
        }
      ]
    },
    {
