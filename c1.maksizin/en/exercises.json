          "options": [
            [
              "maksızın",
              "muksuzun",
              "meksizin"
            ]
          ],
          "translation": "Decided without asking anyone.",
          "explanation": "sor → o → -maksızın. There are only two forms: -maksızın and -meksizin."
        },
        {
          "text": "Hiç düşün___ “evet” dedim.",
          "answers": [
            [
              "meksizin"
            ]
          ],
          "options": [
            [
              "maksızın",
              "meksizin",
              "müksüzün"
            ]
          ],
          "translation": "I said “yes” without thinking.",
          "explanation": "düşün → ü → -meksizin."
        }
      ]
    },
