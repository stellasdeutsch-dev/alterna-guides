          ],
          "options": [
            [
              "meksizin",
              "maksızın",
              "memeksizin"
            ]
          ],
          "translation": "The meeting went on for three hours without a break.",
          "explanation": "ver → e → -meksizin. “Not” is already inside, we don't add -me."
        },
        {
          "text": "Müşteri randevu al___ içeri girdi.",
          "answers": [
            [
              "maksızın"
            ]
          ],
          "options": [
            [
              "meksizin",
              "maksızın",
              "mamaksızın"
            ]
          ],
          "translation": "The client walked in without an appointment.",
          "explanation": "al → a → -maksızın."
        },
        {
          "text": "Kimseye sor___ karar verdi.",
          "answers": [
            [
              "maksızın"
            ]
