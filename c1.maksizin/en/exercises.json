{
  "topic": "c1.maksizin",
  "exercises": [
    {
      "id": "c1.maksizin.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "What does the -maksızın / -meksizin form mean?",
      "items": [
        {
          "prompt": "Saatlerce durmaksızın çalıştı. — durmaksızın:",
          "say": "Saatlerce durmaksızın çalıştı.",
          "options": [
            "without stopping",
            "having stopped",
            "in order to stop"
          ],
          "answer": 0,
          "explanation": "dur — to stop, -maksızın — “without doing”. So he worked without stopping."
        },
        {
          "prompt": "Raporu kimseye göstermeksizin gönderin. — göstermeksizin:",
          "say": "Raporu kimseye göstermeksizin gönderin.",
          "options": [
            "having shown everyone",
            "without showing anyone",
            "before showing"
          ],
          "answer": 1,
          "explanation": "-meksizin already contains “not”: without showing anyone."
        },
        {
          "prompt": "Tereddüt etmeksizin kabul etti. — tereddüt etmeksizin:",
          "say": "Tereddüt etmeksizin kabul etti.",
          "options": [
            "having thought",
            "without hesitating",
            "hesitating"
          ],
          "answer": 1,
          "explanation": "tereddüt etmek — to hesitate. With -meksizin — without hesitating."
        },
        {
          "prompt": "Haber vermeksizin geldi. — haber vermeksizin:",
          "say": "Haber vermeksizin geldi.",
          "options": [
            "having warned",
            "in order to warn",
            "without warning"
          ],
          "answer": 2,
          "explanation": "haber vermek — to let know. The suffix adds “not”: came without warning."
        }
      ]
    },
    {
