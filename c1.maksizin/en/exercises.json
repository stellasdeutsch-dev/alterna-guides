      "instruction": "Mini-check: five questions.",
      "passPercent": 80,
      "items": [
        {
          "prompt": "Where does -maksızın sound right?",
          "options": [
            "In a text to a friend: “Seni beklemeksizin yedim”",
            "On the news: “Yağmur saatlerce durmaksızın yağdı”",
            "In a note to mom: “Kahvaltı yapmaksızın çıktım”"
          ],
          "answer": 1,
          "explanation": "-maksızın is for news, reports and announcements. To a friend or mom, we write -madan: beklemeden, yapmadan."
        },
        {
          "type": "true_false",
          "statement": "This suffix has four forms, like -sız: -maksızın, -meksizin, -muksuzun, -müksüzün.",
          "answer": false,
          "explanation": "There are two forms: -maksızın after a, ı, o, u and -meksizin after e, i, ö, ü."
        },
        {
          "prompt": "How do you say “before leaving”?",
          "options": [
            "gitmeksizin önce",
            "gitmeden önce",
            "gitmemeksizin"
          ],
          "answer": 1,
          "explanation": "Only -madan önce can do “before”. -meksizin only means “without doing”."
        },
        {
          "prompt": "Pick the right form of gör-:",
          "options": [
            "görmaksızın",
            "görmeksizin",
            "görmöksüzün"
          ],
          "answer": 1,
          "explanation": "gör → ö → front vowel → -meksizin."
        },
        {
          "type": "true_false",
          "statement": "sormaksızın already has “not”, so you don't need to add a second -ma.",
          "answer": true,
