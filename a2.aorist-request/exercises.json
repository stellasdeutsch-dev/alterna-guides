      "difficulty": 1,
      "instruction": "Где вежливая просьба?",
      "items": [
        {
          "id": "1",
          "prompt": "Ты просишь друга открыть окно.",
          "options": [
            "Pencereyi açar mısın?",
            "Pencereyi aç!"
          ],
          "answer": 0,
          "say": "Pencereyi açar mısın?",
          "explanation": "Aç! — приказ. Açar mısın? — вопрос. Вопрос и есть вежливость."
        },
        {
          "id": "2",
          "prompt": "Ты просишь официанта принести счёт.",
          "options": [
            "Hesabı getir!",
            "Hesabı getiriyor musun?",
            "Hesabı getirir misiniz?"
          ],
          "answer": 2,
          "say": "Hesabı getirir misiniz?",
          "explanation": "Официант — чужой человек, значит siz: getirir misiniz. Getiriyor musun спрашивает, что он делает прямо сейчас."
        },
        {
          "id": "3",
          "prompt": "Ты просишь водителя остановиться.",
          "options": [
            "Durur musunuz?",
            "Dur!",
            "Duruyor musunuz?"
          ],
          "answer": 0,
          "say": "Durur musunuz?",
          "explanation": "dur — из тринадцати исключений: durur. Дальше musunuz по гласной u."
        },
        {
          "id": "4",
          "prompt": "Ты просишь соседа говорить медленнее.",
          "options": [
            "Yavaş konuş!",
            "Yavaş konuşur musunuz?"
          ],
          "answer": 1,
          "say": "Yavaş konuşur musunuz?",
          "explanation": "Приказ соседу — плохая идея. Konuşur musunuz — тот же смысл, но мягко."
        }
      ]
    },
