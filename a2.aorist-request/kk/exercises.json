      "difficulty": 1,
      "instruction": "Сыпайы өтініш қайсы?",
      "items": [
        {
          "id": "1",
          "prompt": "Досыңнан терезені ашуды сұрайсың.",
          "options": [
            "Pencereyi açar mısın?",
            "Pencereyi aç!"
          ],
          "answer": 0,
          "say": "Pencereyi açar mısın?",
          "explanation": "Aç! — бұйрық. Açar mısın? — сұрақ. Сұрақтың өзі — сыпайылық."
        },
        {
          "id": "2",
          "prompt": "Даяшыдан есепшотты әкелуді сұрайсың.",
          "options": [
            "Hesabı getir!",
            "Hesabı getiriyor musun?",
            "Hesabı getirir misiniz?"
          ],
          "answer": 2,
          "say": "Hesabı getirir misiniz?",
          "explanation": "Даяшы — бөтен адам, демек siz: getirir misiniz. Getiriyor musun оның дәл қазір не істеп жатқанын сұрайды."
        },
        {
          "id": "3",
          "prompt": "Жүргізушіден тоқтауды сұрайсың.",
          "options": [
            "Durur musunuz?",
            "Dur!",
            "Duruyor musunuz?"
          ],
          "answer": 0,
          "say": "Durur musunuz?",
          "explanation": "dur — он үш ерекшеліктің бірі: durur. Әрі қарай u дауыстысы бойынша musunuz."
        },
        {
          "id": "4",
          "prompt": "Көршіңнен баяуырақ сөйлеуді сұрайсың.",
          "options": [
            "Yavaş konuş!",
            "Yavaş konuşur musunuz?"
          ],
          "answer": 1,
          "say": "Yavaş konuşur musunuz?",
          "explanation": "Көршіге бұйрық — жаман ой. Konuşur musunuz — мағынасы сол, бірақ жұмсақ."
        }
      ]
    },
