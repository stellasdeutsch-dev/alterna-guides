    {
      "id": "a2.aorist-request.ex3",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "matching",
      "difficulty": 2,
      "instruction": "Match the situation and the request",
      "items": [
        {
          "id": "1",
          "pairs": [
            {
              "left": "At a café: you need the menu",
              "right": "Menüyü getirir misiniz?"
            },
            {
              "left": "At the market: you need half a kilo",
              "right": "Yarım kilo tartar mısınız?"
            },
            {
              "left": "In a taxi: turn right",
              "right": "Sağa döner misiniz?"
            },
            {
              "left": "At home: the music is loud",
              "right": "Sesi kısar mısın?"
            },
            {
              "left": "On the waterfront: take our picture",
              "right": "Fotoğrafımızı çeker misiniz?"
            }
          ],
          "explanation": "The verb gives away the situation: getir — bring, tart — weigh, dön — turn, kıs — turn down, çek — take (a photo)."
        }
      ]
    },
