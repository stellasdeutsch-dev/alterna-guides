{
  "topic": "a2.aorist-request",
  "exercises": [
    {
      "id": "a2.aorist-request.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Which one is the polite request?",
      "items": [
        {
          "id": "1",
          "prompt": "You ask a friend to open the window.",
          "options": [
            "Pencereyi açar mısın?",
            "Pencereyi aç!"
          ],
          "answer": 0,
          "say": "Pencereyi açar mısın?",
          "explanation": "Aç! is an order. Açar mısın? is a question. The question is the politeness."
        },
        {
          "id": "2",
          "prompt": "You ask the waiter to bring the check.",
          "options": [
            "Hesabı getir!",
            "Hesabı getiriyor musun?",
            "Hesabı getirir misiniz?"
          ],
          "answer": 2,
          "say": "Hesabı getirir misiniz?",
          "explanation": "The waiter is a stranger, so siz: getirir misiniz. Getiriyor musun asks what he’s doing right now."
        },
        {
          "id": "3",
          "prompt": "You ask the driver to stop.",
          "options": [
            "Durur musunuz?",
            "Dur!",
            "Duruyor musunuz?"
          ],
          "answer": 0,
          "say": "Durur musunuz?",
          "explanation": "dur is one of the thirteen exceptions: durur. Then musunuz, following the vowel u."
        },
        {
          "id": "4",
          "prompt": "You ask a neighbor to speak more slowly.",
          "options": [
            "Yavaş konuş!",
            "Yavaş konuşur musunuz?"
          ],
          "answer": 1,
          "say": "Yavaş konuşur musunuz?",
          "explanation": "Ordering your neighbor around is a bad idea. Konuşur musunuz means the same, but softly."
        }
      ]
    },
