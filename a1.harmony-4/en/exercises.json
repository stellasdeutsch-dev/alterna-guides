    {
      "id": "a1.harmony-4.ex3",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "custom",
      "difficulty": 2,
      "instruction": "Istanbul stories: stick on the tail",
      "description": "Six stories from Istanbul. Each shows a word without its tail; the learner sticks on -ım, -im, -um, -üm or -m (keys 1–5). Logic lives in index.html.",
      "items": [
        {
          "id": "1",
          "word": "çay",
          "ru": "my tea",
          "art": "cay",
          "answer": "ım",
          "explanation": "The last vowel is a, its partner is ı: çayım."
        },
        {
          "id": "2",
          "word": "otel",
          "ru": "my hotel",
          "art": "otel",
          "answer": "im",
          "explanation": "Two vowels; the last one decides. It's e, its partner is i: otelim."
        },
        {
          "id": "3",
          "word": "telefon",
          "ru": "my phone",
          "art": "telefon",
          "answer": "um",
          "explanation": "The last vowel is o, its partner is u: telefonum."
        },
        {
          "id": "4",
          "word": "müdür",
          "ru": "my boss",
          "art": "mudur",
          "answer": "üm",
          "explanation": "ü is high, it's its own partner: müdürüm."
        },
        {
          "id": "5",
          "word": "kahve",
          "ru": "my coffee",
          "art": "kahve",
          "answer": "m",
          "explanation": "The word ends in a vowel. The tail is just -m: kahvem."
        },
        {
          "id": "6",
          "word": "arkadaş",
          "ru": "my friend",
          "art": "arkadas",
          "answer": "ım",
          "explanation": "The last vowel is a, its partner is ı: arkadaşım."
        }
      ]
    },
