  "exercises": [
    {
      "id": "c1.repetition-mi.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "What was actually said?",
      "items": [
        {
          "prompt": "«Hava güzel mi güzel!»",
          "options": [
            "The weather is really, really nice!",
            "Is the weather nice?",
            "Is the weather nice or not?"
          ],
          "answer": 0,
          "say": "Hava güzel mi güzel!",
          "explanation": "The word repeats, mi in between, “!” at the end. Not a question — emphasis."
        },
        {
          "prompt": "«Kargo gelmesine geldi ama kutular kırık.»",
          "options": [
            "The shipment didn't arrive, the boxes are broken.",
            "The shipment did arrive, but the boxes are broken.",
            "Although the shipment arrived, the boxes are intact."
          ],
          "answer": 1,
          "say": "Kargo gelmesine geldi ama kutular kırık.",
          "explanation": "-mAsInA + the same verb + ama: it happened, but with a problem."
        },
        {
          "prompt": "How do you say “really, really expensive”?",
          "options": [
            "Pahalı mi pahalı!",
            "Pahalımı pahalı!",
            "Pahalı mı pahalı!"
          ],
          "answer": 2,
          "say": "Pahalı mı pahalı!",
          "explanation": "Last vowel is ı — so mı. And it's written separately."
        },
        {
          "prompt": "“Aramasına aradım ama…” How does it end?",
          "options": [
            "…açmadı.",
            "…hemen açtı.",
            "…çok mutlu oldum."
          ],
          "answer": 0,
          "say": "Aramasına aradım ama açmadı.",
          "explanation": "After ama comes the bad news: I did call, but nobody picked up."
        },
        {
          "prompt": "Which particle: “büyük ___ büyük”?",
          "options": [
            "mu",
            "mü",
            "mi"
          ],
          "answer": 1,
          "say": "büyük mü büyük",
          "explanation": "Last vowel is ü — so mü."
        }
      ]
    },
