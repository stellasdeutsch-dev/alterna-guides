      "difficulty": 1,
      "instruction": "Which side gig is the case working here?",
      "items": [
        {
          "prompt": "Bu ceketi yüz liraya aldım. What does -ya do?",
          "options": [
            "Price: how much I paid",
            "Place: where I bought it",
            "Reason: why I bought it"
          ],
          "answer": 0,
          "say": "Bu ceketi yüz liraya aldım.",
          "explanation": "The money went to the jacket. Wherever the money goes, that's where the -(y)A arrow points. That's the price."
        },
        {
          "prompt": "Yorgunluktan hemen uyudum. What does -tan do?",
          "options": [
            "Path: through what",
            "Reason: from what",
            "Material: made of what"
          ],
          "answer": 1,
          "say": "Yorgunluktan hemen uyudum.",
          "explanation": "Sleep came out of tiredness. The source of a feeling is a reason, so -DAn."
        },
        {
          "prompt": "Haftada iki kez yüzüyorum. What does -da do?",
          "options": [
            "Purpose: what for",
            "Frequency: how many times per period",
            "Place: where I swim"
          ],
          "answer": 1,
          "say": "Haftada iki kez yüzüyorum.",
          "explanation": "Two times sit in the “week” cell. How many times per period — that's -DA."
        },
        {
          "prompt": "Tahtadan bir masa. What does -dan do?",
          "options": [
            "Price per item",
            "Reason",
            "Material: what it's made of"
          ],
          "answer": 2,
          "say": "Tahtadan bir masa.",
          "explanation": "The table is made of wood. Material is where a thing comes from, so -DAn."
        },
        {
          "prompt": "Köprüden geçtik. What does -den do?",
          "options": [
            "Path: what we went across",
            "Time: when we crossed",
            "Status: where now"
          ],
          "answer": 0,
          "say": "Köprüden geçtik.",
          "explanation": "A bridge is a path. What you go through is a source too: -DAn."
        }
      ]
    },
