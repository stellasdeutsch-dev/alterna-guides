{
  "topic": "b1.conditional-nominal",
  "exercises": [
    {
      "id": "b1.conditional-nominal.ex1",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "multiple_choice",
      "difficulty": 1,
      "instruction": "Pick the form",
      "items": [
        {
          "id": "1",
          "prompt": "yorgun + sen → ?",
          "say": "yorgunsan",
          "options": [
            "yorgunsan",
            "yorgunsen",
            "yorgunysan"
          ],
          "answer": 0,
          "explanation": "Last vowel u means sa. It ends in a consonant, so no y. Person sen is n."
        },
        {
          "id": "2",
          "prompt": "hasta + o → ?",
          "say": "hastaysa",
          "options": [
            "hastasa",
            "hastaysa",
            "hastase"
          ],
          "answer": 1,
          "explanation": "hasta ends in a vowel. Two vowels in a row don’t get along, so y steps in between: hastaysa."
        },
        {
          "id": "3",
          "prompt": "öğrenci + siz → ?",
          "say": "öğrenciyseniz",
          "options": [
            "öğrencisanız",
            "öğrenciseniz",
            "öğrenciyseniz"
          ],
          "answer": 2,
          "explanation": "Vowel i means se. Ends in a vowel, so y. Person siz is niz. Total: öğrenciyseniz."
        },
        {
          "id": "4",
          "prompt": "“if you have time” → ?",
          "say": "zamanın varsa",
          "options": [
            "zamanın varsa",
            "zamanın var",
            "zamanın yoksa"
          ],
          "answer": 0,
          "explanation": "No verb “have”: Turkish says “your time is there.” “You” sits in zamanın, “there is” is var. Without the sa clip it’s just a fact. zamanın varsa — if you have time."
        },
        {
          "id": "5",
          "prompt": "“if you’re not hungry” → ?",
          "say": "aç değilsen",
          "options": [
            "aç yoksan",
            "aç değilsen",
            "açsan değil"
          ],
          "answer": 1,
          "explanation": "“Not” is değil, and “are” disappears. The clip jumps onto değil: aç değilsen. yok is “there isn’t,” not “not.”"
        }
      ]
    },
    {
      "id": "b1.conditional-nominal.ex2",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "sort_buckets",
      "difficulty": 1,
      "instruction": "Sort the words by clip",
      "items": [
        {
          "id": "1",
          "buckets": [
            {
              "id": "sa",
              "label": "-sa"
            },
            {
              "id": "se",
              "label": "-se"
            },
            {
              "id": "ysa",
              "label": "-ysa"
            },
            {
              "id": "yse",
              "label": "-yse"
            }
          ],
          "entries": [
            {
              "text": "yorgun",
              "bucket": "sa"
            },
            {
              "text": "güzel",
              "bucket": "se"
            },
            {
              "text": "hasta",
              "bucket": "ysa"
            },
            {
              "text": "iyi",
              "bucket": "yse"
            },
            {
              "text": "sıcak",
              "bucket": "sa"
            },
            {
              "text": "üzgün",
              "bucket": "se"
            },
            {
              "text": "dolu",
              "bucket": "ysa"
            },
            {
              "text": "kötü",
              "bucket": "yse"
            }
          ],
          "explanation": "Two questions. What’s the last vowel: a ı o u → sa, e i ö ü → se. Does the word end in a vowel? Then y goes first."
        }
      ]
    },
    {
      "id": "b1.conditional-nominal.ex3",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "matching",
      "difficulty": 2,
      "instruction": "Match the condition and the translation",
      "items": [
        {
          "id": "1",
          "pairs": [
            {
              "left": "Yorgunsan",
              "right": "if you’re tired"
            },
            {
              "left": "Yorgun değilsen",
              "right": "if you’re not tired"
            },
            {
              "left": "Zamanın varsa",
              "right": "if you have time"
            },
            {
              "left": "Zamanın yoksa",
              "right": "if you don’t have time"
            },
            {
              "left": "Evdeysen",
              "right": "if you’re home"
            }
          ],
          "explanation": "değil = “not,” yok = “there isn’t / don’t have,” var = “there is / have.” The sa clip turns all of them into “if.” No “are” anywhere."
        }
      ]
    },
    {
      "id": "b1.conditional-nominal.ex4",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "mixed",
      "difficulty": 2,
      "instruction": "Build it, find the mistake, write it yourself",
      "items": [
        {
          "id": "1",
          "type": "build_sentence",
          "translation": "If you’re hungry, there’s a restaurant here.",
          "words": [
            "Açsan",
            "burada",
            "bir",
            "lokanta",
            "var."
          ],
          "distractors": [
            "Açysan"
          ],
          "explanation": "aç ends in the consonant ç, so no buffer y: açsan. And no word for “are” — the clip does the job."
        },
        {
          "id": "2",
          "type": "error_hunt",
          "prompt": "Find the mistake",
          "tokens": [
            "Ekmek",
            "değilse",
            "simit",
            "al."
          ],
          "wrong": 1,
          "fix": "yoksa",
          "options": [
            "yoksa",
            "varsa",
            "değil"
          ],
          "explanation": "Like English “no bread” vs “not bread.” No bread → yok: ekmek yoksa. değil is “not”: ekmek değilse — “if it’s not bread.”"
        },
        {
          "id": "3",
          "type": "gap_fill",
          "text": "___ çıkalım. (hazır, sen)",
          "answers": [
            [
              "Hazırsan",
              "hazırsan"
            ]
          ],
          "translation": "If you’re ready, let’s go.",
          "explanation": "hazır: last vowel ı → sa, ends in a consonant. Person sen → n: hazırsan."
        },
        {
          "id": "4",
          "type": "build_sentence",
          "translation": "If you’re students, there’s a discount.",
          "words": [
            "Öğrenciyseniz",
            "indirim",
            "var."
          ],
          "distractors": [
            "Öğrenciseniz"
          ],
          "explanation": "öğrenci ends in a vowel, so y. Without it the clip won’t hold."
        }
      ]
    },
    {
      "id": "b1.conditional-nominal.ex5",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "custom",
      "difficulty": 2,
      "instruction": "Tune the guitar: put the clip on the right fret",
      "description": "A phrase with a gap and a neck with four frets. The learner picks a fret (button or keys 1–4), the capo slides onto it, the phrase plays. Logic lives in index.html.",
      "items": [
        {
          "id": "1",
          "phrase": "Hasta___ eczaneye git.",
          "ru": "If you’re sick, go to the pharmacy.",
          "options": [
            "ysan",
            "san",
            "sen",
            "yse"
          ],
          "answer": "ysan",
          "say": "Hastaysan eczaneye git.",
          "explanation": "hasta ends in the vowel a: you need y, then sa, then person n."
        },
        {
          "id": "2",
          "phrase": "Öğrenci___ indirim var.",
          "ru": "If you’re students, there’s a discount.",
          "options": [
            "sanız",
            "yseniz",
            "ysanız",
            "seniz"
          ],
          "answer": "yseniz",
          "say": "Öğrenciyseniz indirim var.",
          "explanation": "Vowel i → se. Ends in a vowel → y. Person siz → niz."
        },
        {
          "id": "3",
          "phrase": "Hava sıcak___ denize gireriz.",
          "ru": "If it’s hot, we’ll go swimming in the sea.",
          "options": [
            "se",
            "ysa",
            "sa",
            "yse"
          ],
          "answer": "sa",
          "say": "Hava sıcaksa denize gireriz.",
          "explanation": "sıcak: vowel a, ends in a consonant. Just sa."
        },
        {
          "id": "4",
          "phrase": "Zamanın var___ Kaleiçi'ne gidelim.",
          "ru": "If you have time, let’s go to Kaleiçi.",
          "options": [
            "san",
            "sa",
            "se",
            "ysa"
          ],
          "answer": "sa",
          "say": "Zamanın varsa Kaleiçi'ne gidelim.",
          "explanation": "“You” already sits in zamanın (your time). var has no person of its own: just varsa — not varsan."
        },
        {
          "id": "5",
          "phrase": "Aç değil___ sadece çay içelim.",
          "ru": "If you’re not hungry, let’s just have tea.",
          "options": [
            "san",
            "ysen",
            "sen",
            "sa"
          ],
          "answer": "sen",
          "say": "Aç değilsen sadece çay içelim.",
          "explanation": "The clip sits on değil. Its vowel i → se, person sen → n."
        },
        {
          "id": "6",
          "phrase": "Evde___ geliyorum.",
          "ru": "If you’re home, I’m coming over.",
          "options": [
            "sen",
            "ysan",
            "san",
            "ysen"
          ],
          "answer": "ysen",
          "say": "Evdeysen geliyorum.",
          "explanation": "evde ends in the vowel e: you need y and se. Person sen → n."
        }
      ]
    },
