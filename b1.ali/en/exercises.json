          "answer": 0,
          "explanation": "taşınalı = since moving. The stopwatch started on moving day."
        },
        {
          "id": "2",
          "prompt": "Seni görmeyeli çok oldu.",
          "say": "Seni görmeyeli çok oldu.",
          "options": [
            "Haven't seen you in ages.",
            "I see you often.",
            "Let's meet up."
          ],
          "answer": 0,
          "explanation": "görme = not see. görmeyeli = since last seeing."
        },
        {
          "id": "3",
          "prompt": "Which form means “since coming”?",
          "options": [
            "geleli",
            "gelelim",
            "gelince"
          ],
          "answer": 0,
          "explanation": "gelelim means “let's come.” One letter, a different meaning."
        },
        {
          "id": "4",
          "prompt": "Geldi geleli hiç dinlenmedi.",
          "say": "Geldi geleli hiç dinlenmedi.",
          "options": [
            "Ever since I came, I haven't rested once.",
            "I came and rested right away.",
            "If he comes, he won't rest."
          ],
          "answer": 0,
          "explanation": "The echo geldi geleli stretches time: from that moment until now."
        }
      ]
    },
