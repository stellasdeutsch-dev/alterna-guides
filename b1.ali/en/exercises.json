    {
      "id": "b1.ali.ex4",
      "lesson": 1,
      "kind": "practice",
      "skill": "grammar",
      "type": "custom",
      "difficulty": 2,
      "instruction": "Stopwatch: point the hand at the right suffix",
      "description": "A dial with four sectors: -alı, -eli, -yalı, -yeli. The learner sets the hand and presses “Stop.” Logic is in index.html.",
      "items": [
        {
          "id": "1",
          "stem": "taşın",
          "ru": "since moving",
          "answer": "alı",
          "explanation": "The last vowel is ı, ends in a consonant: -alı."
        },
        {
          "id": "2",
          "stem": "gör",
          "ru": "since seeing",
          "answer": "eli",
          "explanation": "The last vowel is ö, ends in a consonant: -eli."
        },
        {
          "id": "3",
          "stem": "başla",
          "ru": "since starting",
          "answer": "yalı",
          "explanation": "Ends in the vowel a. You need the bridge y: -yalı."
        },
        {
          "id": "4",
          "stem": "görme",
          "ru": "since last seeing",
          "answer": "yeli",
          "explanation": "-me always leaves a vowel at the end, so y: görmeyeli."
        },
        {
          "id": "5",
          "stem": "uyu",
          "ru": "since falling asleep",
          "answer": "yalı",
          "explanation": "u is a back vowel, and it ends in a vowel: uyuyalı."
        }
      ]
    },
